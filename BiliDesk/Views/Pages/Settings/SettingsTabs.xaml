<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BiliDesk.Views.Controls">
    <!--
        设置页四个 Tab 的内容模板(2026-10-03 重做)。
        由 SettingsPage.xaml 的 ContentControl 按 TabIndex 切换。

        行的写法约定(全部页面保持一致):
          · 每行 = Grid(SettingsRowStyle), 列 0 = 标题+描述, 列 1 = 控件(Auto, 右对齐);
          · 行间用 SettingsRowDivider(比页面通用分隔线更淡);
          · 布尔项 = SettingsToggleStyle 开关; 枚举项 = SettingsComboStyle 下拉;
          · 有副标题/hint 的行, 描述文字直接绑 VM 现有属性, 文案零改动。

        与旧版(单页长列表)的对应关系:
          通用:   颜色模式 / 主题色 / 关闭时最小化到托盘 / 立即收进托盘
          播放:   首页推荐算法 / 弹幕四项(显示/区域/智能屏蔽/彩色/关键词) / 赞助片段
          数据管理: 账户 / 封面图片缓存 / 短视频下载缓存
          关于:   软件信息 / 作者 / 声明 / 自动检查更新 / 检查更新 / 版本号
    -->

    <!-- 区块标题: 竖条 + 加粗文字。四个模板都用 -->
    <DataTemplate x:Key="SectionHeaderTemplate">
        <StackPanel Style="{StaticResource SettingsSectionHeaderStyle}">
            <Border Width="3.5" Height="15" CornerRadius="2"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
    </DataTemplate>

    <!-- 行标题+描述的公共 StackPanel 写法, 只是为了少重复; 控件列各处不同 -->
    <!-- ==================== 通用 ==================== -->
    <DataTemplate x:Key="GeneralTabTemplate">
        <StackPanel>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="外观" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- 颜色模式: 参考图是下拉。旧版为三段单选(跟随系统/浅色/深色) -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="应用主题" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="选择深色或浅色模式; 跟随系统会随 Windows 自动切换"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding ThemeSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 主题色。这块不是"一行"能装下的(调色盘 150 高), 用竖排布局,
                         但标题/描述与行标题同一套字号。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="主题色" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="按钮、选中项、链接等强调色。默认是 B 站粉, 也可以跟随系统或自己调一个"
                                   Style="{StaticResource SettingsRowDescStyle}" />

                        <!-- 来源三选一(分段单选保留: 三个来源是并列关系, 下拉反而多一步) -->
                        <Border HorizontalAlignment="Left" Background="{DynamicResource InputBackgroundBrush}"
                                CornerRadius="9" Padding="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="B 站粉"
                                             IsChecked="{Binding IsAccentDefault, Mode=TwoWay}" />
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="跟随系统" Margin="6,0,0,0"
                                             IsChecked="{Binding IsAccentSystem, Mode=TwoWay}" />
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="自定义" Margin="6,0,0,0"
                                             IsChecked="{Binding IsAccentCustom, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 拖动起止由代码后置接到 VM 上(见 SettingsPage.OnLoaded) -->
                            <controls:ColorPalette x:Name="Palette" Height="150"
                                                   IsEnabled="{Binding CanEditAccent}"
                                                   Color="{Binding AccentPickerColor, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <!-- 预览永远引实际生效的 AccentBrush, 与全应用一致 -->
                                <Border Width="46" Height="46" CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
                                <TextBox Width="104" Margin="0,12,0,0" HorizontalAlignment="Left"
                                         Style="{StaticResource FluentTextBoxStyle}"
                                         IsEnabled="{Binding CanEditAccent}"
                                         Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="也可以直接填 HEX, 例如 #7C4DFF" />
                                <Button Content="恢复默认" Style="{StaticResource SubtleButtonStyle}"
                                        Margin="0,10,0,0" Padding="12,5" HorizontalAlignment="Left"
                                        Command="{Binding ResetAccentCommand}"
                                        IsEnabled="{Binding IsDefaultAccent, Converter={StaticResource InvBool}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="托盘" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="关闭时最小化到托盘" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CloseToTrayHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="立即收进托盘" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="把主界面收进系统托盘, 双击托盘图标可恢复"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="最小化到托盘"
                                Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding MinimizeToTrayCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 播放 ==================== -->
    <DataTemplate x:Key="PlaybackTabTemplate">
        <StackPanel>

            <!-- 推荐算法这一块整体删除了(2026-10-03): 原本有「B 站官方 App / 浏览器网页版」
                 二选一, 但实测 App 端接口对第三方客户端不提供个性化(返回全站通用热门池,
                 平均播放量 66~103 万; 网页 rcmd 只有 17 万且明显更贴口味)。留着只会误导,
                 所以连"算法"这个概念一起撤掉, 首页推荐固定走网页版。详见 ApiClient.GetRecommendAsync。 -->

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="播放" />

            <!-- 默认画质(2026-10-04 新增): 开始播放**之前**先选定本次要用的清晰度,
                 之后每条视频都用它起播; 该档不存在/没有权限时自动降到可用的下一档
                 (降级规则见 ApiClient.GetPlayUrlAsync 的选流分支)。
                 默认档是 1080P —— 与播放器改动前写死的 qn=80 一致, 老用户升级后画质不变。 -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="默认画质" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding QualityHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding QualitySelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 免登录 1080P: 未登录时给取流请求补 try_look + dm_img_* 四件套,
                         把匿名可见清晰度从 360P/480P 提到 720P/1080P(依据见 ApiClient.ApplyTryLook)。
                         这是设备指纹启发式放权, B 站改判据就会失效, 所以给用户一个关掉的入口。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="免登录 1080P" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding NoLogin1080PHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding NoLogin1080P, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- CDN 线路: 自动测速挑最快 / 手动指定一家 / 跟随服务端。
                         实测各家 CDN 同一时刻吞吐能差 4 倍以上, 且排名随网络/地区/时段变化,
                         所以默认自动。逻辑与实测依据见 Services/CdnService.cs。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="线路选择" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="B 站为同一视频提供多家 CDN; 自动测速会实测吞吐挑最快的一条"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding CdnModeOptions}"
                                  SelectedItem="{Binding CdnModeSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 手动指定: 只在「手动指定」模式下可点(置灰而非隐藏) -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="指定 CDN" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="仅在「手动指定」时生效; 该线路不可用时会自动改用最快线路"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanPickCdn}"
                                  ItemsSource="{Binding CdnHostOptions}"
                                  SelectedItem="{Binding CdnHostSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 屏蔽 PCDN: 默认开。PCDN 拿其他用户带宽做节点, 速度不稳定 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="屏蔽 PCDN" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="不参与点对点分发(会占用他人带宽且速度不稳定); 实测常规 CDN 吞吐更高"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding BlockPcdn, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 重新测速: 换网络后排名会变, 而自动测速有 10 分钟缓存 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="重新测速" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CdnSpeedReport}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="{Binding CdnTestStatus}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Visibility="{Binding CdnTestStatus, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="开始测速" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding TestCdnCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="弹幕" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="显示弹幕" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="关闭后播放器不再渲染任何弹幕"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DanmakuEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="弹幕显示区域" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding DanmakuAreaText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="25" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding DanmakuAreaPercent, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="智能屏蔽" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="过滤超长弹幕与刷屏弹幕, 减少加载量与卡顿"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DanmakuSmartFilter, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="彩色弹幕" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="按发送者选的颜色显示弹幕; 关闭后全部显示为白色"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DanmakuColorful, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="关键词屏蔽" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="每行一条, 也可用逗号分隔。以 re: 开头按正则匹配, 例如 re:^\d{4}/\d{1,2}/\d{1,2}$ 可屏蔽日期打卡"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <TextBox Margin="0,10,0,0" MinHeight="72" MaxHeight="140"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource FluentTextBoxStyle}"
                                 Text="{Binding DanmakuBlockKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DanmakuRuleCountText}"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="跳过赞助片段" />

            <!-- 数据来自 B 站社区众筹标注(SponsorBlock)。默认关: 开启后每条视频的 BV 号
                 都会发到第三方服务器, 必须由用户自己选 —— 隐私告知就写在同一张卡里。 -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动跳过赞助片段" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="播到被社区标注的片段时自动跳到片段末尾, 右上角可随时撤回"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SponsorBlockEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 类别多选。总开关关掉时整块置灰(可见但不可点) -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}" IsEnabled="{Binding SponsorBlockEnabled}">
                        <TextBlock Text="跳过的类别" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="数据来自网友标注的众筹数据库, 没人标注过的视频不会被跳过"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <ItemsControl ItemsSource="{Binding SponsorCategoryOptions}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" Style="{StaticResource LabeledCheckBoxStyle}"
                                              Margin="0,0,18,8" Cursor="Hand"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SponsorBlockSummary}"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="开启后, 每条播放的视频会把它的 BV 号与分 P 编号发送到第三方标注服务 (bsbsb.top) 用于查询片段; 该请求不含你的账号或登录信息。"
                                   Style="{StaticResource SettingsRowDescStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="片段由网友标注, 可能标错; 跳过时会提示, 可以随时点「撤回」回到片段开头。"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 数据管理 ==================== -->
    <DataTemplate x:Key="DataTabTemplate">
        <StackPanel>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="账户" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <!-- 已登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AvatarBox" Width="46" Height="46" CornerRadius="23"
                                Background="{DynamicResource AccentSoftFillBrush}">
                            <TextBlock x:Name="AvatarFallback" Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Lv." /><Run Text="{Binding UserLevel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding UserCoins, Mode=OneWay}" /><Run Text=" 硬币" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="退出登录" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" Command="{Binding LogoutCommand}" />
                    </Grid>
                    <!-- 未登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding LoginCommand}" />
                            <TextBlock Text="登录后可观看高清视频、同步账号信息"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="缓存" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- "观看历史(本机)"已随本机历史移除(历史统一走云端), 不再列。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="封面图片缓存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CacheSizeText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 短视频下载缓存: 3 分钟内视频的 1080P 音视频本地合流产物,
                         和上面的封面缓存是两回事。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="短视频下载缓存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding VideoCacheSizeText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="{Binding VideoCacheHint}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding ClearVideoCacheCommand}"
                                ToolTip="删除已下载的短视频(下次播放会重新下载)" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 关于 ==================== -->
    <DataTemplate x:Key="AboutTabTemplate">
        <StackPanel>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="软件" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14">
                        <Border Width="34" Height="34" CornerRadius="9">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/app.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BiliDesk" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="一款哔哩哔哩第三方桌面客户端。"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <TextBlock Text="本应用为非官方软件, 视频内容与版权归哔哩哔哩所有。"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="更新" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AutoCheckUpdateHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Visibility="{Binding UpdateStatusText, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查更新" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding CheckUpdateCommand}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本号" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="当前使用中的程序版本"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionNumber}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="作者" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Button Style="{StaticResource AuthorCardButtonStyle}"
                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                            Margin="0,8"
                            Command="{Binding OpenAuthorCommand}" ToolTip="在应用内打开作者的主页">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentSoftFillBrush}">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="作者" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="ABing" FontWeight="SemiBold" FontSize="14"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="BiliDesk 作者 / 点击进入我的 B 站主页"
                                           Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="非官方声明与免责声明" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="首次启动时已确认, 可随时在这里重新查看全文"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Button Content="查看声明" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Command="{Binding ShowDisclaimerCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
