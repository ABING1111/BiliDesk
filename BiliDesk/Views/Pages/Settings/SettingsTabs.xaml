<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:BiliDesk.Views.Controls">
    <!--
        设置页四个 Tab 的内容模板(2026-10-03 重做)。
        由 SettingsPage.xaml 的 ContentControl 按 TabIndex 切换。

        行的写法约定(全部页面保持一致):
          · 每行 = Grid(SettingsRowStyle), 列 0 = 标题+描述, 列 1 = 控件(Auto, 右对齐);
          · 行间用 SettingsRowDivider(比页面通用分隔线更淡);
          · 布尔项 = SettingsToggleStyle 开关; 枚举项 = SettingsComboStyle 下拉;
          · 有副标题/hint 的行, 描述文字直接绑 VM 现有属性, 文案零改动。

        与旧版(单页长列表)的对应关系:
          通用:   颜色模式 / 主题色 / 关闭时最小化到托盘 / 立即收进托盘
          播放:   跳过赞助片段 / 画质 / 缓冲 / 网络线路 / 弹幕(显示与过滤 / 外观)
          数据管理: 账户 / 封面图片缓存 / 短视频下载缓存
          关于:   软件信息 / 作者 / 声明 / 自动检查更新 / 检查更新 / 版本号

        ★ 2026-11-05 排版重整(播放页):
          · 「跳过赞助片段」从**最下面提到最上面** —— 它是整个播放页唯一一个用户会主动
            去开的功能, 且默认关; 放在最底下等于要一路滚到底才看得见, 常常就此错过。
          · 区块顺序改为: 跳过赞助片段 → 播放 → 弹幕。
          · 卡片内按"组"分组, 组间用 SettingsGroupHeaderStyle 的小标题隔开
            (播放页: 画质 / 缓冲 / 网络线路; 弹幕页: 显示与过滤 / 外观)。
            原来十几行同权重地堆在一张卡里, 用户分不清哪几行是一回事。
          · 删掉了「按类型过滤」后面那条**重复的分隔线**(原来连着两条)。
    -->

    <!-- 区块标题: 竖条 + 加粗文字。四个模板都用 -->
    <DataTemplate x:Key="SectionHeaderTemplate">
        <StackPanel Style="{StaticResource SettingsSectionHeaderStyle}">
            <Border Width="3.5" Height="15" CornerRadius="2"
                    Background="{DynamicResource AccentBrush}"
                    VerticalAlignment="Center" />
            <TextBlock Text="{Binding}" FontSize="14" FontWeight="Bold"
                       Margin="8,0,0,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </StackPanel>
    </DataTemplate>

    <!-- 行标题+描述的公共 StackPanel 写法, 只是为了少重复; 控件列各处不同 -->
    <!-- ==================== 通用 ==================== -->
    <DataTemplate x:Key="GeneralTabTemplate">
        <StackPanel>

            <!-- ============ 首页推荐 ============
                 2026-11 恢复「网页版 / App 端」二选一(2026-10-03 曾因 App 端接口
                 对第三方客户端可能返回通用池而删除)。默认网页版; 切换后首页会
                 立即清空并按新来源重新加载(见 SettingsStore.SetRecommendSource)。 -->
            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="首页推荐" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Text="推荐来源" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="{Binding RecommendSourceHint}"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <TextBlock Text="切换后首页推荐会立即清空并重新加载"
                                   Style="{StaticResource SettingsRowDescStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                    <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                              Width="170" VerticalAlignment="Center"
                              ItemsSource="{Binding RecommendOptions}"
                              SelectedItem="{Binding RecommendSelected, Mode=TwoWay}" />
                </Grid>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="外观" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- 颜色模式: 参考图是下拉。旧版为三段单选(跟随系统/浅色/深色) -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="应用主题" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="选择深色或浅色模式; 跟随系统会随 Windows 自动切换"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170"
                                  ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding ThemeSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 主题色。这块不是"一行"能装下的(调色盘 150 高), 用竖排布局,
                         但标题/描述与行标题同一套字号。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="主题色" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="按钮、选中项、链接等强调色。默认是 B 站粉, 也可以跟随系统或自己调一个"
                                   Style="{StaticResource SettingsRowDescStyle}" />

                        <!-- 来源三选一(分段单选保留: 三个来源是并列关系, 下拉反而多一步) -->
                        <Border HorizontalAlignment="Left" Background="{DynamicResource InputBackgroundBrush}"
                                CornerRadius="9" Padding="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="B 站粉"
                                             IsChecked="{Binding IsAccentDefault, Mode=TwoWay}" />
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="跟随系统" Margin="6,0,0,0"
                                             IsChecked="{Binding IsAccentSystem, Mode=TwoWay}" />
                                <RadioButton GroupName="AccentSourceGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="自定义" Margin="6,0,0,0"
                                             IsChecked="{Binding IsAccentCustom, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="250" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 拖动起止由代码后置接到 VM 上(见 SettingsPage.OnLoaded) -->
                            <controls:ColorPalette x:Name="Palette" Height="150"
                                                   IsEnabled="{Binding CanEditAccent}"
                                                   Color="{Binding AccentPickerColor, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                                <!-- 预览永远引实际生效的 AccentBrush, 与全应用一致 -->
                                <Border Width="46" Height="46" CornerRadius="10"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"
                                        BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
                                <TextBox Width="104" Margin="0,12,0,0" HorizontalAlignment="Left"
                                         Style="{StaticResource FluentTextBoxStyle}"
                                         IsEnabled="{Binding CanEditAccent}"
                                         Text="{Binding AccentColor, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                         ToolTip="也可以直接填 HEX, 例如 #7C4DFF" />
                                <Button Content="恢复默认" Style="{StaticResource SubtleButtonStyle}"
                                        Margin="0,10,0,0" Padding="12,5" HorizontalAlignment="Left"
                                        Command="{Binding ResetAccentCommand}"
                                        IsEnabled="{Binding IsDefaultAccent, Converter={StaticResource InvBool}}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 界面字体(2026-11-14 新增): 全局文字字体, 弹幕跟随同一字体, 图标不受影响。
                         ★ 下拉每一项用该项自己的字体渲染(所见即所得); 系统字体列表懒加载
                           (打开设置页才枚举, 见 Helpers.UiFont.SystemFonts), 不拖启动。
                         ★ 导入的字体文件复制到数据目录(fonts), 不依赖原文件位置、无需安装到系统;
                           存储语义/生命周期见 Helpers.UiFont 类注释。
                         ★ 排版与「主题色」同款竖排: 标题 + 说明 + 一排控件(下拉/导入/恢复默认)。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="界面字体" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="{Binding FontHint}"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ComboBox Style="{StaticResource SettingsComboStyle}"
                                      Width="240" VerticalAlignment="Center"
                                      ItemsSource="{Binding FontOptions}"
                                      SelectedItem="{Binding FontSelected, Mode=TwoWay}"
                                      VirtualizingStackPanel.IsVirtualizing="True"
                                      VirtualizingStackPanel.VirtualizationMode="Recycling">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Label}" FontFamily="{Binding Preview}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="导入字体文件…" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="10,0,0,0" Padding="12,5" VerticalAlignment="Center"
                                    Command="{Binding ImportFontCommand}" />
                            <Button Content="恢复默认" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Padding="12,5" VerticalAlignment="Center"
                                    Command="{Binding ResetFontCommand}"
                                    IsEnabled="{Binding IsDefaultFont, Converter={StaticResource InvBool}}" />
                        </StackPanel>
                    </StackPanel>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 窗口背景材质(2026-10-06 合并为四选一):
                         原来"亚克力背景"是个开关、云母/云母Alt 是它下面的子选项 —— 语义是错的
                         (云母根本不是亚克力), 而且"关掉开关就选不了云母"很别扭。
                         现在四种材质**平级**: 无 / 亚克力 / 云母 / 云母Alt, 选"无"就是关闭。
                         ★ 为什么给的是"材质选择"而不是"模糊度"滑杆: 系统没有任何 API 能改模糊半径
                           (模糊是 DWM 写死的常量), 官方开放的只有"用哪种材质"。详见 BackdropMaterial。
                         ★ 用与"主题色来源"同款的 SegmentRadioStyle 胶囊组(并列单选),
                           不另造一套控件语言。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="窗口背景材质" Style="{StaticResource SettingsRowTitleStyle}" />
                            <!-- "实验性"标记: 与标题同一行的浅色小胶囊, 不抢标题的视觉重心 -->
                            <Border Background="{DynamicResource AccentSoftFillStrongBrush}"
                                    CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                                    VerticalAlignment="Center">
                                <TextBlock Text="实验性" FontSize="10.5"
                                           Foreground="{DynamicResource AccentTextStrongBrush}" />
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding AcrylicMaterialHint}"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <Border HorizontalAlignment="Left" Background="{DynamicResource InputBackgroundBrush}"
                                CornerRadius="9" Padding="3" Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton GroupName="BackdropMaterialGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="无"
                                             IsChecked="{Binding IsMaterialNone, Mode=TwoWay}" />
                                <RadioButton GroupName="BackdropMaterialGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="亚克力" Margin="6,0,0,0"
                                             IsChecked="{Binding IsMaterialAcrylic, Mode=TwoWay}" />
                                <RadioButton GroupName="BackdropMaterialGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="云母" Margin="6,0,0,0"
                                             IsChecked="{Binding IsMaterialMica, Mode=TwoWay}" />
                                <RadioButton GroupName="BackdropMaterialGroup" Style="{StaticResource SegmentRadioStyle}"
                                             Content="云母 Alt" Margin="6,0,0,0"
                                             IsChecked="{Binding IsMaterialMicaAlt, Mode=TwoWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 亚克力透明度: 只在选中**亚克力**时显示。
                         ★ 云母是不透明的(只采样壁纸), 对它调"页面底不透明度"没有实际效果 ——
                           折起来免得用户调半天发现没反应。 -->
                    <Border Style="{StaticResource SettingsRowDivider}"
                            Visibility="{Binding IsTransparentMaterial, Converter={StaticResource BoolToVis}}" />

                    <!-- 亚克力透明度调节(浅色主题): 只在亚克力开启时显示。
                         ★ 排版与"弹幕显示区域"那行**保持同款**(用户要求): 说明行里带数值,
                           右侧是固定 240 宽的 SettingsSliderStyle 滑杆 —— 而不是小号默认滑杆 + 右侧百分比。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}"
                          Visibility="{Binding IsTransparentMaterial, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="亚克力透明度 · 浅色" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AcrylicOpacityLightText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="{Binding AcrylicOpacityLightMin}" Maximum="{Binding AcrylicOpacityLightMax}"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding AcrylicOpacityLight, Mode=TwoWay}" />
                    </Grid>

                    <!-- 亚克力透明度调节(深色主题): 同上, 深浅两套值可分别调 -->
                    <Border Style="{StaticResource SettingsRowDivider}"
                            Visibility="{Binding IsTransparentMaterial, Converter={StaticResource BoolToVis}}" />
                    <Grid Style="{StaticResource SettingsRowStyle}"
                          Visibility="{Binding IsTransparentMaterial, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="亚克力透明度 · 深色" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AcrylicOpacityDarkText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="{Binding AcrylicOpacityDarkMin}" Maximum="{Binding AcrylicOpacityDarkMax}"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding AcrylicOpacityDark, Mode=TwoWay}" />
                    </Grid>

                </StackPanel>
            </Border>

            <!-- ============ 交互 ============
                 ★ 2026-11-07 用户要求: 把「软件缩放」「卡片列数」从「外观」挪出来,
                   和新增的「滚轮速度」一起单独成板块 —— 这三项都是"怎么滚 / 怎么排 / 多大"
                   的操作类偏好, 与配色、材质那些纯观感项分开。 -->
            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="交互" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- 滚轮速度(2026-11-07 新增): 一格滚轮滑多远。
                         ★ 滚动是"按这个距离 + 缓动曲线滑过去"(见 Helpers/WheelScroll), 不是瞬移。
                         ★ 条目滚动的虚拟化列表(动态页动态流、会话列表等)保持引擎原生的"一格 3 条",
                           不跟着加速 —— 再乘倍数会一笔跳过好几张整卡。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="滚轮速度" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding WheelSpeedText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="滚轮每格滑过的距离；条目滚动的列表保持系统默认"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="{Binding WheelSpeedMin}" Maximum="{Binding WheelSpeedMax}"
                                IsSnapToTickEnabled="True" TickFrequency="25"
                                Value="{Binding WheelSpeedPercent, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 卡片列数(2026-10-06 新增; 2026-11-07 从「外观」移入「交互」):
                         0 = 自动(按窗口宽度), 2~8 = 固定列数。
                         ★ 作用于所有卡片页(首页/历史/收藏/搜索/分区/稍后再看/关注/个人空间) ——
                           它们共用同一套卡片墙, 且用户选定"所有卡片页统一"。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="卡片列数" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CardColumnsText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="作用于首页、历史、收藏、搜索等所有卡片页"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="{Binding CardColumnsMin}" Maximum="{Binding CardColumnsMax}"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding CardColumns, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 软件缩放(2026-10-06 新增; 2026-11-07 从「外观」移入「交互」):
                         把整个界面按百分比放大/缩小, 与系统 DPI 无关。
                         ★ 用 LayoutTransform(见 Helpers/UiScale): 字与控件一起缩, 布局会重新排版。
                         ★★ 说明文案必须点明播放器的缩放范围 —— 只有右侧信息栏(含评论区)跟着缩,
                            视频画面与顶栏保持原尺寸。不能连视频区一起缩: LibVLCSharp.WPF 3.8.0 把
                            控制栏/弹幕层放在独立浮层窗口里, 那层不认祖先缩放, 会与视频区错开
                            195×186px(实测见 .probes/bd-probe-uiscale-player)。不讲清楚用户会当 bug。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="软件缩放" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding UiScaleText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="放大界面文字与控件；播放器只缩放右侧信息栏"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="{Binding UiScaleMin}" Maximum="{Binding UiScaleMax}"
                                IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding UiScalePercent, Mode=TwoWay}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="托盘" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="关闭时最小化到托盘" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CloseToTrayHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="立即收进托盘" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="把主界面收进系统托盘, 双击托盘图标可恢复"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="最小化到托盘"
                                Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding MinimizeToTrayCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 播放 ==================== -->
    <DataTemplate x:Key="PlaybackTabTemplate">
        <StackPanel>

            <!-- ★★★ 2026-11-05 排版重整: 「跳过赞助片段」提到**最上面**。
                 理由: 它是整个播放页里唯一一个**用户会主动去开的功能**(其余都是"调参数")，
                 而且默认关 —— 放在最下面意味着用户要一路滚到底才看得见它, 常常就此错过。
                 区块顺序改为: 跳过赞助片段 → 播放 → 弹幕。
                 同一次重整还做了:
                   · 「播放」区按"画质 / 缓冲 / 网络线路"三组分组, 每组加小标题,
                     不再是十来个同权重行堆在一张卡里;
                   · 「弹幕」区的"智能屏蔽"提到"显示弹幕"旁边(都是开关, 归在一起),
                     外观三项与过滤项分开;
                   · 删掉了一行重复的分隔线(原来"按类型过滤"后面连着两条)。 -->

            <!-- ============ 跳过赞助片段(置顶) ============ -->
            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="跳过赞助片段" />

            <!-- 数据来自 B 站社区众筹标注(SponsorBlock)。默认关: 开启后每条视频的 BV 号
                 都会发到第三方服务器, 必须由用户自己选 —— 隐私告知就写在同一张卡里。 -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动跳过赞助片段" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="播到被社区标注的片段时自动跳到片段末尾, 右上角可随时撤回"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding SponsorBlockEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 类别多选。总开关关掉时整块置灰(可见但不可点) -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}" IsEnabled="{Binding SponsorBlockEnabled}">
                        <TextBlock Text="跳过的类别" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="数据来自网友标注的众筹数据库, 没人标注过的视频不会被跳过"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <ItemsControl ItemsSource="{Binding SponsorCategoryOptions}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" Style="{StaticResource LabeledCheckBoxStyle}"
                                              Margin="0,0,18,8" Cursor="Hand"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SponsorBlockSummary}"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,2,0,0" />
                    </StackPanel>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="开启后, 每条播放的视频会把它的 BV 号与分 P 编号发送到第三方标注服务 (bsbsb.top) 用于查询片段; 该请求不含你的账号或登录信息。"
                                   Style="{StaticResource SettingsRowDescStyle}"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="片段由网友标注, 可能标错; 跳过时会提示, 可以随时点「撤回」回到片段开头。"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,4,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 播放 ============ -->
            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="播放" />

            <!-- 默认画质(2026-10-04 新增): 开始播放**之前**先选定本次要用的清晰度,
                 之后每条视频都用它起播; 该档不存在/没有权限时自动降到可用的下一档
                 (降级规则见 ApiClient.GetPlayUrlAsync 的选流分支)。
                 默认档是 1080P —— 与播放器改动前写死的 qn=80 一致, 老用户升级后画质不变。

                 ★ 2026-11-05 排版重整: 原来这十几行同权重地堆在一张卡里, 用户分不清
                   哪几行是一回事。现在按"画质 / 缓冲 / 网络线路"分三组, 组间用小标题
                   (SettingsGroupHeaderStyle)隔开。 -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- ★ 组一: 画质 -->
                    <TextBlock Text="画质" Style="{StaticResource SettingsGroupHeaderStyle}"
                               Margin="0,10,0,0" />

                    <!-- 播放器窗口大小/位置记忆(2026-11-03 新增大小, 2026-11-07 增加位置)。
                         关闭后播放器每次都回到 XAML 的默认 1280×760 并居中, 也不再写盘。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="记住播放器窗口大小和位置" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding RememberPlayerWindowSizeHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding RememberPlayerWindowSize, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="默认画质" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding QualityHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding QualityOptions}"
                                  SelectedItem="{Binding QualitySelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 免登录 1080P: 未登录时给取流请求补 try_look + dm_img_* 四件套,
                         把匿名可见清晰度从 360P/480P 提到 720P/1080P(依据见 ApiClient.ApplyTryLook)。
                         这是设备指纹启发式放权, B 站改判据就会失效, 所以给用户一个关掉的入口。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="免登录 1080P" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding NoLogin1080PHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding NoLogin1080P, Mode=TwoWay}" />
                    </Grid>

                    <!-- ★ 组二: 音质(2026-11-06) -->
                    <TextBlock Text="音质" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- 音质档位: 与播放器控制栏那枚音质按钮读写同一个配置。
                         ★ 只影响音轨, 不改画面清晰度。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="音质档位" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AudioTierHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding AudioTierOptions}"
                                  SelectedItem="{Binding AudioTierSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 高音质音轨优先: 有 Hi-Res 无损 / 杜比音轨时优先使用。
                         ★ 只影响音频选轨, 不改画面清晰度; 普通视频仍回落到 192K AAC。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="优先高音质音轨" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding PreferHighQualityAudioHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding PreferHighQualityAudio, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- ★ 组三: 播放进度(2026-11-06) -->
                    <TextBlock Text="播放进度" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- 自动续播: 打开视频时跳到此前的本机 / B 站云端进度。
                         ★ 关闭后仍然记录, 只是不自动跳转。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动续播" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AutoResumeHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AutoResume, Mode=TwoWay}" />
                    </Grid>

                    <!-- ★ 组四: 播放页(2026-11-14)
                         相关视频是信息栏里的补充内容, 不属于画质/缓冲/网络任何一组;
                         单独成组, 用户找"播放器里显示什么"时不用在播放进度里翻。 -->
                    <TextBlock Text="播放页" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- 显示相关视频: 关闭后播放器不再请求相关视频接口, 信息栏也不显示该区块。
                         ★ 已打开的播放器会立即生效(见 SettingsStore.RelatedVideosChanged)。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="显示相关视频" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding ShowRelatedVideosHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowRelatedVideos, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- ★ 组五: 缓冲 -->
                    <TextBlock Text="缓冲" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- 缓冲策略(2026-11-01 新增): 自动按带宽/码率挑预读深度, 还是手动固定值。
                         ★ 默认自动: 依据见 Services/BufferPolicy.cs —— 缓冲值对起播几乎无影响,
                           真正影响的是播放中的抗抖动余量, 而"该留多少"取决于网络状况。
                         ★ 手动档恒用下面的「网络缓冲」固定值(与 2026-10-30 之前的旧行为一致)。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="缓冲策略" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding BufferPolicyHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding BufferPolicyOptions}"
                                  SelectedItem="{Binding BufferPolicySelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 网络缓冲(2026-10-30 新增): LibVLC 流式播放的预读深度。
                         越小越省内存, 越大越抗网络抖动; 只对网络流生效(本地文件/合流缓存不受影响)。
                         ★ 实测(探针 bd-probe-startcfix)起播阶段 300/3000ms 几乎无差别 ——
                           所以文案只说"抗抖动", 不宣传"调小就秒开"。
                         ★ 走**媒体级**选项(:network-caching=), 改完下一条视频生效, 不需要重建播放器内核。
                         ★ 2026-11-01: 只在"手动"缓冲策略下生效(自动档由 BufferPolicy 挑值), 自动档置灰。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}" IsEnabled="{Binding CanPickNetworkCaching}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="网络缓冲" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding NetworkCachingHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding NetworkCachingOptions}"
                                  SelectedItem="{Binding NetworkCachingSelected, Mode=TwoWay}" />
                    </Grid>

                    <!-- ★ 组三: 网络线路 -->
                    <TextBlock Text="网络线路" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- CDN 线路: 跟随服务端(默认) / 自动测速挑最快 / 手动指定一家。
                         自动测速虽能挑到瞬时最快, 但换 host 后部分线路持续吞吐/抖动更差,
                         用户反馈卡顿反而更多; 所以 2026-11-05 起默认跟随服务端。
                         逻辑与实测依据见 Services/CdnService.cs。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="线路选择" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="B 站为同一视频提供多家 CDN; 跟随服务端使用接口返回的线路, 自动测速会实测吞吐挑最快的一条"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  ItemsSource="{Binding CdnModeOptions}"
                                  SelectedItem="{Binding CdnModeSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 手动指定: 只在「手动指定」模式下可点(置灰而非隐藏) -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="指定 CDN" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="仅在「手动指定」时生效; 该线路不可用时会自动改用最快线路"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <ComboBox Grid.Column="1" Style="{StaticResource SettingsComboStyle}"
                                  Width="170" VerticalAlignment="Center"
                                  IsEnabled="{Binding CanPickCdn}"
                                  ItemsSource="{Binding CdnHostOptions}"
                                  SelectedItem="{Binding CdnHostSelected, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 屏蔽 PCDN: 默认开。PCDN 拿其他用户带宽做节点, 速度不稳定 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="屏蔽 PCDN" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="不参与点对点分发(会占用他人带宽且速度不稳定); 实测常规 CDN 吞吐更高"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding BlockPcdn, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 重新测速: 换网络后排名会变, 而自动测速有 10 分钟缓存 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="重新测速" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CdnSpeedReport}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="{Binding CdnTestStatus}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Visibility="{Binding CdnTestStatus, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="开始测速" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding TestCdnCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="弹幕" />

            <!-- ★ 2026-11-05 排版重整: 原来「显示弹幕」「智能屏蔽」两个开关被隔在
                 卡片两端(中间夹着滑杆与芯片), 用户找不到。改成两个小分组:
                 "显示与过滤"(开关 + 滑杆 + 类型胶囊)与"外观"(不透明度/字号/速度)。 -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!-- ★ 组一: 显示与过滤 -->
                    <TextBlock Text="显示与过滤" Style="{StaticResource SettingsGroupHeaderStyle}"
                               Margin="0,10,0,0" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="显示弹幕" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="关闭后播放器不再渲染任何弹幕"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DanmakuEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 智能屏蔽: 与「显示弹幕」同为开关, 紧挨着放(原来隔了好几行,
                         几乎没人发现它)。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="智能屏蔽" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="过滤超长弹幕与刷屏弹幕, 减少加载量与卡顿"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding DanmakuSmartFilter, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="弹幕显示区域" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding DanmakuAreaText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                Width="240" VerticalAlignment="Center"
                                Minimum="25" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding DanmakuAreaPercent, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 按类型过滤(2026-10-05 新增): 四个并列可叠加的胶囊, 关掉哪一类就把它从画面去掉。
                         ★ 为什么不做成"每组单选": 这四个是**并列的过滤维度**而不是互斥的类别 ——
                           一条弹幕可能同时是"滚动 + 彩色", 用户要能同时关掉/保留任意组合。
                         ★ 四个开关全开 = 不过滤(默认), 播放器那边有对应的短路, 不白跑一遍过滤。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="按类型过滤" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="{Binding DanmakuTypeFilterHint}"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <WrapPanel Margin="0,12,0,0">
                            <ToggleButton Style="{StaticResource SettingsFilterChipStyle}" Content="滚动"
                                          IsChecked="{Binding DanmakuFilterScroll, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SettingsFilterChipStyle}" Content="固定"
                                          Margin="8,0,0,0"
                                          IsChecked="{Binding DanmakuFilterFixed, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SettingsFilterChipStyle}" Content="彩色"
                                          Margin="8,0,0,0"
                                          IsChecked="{Binding DanmakuFilterColorful, Mode=TwoWay}" />
                            <ToggleButton Style="{StaticResource SettingsFilterChipStyle}" Content="高级"
                                          Margin="8,0,0,0"
                                          ToolTip="高级弹幕是会用图形/动画自己绘制的一类(mode 7/8/9), 与普通文字弹幕不同源"
                                          IsChecked="{Binding DanmakuFilterAdvanced, Mode=TwoWay}" />
                        </WrapPanel>
                    </StackPanel>

                    <!-- ★ 组二: 外观 -->
                    <TextBlock Text="外观" Style="{StaticResource SettingsGroupHeaderStyle}" />

                    <!-- ===== 外观三项(2026-10-12 新增): 不透明度 / 字号 / 速度 =====
                         ★ 为什么单独一块而不是塞进「显示弹幕」那一行:
                           三项都是**滑杆+数值**, 与上面那行"标题+开关"的形状不同,
                           挤在一起会让开关那一行被拉得很高。
                         ★ 每一项的滑杆都绑定到**同一个** SettingsViewModel 属性,
                           播放器与设置页因此始终是同一份数据(不存在两边各存一份)。 -->
                    <StackPanel Style="{StaticResource SettingsRowStyle}">
                        <TextBlock Text="弹幕外观" Style="{StaticResource SettingsRowTitleStyle}" />
                        <TextBlock Text="即时生效, 播放中的弹幕会立刻跟着变"
                                   Style="{StaticResource SettingsRowDescStyle}" />

                        <!-- ===== 胶囊底衬(2026-11-05 新增) =====
                             ★ 为什么放在「外观」组的最上面: 它是**呈现方式**的总开关
                               (有底衬 / 纯文字), 而下面三条是这个呈现方式下的细调
                               (不透明度/字号/速度) —— 顺序上"先选样式再调细节"更顺。
                             ★ 为什么是开关而不是滑杆: 只有开/关两态, 滑杆停在哪都说不清;
                               而且"要不要底衬"是二元的, 用开关一眼能看出当前状态。
                             ★ 历史: 2026-10-07 用户要求去掉弹幕的长方形底衬, 那时是**直接删掉**;
                               现在改成可选项 —— 纯白字压在明亮画面上会看不清, 底衬正是为了
                               解决这个, 但清爽也要留着, 所以让用户自己选(默认开)。 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                                <TextBlock Text="胶囊底衬" Style="{StaticResource SettingsRowTitleStyle}" />
                                <TextBlock Text="半透明圆角底衬, 压在亮画面上也能看清; 关掉恢复纯文字"
                                           Style="{StaticResource SettingsRowDescStyle}" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding DanmakuPillBackground, Mode=TwoWay}" />
                        </Grid>

                        <!-- 不透明度 -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="不透明度" FontSize="12.5" Width="66"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                    Margin="10,0,10,0" VerticalAlignment="Center"
                                    Minimum="20" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DanmakuOpacityPercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding DanmakuOpacityText}" FontSize="12.5"
                                       MinWidth="42" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <!-- 字号 -->
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="弹幕字号" FontSize="12.5" Width="66"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Slider Grid.Column="1" Style="{StaticResource SettingsSliderStyle}"
                                    Margin="10,0,10,0" VerticalAlignment="Center"
                                    Minimum="50" Maximum="300" TickFrequency="25"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding DanmakuFontScalePercent, Mode=TwoWay}" />
                            <TextBlock Grid.Column="2" Text="{Binding DanmakuFontScaleText}" FontSize="12.5"
                                       MinWidth="66" TextAlignment="Right" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>

                        <!-- 速度: 用五个档位而不是滑杆, 与 B 站客户端的观感一致(见 DanmakuMotion 的说明) -->
                        <StackPanel Margin="0,12,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="弹幕速度" FontSize="12.5"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding DanmakuSpeedText}" FontSize="12.5"
                                           Margin="12,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel>
                            <WrapPanel Margin="0,8,0,0">
                                <!-- ★ 五个档位手写成 5 个 RadioButton, 不走 ItemsControl:
                                       档位是**固定的五档**, 不是运行时数据 —— 套 ItemsControl
                                       反而要额外写一个"文案→档位"的转换器(而 WPF 里
                                       RadioButtonGroup 的选中项与 int 之间并没有现成转换,
                                       那种写法看起来省事, 实际是最容易静默失灵的一种。
                                       5 个按钮写死在这里, 选中逻辑一眼可读。 -->
                                <RadioButton Style="{StaticResource SettingsSpeedChipStyle}" GroupName="DanmakuSpeed"
                                             Content="慢" Cursor="Hand"
                                             IsChecked="{Binding DanmakuSpeedIs0, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SettingsSpeedChipStyle}" GroupName="DanmakuSpeed"
                                             Content="较慢" Cursor="Hand" Margin="8,0,0,0"
                                             IsChecked="{Binding DanmakuSpeedIs1, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SettingsSpeedChipStyle}" GroupName="DanmakuSpeed"
                                             Content="适中" Cursor="Hand" Margin="8,0,0,0"
                                             IsChecked="{Binding DanmakuSpeedIs2, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SettingsSpeedChipStyle}" GroupName="DanmakuSpeed"
                                             Content="较快" Cursor="Hand" Margin="8,0,0,0"
                                             IsChecked="{Binding DanmakuSpeedIs3, Mode=TwoWay}" />
                                <RadioButton Style="{StaticResource SettingsSpeedChipStyle}" GroupName="DanmakuSpeed"
                                             Content="极快" Cursor="Hand" Margin="8,0,0,0"
                                             IsChecked="{Binding DanmakuSpeedIs4, Mode=TwoWay}" />
                            </WrapPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 数据管理 ==================== -->
    <DataTemplate x:Key="DataTabTemplate">
        <StackPanel>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="账户" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid Style="{StaticResource SettingsRowStyle}">
                    <!-- 已登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AvatarBox" Width="46" Height="46" CornerRadius="23"
                                Background="{DynamicResource AccentSoftFillBrush}">
                            <TextBlock x:Name="AvatarFallback" Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Lv." /><Run Text="{Binding UserLevel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding UserCoins, Mode=OneWay}" /><Run Text=" 硬币" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="退出登录" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" Command="{Binding LogoutCommand}" />
                    </Grid>
                    <!-- 未登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding LoginCommand}" />
                            <TextBlock Text="登录后可观看高清视频、同步账号信息"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="缓存" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <!--
                        下载/缓存位置(2026-10-11 语义调整)。
                        位置放在这组卡片的**最上面**。
                        ★ 管的是**下载的视频**(以及"图片另存为")—— 用户理解的"缓存"就是
                          "下载下来的视频存在哪", 离线缓存页那行"缓存位置"也是同一个目录。
                        ★ 内部缓存(封面 imgcache / 短视频 vcache)不再暴露, 固定在 %LocalAppData%,
                          用户看不见也无需管理; 下面两行"清理缓存"清的就是那部分。
                        ★ 改位置**只影响以后下载**的视频, 不搬走已下载的成品文件。
                    -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="缓存位置" Style="{StaticResource SettingsRowTitleStyle}" />
                            <!-- 实际生效的路径(可能很长, 允许换行显示, 不省略成 "..." —— 
                                 用户要的就是"到底存在哪"这一个信息) -->
                            <TextBlock Text="{Binding CacheLocation}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       TextWrapping="Wrap" />
                            <TextBlock Text="{Binding CacheLocationHint}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="打开" Style="{StaticResource SubtleButtonStyle}"
                                    Padding="12,5"
                                    Command="{Binding OpenCacheLocationCommand}"
                                    ToolTip="在资源管理器里打开下载目录" />
                            <Button Content="更改" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Padding="12,5"
                                    Command="{Binding ChangeCacheLocationCommand}"
                                    ToolTip="选择新的下载位置(已下载的视频不会被搬走)" />
                            <Button Content="恢复默认" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="8,0,0,0" Padding="12,5"
                                    Command="{Binding ResetCacheLocationCommand}"
                                    ToolTip="回到系统「下载」文件夹" />
                        </StackPanel>
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- "观看历史(本机)"已随本机历史移除(历史统一走云端), 不再列。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="封面图片缓存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding CacheSizeText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="{Binding CoverCacheHint}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <Border Style="{StaticResource SettingsRowDivider}" />

                    <!-- 短视频下载缓存: 极短片(≤60s / ≤8MB)的 1080P 音视频本地合流产物,
                         和上面的封面缓存是两回事。超过这个体积的一律远端直接起播, 不落盘。 -->
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="短视频下载缓存" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding VideoCacheSizeText}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                            <TextBlock Text="{Binding VideoCacheHint}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding ClearVideoCacheCommand}"
                                ToolTip="删除已下载的短视频(下次播放会重新下载)" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ==================== 关于 ==================== -->
    <DataTemplate x:Key="AboutTabTemplate">
        <StackPanel>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="软件" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,14">
                        <Border Width="34" Height="34" CornerRadius="9">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/app.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BiliDesk" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Margin="0,0,0,14">
                        <TextBlock Text="一款哔哩哔哩第三方桌面客户端。"
                                   Style="{StaticResource SettingsRowDescStyle}" />
                        <TextBlock Text="本应用为非官方软件, 视频内容与版权归哔哩哔哩所有。"
                                   Style="{StaticResource SettingsRowDescStyle}" Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="更新" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding AutoCheckUpdateHint}"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" Style="{StaticResource SettingsToggleStyle}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="检查更新" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Style="{StaticResource SettingsRowDescStyle}"
                                       Visibility="{Binding UpdateStatusText, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查更新" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center"
                                Command="{Binding CheckUpdateCommand}" />
                    </Grid>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本号" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="当前使用中的程序版本"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionNumber}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>

            <ContentControl ContentTemplate="{StaticResource SectionHeaderTemplate}"
                            Content="作者" />

            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Button Style="{StaticResource AuthorCardButtonStyle}"
                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                            Margin="0,8"
                            Command="{Binding OpenAuthorCommand}" ToolTip="在应用内打开作者的主页">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentSoftFillBrush}">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="作者" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="ABing" FontWeight="SemiBold" FontSize="14"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="BiliDesk 作者 / 点击进入我的 B 站主页"
                                           Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                    </Button>
                    <Border Style="{StaticResource SettingsRowDivider}" />
                    <Grid Style="{StaticResource SettingsRowStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="非官方声明与免责声明" Style="{StaticResource SettingsRowTitleStyle}" />
                            <TextBlock Text="首次启动时已确认, 可随时在这里重新查看全文"
                                       Style="{StaticResource SettingsRowDescStyle}" />
                        </StackPanel>
                        <Button Content="查看声明" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" HorizontalAlignment="Right"
                                Command="{Binding ShowDisclaimerCommand}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
