<UserControl x:Class="BiliDesk.Views.Pages.RegionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        分区页(2026-09-26): 点左上角 logo 的分区面板里的一项, 就切到这里。
        结构与首页一致 —— 大标题 + 卡片操作 + VideoCard 卡片墙。

        ★★★ 2026-10-17 数据源重做(用户报"分区视频数据有问题"):
            走 ApiClient.GetRegionFeedAsync —— region/feed/rcmd + **v2 tid**(美食=1020),
            也就是 B站网页版分区页(/c/food/)真正的数据源。选型与实测见那个方法的注释。
            旧实现走的是 ranking/v2 + 旧 tid, 实测返回约 564 天前的陈旧榜单。
        ★ 现在**支持翻页**(旧实现做不到): 滚到接近底部自动补下一页, 见 code-behind 的
          OnListScrollChanged。标题右侧的刷新按钮 = 回到游标 1 重拉第一页。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行: 分区名 + 一句说明 + 刷新(和首页"首页 + 问候语"同一个位置关系) -->
        <Grid Margin="36,20,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding RegionName}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="本区精选" Margin="14,0,0,6" VerticalAlignment="Bottom"
                           Style="{StaticResource MetaTextStyle}" />
            </StackPanel>
            <!-- ★ 刷新按钮: 回到游标 1 重拉第一页(列表会被整体换成服务端此刻的快照)。
                 翻页是滚动自动触发的, 所以这里只有"刷新"没有"加载更多"按钮(与首页一致)。 -->
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Bottom" Margin="0,0,0,2"
                    Command="{Binding RefreshCommand}" ToolTip="刷新本分区">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="36,14,36,0">
            <!-- 加载中 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="20" Height="20" />
                <TextBlock Text="正在加载…" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MetaTextStyle}" />
            </StackPanel>

            <!-- 失败(首屏): 一行说明 + 重试 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFirstError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource MetaTextStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           TextAlignment="Center" />
                <Button Content="重试" Style="{StaticResource SubtleButtonStyle}" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}" />
            </StackPanel>

            <!-- 卡片墙: 容器由 DeferredFill 分帧挂载(和首页同一套, 否则一次布局生成几十张卡会卡) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnListScrollChanged"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <ItemsControl x:Name="CardList" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部: 补页转圈 / 补页失败提示。
                         ★ 外层 StackPanel **不留 Margin**: 里面两个都折叠时它自身高度为 0,
                           不给列表尾巴上挂一段空白(留了 Margin 的话滚到底永远多出 42px 空气)。 -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,24"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="16" Height="16" />
                            <TextBlock Text="正在加载更多…" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>

                        <!-- 补页失败: 只在列表底部说一句, **不**盖到已有卡片上(见 ShowMoreError 的说明)。
                             ★ 重试按钮走 RetryMoreCommand(重拉**同一页**)而不是 RefreshCommand ——
                               后者会把列表清空从头再来, 用户已经翻到的位置就没了。 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,24"
                                    Visibility="{Binding ShowMoreError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Error}" VerticalAlignment="Center"
                                       Style="{StaticResource MetaTextStyle}" />
                            <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="12,0,0,0" Padding="10,3"
                                    Command="{Binding RetryMoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
