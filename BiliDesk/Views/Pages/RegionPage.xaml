<UserControl x:Class="BiliDesk.Views.Pages.RegionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        分区页(2026-09-26): 点左上角 logo 的分区面板里的一项, 就切到这里。
        结构与首页一致 —— 大标题 + 卡片操作 + VideoCard 卡片墙。

        ★★★ 2026-10-17 数据源重做(用户报"分区视频数据有问题"):
            走 ApiClient.GetRegionFeedAsync —— region/feed/rcmd + **v2 tid**(美食=1020),
            也就是 B站网页版分区页(/c/food/)真正的数据源。选型与实测见那个方法的注释。
            旧实现走的是 ranking/v2 + 旧 tid, 实测返回约 564 天前的陈旧榜单。
        ★ 现在**支持翻页**(旧实现做不到): 滚到接近底部自动补下一页, 见 code-behind 的
          OnListScrollChanged。标题右侧的刷新按钮 = 回到游标 1 重拉第一页。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行: 分区名 + 一句说明。
             ★★ 2026-10-17 刷新按钮**从这一行挪走**(用户报"分区列表右上角刷新与其他按钮重合"):
                这一行的右端正好落在右上角那三个窗口按钮(最小化/最大化/关闭)的位置上 ——
                那三个是浮层(Panel.ZIndex=20, 见 MainWindow), 刷新键被它们压住, 点不准也看不清。
                现在刷新与「回到顶部」一起放进右下角浮动工具列, 与首页同一套(见本文件底部那段)。 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="36,20,36,0">
            <TextBlock Text="{Binding RegionName}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="本区精选" Margin="14,0,0,6" VerticalAlignment="Bottom"
                       Style="{StaticResource MetaTextStyle}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="36,14,36,0">
            <!-- 加载中 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="20" Height="20" />
                <TextBlock Text="正在加载…" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MetaTextStyle}" />
            </StackPanel>

            <!-- 失败(首屏): 一行说明 + 重试 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFirstError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource MetaTextStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           TextAlignment="Center" />
                <Button Content="重试" Style="{StaticResource SubtleButtonStyle}" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}" />
            </StackPanel>

            <!-- 卡片墙: 容器由 DeferredFill 分帧挂载(和首页同一套, 否则一次布局生成几十张卡会卡) -->
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="OnListScrollChanged"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <!-- ★ 底部留白给右下角浮动工具列让位(与首页同款做法, 见 HomePage 的 250)。
                     这里是 2 个 38px 按钮 + 6px 间距 + 20px 下边距 ≈ 102, 取 110 留点余量。
                     必须留在**滚动内容之外**(挂在容器 margin 上而不是卡片上),
                     这样滚到底时最后一行能整行滚到浮动按钮上方, 不被压住。 -->
                <StackPanel Margin="0,0,0,110">
                    <ItemsControl x:Name="CardList" Margin="0,4,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部: 补页转圈 / 补页失败提示。
                         ★ 外层 StackPanel **不留 Margin**: 里面两个都折叠时它自身高度为 0,
                           不给列表尾巴上挂一段空白(留了 Margin 的话滚到底永远多出 42px 空气)。 -->
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,24"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="16" Height="16" />
                            <TextBlock Text="正在加载更多…" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>

                        <!-- 补页失败: 只在列表底部说一句, **不**盖到已有卡片上(见 ShowMoreError 的说明)。
                             ★ 重试按钮走 RetryMoreCommand(重拉**同一页**)而不是 RefreshCommand ——
                               后者会把列表清空从头再来, 用户已经翻到的位置就没了。 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,24"
                                    Visibility="{Binding ShowMoreError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Error}" VerticalAlignment="Center"
                                       Style="{StaticResource MetaTextStyle}" />
                            <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="12,0,0,0" Padding="10,3"
                                    Command="{Binding RetryMoreCommand}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 右下角浮动工具列(回到顶部 + 刷新) =====
             ★★ 2026-10-17 新增(用户要求"改成和首页一致的右下方工具列【包含刷新和回到顶部】")。
                原来「刷新」放在标题行右端, 与右上角的窗口按钮(最小化/最大化/关闭)重叠 —— 见本文件顶部说明。

             ★ 用与首页**同一份** `FloatingIconButtonStyle`: 常态/悬停/按下三种底色都不透明 ——
               工具列浮在卡片封面上, 默认 IconButtonStyle 那 4% 黑等于没有底, 图标会糊进封面图案。
             ★ 它是浮层(Panel.ZIndex 浮在内容之上), **不占独立列** —— 占列的话滚动条会被挤到
               按钮左边, 看着像没贴到窗口右缘。右边留 16px 正好避让开滚动条。
             ★ 「回到顶部」始终占位、只切透明度与命中测试(不用 Visibility): 它在这一列的最上面,
               用 Collapsed 的话下面那个按钮每滚过一次阈值就会上下跳一下(首页同款坑)。 -->
        <StackPanel x:Name="ToolBar" Grid.Row="1" Panel.ZIndex="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 回到顶部: 下滑之后才亮起来(见 code-behind 的 UpdateBackToTop)。E70E = ChevronUp -->
            <Button x:Name="BtnTop" Style="{StaticResource FloatingIconButtonStyle}"
                    Opacity="0" IsHitTestVisible="False"
                    Click="OnBackToTopClick" ToolTip="回到顶部">
                <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>

            <!-- 刷新: 回到游标 1 重拉第一页(列表会被整体换成服务端此刻的快照)。
                 ★ 走 code-behind 的 OnRefreshClick 而不是直接绑 RefreshCommand —— 刷完要把列表
                   滚回顶部(那 500 条内容是从头换的), 那是"视图"的事, VM 不该管(与首页同款写法)。
                 翻页是滚动自动触发的, 所以这里只有"刷新"没有"加载更多"按钮。 -->
            <Button x:Name="BtnRefresh" Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Click="OnRefreshClick" ToolTip="刷新本分区">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
