<UserControl x:Class="BiliDesk.Views.Pages.RegionPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        分区页(2026-09-26): 点左上角 logo 的分区面板里的一项, 就切到这里。
        结构与首页一致 —— 大标题 + 卡片操作 + VideoCard 卡片墙。

        ★★ 2026-10-13 数据源定为"热门"(用户报"分区内容现在全是垃圾视频"):
           走 ApiClient.GetRegionFeedAsync —— ranking/v2 分区榜为主(质量好),
           被它拒掉的 rid(资讯 202)才回退 newlist。选型过程见那个方法的注释。
        ★ 没有"加载更多": 两个接口的 pn 都被服务端忽略(实测返回完全相同条目),
          一次 50~95 条就是全部。刷新靠标题行右上角那颗按钮 = 重新请求一次。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行: 分区名 + 一句说明 + 刷新(和首页"首页 + 问候语"同一个位置关系) -->
        <Grid Margin="36,20,36,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="{Binding RegionName}" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="热门 · 最新" Margin="14,0,0,6" VerticalAlignment="Bottom"
                           Style="{StaticResource MetaTextStyle}" />
            </StackPanel>
            <!-- ★ 刷新按钮(2026-10-13 用户要求"内容可以刷新"):
                 分区接口**不支持翻页**(实测 pn=1/2/3 返回完全相同的条目), 所以没有"加载更多",
                 刷新 = 重新请求一次, 拿到服务端此刻的快照。 -->
            <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                    VerticalAlignment="Bottom" Margin="0,0,0,2"
                    Command="{Binding RefreshCommand}" ToolTip="刷新本分区">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </Grid>

        <Grid Grid.Row="1" Margin="36,14,36,0">
            <!-- 加载中 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="20" Height="20" />
                <TextBlock Text="正在加载…" Margin="8,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource MetaTextStyle}" />
            </StackPanel>

            <!-- 失败 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding Error}" Style="{StaticResource MetaTextStyle}"
                           HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                           TextAlignment="Center" />
                <Button Content="重试" Style="{StaticResource SubtleButtonStyle}" Margin="0,12,0,0"
                        HorizontalAlignment="Center" Command="{Binding RetryCommand}" />
            </StackPanel>

            <!-- 卡片墙: 容器由 DeferredFill 分帧挂载(和首页同一套, 否则 90 张卡片一次布局会卡) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasItems, Converter={StaticResource BoolToVis}}">
                <ItemsControl x:Name="CardList" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <controls:VideoCard />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
