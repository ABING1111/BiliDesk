<UserControl x:Class="BiliDesk.Views.Pages.UserSpacePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ======== 顶部 UP 主信息区 ======== -->
        <Border Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="36,22,36,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- 头像(带等级徽章)。右键可看大图 / 保存头像 -->
                <Grid Grid.Column="0">
                    <Grid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="查看头像大图" Click="OnViewAvatar">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="下载头像到本地" Click="OnDownloadAvatar">
                                <MenuItem.Icon>
                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Grid.ContextMenu>
                    <Border Width="76" Height="76" CornerRadius="38"
                            Background="{DynamicResource AccentSoftFillBrush}"
                            helpers:Cover.Source="{Binding Face}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="32" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <!-- 等级徽章 -->
                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            Background="#FF9C0A" CornerRadius="8" Padding="6,1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Level}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Level, StringFormat=LV{0}, Mode=OneWay}"
                                   FontSize="10" FontWeight="Bold" Foreground="White" />
                    </Border>
                </Grid>

                <!-- 名称 / 签名 / 数据 -->
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontSize="19" FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                        <TextBlock Style="{StaticResource MetaTextStyle}" Margin="12,2,0,0"
                                   VerticalAlignment="Center">
                            <Run Text="mid: " /><Run Text="{Binding Mid, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Text="{Binding Sign}" Style="{StaticResource MetaTextStyle}"
                               Margin="0,6,0,0" MaxWidth="560" TextTrimming="CharacterEllipsis" />
                    <!-- 数据行 -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FollowerText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text=" 粉丝" Style="{StaticResource MetaTextStyle}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,1" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                            <TextBlock Text="{Binding FollowingText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text=" 关注" Style="{StaticResource MetaTextStyle}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,1" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="22,0,0,0">
                            <TextBlock Text="{Binding VideoCountText}" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text=" 投稿" Style="{StaticResource MetaTextStyle}"
                                       VerticalAlignment="Bottom" Margin="2,0,0,1" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 关注按钮 -->
                <Button Grid.Column="2" Style="{StaticResource AccentButtonStyle}"
                        Command="{Binding FollowCommand}" Padding="22,8"
                        VerticalAlignment="Center" ToolTip="关注该 UP 主">
                    <TextBlock Text="+ 关注" FontSize="12" />
                </Button>
            </Grid>
        </Border>

        <!-- ======== 视频列表区 ======== -->
        <Grid Grid.Row="1">
            <!-- 首次加载的居中大菊花(仅无内容时显示, 避免与错误提示同屏) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 错误提示(重试) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="30" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Error}" Margin="0,10,0,0" HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          ScrollChanged="Scroll_OnScrollChanged">
                <StackPanel Margin="36,16,36,24">
                    <!-- 视频网格 -->
                    <ItemsControl ItemsSource="{Binding Videos}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部状态 -->
                    <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" />
                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                   Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
