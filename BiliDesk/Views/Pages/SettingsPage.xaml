<UserControl x:Class="BiliDesk.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource AppBackgroundBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,20,36,32" MaxWidth="660" HorizontalAlignment="Left">
            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />

            <!-- ============ 外观 ============ -->
            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="颜色模式" Style="{StaticResource MetaTextStyle}" />
                    <Border HorizontalAlignment="Left" Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="9" Padding="3" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="ThemeGroup" Style="{StaticResource SegmentRadioStyle}"
                                         Content="跟随系统"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=System, Mode=TwoWay}" />
                            <RadioButton GroupName="ThemeGroup" Style="{StaticResource SegmentRadioStyle}"
                                         Content="浅色"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=Light, Mode=TwoWay}" />
                            <RadioButton GroupName="ThemeGroup" Style="{StaticResource SegmentRadioStyle}"
                                         Content="深色"
                                         IsChecked="{Binding ThemeMode, Converter={StaticResource EnumEquals}, ConverterParameter=Dark, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="选择「跟随系统」时, 应用会随 Windows 自动切换深浅色"
                               Style="{StaticResource MetaTextStyle}" Margin="0,12,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ============ 账户 ============ -->
            <TextBlock Text="账户" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <Grid>
                    <!-- 已登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="AvatarBox" Width="46" Height="46" CornerRadius="23"
                                Background="{DynamicResource AccentSoftFillBrush}">
                            <TextBlock x:Name="AvatarFallback" Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UserName}" FontSize="15" FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                                <Run Text="Lv." /><Run Text="{Binding UserLevel, Mode=OneWay}" />
                                <Run Text=" · " /><Run Text="{Binding UserCoins, Mode=OneWay}" /><Run Text=" 硬币" />
                            </TextBlock>
                        </StackPanel>
                        <Button Grid.Column="2" Content="退出登录" Style="{StaticResource SubtleButtonStyle}"
                                VerticalAlignment="Center" Command="{Binding LogoutCommand}" />
                    </Grid>
                    <!-- 未登录 -->
                    <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                                    Command="{Binding LoginCommand}" />
                            <TextBlock Text="登录后可观看高清视频、同步账号信息"
                                       Style="{StaticResource MetaTextStyle}"
                                       VerticalAlignment="Center" Margin="14,0,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ============ 推荐 ============ -->
            <!-- 两套算法是**两个不同的服务端模型**, 不是同一个接口换个参数 ——
                 所以这里用"选来源"的措辞, 而不是"调节推荐强度"。 -->
            <TextBlock Text="推荐" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="首页推荐算法" FontSize="13" />
                    <TextBlock Text="「推荐」页的内容来自哪一套推荐模型, 选更合你口味的那一份"
                               Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                    <Border HorizontalAlignment="Left" Background="{DynamicResource InputBackgroundBrush}"
                            CornerRadius="9" Padding="3" Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton GroupName="RecommendGroup" Style="{StaticResource SegmentRadioStyle}"
                                         Content="B 站官方 App"
                                         IsChecked="{Binding RecommendSource, Converter={StaticResource EnumEquals}, ConverterParameter=App, Mode=TwoWay}" />
                            <RadioButton GroupName="RecommendGroup" Style="{StaticResource SegmentRadioStyle}"
                                         Content="浏览器网页版"
                                         IsChecked="{Binding RecommendSource, Converter={StaticResource EnumEquals}, ConverterParameter=Web, Mode=TwoWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding RecommendSourceHint}" Style="{StaticResource MetaTextStyle}"
                               Margin="0,12,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="切换后会立刻重新拉取首页推荐; 未登录时两个来源都只能拿到通用热门流"
                               Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 弹幕 ============ -->
            <TextBlock Text="弹幕" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <!-- 弹幕开关 -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="显示弹幕" FontSize="13" />
                            <TextBlock Text="关闭后播放器不再渲染任何弹幕" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                  IsChecked="{Binding DanmakuEnabled, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <!-- 显示区域 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="240" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="弹幕显示区域" FontSize="13" />
                            <TextBlock Text="{Binding DanmakuAreaText}" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Slider Grid.Column="1" VerticalAlignment="Center"
                                Minimum="25" Maximum="100" IsSnapToTickEnabled="True" TickFrequency="5"
                                Value="{Binding DanmakuAreaPercent, Mode=TwoWay}"
                                IsMoveToPointEnabled="True" Cursor="Hand" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <!-- 智能屏蔽 -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="智能屏蔽" FontSize="13" />
                            <TextBlock Text="过滤超长弹幕与刷屏弹幕, 减少加载量与卡顿" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                  IsChecked="{Binding DanmakuSmartFilter, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <!-- 彩色弹幕 -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="彩色弹幕" FontSize="13" />
                            <TextBlock Text="按发送者选的颜色显示弹幕; 关闭后全部显示为白色" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <CheckBox HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand"
                                  IsChecked="{Binding DanmakuColorful, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <!-- 关键词屏蔽 -->
                    <StackPanel>
                        <TextBlock Text="关键词屏蔽" FontSize="13" />
                        <TextBlock Text="每行一条, 也可用逗号分隔。以 re: 开头按正则匹配, 例如 re:^\d{4}/\d{1,2}/\d{1,2}$ 可屏蔽日期打卡"
                                   Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBox Margin="0,10,0,0" MinHeight="72" MaxHeight="140"
                                 AcceptsReturn="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 VerticalContentAlignment="Top"
                                 Style="{StaticResource FluentTextBoxStyle}"
                                 Text="{Binding DanmakuBlockKeywords, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="{Binding DanmakuRuleCountText}" Style="{StaticResource MetaTextStyle}"
                                   Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ 跳过赞助片段 ============ -->
            <!-- 数据来自 B 站社区的众筹标注(SponsorBlock / 小电视空降助手背后那套服务端)。
                 ★ 默认关: 开启后每条视频的 BV 号都会被发到第三方服务器 —— 这是真实的隐私代价,
                 必须由用户自己选, 所以开关旁边就把这句话写清楚。 -->
            <TextBlock Text="跳过赞助片段" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动跳过赞助片段" FontSize="13" />
                            <TextBlock Text="播到被社区标注的片段时自动跳到片段末尾, 右上角可以随时撤回"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Cursor="Hand" IsChecked="{Binding SponsorBlockEnabled, Mode=TwoWay}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />

                    <!-- 类别多选。总开关关掉时整块置灰(留着可见但不给点, 用户能看到有什么可选) -->
                    <StackPanel IsEnabled="{Binding SponsorBlockEnabled}">
                        <TextBlock Text="跳过的类别" FontSize="13" />
                        <TextBlock Text="数据来自网友标注的众筹数据库, 没人标注过的视频不会被跳过"
                                   Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding SponsorCategoryOptions}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox Content="{Binding Label}" Margin="0,0,18,8" Cursor="Hand"
                                              IsChecked="{Binding IsChecked, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding SponsorBlockSummary}" Style="{StaticResource MetaTextStyle}"
                                   Margin="0,2,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />

                    <!-- 隐私告知: 不是装饰性文案。开启后 BV 号会离开本机, 必须写在开关旁边。 -->
                    <TextBlock Text="开启后, 每条播放的视频会把它的 BV 号与分 P 编号发送到第三方标注服务 (bsbsb.top) 用于查询片段; 该请求不含你的账号或登录信息。"
                               Style="{StaticResource MetaTextStyle}" Margin="0,0,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="片段由网友标注, 可能标错; 跳过时会提示, 可以随时点「撤回」回到片段开头。"
                               Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ============ 启动 ============ -->
            <TextBlock Text="启动" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="启动时打开" FontSize="13" />
                    <TextBlock Text="应用启动后直接进入这个页面"
                               Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                    <!-- 用胶囊而非下拉框: 只有 4 个选项, 一眼看全比下拉一层更省事,
                         而且 ChipTabStyle 是应用里现成的样式, 不用再补一套 ComboBox 外观。
                         2026-09-26 侧栏改版: 历史/收藏不再是启动页选项(入口收进「我的」)。 -->
                    <WrapPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <RadioButton GroupName="StartupGroup" Style="{StaticResource ChipTabStyle}"
                                     Content="首页" Margin="0,0,8,8"
                                     IsChecked="{Binding StartupPage, Converter={StaticResource EnumEquals}, ConverterParameter=Home, Mode=TwoWay}" />
                        <RadioButton GroupName="StartupGroup" Style="{StaticResource ChipTabStyle}"
                                     Content="动态" Margin="0,0,8,8"
                                     IsChecked="{Binding StartupPage, Converter={StaticResource EnumEquals}, ConverterParameter=Follow, Mode=TwoWay}" />
                        <RadioButton GroupName="StartupGroup" Style="{StaticResource ChipTabStyle}"
                                     Content="我的" Margin="0,0,8,8"
                                     IsChecked="{Binding StartupPage, Converter={StaticResource EnumEquals}, ConverterParameter=Mine, Mode=TwoWay}" />
                        <RadioButton GroupName="StartupGroup" Style="{StaticResource ChipTabStyle}"
                                     Content="设置" Margin="0,0,8,8"
                                     IsChecked="{Binding StartupPage, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=TwoWay}" />
                    </WrapPanel>
                    <TextBlock Text="{Binding StartupPageHint}" Style="{StaticResource MetaTextStyle}"
                               Margin="0,2,0,0" Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </Border>

            <!-- ============ 托盘 ============ -->
            <TextBlock Text="托盘" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <!-- 关闭键的行为开关。默认打开(收进托盘), 关掉就是"关掉即退出" -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="关闭时最小化到托盘" FontSize="13" />
                            <TextBlock Text="{Binding CloseToTrayHint}" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Cursor="Hand" IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                    </Grid>
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <!-- 立即收进托盘: 不用真的去点关闭键就能确认这个行为是什么效果 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="立即收进托盘" FontSize="13" />
                            <TextBlock Text="把主界面收进系统托盘, 双击托盘图标可恢复"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="最小化到托盘" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding MinimizeToTrayCommand}" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 数据 ============ -->
            <TextBlock Text="数据" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <!-- "观看历史(本机)"这一项随本机历史一起移除了:
                         历史统一走 B 站账号的云端记录, 本机不再单独存一份。 -->
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="封面图片缓存" FontSize="13" />
                            <TextBlock Text="{Binding CacheSizeText}" Style="{StaticResource MetaTextStyle}"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="清理缓存" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ClearCacheCommand}" />
                    </Grid>

                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />

                    <!-- 短视频下载缓存: 3 分钟以内视频的 1080P 音视频会被下到本地合流成一个 mp4
                         (为了跳转快、结尾完整), 这是它的产物。和上面的封面缓存是两回事。 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="短视频下载缓存" FontSize="13" />
                            <TextBlock Text="{Binding VideoCacheSizeText}"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                            <TextBlock Text="{Binding VideoCacheHint}"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,3,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="清理缓存"
                                Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ClearVideoCacheCommand}"
                                ToolTip="删除已下载的短视频(下次播放会重新下载)" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ 关于 ============ -->
            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" Margin="0,26,0,0" />
            <Border Style="{StaticResource SettingCardStyle}" Margin="0,10,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="9">
                            <Border.Background>
                                <ImageBrush ImageSource="/Assets/app.png" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="BiliDesk" FontSize="14" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RuntimeInfo}" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="一款哔哩哔哩第三方桌面客户端。"
                               Style="{StaticResource MetaTextStyle}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <TextBlock Text="本应用为非官方软件, 视频内容与版权归哔哩哔哩所有。"
                               Style="{StaticResource MetaTextStyle}" Margin="0,6,0,0" />

                    <!-- 分隔线 + 作者栏(点击头像/名字进入作者 B 站主页) -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <Button Style="{StaticResource AuthorCardButtonStyle}"
                            HorizontalContentAlignment="Stretch" Cursor="Hand"
                            Click="OnAuthorClick" ToolTip="在应用内打开作者的主页">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17"
                                    Background="{DynamicResource AccentSoftFillBrush}">
                                <TextBlock Text="A" FontWeight="Bold" FontSize="16"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="作者" Style="{StaticResource MetaTextStyle}"
                                               VerticalAlignment="Center" />
                                    <TextBlock Text="ABing" FontWeight="SemiBold" FontSize="14"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                                <TextBlock Text="BiliDesk 作者 / 点击进入我的 B 站主页"
                                           Style="{StaticResource MetaTextStyle}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="&#xE76C;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="13" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </Grid>
                    </Button>

                    <!-- 免责声明: 首次启动是"同意才继续", 这里是随时可复查的只读入口 -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="非官方声明与免责声明" FontSize="13" />
                            <TextBlock Text="首次启动时已确认, 可随时在这里重新查看全文"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <Button Content="查看声明" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding ShowDisclaimerCommand}" />
                    </Grid>

                    <!-- 自动检查更新: 匿名的 GitHub Releases 请求, 不带账号信息 -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="自动检查更新" FontSize="13" />
                            <TextBlock Text="{Binding AutoCheckUpdateHint}"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                        <CheckBox Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                                  Cursor="Hand" IsChecked="{Binding AutoCheckUpdate, Mode=TwoWay}" />
                    </Grid>

                    <!-- 手动检查更新: 与自动检查共用同一个弹窗; 结果反馈在副标题上 -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                            <TextBlock Text="检查更新" FontSize="13" />
                            <TextBlock Text="{Binding UpdateStatusText}"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0"
                                       TextWrapping="Wrap"
                                       Visibility="{Binding UpdateStatusText, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="检查更新" Style="{StaticResource SubtleButtonStyle}"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Command="{Binding CheckUpdateCommand}" />
                    </Grid>

                    <!-- 版本号单独一栏: 数字来自 App.AppVersion(单一来源), 改版本只动那一处 -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,14" />
                    <Grid>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="版本号" FontSize="13" />
                            <TextBlock Text="当前使用中的程序版本"
                                       Style="{StaticResource MetaTextStyle}" Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding VersionNumber}" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>