<UserControl x:Class="BiliDesk.Views.Pages.WatchLaterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        「稍后再看」页(2026-09-28 新增, 版式对齐收藏页):
        标题/编辑操作条 + 卡片墙。入口在「我的」页的快捷入口(第四个按钮), 不在左侧导航栏上。
        与收藏页的差别: 没有收藏夹 chips, 也没有分页 —— 服务端一次给全(上限 100 条)。

        ★ 2026-11-14 改版(用户要求"右上角的工具列全部改为右下角竖列显示"):
          普通态(刷新 / 编辑 / 返回)与编辑态(全选 / 移出所选 / 清空列表 / 退出)全部搬到
          右下角浮动竖列, 图标 + ToolTip, 与首页/分区页同一套 FloatingIconButtonStyle 观感。
          本页没有类别胶囊, 所以标题仍然固定在顶部(不做吸顶)。
          已选计数与批量进度做成工具列上方的小胶囊, 操作时不用回头看标题。
        ★ 滚动条随之移到窗口最右缘(ScrollViewer 不再留 36 横向边距, 边距改挂在内容上),
          与收藏/历史/首页一致; 卡片可用宽度不变。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 编辑态计数(操作按钮已搬到右下角工具列, 头部不再需要为它们撑到 62) -->
        <Grid Grid.Row="0" Margin="36,20,36,0" MinHeight="40">
            <!-- [ 普通模式 ] -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="稍后再看" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding CountText}" VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>

            <!-- [ 编辑模式 ] -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="编辑稍后再看" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                <TextBlock Text="{Binding BusyText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                           FontSize="12" Foreground="{DynamicResource DangerTextBrush}"
                           Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="正在同步稍后再看…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 错误 / 空状态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="40" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" Margin="0,14,0,0" />
                <Button Content="刷新（F5）" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                        Command="{Binding ReloadCommand}"
                        Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}" />
            </StackPanel>

            <!-- 视频网格: 分页展示(见 WatchLaterViewModel), 滚到接近底部由 OnListScrollChanged 补下一页 -->
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                          ScrollChanged="OnListScrollChanged"
                          Visibility="{Binding Error, Converter={StaticResource InvStrToVis}}">
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- 底部留白给右下角工具列让位: 普通态 3 颗按钮(≈146),
                                 编辑态 4 颗 + 计数胶囊(≈244) —— 滚到底时最后一行卡片要整行露出来。 -->
                            <Setter Property="Margin" Value="36,0,36,164" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Margin" Value="36,0,36,244" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 右键"移出稍后再看"经 ExtraMenuItems 合并进卡片自带的右键菜单;
                                     Selectable 在编辑模式下打开(点击变成勾选而不是播放) -->
                                <controls:VideoCard
                                    Selectable="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    ExtraMenuItems="{Binding DataContext.CardMenuItems, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 右下角浮动工具列(2026-11-14) ============
             ★ 按钮用 FloatingIconButtonStyle: 三种状态的底色都**不透明** —— 默认的
               IconButtonStyle 是 4% 黑, 浮在卡片封面上等于没有底, 图标会糊进图片里。
             ★ 外面不加任何底板/边框, 就是最朴素的"一列按钮"(投影在样式模板的 ShadowBd 层)。
             ★ Panel.ZIndex 浮在内容之上、不占独立列: 占列的话滚动条会被挤到按钮左边。
               右边留 16 正好避让开滚动条(8px 宽 + 6px 缩放带)。
             ★ 「移出所选 / 清空列表」用 DangerTextBrush; 全局隐式 TextBlock 样式带
               Foreground setter, 会吃掉继承色, 所以图标 TextBlock 上要**显式**写前景色。
             ★ ToolTipService.ShowOnDisabled: 批量操作进行中按钮是灰的, 但 ToolTip 仍要能读。 -->
        <StackPanel x:Name="ToolBar" Grid.Row="1" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 已选计数 + 批量进度 -->
            <Border HorizontalAlignment="Right" Margin="0,0,0,8"
                    Background="{DynamicResource FlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10,5"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedText}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding BusyText}" FontSize="11" HorizontalAlignment="Right"
                               Margin="0,2,0,0" Foreground="{DynamicResource DangerTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="180"
                               Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Border>

            <!-- [ 普通模式 ] 刷新 / 编辑 / 返回「我的」 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding ReloadCommand}" ToolTip="刷新（F5）">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="编辑：批量移出">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <!-- 返回「我的」页: 稍后再看的入口在那里, 给一条回去的路 -->
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Click="OnBackToMineClick" ToolTip="返回「我的」">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>

            <!-- [ 编辑模式 ] 全选 / 移出所选 / 清空列表 / 退出编辑 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding SelectAllCommand}" ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <MultiBinding StringFormat="{}{0}（{1}）">
                            <Binding Path="SelectAllText" />
                            <Binding Path="SelectedText" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="移出所选" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ClearAllCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="清空列表：清空整个稍后再看" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE75A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="退出编辑">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>