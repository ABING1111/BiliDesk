<UserControl x:Class="BiliDesk.Views.Pages.FollowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!--
            右栏排版切换的两枚小 chip(动态卡 / 卡片墙)。
            写法与播放页评论区的「热门 / 时间」一致: 常态浅灰底, 选中态由 Tag="on" 触发粉底粉字。
            ★ 选中态**只由 code-behind 写 Tag 驱动** —— 两个按钮的亮/灭在一个地方决定,
              分散着改必然出现"两边都亮"或"两边都不亮"(沿用播放页那条经验)。
            ★ 绑定必须写 RelativeSource Self: ControlTemplate 的触发器里不写解析不到,
              改用 TemplatedParent 也会静默失效(2026-10-03 探针实测)。
        -->
        <Style x:Key="FeedLayoutChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{DynamicResource ControlFillDefaultBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 刷新 -->
        <!--
                    右上角的窗口按钮(最小化/最大化/关闭)浮在内容区之上、占 y=4~36。
                    头部因此撑到 62 高: 标题贴顶(和左侧 logo 同一水平线), 右侧操作按钮
                    贴底 —— 它们的顶边落在 44, 正好让开窗口按钮, 谁也不压谁。
                -->
        <Grid Grid.Row="0" Margin="24,20,24,8" MinHeight="62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="动态" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Count, StringFormat=' · 关注 {0} 位 UP'}"
                           VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                    Command="{Binding RefreshCommand}" ToolTip="刷新" VerticalAlignment="Bottom">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15" />
            </Button>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <!-- 未登录提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding NotLoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="登录后可查看你关注的 UP 主的动态"
                           Margin="0,14,0,14" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="20,8"
                        Command="{Binding LoginCommand}" />
            </StackPanel>

            <!-- 加载中(整页) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFullLoading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 主体: 左 UP 列表 + 右内容 ===== -->
            <Grid Visibility="{Binding ShowFullLoading, Converter={StaticResource InvBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左: 全部动态 + UP 列表 ===== -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="UpListScroll_OnScrollChanged"
                              Margin="12,4,0,20">
                    <StackPanel Margin="8,0,8,0">
                        <!-- 全部动态入口: 选中高亮跟 VM.IsAllSelected 走 -->
                        <!-- 选中/悬停观感与左侧导航栏一致: 悬停灰(NavItemHoverBrush),
                             选中粉底(AccentSoftFillBrush) + 粉字(AccentTextBrush)。 -->
                        <Border CornerRadius="10" Padding="12,10" Margin="0,4,0,6" Cursor="Hand"
                                MouseLeftButtonUp="OnSelectAll">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{DynamicResource AccentSoftFillBrush}">
                                    <Path Data="{DynamicResource DynamicIconGeometry}"
                                          Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="全部动态" FontSize="14" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 关注的 UP(点击 = 只看 TA 的投稿) -->
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,4" Cursor="Hand"
                                            MouseLeftButtonUp="OnSelectUp"
                                            ToolTip="只看 TA 的投稿视频">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 头像。右键可看大图 / 保存。
                                                 ★ 外面套一层同尺寸 Grid 只为一件事: 把未读角标压在头像
                                                   右下角(2026-10-15, 用户要求"有未读最新消息就在头像
                                                   右下角标注")。单靠 Border 自己叠不出来 ——
                                                   它 ClipToBounds=True, 会把越界的子元素裁掉。 -->
                                            <Grid Grid.Column="0" Width="36" Height="36">
                                                <Border Width="36" Height="36" CornerRadius="18"
                                                        Background="{DynamicResource AccentSoftFillBrush}"
                                                        ClipToBounds="True"
                                                        helpers:Cover.Source="{Binding Face}">
                                                    <Border.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="打开 UP 主页" Click="OnVisitClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="13" VerticalAlignment="Center" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="查看头像大图" Click="OnViewAvatar">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="13" VerticalAlignment="Center" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <MenuItem Header="下载头像到本地" Click="OnDownloadAvatar">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="13" VerticalAlignment="Center" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                            <Separator />
                                                            <MenuItem Header="取消关注" Click="OnUnfollowClick">
                                                                <MenuItem.Icon>
                                                                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="13" VerticalAlignment="Center" />
                                                                </MenuItem.Icon>
                                                            </MenuItem>
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <TextBlock Text="&#xE77B;"
                                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                               FontSize="16"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                                <!-- 未读角标: 与消息页会话列表同款(蓝底数字, 贴右下角)。
                                                     计数来源见 FollowViewModel.UpdateUnreadBadges ——
                                                     本地比对出来的"该 UP 有新动态", 不额外请求接口。 -->
                                                <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                        MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                                                        Background="{DynamicResource AccentBrush}"
                                                        Visibility="{Binding HasNew, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="{Binding NewCount}" FontSize="10"
                                                               Foreground="{DynamicResource TextOnAccentBrush}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 左栏补页 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="14" Height="14" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 右: 内容(两档排版, 右上角可切) ===== -->
                <Grid Grid.Column="1" Margin="12,4,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 右栏标题 + 排版切换(用户要求"可以自己切换排版") -->
                    <Grid Grid.Row="0" Margin="8,0,8,10">
                        <TextBlock Text="{Binding SelectionTitle}" FontSize="15"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="BtnLayoutCards" Style="{StaticResource FeedLayoutChipStyle}"
                                    Content="动态卡" Click="OnLayoutCardsClick"
                                    ToolTip="单列动态卡: 头像 + 发布时间 + 视频" />
                            <Button x:Name="BtnLayoutWall" Style="{StaticResource FeedLayoutChipStyle}"
                                    Content="卡片墙" Margin="6,0,0,0" Click="OnLayoutWallClick"
                                    ToolTip="多列卡片墙(一屏铺更多, 但没有头像与发布时间)" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="FeedScroll_OnScrollChanged">
                        <StackPanel>
                            <!-- 出错/为空提示(非阻断, 放在列表上方) -->
                            <Border HorizontalAlignment="Center" MaxWidth="520"
                                    Margin="4,4,4,10" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource InfoBarBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                            Margin="16,0,0,0" Padding="10,4"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- ===== 两档排版共用同一个 FeedItems, 只切可见性 =====
                                 ★ 不做"换模板/重建列表": 那会把滚动位置和已生成的容器一起丢掉,
                                   切一下就跳回顶部。两个 ItemsControl 各自绑自己的可见性最省事 ——
                                   Collapsed 的那个不参与测量, 也不会生成容器。
                                 ★ 默认档 = 动态卡(见 SettingsStore.FollowCardWall)。 -->

                            <!-- 动态卡(默认): 单列, 每条 = 头像 + UP 名 + 发布时间 + 视频。
                                 不挂卡片墙(CardWallPanel) —— 卡片墙是"一屏铺满尽量多张"的网格,
                                 而动态流要的是每条都有清晰的作者与时间归属, 两者目标相反。 -->
                            <ItemsControl ItemsSource="{Binding FeedItems}" Margin="4,0,8,0"
                                          Visibility="{Binding UseCardWall, Converter={StaticResource InvBoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DynamicCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 卡片墙(切换档): 复用 VideoCard(点击播放/右键操作/全局屏蔽同首页) -->
                            <ItemsControl ItemsSource="{Binding FeedItems}" Margin="4,0,0,0"
                                          Visibility="{Binding UseCardWall, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:VideoCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 底部状态 -->
                            <StackPanel Margin="0,10,0,24" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                    <controls:LoadingRing Width="18" Height="18" />
                                    <TextBlock Text="加载中…" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                           Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
