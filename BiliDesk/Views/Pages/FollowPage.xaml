<UserControl x:Class="BiliDesk.Views.Pages.FollowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!--
            右栏排版切换的两枚小 chip(动态卡 / 卡片墙)。
            写法与播放页评论区的「热门 / 时间」一致: 常态浅灰底, 选中态由 Tag="on" 触发粉底粉字。
            ★ 选中态**只由 code-behind 写 Tag 驱动** —— 两个按钮的亮/灭在一个地方决定,
              分散着改必然出现"两边都亮"或"两边都不亮"(沿用播放页那条经验)。
            ★ 绑定必须写 RelativeSource Self: ControlTemplate 的触发器里不写解析不到,
              改用 TemplatedParent 也会静默失效(2026-10-03 探针实测)。
        -->
        <Style x:Key="FeedLayoutChipStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{DynamicResource ControlFillDefaultBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 关注 UP 行模板(2026-11-06): 普通列表与搜索结果共用。
             ★ 行本身仍是 Border + 现有选中/红点/角标样式, ListBox 只负责虚拟化;
               ListBoxItem 的默认选中高亮在下面用空模板关掉。
             ★★ 2026-11-06 用户反馈"选中时的粉色底衬与头像名字的位置不和谐, 应放到左边去":
                  原来红点单独占一条 22px 的列(没红点的行也照样留白), 行的左右内边距又是
                  6 / 12 —— 头像离底衬左缘 28px、右侧只留 12px, 粉色块整体看着往右倒。
                  现在红点列压到 8px、左右内边距改成 6 / 10 ⇒ 头像离左缘 14px,
                  与右侧的时间标签视觉上对称, 底衬的重心回到左边。 -->
        <DataTemplate x:Key="FollowUserRowTemplate">
            <!-- ★★ 2026-11-06 用户反馈"选中时的粉色底衬与头像名字的位置不和谐, 应放到左边去":
                   原来红点单独占一条 22px 的列(没红点的行也照样留白), 行的左右内边距又是
                   6 / 12 —— 头像离底衬左缘 28px、右侧只留 12px, 粉色块整体看着往右倒。
                   ★ 现在的结构: **底衬本身不留内边距**, 内边距挪到"内容列"上 ——
                     红点列固定在最左(0px 起), 头像列从 8px 起, 左右两端的留白
                     (8 / 10)由内容列自己的 Margin 给出 ⇒ 底衬的重心回到左边,
                     而且红点紧贴底衬左缘, 一眼就能看到"这一行有更新"。 -->
            <Border CornerRadius="10" Padding="0" Margin="0,0,0,4" Cursor="Hand"
                    MouseLeftButtonUp="OnSelectUp"
                    ToolTip="只看 TA 的投稿视频">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- 未读红点: 固定在最左 8px 那一列, 紧贴底衬左缘 -->
                    <Border Grid.Column="0" Width="8" Height="28"
                            Background="Transparent" VerticalAlignment="Center">
                        <Border Width="6" Height="6" CornerRadius="3"
                                Background="{DynamicResource UnreadDotBrush}"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Visibility="{Binding HasNew, Converter={StaticResource BoolToVis}}" />
                    </Border>
                    <Grid Grid.Column="1" Width="36" Height="36" Margin="6,8,0,8">
                        <Border Width="36" Height="36" CornerRadius="18"
                                Background="{DynamicResource AccentSoftFillBrush}"
                                ClipToBounds="True"
                                helpers:Cover.Source="{Binding Face}">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="打开 UP 主页" Click="OnVisitClick">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="查看头像大图" Click="OnViewAvatar">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="下载头像到本地" Click="OnDownloadAvatar">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="取消关注" Click="OnUnfollowClick">
                                        <MenuItem.Icon>
                                            <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="13" VerticalAlignment="Center" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Border.ContextMenu>
                            <TextBlock Text="&#xE77B;"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="16"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                MinWidth="16" Height="16" CornerRadius="8" Padding="4,0"
                                Background="{DynamicResource AccentBrush}"
                                ToolTipService.IsEnabled="{Binding HasNew}"
                                ToolTip="{Binding NewCount, StringFormat='{}{0} 条新动态'}"
                                Visibility="{Binding HasNew, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding NewCount}" FontSize="10"
                                       Foreground="{DynamicResource TextOnAccentBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Grid.Column="2" Text="{Binding Name}"
                               FontSize="13" Margin="10,0,8,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Grid.Column="3" Text="{Binding ActivityLabel}"
                               FontSize="11" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               MaxWidth="72" Margin="0,0,10,0"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding HasActivity, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 关注 UP 列表专用 ListBox 样式: 打开虚拟化(条目滚动), 关掉 ListBox 自带选中高亮。
             ★ 2790+ 关注必须虚拟化, 否则会一次性创建几千个行控件/头像, UI 线程直接卡死。 -->
        <Style x:Key="FollowUserListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <!-- ★ 2026-11-06 用户报"动态页出现多个可以左右拖动的横条":
                 虚拟化 ListBox 的 HorizontalScrollBarVisibility 默认是 Auto, 只要有一行
                 比视口宽一点点(长 UP 名/长文案)就会长出一条水平滚动条; 左栏、动态流、卡片墙
                 各自一条, 看起来就是"好几个横条", 而且拖它会让内容左右晃动("画面不固定")。
                 这里一律 Disabled: 行内文本本来就都做了 TextTrimming/TextWrapping,
                 不需要横向滚动。 -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 右栏动态流 ListBox: 默认动态卡虚拟化(卡片墙用另一个 ListBox + CardWallPanel,
             因为 CardWallPanel 本身不虚拟化, 由 VM 限制最多 300 条)。 -->
        <Style x:Key="FeedListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <!-- 同上: 动态流也不要有横向滚动条(卡片宽度本来就跟视口一致) -->
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <ContentPresenter />
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <!--
                    右上角的窗口按钮(最小化/最大化/关闭)浮在内容区之上、占 y=4~36。
                    头部因此撑到 62 高: 标题贴顶(和左侧 logo 同一水平线), 右侧操作按钮
                    贴底 —— 它们的顶边落在 44, 正好让开窗口按钮, 谁也不压谁。
                    ★ 2026-11-06 用户要求"已读和刷新按钮做成右下角工具列": 头部右侧原来那两个
                      按钮移到了页面右下角的浮动工具列(见下方 ToolBar), 头部只剩标题。
                -->
        <Grid Grid.Row="0" Margin="24,20,24,8" MinHeight="62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="动态" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Count, StringFormat=' · 关注 {0} 位 UP'}"
                           VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <!-- 未登录提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding NotLoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="登录后可查看你关注的 UP 主的动态"
                           Margin="0,14,0,14" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="20,8"
                        Command="{Binding LoginCommand}" />
            </StackPanel>

            <!-- 加载中(整页) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFullLoading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 主体: 左 UP 列表 + 右内容 ===== -->
            <Grid Visibility="{Binding ShowFullLoading, Converter={StaticResource InvBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左: 全部动态 + UP 列表 ===== -->
                <Grid Grid.Column="0" Margin="12,4,0,20"
                      PreviewMouseLeftButtonDown="OnLeftColumnPress"
                      MouseLeftButtonUp="OnLeftColumnUp">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 搜索已关注的 UP(2026-11-06): 服务端搜索, 不要求先把 2790 人全部加载下来 -->
                    <Grid Grid.Row="0" Margin="8,2,8,6">
                        <TextBox x:Name="UserSearchBox" Style="{StaticResource FluentTextBoxStyle}"
                                 Height="34" Padding="30,0,30,0" FontSize="13"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding UserSearchText, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" VerticalAlignment="Center"
                                   Margin="10,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False" />
                        <!-- ★ 占位符显隐绑 <c>HasUserSearch</c>(bool) 而不是 UserSearchText(string)+InvStrToVis
                             (2026-11-07 修"搜索时占位文字不隐藏, 与输入内容重叠"):
                             · 旧的绑法在源码上是对的(VM 有通知、转换器是对的), 但实测出现过
                               "输入了文字占位符仍在" —— string 属性通知这条路少一环确认, 出问题
                               无声无息(绑定失败只写 Output 窗口)。
                             · HasUserSearch 是 VM 显式 OnPropertyChanged 的 bool, 走项目里
                               到处都在用的 bool→Visibility 转换器(未读红点/刷新按钮同款),
                               同一个通知顺带把 ✕ 清除按钮一起驱动 —— 两者的显隐**必然一致**。
                             · 另一个附带修正: 判空从 IsNullOrEmpty 升级为 IsNullOrWhiteSpace 的语义
                               (HasUserSearch 本来就是 IsNullOrWhiteSpace) —— 输入纯空格时占位符
                               也不再显示。 -->
                        <TextBlock Text="搜索已关注的 UP" FontSize="12.5"
                                   VerticalAlignment="Center" Margin="30,0,30,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasUserSearch, Converter={StaticResource InvBoolToVis}}" />
                        <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                FontSize="10" Width="24" Height="24" Padding="0"
                                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                                Style="{StaticResource IconButtonStyle}"
                                Click="OnClearUserSearch"
                                Visibility="{Binding HasUserSearch, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- 全部动态入口: 选中高亮跟 VM.IsAllSelected 走。
                         ★★★ 2026-11-06 用户报"全部动态和底下的 up 显示不对称":
                           这个入口在 ListBox **外面**, 而 UP 行在 ListBox **里面** ——
                           后者的宽度要扣掉垂直滚动条(约 10px), 于是两块粉色底衬
                           右缘差一截、左缘也差 1px, 看起来就是"上下两行没对齐"。
                           这里的 Margin/Width 由 code-behind 精确同步(见 SyncAllDynamicEntry);
                           选中态/悬停态与 UP 行完全同款。 -->
                    <Border x:Name="AllDynamicEntry" Grid.Row="1" CornerRadius="10"
                            Padding="14,10,10,10" Margin="8,4,8,6" Cursor="Hand"
                            HorizontalAlignment="Left"
                            MouseLeftButtonUp="OnSelectAll">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="36" Height="36" CornerRadius="18"
                                    Background="{DynamicResource AccentSoftFillBrush}">
                                <Path Data="{DynamicResource DynamicIconGeometry}"
                                      Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                                      Width="18" Height="18" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="全部动态" FontSize="14" FontWeight="SemiBold"
                                       Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- 关注 UP 列表: 虚拟化 ListBox。搜索时切换成搜索结果列表。
                         ★ 2026-11-06 用户要求"左栏只做一个面板, 不要分有新视频和 UP 多个面板":
                           有未读但还没分页加载出来的 UP 现在作为**占位行**插在这个列表最前面
                           (见 FollowViewModel.SyncUnreadPlaceholders), 不再单独开一个面板。 -->
                    <Grid Grid.Row="2">
                        <ListBox x:Name="UsersList" Style="{StaticResource FollowUserListStyle}"
                                 Margin="8,0,8,0"
                                 ItemsSource="{Binding Users}"
                                 ItemTemplate="{StaticResource FollowUserRowTemplate}"
                                 ScrollViewer.ScrollChanged="UpListScroll_OnScrollChanged"
                                 Visibility="{Binding HasUserSearch, Converter={StaticResource InvBoolToVis}}" />
                        <ListBox x:Name="UserSearchList" Style="{StaticResource FollowUserListStyle}"
                                 Margin="8,0,8,0"
                                 ItemsSource="{Binding FollowingSearchResults}"
                                 ItemTemplate="{StaticResource FollowUserRowTemplate}"
                                 Visibility="{Binding HasUserSearch, Converter={StaticResource BoolToVis}}" />
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding ShowUserSearchEmpty, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="没有匹配的已关注 UP" FontSize="12"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Visibility="{Binding UserSearching, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" HorizontalAlignment="Center" />
                            <TextBlock Text="搜索中…" FontSize="11" Margin="0,8,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                        <TextBlock Text="{Binding UserSearchError}" FontSize="12"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="200"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding HasUserSearchError, Converter={StaticResource BoolToVis}}" />
                    </Grid>

                    <!-- 左栏底部状态: 与右栏的 LoadingMore 完全分开。
                         ★ 2026-11-06 用户要求去掉"已加载 N / 2790"那行统计提示 —— 左下角不再显示。 -->
                    <Grid Grid.Row="3" Margin="8,4,8,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding LoadingMoreUsers, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="14" Height="14" />
                            <TextBlock Text="正在加载关注列表…" FontSize="11" Margin="6,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                    Visibility="{Binding HasUsersLoadError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding UsersLoadError}" FontSize="11"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="150" />
                            <Button Content="重试" Style="{StaticResource LinkButtonStyle}" Margin="8,0,0,0"
                                    Command="{Binding LoadMoreCommand}" />
                        </StackPanel>
                    </Grid>
                </Grid>

                <!-- ===== 右: 内容(两档排版, 右上角可切) ===== -->
                <!-- ★ 底部只留 20px 常规间距(2026-11-06 用户要求删掉之前那 96px 的留白):
                     96px 是为右下角浮动工具列预留的, 但它在列表底部形成一块灰色空带,
                     看着像"被一个长方形画幅遮挡住了"。工具列浮在内容上是常态(首页同款),
                     滚到底时它只压住最后一张卡片的右下角。 -->
                <Grid Grid.Column="1" Margin="12,4,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 右栏标题 + 排版切换(用户要求"可以自己切换排版") -->
                    <Grid Grid.Row="0" Margin="8,0,8,10">
                        <TextBlock Text="{Binding SelectionTitle}" FontSize="15"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:Name="BtnLayoutCards" Style="{StaticResource FeedLayoutChipStyle}"
                                    Content="动态卡" Click="OnLayoutCardsClick"
                                    ToolTip="单列动态卡: 头像 + 发布时间 + 视频" />
                            <Button x:Name="BtnLayoutWall" Style="{StaticResource FeedLayoutChipStyle}"
                                    Content="卡片墙" Margin="6,0,0,0" Click="OnLayoutWallClick"
                                    ToolTip="多列卡片墙(一屏铺更多, 但没有头像与发布时间)" />
                        </StackPanel>
                    </Grid>

                    <!-- ===== 关注直播看板(2026-10-31 新增) =====
                         我关注的主播里正在播的, 一行一个: 头像 + 名字 + 直播标题。
                         ★ 点整行 → 直接进 TA 的直播间(Svc.Player.PlayLive), 不经任何中间页。
                         ★ **常驻显示**(2026-10-31 用户问"看板在哪里" —— 之前做成"没人在播就整块
                           隐藏", 结果用户找不到这个功能; 空态改成一行说明文字, 位置固定可预期)。
                           未登录才整块隐藏(登录了才有"关注"可言)。
                         ★ 展开态可折叠(点标题行切换), 数据与动态流并行加载。 -->
                    <Border Grid.Row="1" Margin="8,0,8,10" Padding="12,10" CornerRadius="10"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding NotLoggedIn}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel>
                            <!-- 标题行: 点它折叠/展开 -->
                            <Grid Cursor="Hand" MouseLeftButtonUp="OnToggleLiveBoard">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="13" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock Text="{Binding LiveBoardTitle}" FontSize="13" FontWeight="SemiBold"
                                               Margin="8,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <controls:LoadingRing Width="14" Height="14" Margin="8,0,0,0"
                                                          VerticalAlignment="Center"
                                                          Visibility="{Binding LiveBoardLoading, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                                <!-- 展开箭头(收起时转 180°) -->
                                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"
                                           RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="{Binding LiveBoardOpen, Converter={StaticResource BoolToAngle}}" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <!-- 主播列表(竖排, 一行一个); 空态给一行说明 —— 看板常驻后
                                 "为什么列表是空的"要自己解释清楚, 不然像坏了。
                                 ★ 必须自带 ScrollViewer + MaxHeight(2026-11-03 修"直播看板无法
                                   鼠标滚轮滚动"): 看板在 Grid.Row="Auto" 里, 不设上限时它会一直
                                   撑高把下面的动态流挤扁, 而且滚轮没有可滚目标; 关注的主播一多
                                   就只能看到前几个。限高之后列表自己滚, 动态流仍占剩余空间。 -->
                            <ScrollViewer Margin="0,8,0,0" MaxHeight="240"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Visibility="{Binding LiveBoardOpen, Converter={StaticResource BoolToVis}}">
                                <ItemsControl ItemsSource="{Binding LiveNow}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="8" Padding="6,6" Margin="0,0,0,4" Cursor="Hand"
                                                    ToolTip="进入直播间"
                                                    MouseLeftButtonUp="OnLiveItemClick">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <!-- 头像 + 直播中角标(红点在头像右下角, 照 B 站直播面板) -->
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                            Background="{DynamicResource AccentSoftFillBrush}" ClipToBounds="True"
                                                            helpers:Cover.Source="{Binding Cover}"
                                                            ToolTip="{Binding Title}">
                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="14" Foreground="{DynamicResource AccentTextBrush}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Author}" FontSize="13" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Title}" FontSize="11.5" Margin="0,1,0,0"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <!-- 「直播中」标 -->
                                                    <Border Grid.Column="2" CornerRadius="4" Padding="5,2"
                                                            VerticalAlignment="Center"
                                                            Background="{DynamicResource DangerBrush}">
                                                        <TextBlock Text="直播中" FontSize="9.5" FontWeight="SemiBold"
                                                                   Foreground="White" />
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <!-- 空态: 加载完成且没人在播(加载中不显示, 由标题行的 ring 表达) -->
                            <TextBlock Text="关注的主播暂时都没有在直播"
                                       FontSize="12" Margin="0,8,0,2"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding ShowLiveEmptyText, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 出错/为空提示(非阻断, 固定在列表上方, 不随滚动跑掉) -->
                        <Border Grid.Row="0" HorizontalAlignment="Center" MaxWidth="520"
                                Margin="4,4,4,10" Padding="14,10" CornerRadius="8"
                                Background="{DynamicResource InfoBarBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                                Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                        Margin="16,0,0,0" Padding="10,4"
                                        Command="{Binding RefreshCommand}" />
                            </StackPanel>
                        </Border>

                        <!-- 底部状态: 加载中 / 失败重试 / 卡片墙上限 / 已经到底
                             ★★ 2026-11-06 用户要求"把最下面那个长方形画幅彻底删除":
                             那个矩形其实是**被裁掉的半张动态卡** —— ListBox 滚到底时按**像素**
                             停, 最后一张卡只露出顶部一行(头像+标题), 它的白色卡片底色
                             横贯整个右栏宽度, 看着就像"下面压着一个长方形画幅"。
                             两处一起改:
                               ① 底部状态区从 Grid 的独立一行改成**浮在列表之上的浮层**
                                  (不再占一行高度, 列表能一直铺到面板底边);
                               ② 滚到底时按**项**对齐(见 FeedScroll_OnScrollChanged 的
                                  ScrollIntoView), 让最后一张卡完整显示而不是裁一半。 -->
                        <Grid Grid.Row="1">
                            <!-- 默认动态卡: 虚拟化 ListBox, 只创建可见卡片。
                                 ★ 不加外部 ScrollViewer, 否则虚拟化会失效。 -->
                            <ListBox x:Name="FeedList" Style="{StaticResource FeedListStyle}"
                                     Margin="4,0,8,0"
                                     ItemsSource="{Binding FeedItems}"
                                     ScrollViewer.ScrollChanged="FeedScroll_OnScrollChanged"
                                     Visibility="{Binding UseCardWall, Converter={StaticResource InvBoolToVis}}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <controls:DynamicCard />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 卡片墙: CardWallPanel 不虚拟化, VM 里限制最多 300 条。 -->
                            <ListBox x:Name="FeedWallList" Style="{StaticResource FeedListStyle}"
                                     Margin="4,0,0,0"
                                     ItemsSource="{Binding WallItems}"
                                     ScrollViewer.ScrollChanged="FeedScroll_OnScrollChanged"
                                     Visibility="{Binding UseCardWall, Converter={StaticResource BoolToVis}}">
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                                    </ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <controls:VideoCard />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- 底部状态浮层: 盖在列表底部, 不占高度。
                                 ★★★ 2026-11-06 用户报"底部状态区加载一遍后会出现椭圆一样的东西
                                 且一直显示不会自动隐藏" —— 那是**这个 Border 本身**:
                                 它有 Padding="12,6" + 背景色 + 圆角, 即使里面四个子项
                                 全是 Collapsed, 它照样渲染成一个 24×12 的小圆角块(看着像椭圆),
                                 而且永远在那儿。⇒ 整个浮层必须跟着内容一起消失。
                                 ★ 用一个 Bool 统一控制: 四个子项里**只要有一个可见**就显示浮层,
                                 否则整个 StackPanel 收起来(Visibility=Collapsed, 不占任何空间)。 -->
                            <StackPanel x:Name="FeedStatusOverlay" Grid.Row="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                        Margin="0,0,0,10" Panel.ZIndex="5">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding LoadingMore}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding LoadMoreError}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowWallLimitHint}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                            <MultiDataTrigger>
                                                <MultiDataTrigger.Conditions>
                                                    <Condition Binding="{Binding ShowEndOfFeed}" Value="True" />
                                                </MultiDataTrigger.Conditions>
                                                <Setter Property="Visibility" Value="Visible" />
                                            </MultiDataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        CornerRadius="8" Padding="12,6"
                                        Opacity="0.94">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                            <controls:LoadingRing Width="18" Height="18" />
                                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal"
                                                    Visibility="{Binding LoadMoreError, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="加载更多失败" Style="{StaticResource MetaTextStyle}"
                                                       VerticalAlignment="Center" />
                                            <Button Content="重试" Style="{StaticResource LinkButtonStyle}"
                                                    Margin="8,0,0,0" Command="{Binding LoadMoreFeedCommand}" />
                                        </StackPanel>
                                        <TextBlock Text="卡片墙最多显示 300 条，切换「动态卡」继续浏览"
                                                   Style="{StaticResource MetaTextStyle}"
                                                   Visibility="{Binding ShowWallLimitHint, Converter={StaticResource BoolToVis}}" />
                                        <!-- ★ 绑 ShowEndOfFeed(而不是 HasMore 取反): 到底了之后往上滚,
                                             这句提示要跟着消失 —— 它是"到底了"的瞬时反馈, 不是常驻横幅。 -->
                                        <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                                   Visibility="{Binding ShowEndOfFeed, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- ===== 右下角浮动工具列(2026-11-06) =====
             用户要求"已读和刷新按钮做成右下角工具列"。原来这两个按钮在页面头部右侧,
             现在浮到右下角, 与首页/分区页同一套观感(FloatingIconButtonStyle)。
             ★ 用 Panel.ZIndex 浮在内容之上, 不占独立列 —— 占列的话右栏滚动条会被挤到
               按钮左边, 看着没贴到窗口右缘。
             ★ 未登录时整列隐藏: 没有"关注"可言, 已读/刷新都没有意义。 -->
        <StackPanel x:Name="ToolBar" Grid.Row="1" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,20,20">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding NotLoggedIn}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <!-- 全部已读: 有红点时出现。
                 ★★ 2026-11-06 用户要求"优化工具列已读按钮图案, 使他更符合功能用途":
                   原来用的是 E73E(一个**裸对勾**), 单独看只像"选中/完成", 表达不出
                   "把动态**标记为已读**"这层意思。
                   改成矢量画的「信封 + 对勾」—— 动态本身就是一条消息(信封),
                   右下角压一个对勾 = "标记为已读", 与 B 站消息中心的语义一致。
                   ★ 用矢量而不是字体字形: 字形在不同 Windows 版本上可能缺字/变形,
                     而 Path 是我们自己画的, 一定长这个样子。 -->
            <Button x:Name="BtnMarkAllRead" Style="{StaticResource FloatingIconButtonStyle}"
                    Command="{Binding MarkAllReadCommand}"
                    ToolTip="全部已读(清空所有 UP 的新视频红点)"
                    Visibility="{Binding HasAnyUnread, Converter={StaticResource BoolToVis}}">
                <Grid Width="17" Height="17">
                    <!-- 信封轮廓 + 封口折线(略偏左上, 给右下角的对勾让位) -->
                    <Path Data="M 1.5,4 H 11.5 V 11.5 H 1.5 Z M 1.5,4 L 6.5,7.6 L 11.5,4"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.1" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                    <!-- 右下角的对勾(压在信封角上, 但与封口折线错开) -->
                    <Path Data="M 8.6,12.4 L 11,14.7 L 15.6,9.2"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Grid>
            </Button>
            <!-- 刷新 -->
            <Button x:Name="BtnRefresh" Style="{StaticResource FloatingIconButtonStyle}"
                    Margin="0,6,0,0" Click="OnRefreshClick" ToolTip="刷新">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
