<UserControl x:Class="BiliDesk.Views.Pages.FollowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 刷新 -->
        <!--
                    右上角的窗口按钮(最小化/最大化/关闭)浮在内容区之上、占 y=4~36。
                    头部因此撑到 62 高: 标题贴顶(和左侧 logo 同一水平线), 右侧操作按钮
                    贴底 —— 它们的顶边落在 44, 正好让开窗口按钮, 谁也不压谁。
                -->
        <Grid Grid.Row="0" Margin="24,20,24,8" MinHeight="62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="动态" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding Count, StringFormat=' · 关注 {0} 位 UP'}"
                           VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>
            <Button HorizontalAlignment="Right" Style="{StaticResource IconButtonStyle}"
                    Command="{Binding RefreshCommand}" ToolTip="刷新" VerticalAlignment="Bottom">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="15" />
            </Button>
        </Grid>

        <!-- 内容 -->
        <Grid Grid.Row="1">
            <!-- 未登录提示 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding NotLoggedIn, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="登录后可查看你关注的 UP 主的动态"
                           Margin="0,14,0,14" FontSize="13"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           HorizontalAlignment="Center" />
                <Button Content="登录哔哩哔哩" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Padding="20,8"
                        Command="{Binding LoginCommand}" />
            </StackPanel>

            <!-- 加载中(整页) -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowFullLoading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 主体: 左 UP 列表 + 右内容 ===== -->
            <Grid Visibility="{Binding ShowFullLoading, Converter={StaticResource InvBoolToVis}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="252" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ===== 左: 全部动态 + UP 列表 ===== -->
                <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="UpListScroll_OnScrollChanged"
                              Margin="12,4,0,20">
                    <StackPanel Margin="8,0,8,0">
                        <!-- 全部动态入口: 选中高亮跟 VM.IsAllSelected 走 -->
                        <!-- 选中/悬停观感与左侧导航栏一致: 悬停灰(NavItemHoverBrush),
                             选中粉底(AccentSoftFillBrush) + 粉字(AccentTextBrush)。 -->
                        <Border CornerRadius="10" Padding="12,10" Margin="0,4,0,6" Cursor="Hand"
                                MouseLeftButtonUp="OnSelectAll">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                        </Trigger>
                                        <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="18"
                                        Background="{DynamicResource AccentSoftFillBrush}">
                                    <Path Data="{DynamicResource DynamicIconGeometry}"
                                          Stroke="{DynamicResource AccentTextBrush}" StrokeThickness="1.6"
                                          Width="18" Height="18" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="全部动态" FontSize="14" FontWeight="SemiBold"
                                           Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAllSelected}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- 关注的 UP(点击 = 只看 TA 的投稿) -->
                        <ItemsControl ItemsSource="{Binding Users}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="10" Padding="12,8" Margin="0,0,0,4" Cursor="Hand"
                                            MouseLeftButtonUp="OnSelectUp"
                                            ToolTip="只看 TA 的投稿视频">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource NavItemHoverBrush}" />
                                                    </Trigger>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{DynamicResource AccentBorderFillBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <!-- 头像。右键可看大图 / 保存 -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18"
                                                    Background="{DynamicResource AccentSoftFillBrush}"
                                                    ClipToBounds="True"
                                                    helpers:Cover.Source="{Binding Face}">
                                                <Border.ContextMenu>
                                                    <ContextMenu>
                                                        <MenuItem Header="打开 UP 主页" Click="OnVisitClick">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="13" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="查看头像大图" Click="OnViewAvatar">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="13" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <MenuItem Header="下载头像到本地" Click="OnDownloadAvatar">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="13" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                        <Separator />
                                                        <MenuItem Header="取消关注" Click="OnUnfollowClick">
                                                            <MenuItem.Icon>
                                                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                           FontSize="13" VerticalAlignment="Center" />
                                                            </MenuItem.Icon>
                                                        </MenuItem>
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <TextBlock Text="&#xE77B;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="16"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                       FontSize="13" Margin="10,0,0,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 左栏补页 -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="14" Height="14" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- ===== 右: 内容(卡片网格, 尽量铺满) ===== -->
                <Grid Grid.Column="1" Margin="12,4,24,20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 右栏标题 -->
                    <TextBlock Grid.Row="0" Text="{Binding SelectionTitle}" FontSize="15"
                               FontWeight="SemiBold" Margin="8,0,0,10" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="FeedScroll_OnScrollChanged">
                        <StackPanel>
                            <!-- 出错/为空提示(非阻断, 放在列表上方) -->
                            <Border HorizontalAlignment="Center" MaxWidth="520"
                                    Margin="4,4,4,10" Padding="14,10" CornerRadius="8"
                                    Background="{DynamicResource InfoBarBackgroundBrush}"
                                    BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                            Margin="16,0,0,0" Padding="10,4"
                                            Command="{Binding RefreshCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- 视频卡片网格: 复用 VideoCard(点击播放/右键操作/全局屏蔽同首页) -->
                            <ItemsControl ItemsSource="{Binding FeedItems}" Margin="4,0,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <controls:VideoCard />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 底部状态 -->
                            <StackPanel Margin="0,10,0,24" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal"
                                            Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                    <controls:LoadingRing Width="18" Height="18" />
                                    <TextBlock Text="加载中…" Margin="8,0,0,0"
                                               VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                                </StackPanel>
                                <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                           Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
