<UserControl x:Class="BiliDesk.Views.Pages.MinePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        「我的」页(2026-09-26 新增, 版式对齐 B 站网页版 space 首页):
        页首卡片(资料 + 统计 + 快捷入口) → 我的收藏夹卡片。
        ★ 2026-11-28: 页首卡片化 —— 资料/统计/快捷入口收进一张圆角卡片,
          中间原本近 460px 的空白变成卡片内留白; 资料与统计之间加竖分隔线;
          经验条改成跟随元信息行宽度, 快捷入口胶囊整体收小一档。
        ★ 2026-11-27: 「动态/关注/粉丝」从资料头下面单独一行搬进资料头这一行,
          紧跟在昵称块后面(整条从左连续排开) —— 中途试过"靠右对齐",
          结果头像块与三项分居页面两端、中间空 1100px, 视觉上头重脚轻, 用户退回。
        快捷入口现有四个: 离线缓存 / 观看记录 / 我的订阅 / 稍后再看(2026-09-28 加)。
        ★ 2026-11-27: 第三枚「我的收藏」改成「我的订阅」(用户要求, 入口对标 B 站),
          点它进新增的「我的订阅」页(追番/追剧/订阅的合集)。
          下方的「我的收藏」收藏夹区块**保持原样** —— 收藏页的入口仍由它承担。
    -->
    <UserControl.Resources>
        <!--
            收藏夹卡片右上角的「删除收藏夹」(2026-11-19)。
            ★ 默认藏起来, 悬停整张卡片才出现: 常驻一颗红叉会把封面弄脏, 也容易误点。
            ★ 默认收藏夹(B 站不让删)永远不出现 —— 由 IsDefault 条件控制。
            ★ 半透明黑底 + 白图标, 压在封面图上也能看清(封面明暗不确定, 用主题灰底会糊掉)。
        -->
        <Style x:Key="FolderDeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="14" Background="#B3000000"
                                BorderBrush="#40FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#E6000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#FF000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <!-- 悬停在整张卡片(卡片根 StackPanel)上 -->
                        <Condition Binding="{Binding IsMouseOver,
                                             RelativeSource={RelativeSource AncestorType=StackPanel}}"
                                   Value="True" />
                        <Condition Binding="{Binding IsDefault}" Value="False" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            经验进度条(2026-11-28 重做)。
            ★ 宽度不再写死: 轨道由资料头里那一行文字(Auto 列)撑开, 指示段 = 轨道宽 × 百分比,
              交给 ProgressBar 自己算 —— VM 原来的 ExpBarWidth(= 120 × 进度)已经删掉。
            ★ 轨道色用 ControlFillPressedBrush 而不是 DividerBrush: 深色卡片底(#2E2E2E)上
              Divider(8% 白)几乎看不见, 13% 白才读得出"这里有一条轨道"; 浅色下同理(6% → 12% 黑)。
            ★ IsHitTestVisible=False: 它只是装饰, 不该抢走资料头 Button 的点击。
        -->
        <Style x:Key="ExpBarStyle" TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border x:Name="PART_Track" CornerRadius="2"
                                    Background="{DynamicResource ControlFillPressedBrush}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentBrush}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid helpers:Responsive.Enable="True">

        <!-- 响应式: 窄档收内边距。
             ★ 内边距走下面的 VisualState(Thickness 可插值, 平滑过渡)。
             ★ 2026-11-27 起快捷入口是 WrapPanel 里的横向胶囊, 放不下时自己折行,
               不再需要"窄档 4 列改 2 列"那一档。档位来自主窗口, 见 Helpers/Responsive.cs。 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium" />

                <VisualState x:Name="Compact">
                    <Storyboard>
                        <ThicknessAnimation Storyboard.TargetName="PageHeader"
                                            Storyboard.TargetProperty="Margin"
                                            To="20,20,20,0" Duration="0" />
                        <ThicknessAnimation Storyboard.TargetName="PageBody"
                                            Storyboard.TargetProperty="Margin"
                                            To="20,6,20,28" Duration="0" />
                        <!-- 页首卡片的内边距也跟着收一档(24,20 → 16,16):
                             窄窗口下内容线正好仍是 20 + 16 = 36, 与旧版落点一致。 -->
                        <ThicknessAnimation Storyboard.TargetName="HeaderCard"
                                            Storyboard.TargetProperty="Padding"
                                            To="16,16" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题行(头部撑到 62: 右上角窗口按钮占 y=4~36, 与其它页面同一套规则) -->
        <Grid x:Name="PageHeader" Grid.Row="0" Margin="36,20,36,0" MinHeight="62">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="我的" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- ============ 未登录 ============ -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding IsLoggedIn, Converter={StaticResource InvBoolToVis}}">
            <Border Width="72" Height="72" CornerRadius="36"
                    Background="{DynamicResource AccentSoftFillBrush}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="34" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="登录后查看你的收藏、历史与硬币经验"
                       FontSize="14" Margin="0,18,0,0" HorizontalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" />
            <Button Content="去登录" Style="{StaticResource AccentButtonStyle}"
                    Padding="28,8" Margin="0,18,0,0" HorizontalAlignment="Center"
                    Command="{Binding LoginCommand}" />
        </StackPanel>

        <!-- ============ 已登录 ============ -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding IsLoggedIn, Converter={StaticResource BoolToVis}}">
            <StackPanel x:Name="PageBody" Margin="36,6,36,28">

                <!-- == 资料头(2026-11-28 卡片化) ==
                     把「资料 + 统计 + 快捷入口」收进一张圆角卡片: 中间原本近 460px 的空白
                     从"页面上的洞"变成"卡片内的呼吸感", 页首也终于读作一个整体。

                     ★ 对齐规则: 卡片左边缘落在页面对齐线(36)上, 与「我的」标题、
                       下方「我的收藏」同一条线; 卡片内容再统一内缩 24。
                       对齐看容器边, 内容自己缩一档 —— 不要把内容也顶到 36。
                     ★ 底色必须用 CardBackgroundBrush: 亚克力模式下 ThemeService 会把它
                       连同面板一起按材质重算(比面板再实一档), 写死 #2E2E2E 会穿帮。
                     ★ 资料头 / 三个数字仍是 Button(ClickableAreaButtonStyle):
                       WPF 的 MouseLeftButtonUp 是 **Direct(直达)路由**, 挂在父级 Border 上时
                       点在子元素(头像/数字)上永远不会触发; Button.Click 才是冒泡的。
                       (探针 bd-probe-mine 实测: avatar=1 header=0 page=0。)
                     ★ 悬停底衬内边距 10,8 + 负外边距 -10: 底衬比圆形头像各让出 10px,
                       看着才是"框包住了头像"; 负外边距把头像的左边线拉回页面对齐线。 -->
                <Border x:Name="HeaderCard"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="24,20">
                    <Grid x:Name="HeaderGrid" SizeChanged="OnHeaderSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <!-- 右列用 * 而不是 Auto: Auto 列里的流式面板拿到的是无限宽, 永远不折行。 -->
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 第 1 行 = 资料头; 第 2 行 = 快捷入口落到下方时它与资料头的间距(平时高 0);
                             第 3 行 = 快捷入口(平时不用) -->
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel x:Name="ProfileBlock" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Style="{StaticResource ClickableAreaButtonStyle}"
                                    HorizontalAlignment="Left"
                                    Padding="10,8" Margin="-10,0,-10,0"
                                    Command="{Binding OpenSelfSpaceCommand}"
                                    ToolTip="查看我的个人主页"
                                    ToolTipService.Placement="Bottom"
                                    ToolTipService.VerticalOffset="8">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <Border x:Name="AvatarBox" Width="72" Height="72" CornerRadius="36"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentSoftFillBrush}"
                                            helpers:Cover.Source="{Binding Face}">
                                        <!-- 兜底人形: Cover.Source 把头像画在 Border 的 Background 上, 子元素会叠在图上,
                                             所以 Face 有 URL 就把图标藏掉(和侧栏头像当年的处理一致) -->
                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="28" Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Visibility="{Binding Face, Converter={StaticResource InvStrToVis}}" />
                                    </Border>
                                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- MaxWidth + 省略号: 昵称过长时会把右边的统计入口挤出可视区
                                                 (资料头是 StackPanel 里的 Grid, 超宽不会换行, 只会裁掉右边) -->
                                            <TextBlock Text="{Binding Name}" FontSize="22" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" MaxWidth="240"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <!-- 等级徽章: 空串(Lv0)时整块隐藏 -->
                                            <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentSoftFillBrush}"
                                                    Visibility="{Binding LevelText, Converter={StaticResource StrToVis}}">
                                                <TextBlock Text="{Binding LevelText}" FontSize="11" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextBrush}" />
                                            </Border>
                                        </StackPanel>

                                        <!-- 元信息 + 经验条同处一个 Auto 宽的 Grid ——
                                             ★ 轨道宽度因此自动等于上一行文字的宽度(不再写死 120px)。
                                               只剩一行元信息时 Grid 的宽度由它决定, 进度条再跟着铺满,
                                               "120px 的条只压住半行字"那种断线感就没了。 -->
                                        <Grid HorizontalAlignment="Left">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="硬币" FontSize="12"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text="{Binding CoinsText}" FontSize="12" Margin="4,0,0,0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                                <!-- 经验: 没拿到(ExpText 为空)时整段隐藏 -->
                                                <StackPanel Orientation="Horizontal" Margin="20,0,0,0"
                                                            Visibility="{Binding ExpText, Converter={StaticResource StrToVis}}">
                                                    <TextBlock Text="经验" FontSize="12"
                                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                                    <TextBlock Text="{Binding ExpText}" FontSize="12" Margin="4,0,0,0"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                                </StackPanel>
                                            </StackPanel>

                                            <!-- 经验进度条(2026-11-28 重做): 轨道 = 上行文字宽, 4px 高, 右端百分比。
                                                 ★ 用 ProgressBar 而不是 Border + 绑定像素宽度: VM 里原来是
                                                   "120 × 进度"的换算, 换成满宽后就失效了; ProgressBar 自己按
                                                   "轨道实际宽度 × 百分比"算指示段, 窗口缩放/125% 下都不会错位。 -->
                                            <Grid Grid.Row="1" Margin="0,7,0,0"
                                                  Visibility="{Binding ExpText, Converter={StaticResource StrToVis}}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <!-- ★ Mode=OneWay 必须写: RangeBase.Value 默认 TwoWay,
                                                     而 ExpProgress 只有私有 setter —— 不写会在运行时抛
                                                     "无法对只读属性进行 TwoWay 绑定"(探针实测)。 -->
                                                <ProgressBar Grid.Column="0" Style="{StaticResource ExpBarStyle}"
                                                             Maximum="1" Value="{Binding ExpProgress, Mode=OneWay}"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Margin="8,0,0,0"
                                                           Text="{Binding ExpPercentText}" FontSize="11"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </Grid>
                                        </Grid>
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <!-- == 资料 | 统计 之间的竖分隔(2026-11-28) ==
                                 距离上统计原来离快捷入口(24)比离资料(36)更近, 视觉分组和语义分组是反的;
                                 加一根 36 高的竖线 + 两侧 32 / 28, "人"和"数据"的关系一眼就读出来了。 -->
                            <Border Width="1" Height="36" VerticalAlignment="Center"
                                    Margin="32,0,28,0"
                                    Background="{DynamicResource DividerBrush}" />

                            <!-- == 动态 / 关注 / 粉丝(数字在上、标签在下) ==
                                 ★ 2026-11-18(issue #90): 三个数字都是可点入口, 点进「我的空间」对应 Tab。
                                 ★ 用 Button(ClickableAreaButtonStyle) 而不是 Border + 鼠标事件:
                                   Click 冒泡、按下-抬起自带配对判定、键盘 Tab + 空格/回车可用。
                                 ★ MinWidth=72: 三项等宽, 数字位数不同(11 / 229 / 737)时也不会左右跳动。
                                 ★ 2026-11-28: 数字 18 → 20、标签 12 → 11, 把"人名"与"数据"拉开一档;
                                   与资料之间改由上面那根竖线分组, 不再靠 36px 的空隙。 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="DynamicEntry" Style="{StaticResource ClickableAreaButtonStyle}"
                                        MinWidth="72" Padding="0,6" Command="{Binding OpenDynamicsCommand}"
                                        ToolTip="查看我的动态">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DynamicText}" FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="动态" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FollowingEntry" Style="{StaticResource ClickableAreaButtonStyle}"
                                        MinWidth="72" Padding="0,6" Command="{Binding OpenFollowingsCommand}"
                                        ToolTip="查看我关注的 UP 主">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FollowingText}" FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="关注" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="FollowerEntry" Style="{StaticResource ClickableAreaButtonStyle}"
                                        MinWidth="72" Padding="0,6" Command="{Binding OpenFollowersCommand}"
                                        ToolTip="查看我的粉丝">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding FollowerText}" FontSize="20" FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                                        <TextBlock Text="粉丝" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- 快捷入口落到下方时它与资料头的间距; 留在右侧时高度 0(由 code-behind 切换) -->
                        <Border Grid.Row="1"
                                x:Name="HeaderGap" Height="0" />

                        <!-- == 快捷入口(四个: 离线缓存 / 观看记录 / 我的订阅 / 稍后再看) ==
                             ★ 2026-11-27 改成「横向胶囊 + 从左依次排开」(用户反馈排版不自然):
                               原来是 UniformGrid 把四块均匀撒满整行(图标在上、文字在下, 112×66)。
                             ★ 2026-11-28: 46 → 40 高、图标 18 → 16、内边距 18 → 16、项间距 12 → 10。
                               四枚加起来原来比左边的统计还"重", 压得页首往右倒; 收一档后
                               胶囊是"轻量快捷入口", 视觉重量让回给资料与数字。
                             ★ 常态给一层很淡的底(ControlFillDefaultBrush)+ 1px 描边:
                               光秃秃的"图标 + 字"靠左排会像浮在页面上, 有底才成其为"一枚按钮"; 悬停加深。
                             ★ 底块必须自带背景: 没有背景 = 不参与命中测试(这里的 MouseLeftButtonUp 就收不到)。
                             ★ 折行/落位: 面板是 RightWrapPanel(每一行都靠右; 自带 WrapPanel 折行后第二行会贴左)。
                               ① 右侧放得下一行 → 一行, 贴在资料头同一行的最右;
                               ② 放不下一行但放得下两行 → 折成两行, 仍在右侧、两行右对齐;
                               ③ 连两行都放不下 → 落到资料头下方, 从头像的起始线向右排。
                               三种状态由 code-behind 的 UpdateQuickEntryPlacement 按**实际宽度**切换。
                             ★ 胶囊 Margin 上下各留 4: 折成两行时两行之间才有缝; 只有一行时整体仍垂直居中。
                             ★ 右边的 -10 抵掉最后一枚的 10px 右外边距, 让胶囊右缘贴住卡片内容线。 -->
                        <helpers:RightWrapPanel x:Name="QuickGrid" SizeChanged="OnQuickGridSizeChanged"
                                                BalanceLines="True"
                                                VerticalAlignment="Center" Margin="32,0,-10,0">
                            <helpers:RightWrapPanel.Resources>
                                <Style x:Key="QuickEntry" TargetType="Border">
                                    <Setter Property="Height" Value="40" />
                                    <Setter Property="CornerRadius" Value="10" />
                                    <Setter Property="Padding" Value="16,0" />
                                    <Setter Property="Margin" Value="0,4,10,4" />
                                    <Setter Property="Background" Value="{DynamicResource ControlFillDefaultBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Setter Property="Cursor" Value="Hand" />
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                <!-- 胶囊里的图标: 与文字同一基线带(各自 VerticalAlignment=Center) -->
                                <Style x:Key="QuickEntryIcon" TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
                                    <Setter Property="FontSize" Value="16" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                </Style>
                                <Style x:Key="QuickEntryText" TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="13" />
                                    <Setter Property="Margin" Value="8,0,0,0" />
                                    <Setter Property="VerticalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                </Style>
                            </helpers:RightWrapPanel.Resources>
                            <Border Style="{StaticResource QuickEntry}" MouseLeftButtonUp="OnOpenCacheClick"
                                    ToolTip="打开离线缓存">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE896;" Style="{StaticResource QuickEntryIcon}" />
                                    <TextBlock Text="离线缓存" Style="{StaticResource QuickEntryText}" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource QuickEntry}" MouseLeftButtonUp="OnOpenHistoryClick"
                                    ToolTip="打开观看记录">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE81C;" Style="{StaticResource QuickEntryIcon}" />
                                    <TextBlock Text="观看记录" Style="{StaticResource QuickEntryText}" />
                                </StackPanel>
                            </Border>
                            <!-- 我的订阅(2026-11-27): 追番 / 追剧 / 订阅的合集。
                                 ★ 原来的「我的收藏」胶囊已去掉 —— 收藏页入口交给下方收藏夹区块。 -->
                            <Border Style="{StaticResource QuickEntry}" MouseLeftButtonUp="OnOpenSubscriptionClick"
                                    ToolTip="打开我的订阅">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE006;" Style="{StaticResource QuickEntryIcon}" />
                                    <TextBlock Text="我的订阅" Style="{StaticResource QuickEntryText}" />
                                </StackPanel>
                            </Border>
                            <!-- 稍后再看(2026-09-28 新增) -->
                            <Border Style="{StaticResource QuickEntry}" MouseLeftButtonUp="OnOpenWatchLaterClick"
                                    ToolTip="打开稍后再看">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7C1;" Style="{StaticResource QuickEntryIcon}" />
                                    <TextBlock Text="稍后再看" Style="{StaticResource QuickEntryText}" />
                                </StackPanel>
                            </Border>
                        </helpers:RightWrapPanel>
                    </Grid>
                </Border>

                <!-- == 我的收藏 ==
                     ★ 2026-11-28: 页首改成卡片后, 原来的 1px 分隔线是多余的 ——
                       卡片下边缘已经是一条明确的分区线, 再叠一条线两行会显得密。 -->
                <Grid Margin="0,28,0,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="我的收藏" FontSize="15" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding FavCountText}" FontSize="15" FontWeight="SemiBold"
                                   Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding FavCountText, Converter={StaticResource StrToVis}}" />
                        <!-- 进收藏页看全部 -->
                        <Button Style="{StaticResource BareIconButtonStyle}" Margin="4,0,0,0"
                                Click="OnOpenFavoritesClick" ToolTip="打开收藏页"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="12" />
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,6,0"
                                Command="{Binding CreateFolderCommand}" ToolTip="新建收藏夹">
                            <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" />
                        </Button>
                        <Button Style="{StaticResource IconButtonStyle}"
                                Click="OnRefreshFoldersClick" ToolTip="刷新收藏夹（F5）">
                            <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- 收藏夹卡片(横向, 装不下时滚动) -->
                <StackPanel HorizontalAlignment="Center" Margin="0,26,0,0"
                            Visibility="{Binding FolderLoading, Converter={StaticResource BoolToVis}}">
                    <controls:LoadingRing Width="26" Height="26" HorizontalAlignment="Center" />
                </StackPanel>

                <TextBlock Text="{Binding FolderError}" FontSize="13" Margin="0,18,0,0"
                           HorizontalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding FolderError, Converter={StaticResource StrToVis}}" />

                <!-- 一个收藏夹都没有: 只显示"还没有创建收藏夹"而不给入口等于死路 -->
                <Button Content="新建收藏夹" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,12,0,0" Padding="20,7"
                        Command="{Binding CreateFolderCommand}"
                        Visibility="{Binding NoFolders, Converter={StaticResource BoolToVis}}" />

                <!-- 收藏夹卡片: 走 CardWall(2026-11-27 用户要求"尽量让卡片铺满")。
                     ★ 原来固定 168 宽的 WrapPanel 只在最左边排满, 右侧会剩一截空白(尤其
                       新建/刷新按钮下方那一块)。
                     ★ CardWall 按可用宽度算列宽, 卡片自动撑满整行; 它的 Gap=16 要求卡片
                       左右外边距各 8(见 Helpers/CardWall.cs 的"与 VideoCard 的耦合")。
                     ★ 封面比例沿用原来的 168:104 ≈ 1.6, 封面圆角仍写在装图的那层 Border 自己身上。 -->
                <ItemsControl ItemsSource="{Binding Folders}" Margin="0,16,0,0"
                              Visibility="{Binding FolderError, Converter={StaticResource InvStrToVis}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <helpers:CardWallPanel helpers:CardWall.Enable="True"
                                                   helpers:CardWall.Aspect="1.6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 一个收藏夹卡片: 封面 + 标题 + "共N条视频 · 私密"。
                                 宽高都读卡片墙的继承属性, 不再写死 168x104。 -->
                            <StackPanel Cursor="Hand" Margin="8,10" Background="Transparent"
                                        MouseLeftButtonUp="OnFolderClick"
                                        Width="{Binding (helpers:CardWall.ItemWidth),
                                                        RelativeSource={RelativeSource Self}}">
                                <Grid Height="{Binding (helpers:CardWall.CoverHeight),
                                                       RelativeSource={RelativeSource AncestorType=StackPanel}}">
                                    <Border x:Name="FolderCover" CornerRadius="8"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            helpers:Cover.Source="{Binding Cover}">
                                        <!-- 注意: 不能放兜底图标 —— Cover.Source 把图画在 Border 的
                                             Background 上, 子元素永远叠在它上面; 拉图失败时
                                             CardBackgroundBrush 底色本身就是兜底 -->
                                    </Border>
                                    <!-- 悬停时出现的删除按钮(默认收藏夹不显示, 见上面样式) -->
                                    <Button Style="{StaticResource FolderDeleteButtonStyle}"
                                            HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Margin="0,6,6,0" ToolTip="删除收藏夹"
                                            Click="OnDeleteFolderClick">
                                        <TextBlock Text="&#xE74D;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="White" />
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="2,8,0,0"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock FontSize="11" Margin="2,3,0,0"
                                           Foreground="{DynamicResource TextTertiaryBrush}">
                                    <Run Text="共" /><Run Text="{Binding MediaCount, Mode=OneWay}" /><Run Text="条视频 · " /><Run Text="{Binding PrivacyText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
