<UserControl x:Class="BiliDesk.Views.Pages.FavoritesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        收藏页(2026-11-14 改版): 吸顶胶囊 + 右下角浮动工具列。

        ★ 整页只有一个 ScrollViewer(PageScroll): 标题「收藏」跟着内容一起上滑滚走,
          收藏夹胶囊条滚到距顶端 8px 处钉住 —— 与设置页顶部 Tab 完全同一套效果,
          算法抽在 Helpers/StickyPin(占位块量自然位置 + TranslateTransform 反向抵消)。
          胶囊只有一个实例, 尺寸/字号/内边距全程不变, 也没有整条吸顶栏/背景色块。
        ★ 标题行右上角那排操作(编辑 / 返回 / 刷新)与编辑态那排(全选 / 移出 / 清空 / 退出)
          全部搬到**右下角竖列**(FloatingIconButtonStyle, 与首页/分区页同一套观感),
          图标 + ToolTip, 不再横排在头部。已选计数与批量进度做成工具列上方的小胶囊,
          标题滚走之后也照样看得到。
        ★ 收藏夹条的溢出折叠逻辑(UpdateFolderOverflow)原样保留: 它量的是内容流里那个
          占位 Grid(FolderBarHost)的宽度, 与胶囊本体是不是浮层无关。
    -->
    <Grid>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnListScrollChanged">
            <Grid>
                <!-- ============ 正常内容流 ============ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- 底部留白给右下角工具列让位: 普通态 3 颗按钮(≈146),
                                 编辑态 4 颗 + 计数胶囊(≈244) —— 滚到底时最后一行卡片要整行露出来。 -->
                            <Setter Property="Margin" Value="36,20,36,164" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Margin" Value="36,20,36,244" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ============ 标题行(随内容滚走) ============
                         胶囊本体在下面(滚动内容的最后一个子元素, 这样才能盖住卡片并吸顶),
                         这里只留一个同高的透明占位, 保证内容区起始位置与原布局一致。 -->
                    <Grid>
                        <!-- [ 普通模式 ] 标题 + 条数 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                            <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="20" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="收藏" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                            <TextBlock Text="{Binding CountText}" VerticalAlignment="Bottom" Margin="6,0,0,6"
                                       Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
                        </StackPanel>

                        <!-- [ 编辑模式 ] 标题 + 当前收藏夹 + 已选计数 + 进度 -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="编辑收藏" Style="{StaticResource PageTitleStyle}" />
                            <TextBlock Text="{Binding CurrentFolderTitle, StringFormat=· {0}}"
                                       VerticalAlignment="Bottom" Margin="10,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                                       TextTrimming="CharacterEllipsis" MaxWidth="240" />
                            <TextBlock Text="{Binding SelectedText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                            <TextBlock Text="{Binding BusyText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                       FontSize="12" Foreground="{DynamicResource DangerTextBrush}"
                                       Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
                        </StackPanel>
                    </Grid>

                    <!-- 收藏夹条的**占位**(登录后才有内容)。
                         胶囊本体是浮层(见下方 StickyFolderBar), 不占高度, 所以这里撑一个同高的
                         透明块; 它同时是 StickyPin 量"自然顶边"的锚点, 也是溢出折叠量宽度的容器
                         (FolderBarHost.ActualWidth = 内容区可用宽, 与改版前一致)。 -->
                    <Grid x:Name="FolderBarHost" Margin="0,14,0,10"
                          Visibility="{Binding Folders.Count, Converter={StaticResource CountToVis}}">
                        <Border x:Name="FolderBarSlot" Visibility="Hidden"
                                Height="{Binding ActualHeight, ElementName=StickyFolderBar}" />
                    </Grid>

                    <!-- ============ 卡片墙 ============ -->
                    <StackPanel Visibility="{Binding Error, Converter={StaticResource InvStrToVis}}">
                        <ItemsControl ItemsSource="{Binding Items}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- 右键"移出收藏"通过 ExtraMenuItems 合并进卡片自带的右键菜单,
                                         而不是套一层带 ContextMenu 的 Grid —— 后者会被卡片自己的菜单顶掉。
                                         Selectable 在编辑模式下打开: 卡片左上角出现选中圆标, 且点击变成勾选。 -->
                                    <controls:VideoCard
                                        Selectable="{Binding DataContext.IsEditMode, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        ExtraMenuItems="{Binding DataContext.CardMenuItems, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 底部状态 -->
                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                <controls:LoadingRing Width="18" Height="18" />
                                <TextBlock Text="加载中…" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ============ 吸顶收藏夹胶囊 ============
                     ★ 只有一个实例, 必须是滚动内容的**最后一个子元素**(画在卡片之上);
                       滚动时由 StickyPin 反向平移抵消滚动量, 到距顶端 8px 处钉住。
                     ★ 用 Grid 而不是 Border 当根: 里面除了胶囊还要挂「⋯」浮层(Popup)。
                     ★ IsHitTestVisibleInChrome: 钉住后顶端进入窗口标题栏区(CaptionHeight=20),
                       不标的话那块区域里的点击会被 WindowChrome 当成"拖动窗口"吞掉。
                     ★ 用 RadioButton + GroupName 而不是 Button: 单选中状态由控件自己维护,
                       选中样式能直接写在样式触发器里, 不必在代码后置里手动遍历改 FontWeight。 -->
                <Grid x:Name="StickyFolderBar" VerticalAlignment="Top" HorizontalAlignment="Left"
                      Margin="36,74,0,0"
                      Visibility="{Binding Folders.Count, Converter={StaticResource CountToVis}}"
                      shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="StickyFolderShift" />
                    </Grid.RenderTransform>

                    <!-- ★ 底色用 FrostedPanelBrush(磨砂浮层): 胶囊吸顶后压在卡片封面上,
                         亚克力下半透明但把封面压住保证标签可读(太透糊字 / 全不透明死白都不行, 见 ThemeService)。 -->
                    <Border HorizontalAlignment="Left"
                            Background="{DynamicResource FrostedPanelBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                            CornerRadius="22" Padding="5">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08" />
                        </Border.Effect>
                        <StackPanel Orientation="Horizontal">
                            <!-- 主条: 只放 VisibleFolders(划分在代码后置完成) -->
                            <ItemsControl x:Name="FolderChips" ItemsSource="{Binding VisibleFolders, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- CommandParameter 传数据项本身(FavFolder);
                                             选中态由 RadioButton + GroupName 自己维护, 不需要代码后置插手。
                                             ★ IsCurrent 是"程序切夹"的同步通道: OneWay 绑定 + ToggleButton 的
                                             SetCurrentValue 特性让用户点击也不会扯断这条绑定 -->
                                        <RadioButton GroupName="FavFolderChip" Style="{StaticResource SettingsTabStyle}"
                                                     Content="{Binding DisplayText}"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     Margin="0,0,4,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- 「⋯」折叠按钮: 有被折进去的夹子时才显示。
                                 红点 = 当前选中的夹子在被折叠的那部分里(别让用户以为它丢了)。
                                 ★ 用 SubtleButtonStyle(Button), 不能用 SettingsTabStyle
                                   (那是 RadioButton 的样式, 套在 Button 上直接抛 XamlParse)。 -->
                            <Button x:Name="FolderMoreButton" Style="{StaticResource SubtleButtonStyle}"
                                    VerticalAlignment="Center"
                                    Click="OnFolderMoreClick" ToolTip="更多收藏夹"
                                    Cursor="Hand" Padding="10,7">
                                <Grid>
                                    <TextBlock Text="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="14" />
                                    <Ellipse x:Name="FolderMoreDot" Width="7" Height="7"
                                             Fill="{DynamicResource AccentBrush}"
                                             HorizontalAlignment="Right" VerticalAlignment="Top"
                                             Margin="0,0,2,0" Visibility="Collapsed" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- 折叠浮层: 白卡圆角带投影, 流式多行展示**被折叠的**收藏夹。
                         ★ 底色用 FlyoutBackgroundBrush(恒不透明)而不是 CardBackgroundBrush:
                           浮层盖在卡片墙上, 亚克力下卡片底半透明, 跟着透会糊字(合集面板同款坑)。 -->
                    <Popup x:Name="FolderMorePopup" PlacementTarget="{Binding ElementName=FolderMoreButton}"
                           Placement="Bottom" AllowsTransparency="True" PopupAnimation="Fade"
                           StaysOpen="False">
                        <Border Background="{DynamicResource FlyoutBackgroundBrush}"
                                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                CornerRadius="12" Padding="10" Margin="8" MaxWidth="560">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.14" />
                            </Border.Effect>
                            <ItemsControl x:Name="FolderMoreList"
                                          ItemsSource="{Binding HiddenFolders, RelativeSource={RelativeSource AncestorType=UserControl}}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- 浮层里是独立的一份 RadioButton: GroupName 不同(不与主条互斥),
                                             选中态靠 VM 的 IsCurrent 驱动(OneWay); 点选后由代码收起浮层。 -->
                                        <RadioButton GroupName="FavFolderChipPopup"
                                                     Style="{StaticResource SettingsTabStyle}"
                                                     Content="{Binding DisplayText}"
                                                     IsChecked="{Binding IsCurrent, Mode=OneWay}"
                                                     Command="{Binding DataContext.SelectFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     CommandParameter="{Binding}"
                                                     Margin="0,0,4,4"
                                                     Click="OnFolderPopupChipClick" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                    </Popup>
                </Grid>
            </Grid>
        </ScrollViewer>

        <!-- 加载中(页面级浮层, 不跟着滚) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"
                    Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
            <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
            <TextBlock Text="正在同步云端收藏夹…" Style="{StaticResource MetaTextStyle}"
                       Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 错误 / 空状态 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="480" Panel.ZIndex="10"
                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
            <TextBlock Text="&#xE735;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="40" Foreground="{DynamicResource TextTertiaryBrush}"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" Margin="0,14,0,0" />
            <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                    Command="{Binding ReloadCommand}"
                    Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}" />
        </StackPanel>

        <!-- ============ 右下角浮动工具列(2026-11-14) ============
             用户要求"收藏 / 历史 / 稍后再看右上角的工具列全部改为右下角竖列显示"。
             ★ 按钮用 FloatingIconButtonStyle: 三种状态的底色都**不透明** —— 默认的
               IconButtonStyle 是 4% 黑, 浮在卡片封面上等于没有底, 图标会糊进图片里。
             ★ 外面不加任何底板/边框, 就是最朴素的"一列按钮"(投影在样式模板的 ShadowBd 层)。
             ★ Panel.ZIndex 浮在内容之上、不占独立列: 占列的话滚动条会被挤到按钮左边。
               右边留 16 正好避让开滚动条(8px 宽 + 6px 缩放带)。
             ★ 编辑态的「移出所选 / 清空」用 DangerTextBrush; 全局隐式 TextBlock 样式带
               Foreground setter, 会吃掉继承色, 所以图标 TextBlock 上要**显式**写前景色。
             ★ ToolTipService.ShowOnDisabled: 批量操作进行中按钮是灰的, 但 ToolTip 仍要能读。 -->
        <StackPanel x:Name="ToolBar" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 已选计数 + 批量进度: 标题滚走之后, 这里是唯一常驻的反馈 -->
            <Border HorizontalAlignment="Right" Margin="0,0,0,8"
                    Background="{DynamicResource FlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10,5"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedText}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding BusyText}" FontSize="11" HorizontalAlignment="Right"
                               Margin="0,2,0,0" Foreground="{DynamicResource DangerTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="180"
                               Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Border>

            <!-- [ 普通模式 ] 刷新 / 编辑 / 返回「我的」 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding ReloadCommand}" ToolTip="刷新（F5）">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="编辑：批量移出收藏">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <!-- 返回「我的」页: 历史/收藏/缓存的入口都在「我的」页, 统一给一条回去的路 -->
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Click="OnBackToMineClick" ToolTip="返回「我的」">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>

            <!-- [ 编辑模式 ] 全选 / 移出所选 / 清空收藏夹 / 退出编辑 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding SelectAllCommand}" ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <MultiBinding StringFormat="{}{0}（{1}）">
                            <Binding Path="SelectAllText" />
                            <Binding Path="SelectedText" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding RemoveSelectedCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="移出所选" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ClearFolderCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="清空收藏夹：把当前收藏夹里的全部内容移出" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE75A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="退出编辑">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>