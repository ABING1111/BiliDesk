<UserControl x:Class="BiliDesk.Views.Pages.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Background="{DynamicResource AppBackgroundBrush}">
    <UserControl.Resources>
        <!-- 热搜一行: 序号 + 名称 + 徽章。
             ★ 根元素必须显式给 Background="Transparent": WPF 里**没有画刷的元素不参与命中测试**,
               那样悬停高亮和点击都会落空(这个坑在 VideoCard 的标题上踩过, 见那边的注释)。 -->
        <DataTemplate x:Key="HotSearchRowTemplate">
            <Border Height="28" CornerRadius="4" Padding="4,0" Cursor="Hand"
                    MouseLeftButtonUp="OnHotSearchRowClick" ToolTip="{Binding ShowName}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding Rank}" FontSize="12"
                               FontWeight="SemiBold" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                                <Style.Triggers>
                                    <!-- 前三名用强调色: 一眼把最热的几条挑出来 -->
                                    <DataTrigger Binding="{Binding IsTopRank}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="1" Text="{Binding ShowName}" FontSize="12"
                               Margin="0,0,8,0" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />

                    <Border Grid.Column="2" CornerRadius="3" Padding="4,1" VerticalAlignment="Center"
                            Visibility="{Binding HasBadge, Converter={StaticResource BoolToVis}}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource HotBadgeNewBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Badge}" Value="热">
                                        <Setter Property="Background" Value="{DynamicResource HotBadgeHotBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Badge}" Value="独家">
                                        <Setter Property="Background" Value="{DynamicResource HotBadgeExclusiveBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="#FFFFFF" />
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid helpers:Responsive.Enable="True">

        <!-- 响应式: 窄档把左右内边距从 36 收到 20, 卡片区多出 32px 可用宽度。
             档位来自主窗口(继承的附加属性), 这里不自己算 —— 见 Helpers/Responsive.cs。
             Compact 里写 Duration="0"、平滑交给状态组的 GeneratedDuration, 与主窗口同一套写法。 -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <!-- 宽/中档 = 设计值, Storyboard 留空 -->
                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium" />

                <VisualState x:Name="Compact">
                    <Storyboard>
                        <ThicknessAnimation Storyboard.TargetName="PageHeader"
                                            Storyboard.TargetProperty="Margin"
                                            To="20,20,20,0" Duration="0" />
                        <ThicknessAnimation Storyboard.TargetName="TabsRow"
                                            Storyboard.TargetProperty="Margin"
                                            To="20,18,0,8" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 标题 + 分时段问候语(同一行: 问候语贴在"首页"右侧, 留 14px 间隙) -->
        <StackPanel x:Name="PageHeader" Grid.Row="0" Orientation="Horizontal" Margin="36,20,36,0">
            <TextBlock Text="首页" Style="{StaticResource PageTitleStyle}" />
            <!-- 主文案用主文字色而非次级色: 深色主题下次级色(#B0B0B0)在深底上偏灰暗。
                 kaomoji 跟随强调色。 -->
            <StackPanel Orientation="Horizontal" Margin="14,0,0,6" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding Greeting}" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
                <TextBlock Text="{Binding GreetingFace}" FontSize="13" Margin="6,0,0,0"
                           Foreground="{DynamicResource AccentTextBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <!-- 分段标签 + 选中下划线。
             选中态是"字变强调色 + 下方一根短横线", 线由页面在切换时用动画滑到新标签下面
             (见 HomePage.xaml.cs 的 MoveTabIndicator)。

             为什么把标签套进一个 Grid: 下划线要浮在标签行底部、按选中标签的实际位置定位 ——
             四个标签文字长短不同(推荐/热门 vs 排行榜), 位置只能实测, 不能靠固定间距推。 -->
        <Grid x:Name="TabsRow" Grid.Row="1" Margin="36,18,0,8" HorizontalAlignment="Left">
            <StackPanel x:Name="HomeTabs" Orientation="Horizontal">
                <RadioButton x:Name="RecommendTab" Style="{StaticResource UnderlineTabStyle}"
                             Content="推荐" />
                <RadioButton x:Name="PopularTab" Style="{StaticResource UnderlineTabStyle}"
                             Content="热门" Margin="4,0,0,0" />
                <RadioButton x:Name="RankingTab" Style="{StaticResource UnderlineTabStyle}"
                             Content="排行榜" Margin="4,0,0,0" />
                <!-- 直播放在排行榜右侧, 顺序就是需求要的"排行榜右侧" -->
                <RadioButton x:Name="LiveTab" Style="{StaticResource UnderlineTabStyle}"
                             Content="直播" Margin="4,0,0,0" />
            </StackPanel>

            <!-- 选中下划线: 固定 20x3 的圆角短线。宽度写死有两个好处: 与参考图里"线比文字短"的比例一致,
                 而且只需要动画 X 一个属性(宽度不变就不会忽胖忽瘦)。IsHitTestVisible=False: 它浮在
                 标签下沿, 不能把点击吃掉。 -->
            <Border x:Name="TabIndicator" Width="20" Height="3" CornerRadius="1.5"
                    Background="{DynamicResource AccentBrush}" IsHitTestVisible="False"
                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="TabIndicatorTrans" />
                </Border.RenderTransform>
            </Border>
        </Grid>

        <!-- ===== 右下角浮动工具列 =====
             2026-09-30 按用户要求从**右上角移到这里**。原来压在右上角, 窗口一窄就和搜索框抢地方,
             缩到小尺寸时那几个按钮会被内容盖住看不见。移到右下角后只跟"最后一行卡片"重叠,
             而滚动内容末尾留了 250px 下边距(见各处 StackPanel 的 bottom margin),
             滚到底时最后一行能整行露出来。

             ★ 按钮用 `FloatingIconButtonStyle`: 常态/悬停/按下三种底色都是**不透明**的。
               默认的 IconButtonStyle 是 4% 黑(#0A000000), 只适合"浮在纯色页面背景上";
               这里浮在**卡片封面**上, 半透明的底等于没有底, 图标会糊进图片图案里(用户截图反馈)。
             ★★ 外面**不加**任何底板/边框 —— 用户明确要求"每个按钮外面不要加边框,
               保留原来的样子", 所以这里就是最朴素的"一列按钮"。
               (2026-10-01 用户改口: 白色圆角按钮**要加柔和投影**浮起来 —— 投影做在
               FloatingIconButtonStyle 模板内部的 ShadowBd 层上, 不是这里的底板。)

             它是**浮在内容之上**的, 不占独立列 —— 占独立列的话内容区(含滚动条)就只到列左边为止,
             滚动条会被挤到按钮的**左边**, 看着像没贴到窗口右缘。现在内容占满整宽、滚动条落在最右侧,
             按钮用 Panel.ZIndex 浮在右下角(不写 ZIndex 会被后面声明的内容盖住),
             右边留 16px 正好避让开滚动条。

             ★ 「回到顶部」始终占位、**只切透明度与命中测试**, 不用 Visibility ——
               它在同一列按钮的最上面, 用 Collapsed 的话下面四个按钮每滚过一次阈值就会上下跳一下。 -->
        <StackPanel x:Name="ToolBar" Grid.Row="1" Grid.RowSpan="2" Panel.ZIndex="10"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 回到顶部: 下滑之后才亮起来(见 HomePage.xaml.cs 的 UpdateBackToTop)。
                 E70E = ChevronUp。 -->
            <Button x:Name="BtnTop" Style="{StaticResource FloatingIconButtonStyle}"
                    Opacity="0" IsHitTestVisible="False"
                    Click="OnBackToTopClick" ToolTip="回到顶部">
                <TextBlock Text="&#xE70E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>

            <!-- 刷新: 走 code-behind 的 OnRefreshClick 而不是直接绑命令 —— 刷完要把列表滚回顶部
                 (见 HomePage.RefreshCurrentTabAsync 的说明), 那是"视图"的事, VM 不该管。 -->
            <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Click="OnRefreshClick" ToolTip="刷新">
                <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>

            <!-- 深浅色切换: 图标显示的是"点了会切到哪种", 比显示当前状态更直观。
                 PreviewMouseLeftButtonDown 用来记住点击位置, 供圆形扩散动画当圆心 ——
                 光靠 Click 拿不到坐标(键盘触发时更是没有鼠标)。 -->
            <Button x:Name="BtnTheme" Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    PreviewMouseLeftButtonDown="OnThemeButtonMouseDown"
                    Click="OnThemeToggleClick">
                <TextBlock x:Name="ThemeGlyph" Text="&#xE708;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>

            <!-- 离线缓存入口已删(2026-09-26): 收进「我的」页, 这里只剩主题切换和消息 -->

            <!-- B 站消息(私信): 官方 SVG 信封图标 -->
            <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Click="OnMessagesClick" ToolTip="B 站消息(私信)">
                <Path Data="{StaticResource MessageIconGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.4" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="15" Height="15" Stretch="Uniform" />
            </Button>

            <!-- 屏蔽: 点开左上方的小面板输入要屏蔽的标题 / UP 关键词 -->
            <Button x:Name="BtnFilter" Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Click="OnFilterClick" ToolTip="屏蔽内容(标题 / UP 主)">
                <TextBlock Text="&#xE71C;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
            </Button>

            <!-- 屏蔽面板: 弹在**工具列左边**(2026-10-01 用户要求; 原来弹在整条工具列上方)。
                 ★ 锚到 ToolBar: 锚 BtnFilter 的话面板会盖住上面几个按钮。
                 ★ Placement=Left 只定水平位置(右缘贴着工具列左缘, 再留 6px 间隙); 垂直方向
                   默认顶对齐, 而面板(≈340px 高)比工具列(≈214px)高 —— 顺着顶对齐会往窗口
                   下缘外长出去。底对齐在 code-behind 的 Opened 里按实际高度算(见 HomePage 构造函数),
                   面板多高都能贴着工具列底缘, 不用猜一个写死的 VerticalOffset。
                 StaysOpen=False 点到别处就收起。 -->
            <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=ToolBar}"
                   Placement="Left" HorizontalOffset="-6"
                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                <Border Background="{DynamicResource FlyoutBackgroundBrush}" CornerRadius="10"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                        Padding="14" Width="300">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"
                                          Direction="270" Color="#000000" />
                    </Border.Effect>
                    <StackPanel>
                        <TextBlock Text="屏蔽内容" FontSize="14" FontWeight="SemiBold" />
                        <!-- 文案必须说清方向: 这里是"含这些词的不再显示", 不是"只显示含这些词的"。
                             之前写的是"筛选 / 标题包含", 用户自然会理解成搜索, 结果一输入满屏只剩
                             命中的内容, 完全反了。 -->
                        <TextBlock Text="标题或 UP 主里含这些词的视频将不再显示。多个词用空格或逗号分隔。"
                                   FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <TextBlock Text="对首页的推荐 / 热门 / 排行榜、收藏页与云端历史同时生效"
                                   FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />

                        <TextBlock Text="屏蔽标题含" FontSize="12" Margin="0,14,0,6" />
                        <TextBox x:Name="FilterTitleBox" Style="{StaticResource FluentTextBoxStyle}"
                                 Text="{Binding TitleKeyword, Source={x:Static helpers:FilterService.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />

                        <TextBlock Text="屏蔽 UP 主含" FontSize="12" Margin="0,12,0,6" />
                        <TextBox x:Name="FilterUpBox" Style="{StaticResource FluentTextBoxStyle}"
                                 Text="{Binding UpKeyword, Source={x:Static helpers:FilterService.Instance}, UpdateSourceTrigger=PropertyChanged}"
                                 MaxLength="80" />

                        <Grid Margin="0,14,0,0">
                            <TextBlock Text="{Binding Description, Source={x:Static helpers:FilterService.Instance}}"
                                       FontSize="11" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="185"
                                       HorizontalAlignment="Left"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <Button Content="清除" Style="{StaticResource SubtleButtonStyle}"
                                    HorizontalAlignment="Right" Padding="12,4" FontSize="12"
                                    Click="OnClearFilterClick" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Popup>
        </StackPanel>

        <!-- 内容 -->
        <Grid Grid.Row="2">
            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing HorizontalAlignment="Center" />
                <TextBlock Text="加载中…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,10,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ===== 热门 ===== -->
            <ScrollViewer x:Name="PopularScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="PopularScroll_OnScrollChanged"
                          Visibility="{Binding IsPopularTab, Converter={StaticResource BoolToVis}}">
                <!-- 右边不再留 58px(那是给右上角工具列让位的, 工具列已挪到右下角)。
                     现在卡片墙左右都是卡片自带的 8px 外边距, 铺满整个内容宽。

                     底部 250px = 右下角浮动工具列的高度(5 个 38px 按钮 + 间距 + 20px 下边距)。
                     必须留在**滚动内容之外**(挂在容器 margin 上而不是卡片上), 这样滚到底时最后一行
                     能整行滚到浮动按钮上方, 不被压住。拿掉它的话最后一行永远有一角点不到。 -->
                <StackPanel Margin="0,0,0,250">
                    <Border Margin="20,4,20,0" Padding="14,10" CornerRadius="8"
                            Background="{DynamicResource InfoBarBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                            Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="16,0,0,0" Padding="10,4"
                                    Click="OnRefreshClick" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="PopularList" ItemsSource="{Binding PopularItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,28" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" />
                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                        <Button x:Name="MoreBtn" Content="加载更多" Style="{StaticResource SubtleButtonStyle}"
                                Visibility="{Binding PopularHasMore, Converter={StaticResource BoolToVis}}"
                                Command="{Binding LoadMoreCommand}" />
                        <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                   Visibility="{Binding PopularHasMore, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 推荐(个性化) ===== -->
            <ScrollViewer x:Name="RecommendScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="RecommendScroll_OnScrollChanged"
                          Visibility="{Binding IsRecommendTab, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,0,250">
                    <Border Margin="20,4,20,0" Padding="14,10" CornerRadius="8"
                            Background="{DynamicResource InfoBarBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                            Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="16,0,0,0" Padding="10,4"
                                    Click="OnRefreshClick" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="RecommendList" ItemsSource="{Binding RecommendItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,28" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" />
                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                        <Button Content="加载更多" Style="{StaticResource SubtleButtonStyle}"
                                Command="{Binding LoadMoreCommand}" />
                        <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                   Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 排行榜 ===== -->
            <ScrollViewer x:Name="RankingScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="RankingScroll_OnScrollChanged"
                          Visibility="{Binding IsRankingTab, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,0,250">
                    <Border Margin="20,4,20,0" Padding="14,10" CornerRadius="8"
                            Background="{DynamicResource InfoBarBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                            Visibility="{Binding RankingBlocked, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error}" Margin="10,0,0,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="打开网页版排行榜" Style="{StaticResource AccentButtonStyle}"
                                    Margin="16,0,0,0" Padding="12,5"
                                    Command="{Binding OpenRankingWebCommand}" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="RankingList" ItemsSource="{Binding RankingItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- ===== 直播 =====
                 卡片复用的是视频卡片: 直播间同样有封面/标题/UP 主, 差别只在
                 "N 播放"要显示成"N 人气"、以及点击后走直播流(见 VideoCard 里的分支)。
                 列表会滚动加载下一页, 直播不做"已经到底啦"提示 —— 直播是滚不到底的。 -->
            <ScrollViewer x:Name="LiveScroll" VerticalScrollBarVisibility="Auto"
                          ScrollChanged="LiveScroll_OnScrollChanged"
                          Visibility="{Binding IsLiveTab, Converter={StaticResource BoolToVis}}">
                <StackPanel Margin="0,0,0,250">
                    <Border Margin="20,4,20,0" Padding="14,10" CornerRadius="8"
                            Background="{DynamicResource InfoBarBackgroundBrush}"
                            BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                            Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="14" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                       VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                    Margin="16,0,0,0" Padding="10,4"
                                    Click="OnRefreshClick" />
                        </StackPanel>
                    </Border>

                    <ItemsControl x:Name="LiveList" ItemsSource="{Binding LiveItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <helpers:CardWallPanel helpers:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:VideoCard />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,12,0,28" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" />
                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ===== 搜索遮罩 =====
             展开期间它把整页盖住: 点页面上任何地方(而不是输入框 / 词条)都算"点外面", 收起卡片。
             Background 必须是 Transparent 而不是留空 —— 没有画刷的元素不参与命中测试, 那就完全
             吞不到点击了。刻意不加半透明黑蒙版: 参考图里卡片背后就是原样的页面内容。 -->
        <Border x:Name="SearchScrim" Grid.RowSpan="3" Panel.ZIndex="30"
                Background="Transparent" Visibility="Collapsed"
                MouseLeftButtonDown="OnSearchScrimClick" />

        <!-- ===== 搜索卡(收起态就是右上角那个搜索框) =====
             它是**一个元素**: 收起态只有上面那个搜索框, 点一下先整体平移到页面水平正中, 再原地往下长大,
             露出下面的内容框。为什么不让"搜索框"和"内容"做成两个各自动画的元素: 两段动画共用一个容器,
             中间没有交接点, 也就不存在"旧元素淡出 / 新元素淡入"对不齐的问题。

             ★ 视觉上是**两个分开的方框**(2026-09-26 用户要求"搜索与下方热搜不要挤在同一个方框里"):
               ① 搜索框 —— 自带圆角底, 聚焦时泛粉色光晕;
               ② 内容框 —— 自带圆角底 + 细描边, 与搜索框隔开 10px。
             外面这层 Border 只负责动画与布局, **自己不画任何底色**。

             位置动画走 RenderTransform(不参与布局, 不会把右侧图标列挤动), 尺寸走 Width/Height;
             **顶部不动**(展开是往下长), 只有 X 方向在动 —— 点开时向左滑到页面正中, 推导见
             HomePage.xaml.cs 的 PanXFor。

             ★ 右边距 152 不是随手定的(2026-09-26 修"搜索框与最小化/最大化重合"):
               窗口那三个自绘按钮在 MainWindow 里是 `Margin="0,4,4,0"` 右对齐的 3×46 = 138 宽,
               换算到本页坐标就是右边 142 起、一直贴到页右缘; 而搜索框与它们处在**同一条水平线**上
               (与首页标题、左侧 logo 对齐), 纵向躲不开 —— 只能横向让开: 138 + 12 间隙 ≈ 152。
               改这个数时记得同步 HomePage.xaml.cs 里的 SearchBoxRight(算平移量要用)。 -->
        <Border x:Name="SearchCard" Grid.RowSpan="3" Panel.ZIndex="31"
                HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,16,152,0" Width="440" Height="48"
                PreviewMouseLeftButtonDown="OnSearchCardPreviewMouseDown"
                PreviewKeyDown="OnSearchCardPreviewKeyDown">
            <Border.RenderTransform>
                <TranslateTransform x:Name="SearchCardTrans" />
            </Border.RenderTransform>

            <Grid>
                <Grid.RowDefinitions>
                    <!-- 输入行高度 = 收起态高度, 于是收起时下面那行正好 0 高(内容被挤没, 不用另外藏) -->
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- ===== ① 搜索框 ===== -->
                <Grid Grid.Row="0"
                      MouseEnter="OnSearchCardMouseEnter" MouseLeave="OnSearchCardMouseLeave">
                    <!-- 聚焦提示 = 一圈粉色描边(2026-09-26 用户要求"去除光晕、增加粉色描边")。
                         描边放在独立的 SearchInputRing 上: 它只是 Border 的轮廓, 不遮文字(文字在
                         下一层 Grid 里), 聚焦时淡入、失焦淡出。厚度 2、圆角与底色框一致。 -->
                    <Border x:Name="SearchBoxBg" CornerRadius="10"
                            Background="{DynamicResource ControlFillDefaultBrush}" />
                    <!-- 悬停加深(挂在同一个 Grid 上的 MouseEnter/Leave 驱动, 所以只有鼠标真的在
                         搜索框上才亮 —— 展开后鼠标移到下面的内容框上不会误亮)。 -->
                    <Border x:Name="SearchCardBgHover" CornerRadius="10" Opacity="0"
                            Background="{DynamicResource ControlFillHoverBrush}" />
                    <Border x:Name="SearchInputRing" CornerRadius="10" IsHitTestVisible="False"
                            Opacity="0" Background="Transparent"
                            BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2" />

                    <Grid Margin="10,0">
                        <TextBox x:Name="SearchKeywordBox"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                                 SelectionBrush="{DynamicResource AccentBrush}"
                                 FontSize="14" Padding="10,0,44,0"
                                 VerticalContentAlignment="Center"
                                 FocusVisualStyle="{x:Null}"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnSearchKeywordKeyDown"
                                 GotKeyboardFocus="OnSearchKeywordGotFocus"
                                 LostKeyboardFocus="OnSearchKeywordLostFocus" />

                        <!-- 放大镜: 点它就是"用当前词搜一次"。用无底版本 —— 参考图里它就是一枚
                             裸图标, 旁边那圈浅灰方块反而像多长了个按钮。 -->
                        <Button x:Name="BtnSearchGo" Content="&#xE721;"
                                Style="{StaticResource BareIconButtonStyle}"
                                Width="30" Height="30" FontSize="15"
                                HorizontalAlignment="Right" Margin="0,0,4,0"
                                Foreground="{DynamicResource TextSecondaryBrush}"
                                ToolTip="搜索" Click="OnSearchGoClick" />
                    </Grid>
                </Grid>

                <!-- ===== ② 内容框(与搜索框分开的另一个方框, 隔开 10px) ===== -->
                <!-- 默认 Hidden 而不是 Auto: 展开动画期间高度在变, Auto 会中途闪一下滚动条。
                     动画结束由代码切回 Auto(那时内容已按最终高度排好, 需要才出现)。 -->
                <Border x:Name="SearchContentBox" Grid.Row="1" Margin="0,10,0,0" Opacity="0"
                        CornerRadius="10"
                        Background="{DynamicResource FlyoutBackgroundBrush}"
                        BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1">
                    <ScrollViewer x:Name="SearchCardScroll" Margin="0,0,4,0"
                                  VerticalScrollBarVisibility="Hidden"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="20,14,20,16">

                            <!-- ===== 热搜 ===== -->
                            <StackPanel>
                                <TextBlock Text="热搜" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />

                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0"
                                            Visibility="{Binding HotLoading, Converter={StaticResource BoolToVis}}">
                                    <controls:LoadingRing Width="16" Height="16" />
                                    <TextBlock Text="正在获取热搜…" FontSize="12" Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>

                                <!-- 取不到时明说一句: 标题下面空着, 用户只会以为是卡住了 -->
                                <TextBlock Text="{Binding HotError}" FontSize="12" Margin="0,10,0,0"
                                           TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                           Visibility="{Binding HotError, Converter={StaticResource StrToVis}}" />

                                <!-- 两列。左列 1~5、右列 6~10: 接口按名次给, VM 一分为二, 比让
                                     UniformGrid 按行填充再倒序插入直白得多。 -->
                                <Grid Margin="0,6,0,0"
                                      Visibility="{Binding HasHot, Converter={StaticResource BoolToVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsControl Grid.Column="0" ItemsSource="{Binding HotLeft}"
                                                  ItemTemplate="{StaticResource HotSearchRowTemplate}" />
                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding HotRight}"
                                                  ItemTemplate="{StaticResource HotSearchRowTemplate}" />
                                </Grid>
                            </StackPanel>

                            <!-- 热搜与搜索历史之间的分隔线(参考图里两者之间也有一条横线) -->
                            <Border Height="1" Margin="0,14,0,0"
                                    Background="{DynamicResource DividerBrush}"
                                    Visibility="{Binding HasSearchHistory, Converter={StaticResource BoolToVis}}" />

                            <!-- ===== 搜索历史 ===== -->
                            <StackPanel Margin="0,14,0,0"
                                        Visibility="{Binding HasSearchHistory, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <TextBlock Text="搜索历史" FontSize="13" FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextPrimaryBrush}" />
                                    <!-- 文字色写进显式 TextBlock 的局部值: 全局隐式 TextBlock 样式带
                                         Foreground setter, 优先级高于 Button 透传下来的前景色,
                                         直接写 Content="清空" 会拿到主文字色而不是这里想要的次级色。 -->
                                    <Button x:Name="BtnClearSearchHistory"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            HorizontalAlignment="Right" VerticalAlignment="Center"
                                            Padding="8,3" Command="{Binding ClearSearchHistoryCommand}"
                                            ToolTip="清空搜索历史">
                                        <TextBlock Text="清空搜索历史" FontSize="11"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                    </Button>
                                </Grid>

                                <ItemsControl ItemsSource="{Binding SearchHistoryShown}" Margin="0,10,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Style="{StaticResource TagChipStyle}"
                                                    Margin="0,0,8,8" MaxWidth="200" ToolTip="{Binding}"
                                                    Command="{Binding DataContext.UseSearchHistoryCommand,
                                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <!-- 展开更多 / 收起。只在历史超过预览条数时出现。 -->
                                <Button x:Name="BtnToggleHistory" HorizontalAlignment="Center"
                                        Style="{StaticResource SubtleButtonStyle}" Padding="10,4"
                                        Visibility="{Binding CanExpandSearchHistory, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding ToggleHistoryExpandCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding HistoryExpandText}" FontSize="12"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                                        <TextBlock FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   FontSize="10" Margin="5,0,0,0" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                    <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
                                                    <!-- E70D = ChevronDown / E70E = ChevronUp -->
                                                    <Setter Property="Text" Value="&#xE70D;" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HistoryExpanded}" Value="True">
                                                            <Setter Property="Text" Value="&#xE70E;" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>