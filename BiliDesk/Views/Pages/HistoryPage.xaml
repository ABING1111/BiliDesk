<UserControl x:Class="BiliDesk.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        历史记录页: **版式、视觉与交互全部对齐首页**。

        2026-09-30 改版前的样子是"一条记录一行"(168×94 小封面 + 三行文字 + 播放按钮), 与首页的
        卡片墙完全是两套语言。现在:
          · 内容 = 与首页同一套卡片墙(ItemsControl + CardWallPanel + VideoCard),
            连"卡片随窗口宽度自己变宽变窄"也一并继承;
          · 标题 = 首页那套(PageTitleStyle + 左 36 上 20)。

        ★★ 2026-11-14 改版(用户要求): 吸顶胶囊 + 右下角浮动工具列。
          · 整页只有一个 ScrollViewer(PageScroll): 大标题「历史记录」跟着内容一起上滑滚走,
            「视频 / 直播间」胶囊滚到距顶端 8px 处钉住 —— 与设置页顶部 Tab 完全同一套效果,
            算法抽在 Helpers/StickyPin(占位块量自然位置 + TranslateTransform 反向抵消)。
            胶囊只有一个实例, 尺寸/字号/内边距全程不变, 没有整条吸顶栏/背景色块。
          · 原来横排在标题行右上角的操作(刷新 / 编辑 / 返回)与编辑态那排
            (全选 / 删除所选 / 清空全部 / 退出)全部搬到**右下角竖列**, 图标 + ToolTip。
            已选计数与批量进度做成工具列上方的小胶囊 —— 标题滚走之后也照样看得到。
          · 编辑态胶囊用 Hidden 而不是 Collapsed: 占位块的高度绑着它的 ActualHeight,
            Collapsed 会让占位塌成 0, 进出编辑时整墙上下跳一下。

        ★★ 2026-10-06: 搜索历史记录功能**整体移除**(用户要求)。
          起因是它每次过滤都要 view.Refresh() ⇒ 非虚拟化卡片墙**整墙重建**:
          实测 2000 条时一次清空冻结 UI 线程 24.7 秒、内存涨到 1.37GB(探针
          .probes/bd-probe-clearfilter, 反复 20 轮不单调上涨 ⇒ 不是泄漏, 是活着的卡片太重)。
          入口按钮、弹出面板、输入框、防抖、匹配谓词、空态提示一并删除,
          HistoryViewModel 上的 SearchKeyword / HasSearch / ShowNoMatch / SearchHintText
          / ClearSearch 也全部移除。列表只剩"加载更多"这一种增长方式。

        ★ 虚拟化的取舍: 原来那个 ListBox 是虚拟化的, 换成卡片墙之后就**没有虚拟化**了
          (WrapPanel 不实现 IScrollPosInfo, 挂上去等于关掉)。这是"与首页一致"的必然代价,
          首页也是同一套结构(靠 DeferredFill 分帧规避卡顿)。历史每次"加载更多"只追加一页,
          量级可控。
    -->
    <Grid>
        <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto"
                      ScrollChanged="OnScrollChanged">
            <Grid>
                <!-- ============ 正常内容流 ============ -->
                <StackPanel>
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <!-- 底部留白给右下角工具列让位: 普通态 3 颗按钮(≈146),
                                 编辑态 4 颗 + 计数胶囊(≈244) —— 滚到底时最后一行卡片要整行露出来。 -->
                            <Setter Property="Margin" Value="0,0,0,164" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Margin" Value="0,0,0,244" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <!-- ===== 标题 + 胶囊占位(随内容滚走) =====
                         胶囊本体在下面(滚动内容的最后一个子元素, 这样才能盖住卡片并吸顶)。 -->
                    <StackPanel Margin="36,20,36,0">
                        <Grid>
                            <!-- [ 普通模式 ] 标题 + 条数 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                                <TextBlock Text="历史记录" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}"
                                           VerticalAlignment="Bottom" Margin="6,0,0,6"
                                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
                            </StackPanel>

                            <!-- [ 编辑模式 ] 标题 + 已选计数 + 进度 -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="选择要删除的记录" Style="{StaticResource PageTitleStyle}" />
                                <TextBlock Text="{Binding SelectedText}"
                                           VerticalAlignment="Bottom" Margin="10,0,0,6"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                                <!-- 正在逐条删时把进度显示出来: 一次要发 N 个请求, 没有进度会像卡住了 -->
                                <TextBlock Text="{Binding BusyText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                                           FontSize="12" Foreground="{DynamicResource DangerTextBrush}"
                                           Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
                            </StackPanel>
                        </Grid>

                        <!-- 胶囊占位: 只撑高度, 不渲染; StickyPin 用它量"自然顶边"。
                             ★ 编辑态也保留(胶囊只是 Hidden), 进出编辑时内容不会上下跳。 -->
                        <Border x:Name="TabSlot" Margin="0,14,0,0" Visibility="Hidden"
                                Height="{Binding ActualHeight, ElementName=StickyTabBar}" />
                    </StackPanel>

                    <!-- ===== 卡片墙(与首页同构: ItemsControl + CardWallPanel + VideoCard) =====
                         ★ 滚轮手感与首页一致: 由全局 WheelScroll 统一接管(按设置距离 + 两级低通平滑),
                           不再逐处挂旧的 SmoothScroll。 -->
                    <StackPanel Margin="0,12,0,0">
                        <ItemsControl ItemsSource="{Binding Entries}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <behaviors:CardWallPanel behaviors:CardWall.Enable="True" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <!-- Selectable 在编辑模式下打开: 卡片左上角出现选中圆标, 点击变成勾选。
                                         卡片自身负责"点封面播放 / 点标题播放 / 点 UP 主进主页"。 -->
                                    <controls:VideoCard
                                        Selectable="{Binding DataContext.IsEditMode,
                                                     RelativeSource={RelativeSource AncestorType=UserControl}}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 底部状态(与首页同一套写法: 放在滚动流里, 不再浮在列表下沿) -->
                        <StackPanel Margin="0,12,0,0" HorizontalAlignment="Center">
                            <StackPanel Orientation="Horizontal"
                                        Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                                <controls:LoadingRing Width="18" Height="18" />
                                <TextBlock Text="加载中…" Margin="8,0,0,0"
                                           VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                            </StackPanel>
                            <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                       Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- ============ 吸顶类别胶囊: 视频 / 直播间 ============
                     ★ 只有一个实例, 必须是滚动内容的**最后一个子元素**(画在卡片之上);
                       滚动时由 StickyPin 反向平移抵消滚动量, 到距顶端 8px 处钉住。
                     ★ 白色椭圆底 + 投影, 与收藏页/设置页同一形态。
                     ★ GroupName 必须给: 同组 RadioButton 才有互斥。
                     ★ IsHitTestVisibleInChrome: 钉住后顶端进入窗口标题栏区(CaptionHeight=20),
                       不标的话那块区域里的点击会被 WindowChrome 当成"拖动窗口"吞掉。 -->
                <!-- ★ 底色用 FrostedPanelBrush(磨砂浮层): 胶囊吸顶后压在卡片封面上,
                     亚克力下半透明但把封面压住保证标签可读(太透糊字 / 全不透明死白都不行, 见 ThemeService)。 -->
                <Border x:Name="StickyTabBar" VerticalAlignment="Top" HorizontalAlignment="Left"
                        Margin="36,72,0,0"
                        Background="{DynamicResource FrostedPanelBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="22" Padding="5"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Border.RenderTransform>
                        <TranslateTransform x:Name="StickyTabShift" />
                    </Border.RenderTransform>
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08" />
                    </Border.Effect>
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <!-- 编辑态收起胶囊, 但**占位保留**(Hidden 仍参与排版) -->
                                <DataTrigger Binding="{Binding IsEditMode}" Value="True">
                                    <Setter Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="HistoryKind" Style="{StaticResource SettingsTabStyle}"
                                     Content="视频" IsChecked="{Binding IsVideoKind, Mode=TwoWay}" />
                        <RadioButton GroupName="HistoryKind" Style="{StaticResource SettingsTabStyle}"
                                     Content="直播间" Margin="2,0,0,0"
                                     IsChecked="{Binding IsLiveKind, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- 首次加载(页面级浮层, 不跟着滚) -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Panel.ZIndex="10"
                    Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
            <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
            <TextBlock Text="正在同步云端历史…" Style="{StaticResource MetaTextStyle}"
                       Margin="0,12,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <!-- 错误状态 -->
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Panel.ZIndex="10"
                    Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                       TextAlignment="Center" />
            <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                    Command="{Binding ReloadCommand}"
                    Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}" />
        </StackPanel>

        <!-- ============ 右下角浮动工具列(2026-11-14) ============
             用户要求"收藏 / 历史 / 稍后再看右上角的工具列全部改为右下角竖列显示"。
             ★ 按钮用 FloatingIconButtonStyle: 三种状态的底色都**不透明** —— 默认的
               IconButtonStyle 是 4% 黑, 浮在卡片封面上等于没有底, 图标会糊进图片里。
             ★ 外面不加任何底板/边框, 就是最朴素的"一列按钮"(投影在样式模板的 ShadowBd 层)。
             ★ Panel.ZIndex 浮在内容之上、不占独立列: 占列的话滚动条会被挤到按钮左边。
               右边留 16 正好避让开滚动条(8px 宽 + 6px 缩放带)。
             ★ 「删除所选 / 清空全部」用 DangerTextBrush; 全局隐式 TextBlock 样式带
               Foreground setter, 会吃掉继承色, 所以图标 TextBlock 上要**显式**写前景色。
             ★ ToolTipService.ShowOnDisabled: 批量操作进行中按钮是灰的, 但 ToolTip 仍要能读。 -->
        <StackPanel x:Name="ToolBar" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 已选计数 + 批量进度: 标题滚走之后, 这里是唯一常驻的反馈 -->
            <Border HorizontalAlignment="Right" Margin="0,0,0,8"
                    Background="{DynamicResource FlyoutBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                    CornerRadius="10" Padding="10,5"
                    Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="{Binding SelectedText}" FontSize="12" HorizontalAlignment="Right"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="{Binding BusyText}" FontSize="11" HorizontalAlignment="Right"
                               Margin="0,2,0,0" Foreground="{DynamicResource DangerTextBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="180"
                               Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
                </StackPanel>
            </Border>

            <!-- [ 普通模式 ] 刷新 / 编辑 / 返回「我的」 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding ReloadCommand}" ToolTip="重新同步云端历史（F5）">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="编辑：批量删除观看记录">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <!-- 返回「我的」页: 历史/收藏/缓存的入口都在「我的」页, 统一给一条回去的路 -->
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Click="OnBackToMineClick" ToolTip="返回「我的」">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>

            <!-- [ 编辑模式 ] 全选 / 删除所选 / 清空全部 / 退出编辑 -->
            <StackPanel Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource FloatingIconButtonStyle}"
                        Command="{Binding SelectAllCommand}" ToolTipService.ShowOnDisabled="True">
                    <Button.ToolTip>
                        <MultiBinding StringFormat="{}{0}（{1}）">
                            <Binding Path="SelectAllText" />
                            <Binding Path="SelectedText" />
                        </MultiBinding>
                    </Button.ToolTip>
                    <TextBlock Text="&#xE8B3;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="删除所选" ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE74D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ClearAllCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="清空全部：删除账号下全部观看记录(不只是当前已加载的)"
                        ToolTipService.ShowOnDisabled="True">
                    <TextBlock Text="&#xE75A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                               Foreground="{DynamicResource DangerTextBrush}" />
                </Button>
                <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="退出编辑">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>