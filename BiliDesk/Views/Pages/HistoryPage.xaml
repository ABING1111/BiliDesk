<UserControl x:Class="BiliDesk.Views.Pages.HistoryPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        历史记录页(2026-09-30 改版): **版式、视觉与交互全部对齐首页**。

        改版前的样子是"一条记录一行"(168×94 小封面 + 三行文字 + 播放按钮), 与首页的卡片墙
        完全是两套语言。现在:
          · 内容 = 与首页同一套卡片墙(ItemsControl + WrapPanel + CardWall + VideoCard),
            连"卡片随窗口宽度自己变宽变窄"也一并继承;
          · 标题行 = 首页那套(PageTitleStyle + Margin 36,20,36,0);
          · 操作 = 标题行**右上角**(搜索 / 刷新 / 编辑 / 返回「我的」), 与收藏页、稍后再看页
            同一套写法(IconButtonStyle + VerticalAlignment="Bottom")。

        ★ 2026-10-06 再改一次: 搜索框从右下角浮动工具列**搬回右上角**, 工具列整个撤掉。
          起因是右下角那套是"浮在内容上"的, 搜索面板从那儿往左弹出, 会盖住卡片墙一角;
          而右上角与其它页面位置一致, 且不遮挡内容。
          行为一个没少: 实时过滤、Esc 清空并收面板、清空按钮、无匹配空状态、
          过滤生效时按钮变强调色(不然关掉面板后就看不出列表是被筛过的)。

        ★ 虚拟化的取舍: 原来那个 ListBox 是虚拟化的, 换成 WrapPanel 之后就**没有虚拟化**了
          (WrapPanel 不实现 IScrollPosInfo, 挂上去等于关掉)。这是"与首页一致"的必然代价,
          首页也是同一套结构(靠 DeferredFill 分帧规避卡顿)。历史每次"加载更多"只追加一页,
          量级可控。
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ===== 标题行(与首页同一套外边距/字号) =====
             ★ MinHeight 从 62 提到 96(2026-10-03): 这一格里现在有两行 —— 大标题(约 40px)
               和它下面的类别标签(约 34px)。62 装不下, 标签会叠到标题上。 -->
        <Grid Grid.Row="0" Margin="36,20,36,0" MinHeight="96">
            <!-- [ 普通模式 ] 标题 + 条数 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <TextBlock Text="历史记录" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding TotalCount, StringFormat=' ({0})'}"
                           VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>

            <!-- ===== 类别标签: 视频 / 直播间 =====
                 ★ 外层 Border = 白色椭圆底(与收藏页/设置页同一形态, 2026-10-03 用户要求统一),
                   投影让它从页面背景上浮起来。
                 ★ 放在标题**正下方**而不是标题右边: 标题是 28 号大字, 把标签贴着它排会显得很挤,
                   而且窗口窄时还会被条数挤下去。下面另起一行最稳。
                 ★ GroupName 必须给: 同组 RadioButton 才有互斥。 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                        CornerRadius="22" Padding="5" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="14" ShadowDepth="1" Opacity="0.08" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="HistoryKind" Style="{StaticResource SettingsTabStyle}"
                                     Content="视频" IsChecked="{Binding IsVideoKind, Mode=TwoWay}" />
                        <RadioButton GroupName="HistoryKind" Style="{StaticResource SettingsTabStyle}"
                                     Content="直播间" Margin="2,0,0,0"
                                     IsChecked="{Binding IsLiveKind, Mode=TwoWay}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- [ 编辑模式 ] 标题 + 已选计数 + 进度 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="选择要删除的记录" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Text="{Binding SelectedText}"
                           VerticalAlignment="Bottom" Margin="10,0,0,6"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                <!-- 正在逐条删时把进度显示出来: 一次要发 N 个请求, 没有进度会像卡住了 -->
                <TextBlock Text="{Binding BusyText}" VerticalAlignment="Bottom" Margin="10,0,0,6"
                           FontSize="12" Foreground="{DynamicResource DangerTextBrush}"
                           Visibility="{Binding BusyText, Converter={StaticResource StrToVis}}" />
            </StackPanel>

            <!-- [ 普通模式 ] 右上角操作: 搜索 / 刷新 / 编辑 / 返回「我的」。
                 ★ 2026-10-06 从右下角浮动工具列搬到这里(与收藏页、稍后再看页同一套写法):
                   IconButtonStyle + VerticalAlignment="Bottom", 位置和其余页面一致。
                   放右上角的另一个好处是**不遮挡内容** —— 右下角那套是浮在卡片墙上的。 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsEditMode, Converter={StaticResource InvBoolToVis}}">

                <!-- 搜索: 本页搜索的**唯一入口**。点开在按钮下方弹出面板, 输入框在面板里
                     —— 见下面的 SearchPopup。有过滤条件时按钮变强调色,
                     否则收起面板后就看不出列表是被筛过的。 -->
                <Button x:Name="BtnSearch" Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                        Click="OnSearchClick" ToolTip="搜索历史记录">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>

                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding ReloadCommand}" ToolTip="重新同步云端历史">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="0,0,8,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="批量删除观看记录">
                    <TextBlock Text="&#xE70F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <!-- 返回「我的」页: 历史/收藏/缓存的入口都在「我的」页, 统一给一条回去的路 -->
                <Button Style="{StaticResource IconButtonStyle}"
                        Click="OnBackToMineClick" ToolTip="返回「我的」">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>

                <!-- 搜索面板: 弹在搜索按钮**下方**(与右上角这个位置匹配;
                     StaysOpen=False 点到别处就收起, 但关键词**保留**, 列表继续按它过滤)。 -->
                <Popup x:Name="SearchPopup" PlacementTarget="{Binding ElementName=BtnSearch}"
                       Placement="Bottom" HorizontalOffset="-8" VerticalOffset="6"
                       StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Background="{DynamicResource FlyoutBackgroundBrush}" CornerRadius="10"
                            BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                            Padding="14" Width="300">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.3"
                                              Direction="270" Color="#000000" />
                        </Border.Effect>
                        <StackPanel>
                            <TextBlock Text="搜索历史记录" FontSize="14" FontWeight="SemiBold" />

                            <!-- 输入框: 与原来右上角那个**同一套样式与内边距**(Height 44 是
                                 SearchTextBoxStyle 自带的高度, 这里必须跟着写 44 否则会溢出/压扁)。

                                 ★ 这里**不再套**原来那层"灰底圆角矩形"Border(2026-10-01 用户要求去掉
                                   "粉色描边外的灰色小矩形边框"): SearchTextBoxStyle 是**胶囊形**
                                   (CornerRadius 22), 而外层灰底框是 10 —— 两个圆角对不齐, 灰底的四个角
                                   会从粉色描边**外面**露出来(探针像素实测: 框左上角内 3px 处是 #F4F4F4,
                                   而框内是 #FCFCFC), 看着就像描边外还套着一个灰色圆角矩形。
                                   直接不要那层, 输入框就只剩自己这一层 —— 描边(聚焦时变粉)即最外轮廓。 -->
                            <Grid Margin="0,12,0,0" Height="44">
                                <TextBox x:Name="HistorySearchBox" Style="{StaticResource SearchTextBoxStyle}"
                                         Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="OnSearchKeyDown" />
                                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center" Margin="16,0,0,0" IsHitTestVisible="False" />
                                <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                        FontSize="13" Style="{StaticResource IconButtonStyle}"
                                        Width="24" Height="24" HorizontalAlignment="Right"
                                        VerticalAlignment="Center" Margin="0,0,8,0"
                                        Foreground="{DynamicResource TextSecondaryBrush}"
                                        Visibility="{Binding SearchKeyword, Converter={StaticResource StrToVis}}"
                                        Click="OnClearSearchClick" ToolTip="清空搜索" />
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <TextBlock Text="{Binding SearchHintText}" FontSize="11" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" MaxWidth="185"
                                           HorizontalAlignment="Left"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <Button Content="完成" Style="{StaticResource SubtleButtonStyle}"
                                        HorizontalAlignment="Right" Padding="12,4" FontSize="12"
                                        Click="OnCloseSearchClick" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>

            <!-- [ 编辑模式 ] 全选 / 删除所选 / 清空全部 / 退出。 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                <Button Content="{Binding SelectAllText}" Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,6" FontSize="13"
                        Command="{Binding SelectAllCommand}" />
                <Button Content="删除所选" Style="{StaticResource DangerButtonStyle}"
                        Padding="14,7" FontSize="13" Margin="8,0,0,0"
                        Command="{Binding DeleteSelectedCommand}"
                        IsEnabled="{Binding CanOperate}" />
                <Button Content="清空全部" Style="{StaticResource SubtleButtonStyle}"
                        Padding="12,7" FontSize="13" Margin="8,0,0,0"
                        Foreground="{DynamicResource DangerTextBrush}"
                        Command="{Binding ClearAllCommand}"
                        IsEnabled="{Binding CanOperate}"
                        ToolTip="删除账号下全部观看记录(不只是当前已加载的)" />
                <Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding ToggleEditCommand}" ToolTip="退出编辑">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- ===== 内容 ===== -->
        <Grid Grid.Row="1" Margin="0,12,0,0">
            <!-- 首次加载 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="正在同步云端历史…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 错误状态 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource TextSecondaryBrush}"
                           FontSize="13" HorizontalAlignment="Center" TextWrapping="Wrap"
                           TextAlignment="Center" />
                <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                        Command="{Binding ReloadCommand}"
                        Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}" />            </StackPanel>

            <!-- 搜索没有匹配项。和上面对"云端本来就没记录"(Error)区分开:
                 一个该提示"换个词试试", 另一个该提示"登录/同步"。 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="30" Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="没有匹配的记录" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
                <TextBlock Text="只会搜索已加载的记录, 可以下拉加载更多再试"
                           Style="{StaticResource MetaTextStyle}" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 卡片墙(与首页同构: ScrollViewer → StackPanel → ItemsControl + WrapPanel + CardWall)
                 ★ 滚轮手感与首页一致(2026-10-02 用户要求): 之前这里挂了 SmoothScroll(270px/160ms 的
                   缓动滚轮), 历史页手感与首页**不一致** —— 首页是引擎原生滚轮(一格一格、即停),
                   历史页却是缓动+连滚加速。现在删掉, 历史页滚轮回到引擎默认, 与首页完全同款。 -->
            <ScrollViewer x:Name="ListScroll" VerticalScrollBarVisibility="Auto"
                          Margin="0,0,0,0"
                          ScrollChanged="OnScrollChanged">
                <!-- 底部 250px = 右下角浮动工具列的高度, 留在滚动内容之外, 滚到底时最后一行能整行露出来 -->
                <StackPanel Margin="0,0,0,250">
                    <ItemsControl ItemsSource="{Binding Entries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <behaviors:CardWallPanel behaviors:CardWall.Enable="True" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- Selectable 在编辑模式下打开: 卡片左上角出现选中圆标, 点击变成勾选。
                                     卡片自身负责"点封面播放 / 点标题播放 / 点 UP 主进主页"。 -->
                                <controls:VideoCard
                                    Selectable="{Binding DataContext.IsEditMode,
                                                 RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 底部状态(与首页同一套写法: 放在滚动流里, 不再浮在列表下沿) -->
                    <StackPanel Margin="0,12,0,28" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                            <controls:LoadingRing Width="18" Height="18" />
                            <TextBlock Text="加载中…" Margin="8,0,0,0"
                                       VerticalAlignment="Center" Style="{StaticResource MetaTextStyle}" />
                        </StackPanel>
                        <TextBlock Text="已经到底啦" Style="{StaticResource MetaTextStyle}"
                                   Visibility="{Binding HasMore, Converter={StaticResource InvBoolToVis}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
