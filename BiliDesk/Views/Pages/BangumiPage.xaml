<UserControl x:Class="BiliDesk.Views.Pages.BangumiPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <!--
        番剧详情 + 选集页。

        版式: 顶部一条横向"海报 + 标题/评分/简介", 下面是**选集墙**(按集号网格排布,
        而不是竖排长列表 —— 一季动辄上百集, 竖着排要点很久才够到第 80 话)。
        这一页由追番页点卡片进来, 由 NavigationDispatcher 内嵌在主窗口内容区里
        (与 UP 主主页同一套路), 所以自己**不带**返回按钮 —— 那是 MainWindow 的内嵌层负责的。
    -->
    <UserControl.Resources>
        <!-- 选集按钮。
             ★★★ **普通态 / 当前集是两个 Setter 集合, 不是两个 Style** ——
               2026-10-11 踩过: 原来写成
                 <Style TargetType="Button" BasedOn="{StaticResource EpisodeButtonStyle}">
                   <Style.Triggers>
                     <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                       <Setter Property="Style" Value="{StaticResource EpisodeCurrentStyle}" />
               WPF **明确禁止** Style 的 Setter 去改被应用对象的 Style 属性,
               抛 `System.ArgumentException: 不允许 Style 对象影响它所应用于的对象的 Style 属性`
               (栈顶是 `Setter.Seal()`)。
               ★ 它**不是在 InitializeComponent 时炸** —— Setter 是**延迟 Seal** 的, 真正抛在
                 按钮被 ItemsControl 真正生成容器、走布局那一刻。所以"页面能 new 出来、
                 探针也过了"都证明不了它没事: 一季 307 集 = 307 个按钮 = 307 次抛异常 =
                 307 个错误弹窗, 最后把内存耗尽("无法创建新的堆栈防护页面")。
               ⇒ 正确做法: 两种外观写在**同一个 Style 的触发器里**, 只切属性值。

             ★ 触发器的**声明顺序就是优先级**(= 优先级规则里"后声明的同类触发器胜出"),
               所以把 IsCurrent 放在 IsMouseOver **之后**:
               悬停非当前集 → 悬停态; 悬停当前集 → 保持当前态(不闪回浅灰)。
               反过来写的话, 鼠标扫过当前集会让它"掉色", 一眼看去像高亮丢了。 -->
        <Style x:Key="EpisodeButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource ControlFillDefaultBrush}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Height" Value="42" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Bd 的底色必须 TemplateBinding 按钮自己的 Background:
                             触发器改的是 Button.Background, 不这样接的话底色永远不跟着变。 -->
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <!-- ★ Foreground 不在 ContentPresenter 上写死: 它靠继承从按钮拿,
                                 触发器改 Button.Foreground 时文字才会跟着变色
                                 (项目笔记里那条"隐式样式 Foreground 吃掉继承色"的反面)。 -->
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <!-- ① 悬停(普通态): 底色加深 + 文字泛强调色 -->
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </Trigger>
                <!-- ② 当前集: 强调色实底 + 白字 + 半粗。**放在悬停之后**, 优先级更高。 -->
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 加载中 -->
        <StackPanel Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
            <controls:LoadingRing HorizontalAlignment="Center" />
            <TextBlock Text="正在获取选集…" Style="{StaticResource MetaTextStyle}"
                       Margin="0,10,0,0" HorizontalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.RowSpan="2" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding Loading, Converter={StaticResource InvBoolToVis}}">
            <StackPanel Margin="36,28,36,60">

                <!-- ===== 顶部: 海报 + 标题 / 评分 / 简介 ===== -->
                <Grid Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="180" Height="240" CornerRadius="10"
                            ClipToBounds="True" Background="{DynamicResource PlaceholderBrush}">
                        <Border CornerRadius="10" behaviors:Cover.Source="{Binding Cover}" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                        <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap" MaxHeight="64"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,8,0,0"
                                   TextWrapping="Wrap" MaxHeight="36"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Subtitle, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding MetaLine}" FontSize="12" Margin="0,6,0,0"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Visibility="{Binding MetaLine, Converter={StaticResource StrToVis}}" />

                        <TextBlock Text="{Binding Evaluate}" FontSize="12" Margin="0,14,0,0"
                                   TextWrapping="Wrap" MaxHeight="84"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Visibility="{Binding Evaluate, Converter={StaticResource StrToVis}}" />
                    </StackPanel>

                    <Button Grid.Column="2" Content="播放最新一集" Style="{StaticResource AccentButtonStyle}"
                            Padding="16,8" VerticalAlignment="Top"
                            Click="OnPlayLatestClick"
                            Visibility="{Binding HasCurrent, Converter={StaticResource BoolToVis}}" />
                </Grid>

                <!-- ===== 错误 ===== -->
                <Border Margin="0,20,0,0" Padding="14,10" CornerRadius="8"
                        Background="{DynamicResource InfoBarBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" Foreground="{DynamicResource AccentTextBrush}"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Error}" Margin="10,0,0,0"
                                   VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Button Content="重试" Style="{StaticResource SubtleButtonStyle}"
                                Margin="16,0,0,0" Padding="10,4" Click="OnRetryClick" />
                    </StackPanel>
                </Border>

                <!-- ===== 选集 ===== -->
                <TextBlock Text="{Binding EpCountText}" Style="{StaticResource SectionTitleStyle}"
                           Margin="0,32,0,14"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />

                <ItemsControl x:Name="EpisodeList" ItemsSource="{Binding Episodes}"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <!-- WrapPanel: 集号短, 按可用宽度自然折行。
                                 左右不额外加边距 —— 每个按钮自带 Margin="0,0,10,10"。 -->
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding DisplayTitle}" Command="{Binding DataContext.PlayEpisodeCommand,
                                           RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}"
                                    Style="{StaticResource EpisodeButtonStyle}"
                                    ToolTip="{Binding DisplayTitle, Mode=OneWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 一集都没有: 多半是这季还没上正片, 说清楚而不是留一片空白 -->
                <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding NoEpisodes, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="这部番暂时还没有可播放的选集"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource TextTertiaryBrush}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>