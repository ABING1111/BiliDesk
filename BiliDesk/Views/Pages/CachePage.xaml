<UserControl x:Class="BiliDesk.Views.Pages.CachePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 返回 + 标题 + 摘要。
             这一页不在左侧导航栏上(入口在「我的」页), 所以必须自带一个明确的返回入口;
             2026-11-27 起返回/刷新/打开文件夹都收进**右下角浮动工具列**, 头部只留标题。
             (操作按钮搬走后头部不再需要为躲开窗口按钮而撑到 62 高, 收到 40。) -->
        <Grid Grid.Row="0" Margin="36,20,36,0" MinHeight="40">
            <!-- VerticalAlignment="Top" 不能省(和消息页同一个坑): 这一行被 MinHeight 撑高,
                 若让它拉伸, 标题与后面那句"摘要"小字(VerticalAlignment=Bottom)会被拉开 30 多像素。 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <!-- 旧的左上角"返回首页"按钮已删(2026-09-26): 返回入口统一收在右下角工具列 -->
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="离线缓存" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>
        </Grid>

        <!-- 目录路径提示: 明确"离线缓存"就是下载目录里的这些文件, 不做第二份私有缓存 -->
        <TextBlock Grid.Row="1" Margin="36,8,36,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="{Binding CacheDirectory, StringFormat=缓存位置: {0}}" />

        <!-- 内容 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="正在扫描缓存…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 空状态 / 错误 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <!-- 列表 -->
            <!-- ★ 横向边距挂在**内容**上而不是 ScrollViewer 上(2026-11-19):
                 挂在 ScrollViewer 上会把滚动条一起往里推(这里是 36px), 于是各页滚动条
                 有的贴窗口右缘、有的内缩 —— 就是用户报的"长度不一"。
                 按全应用约定: 滚动条贴滚动区右缘, 留白一律交给内容。 -->
            <ScrollViewer x:Name="PageScroll" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0"
                          ScrollChanged="OnScrollChanged"
                          Visibility="{Binding Error, Converter={StaticResource InvStrToVis}}">
                <StackPanel Margin="36,0,36,220">
                    <!-- 空状态: 没有任何缓存文件时才显示 -->
                    <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="还没有离线缓存" Margin="0,14,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="在任意视频卡片上点右键 → 「下载视频到本地」, 下完就能在这里离线播放"
                                   Margin="0,8,0,0" FontSize="12" MaxWidth="420" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                        Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftFillBrush}">
                                            <TextBlock Text="&#xE768;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SizeText}"
                                                           Style="{StaticResource MetaTextStyle}" />
                                                <TextBlock Text=" · " Style="{StaticResource MetaTextStyle}"
                                                           Margin="4,0" />
                                                <TextBlock Text="{Binding TimeText}"
                                                           Style="{StaticResource MetaTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="在应用内播放"
                                                    Click="OnPlayClick" Width="34" Height="34">
                                                <TextBlock Text="&#xE768;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="打开所在位置"
                                                    Click="OnRevealClick" Margin="6,0,0,0" Width="34" Height="34">
                                                <!-- 沿用本工程里既有的"打开"图标码位, 避免用到没验证过的字形 -->
                                                <TextBlock Text="&#xE8A7;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="删除这个文件"
                                                    Click="OnDeleteClick" Margin="6,0,0,0" Width="34" Height="34">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- ============ 右下角浮动工具列(2026-11-27) ============
             用户要求"订阅和下载界面右上角的按钮做进右下角的工具列"。
             与历史/收藏/稍后再看/首页同一套: FloatingIconButtonStyle 三种状态都不透明,
             浮在列表上不会糊进底色; 外面不加底板, 投影在样式模板里。
             ★ Panel.ZIndex 浮在内容之上、不占独立列 —— 占列会把滚动条挤到按钮左边。
               右边留 16 正好避让滚动条; 列表底部留了 220px(播放页入口也亮着时 4 颗按钮
               约占 214px), 最后一行不会被压住。 -->
        <StackPanel x:Name="ToolBar" Grid.Row="0" Grid.RowSpan="3" Panel.ZIndex="20"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,20">

            <!-- 播放页快捷入口: 放在最上面, 出现/收起不会推动下面按钮 -->
            <controls:PlayerFab Margin="0,0,0,6" />

            <!-- 顶部 = 刷新 / 下滑 = 回到顶部(见 OnTopRefreshClick) -->
            <controls:TopRefreshButton x:Name="BtnTopRefresh" Click="OnTopRefreshClick" />

            <!-- 打开下载目录(原右上角的"打开文件夹") -->
            <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Command="{Binding OpenFolderCommand}" ToolTip="打开文件夹">
                <Path Data="{StaticResource FolderIconGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="18" Height="18" Stretch="Uniform" />
            </Button>

            <!-- 返回「我的」页: 历史/收藏/缓存的入口都在「我的」页, 统一给一条回去的路 -->
            <Button Style="{StaticResource FloatingIconButtonStyle}" Margin="0,6,0,0"
                    Click="OnBackToMineClick" ToolTip="返回「我的」">
                <Path Data="{StaticResource BackIconGeometry}"
                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                      StrokeThickness="1.6" StrokeLineJoin="Round"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                      Width="18" Height="18" Stretch="Uniform" />
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
