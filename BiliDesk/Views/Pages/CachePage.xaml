<UserControl x:Class="BiliDesk.Views.Pages.CachePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="{DynamicResource AppBackgroundBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 返回 + 标题 + 操作。
             这一页不在左侧导航栏上(入口在首页右上角工具列), 所以必须自带一个明确的返回入口。 -->
        <!--
                    右上角的窗口按钮(最小化/最大化/关闭)浮在内容区之上、占 y=4~36。
                    头部因此撑到 62 高: 标题贴顶(和左侧 logo 同一水平线), 右侧操作按钮
                    贴底 —— 它们的顶边落在 44, 正好让开窗口按钮, 谁也不压谁。
                -->
        <Grid Grid.Row="0" Margin="36,20,36,0" MinHeight="62">
            <!-- VerticalAlignment="Top" 不能省(和消息页同一个坑): 这一行被 MinHeight=62 撑高,
                 若让它拉伸, 标题与后面那句"摘要"小字(VerticalAlignment=Bottom)会被拉开 30 多像素。 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
                <!-- 旧的左上角"返回首页"按钮已删(2026-09-26): 返回入口统一收在右上角刷新左边 -->
                <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentTextBrush}" />
                <TextBlock Text="离线缓存" Style="{StaticResource PageTitleStyle}" Margin="10,0,0,0" />
                <TextBlock Text="{Binding Summary}" VerticalAlignment="Bottom" Margin="6,0,0,6"
                           Foreground="{DynamicResource TextTertiaryBrush}" FontSize="14" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <Button Content="打开文件夹" Style="{StaticResource SubtleButtonStyle}"
                        Command="{Binding OpenFolderCommand}" Padding="14,6" FontSize="12" />
                <!-- 返回「我的」页(2026-09-26): 历史/收藏/缓存的入口都在「我的」页, 统一给一条回去的路 -->
                <Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        Click="OnBackToMineClick" ToolTip="返回「我的」">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
                <Button Style="{StaticResource IconButtonStyle}" Margin="8,0,0,0"
                        Command="{Binding RefreshCommand}" ToolTip="刷新">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- 目录路径提示: 明确"离线缓存"就是下载目录里的这些文件, 不做第二份私有缓存 -->
        <TextBlock Grid.Row="1" Margin="36,8,36,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="{Binding CacheDirectory, StringFormat=缓存位置: {0}}" />

        <!-- 内容 -->
        <Grid Grid.Row="2" Margin="0,14,0,0">

            <!-- 加载中 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="{Binding Loading, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="30" Height="30" HorizontalAlignment="Center" />
                <TextBlock Text="正在扫描缓存…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,12,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- 空状态 / 错误 -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460"
                        Visibility="{Binding Error, Converter={StaticResource StrToVis}}">
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" />
                <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                        HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                        Command="{Binding RefreshCommand}" />
            </StackPanel>

            <!-- 列表 -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="36,4,36,24"
                          Visibility="{Binding Error, Converter={StaticResource InvStrToVis}}">
                <StackPanel>
                    <!-- 空状态: 没有任何缓存文件时才显示 -->
                    <StackPanel Margin="0,40,0,0" HorizontalAlignment="Center"
                                Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="44" Foreground="{DynamicResource TextTertiaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="还没有离线缓存" Margin="0,14,0,0" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" />
                        <TextBlock Text="在任意视频卡片上点右键 → 「下载视频到本地」, 下完就能在这里离线播放"
                                   Margin="0,8,0,0" FontSize="12" MaxWidth="420" TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                        CornerRadius="10" Padding="12,10" Margin="0,0,0,10"
                                        Cursor="Hand" MouseLeftButtonUp="OnRowClick">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Border Grid.Column="0" Width="38" Height="38" CornerRadius="10"
                                                Background="{DynamicResource AccentSoftFillBrush}">
                                            <TextBlock Text="&#xE768;"
                                                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="16"
                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <TextBlock Text="{Binding SizeText}"
                                                           Style="{StaticResource MetaTextStyle}" />
                                                <TextBlock Text=" · " Style="{StaticResource MetaTextStyle}"
                                                           Margin="4,0" />
                                                <TextBlock Text="{Binding TimeText}"
                                                           Style="{StaticResource MetaTextStyle}" />
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="在应用内播放"
                                                    Click="OnPlayClick" Width="34" Height="34">
                                                <TextBlock Text="&#xE768;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="打开所在位置"
                                                    Click="OnRevealClick" Margin="6,0,0,0" Width="34" Height="34">
                                                <!-- 沿用本工程里既有的"打开"图标码位, 避免用到没验证过的字形 -->
                                                <TextBlock Text="&#xE8A7;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonStyle}" ToolTip="删除这个文件"
                                                    Click="OnDeleteClick" Margin="6,0,0,0" Width="34" Height="34">
                                                <TextBlock Text="&#xE74D;"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="14" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
