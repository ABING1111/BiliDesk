<views:FluentWindow x:Class="BiliDesk.Views.Windows.FavFolderCreateWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiliDesk.Views"
                    Title="新建收藏夹" Width="400" SizeToContent="Height"
                    ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <views:FluentWindow.Resources>
        <!--
            单行输入框(2026-11-19)。

            ★ 不能直接用 FluentTextBoxStyle: 那个样式是给**多行**框设计的 ——
              它的模板把内边距挂在 ScrollViewer 的 Margin 上, 且没有 VerticalAlignment,
              文本内容默认靠上。多行框靠"高度自适应"看着没问题, 但这里需要定高的单行框,
              一旦设 Height=38, 上下内边距把可用高度吃光, 正文被裁得只剩一条缝
              (用户实测: "输入框文字不可见")。
            ★ 这里用 WPF 的标准写法: Padding 挂在 Border 上(只生效一份),
              ScrollViewer 垂直居中。定高 38 时正文自然落在中间。
            颜色/圆角/聚焦与全局 FluentTextBoxStyle 保持一致, 观感不会跳。
        -->
        <Style x:Key="FavFolderNameBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </views:FluentWindow.Resources>

    <!--
        新建收藏夹(2026-11-19)。

        ★ 这个窗口**只收集输入**, 不发请求: 三个入口(收藏页 / 播放器收藏勾选窗 / 「我的」页)
          共用 Helpers/FavFolderActions.CreateAsync —— 弹窗 → 校验 → 调接口 → Toast 全在那里,
          窗口里再写一遍请求就会出现三套错误文案与三种失败表现。
        ★ 名称是唯一必填项; 隐私开关默认公开(与 B 站网页端一致)。
        ★ Enter 提交 / Esc 取消由 IsDefault / IsCancel 负责; 名称不合法时按钮直接禁用,
          不让用户点出一个"看起来能点、点了没反应"的按钮。
    -->
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <StackPanel Margin="24,20,24,20">
            <TextBlock Text="新建收藏夹" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock Text="收藏夹会保存到你的 B 站账号，换设备也能看到。"
                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextTertiaryBrush}" />

            <TextBox x:Name="NameBox" Style="{StaticResource FavFolderNameBoxStyle}"
                     Margin="0,16,0,0" Height="38" MaxLength="20"
                     TextChanged="OnNameChanged" />

            <Grid Margin="0,6,0,0">
                <TextBlock x:Name="HintText" FontSize="11" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="给收藏夹起个名字" />
                <TextBlock x:Name="CountText" FontSize="11" HorizontalAlignment="Right"
                           Foreground="{DynamicResource TextTertiaryBrush}" Text="0/20" />
            </Grid>

            <CheckBox x:Name="PrivateCheck" Style="{StaticResource LabeledCheckBoxStyle}"
                      Content="私密（仅自己可见）" Margin="0,14,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button Content="取消" Style="{StaticResource SubtleButtonStyle}"
                        Padding="18,8" Click="OnCancelClick" IsCancel="True" />
                <Button x:Name="BtnOk" Content="创建" Style="{StaticResource AccentButtonStyle}"
                        Margin="10,0,0,0" Padding="18,8" Click="OnOkClick" IsDefault="True"
                        IsEnabled="False" />
            </StackPanel>
        </StackPanel>
    </Grid>
</views:FluentWindow>
