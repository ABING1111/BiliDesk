<views:FluentWindow x:Class="BiliDesk.Views.LoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliDesk.Views"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Title="登录 - BiliDesk" Width="430" Height="580"
             ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部品牌区 -->
        <StackPanel Grid.Row="0" Margin="30,26,30,18">
            <Border Width="46" Height="46" CornerRadius="13" HorizontalAlignment="Left">
                <Border.Background>
                    <!-- 品牌粉渐变。★ 这里的粉**不跟主题色走**: 这是 B 站品牌标识(B 字 logo),
                         不是"强调色"。产品标识换了色就不再是那个品牌了 —— 和 UP 标/等级徽章同理。
                         (原来是蓝色, 会显得像另一个产品, 所以固定成品牌粉。) -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FB7299" Offset="0" />
                        <GradientStop Color="#FC9DB6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="登录哔哩哔哩" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0" />
            <TextBlock Text="使用哔哩哔哩手机 App 扫码登录, 登录后即可观看高清视频"
                       Style="{StaticResource MetaTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 登录页(官方页面, 扫码 / 短信均可) -->
        <Grid Grid.Row="1" Margin="24,0">
            <Border CornerRadius="12" Background="White"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <wv2:WebView2 x:Name="Wv" />
            </Border>
            <!-- 加载失败提示 -->
            <Border x:Name="ErrorPanel" CornerRadius="12"
                    Background="{DynamicResource InfoBarBackgroundBrush}"
                    BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                    Padding="20" Visibility="Collapsed">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="30" Foreground="{DynamicResource TextTertiaryBrush}"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ErrorText" Text="登录页面加载失败" Margin="0,12,0,0"
                               HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Margin="0,16,0,0"
                            Padding="24,7" Click="OnRetry" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="2" Text="登录状态仅保存在本机, 用于访问哔哩哔哩, 请勿外借账号"
                   Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Center"
                   Margin="20,12,20,18" TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</views:FluentWindow>