<views:FluentWindow x:Class="BiliDesk.Views.LoginWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliDesk.Views"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Title="登录 - BiliDesk" Width="380" Height="540"
             ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 顶部品牌区 -->
        <StackPanel Grid.Row="0" Margin="30,26,30,14">
            <Border Width="46" Height="46" CornerRadius="13" HorizontalAlignment="Left">
                <Border.Background>
                    <!-- 品牌粉渐变。★ 这里的粉**不跟主题色走**: 这是 B 站品牌标识(B 字 logo),
                         不是"强调色"。产品标识换了色就不再是那个品牌了 —— 和 UP 标/等级徽章同理。
                         (原来是蓝色, 会显得像另一个产品, 所以固定成品牌粉。) -->
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FB7299" Offset="0" />
                        <GradientStop Color="#FC9DB6" Offset="1" />
                    </LinearGradientBrush>
                </Border.Background>
                <TextBlock Text="B" Foreground="White" FontWeight="Bold" FontSize="22"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="登录哔哩哔哩" FontSize="19" FontWeight="SemiBold" Margin="0,14,0,0" />
            <TextBlock Text="使用哔哩哔哩手机 App 扫码登录, 登录后即可观看高清视频"
                       Style="{StaticResource MetaTextStyle}" Margin="0,6,0,0" TextWrapping="Wrap" />
        </StackPanel>

        <!-- 二维码区: 原生渲染, 不再加载整页登录网页。
             白底是给扫码器看的对比度, 不跟主题。
             尺寸: 实测登录码是 v8(49 模块 + 8 静区), GetGraphic(4) 出 228px 自然宽,
             白卡 248 = 四周各留 10px, 图像按原尺寸显示避免缩放糊码。 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="24,0">
            <Border Width="248" Height="248" CornerRadius="12" Background="White"
                    HorizontalAlignment="Center">
                <Grid>
                    <controls:LoadingRing x:Name="Loading" Width="28" Height="28" />
                    <Image x:Name="QrImage" Stretch="None"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           RenderOptions.BitmapScalingMode="NearestNeighbor" Visibility="Collapsed" />
                    <!-- 过期/失败覆盖层: 盖住旧码, 给"重新获取"入口 -->
                    <Border x:Name="QrMask" CornerRadius="12" Background="#E6FFFFFF" Visibility="Collapsed">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock x:Name="MaskText" Text="二维码已失效" FontSize="14"
                                       Foreground="#FF5F5F5F" HorizontalAlignment="Center" />
                            <Button x:Name="MaskButton" Content="重新获取" Style="{StaticResource AccentButtonStyle}"
                                    HorizontalAlignment="Center" Margin="0,14,0,0"
                                    Padding="22,6" Click="OnRetry" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock x:Name="StatusText" Text="正在获取二维码…" FontSize="13"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       HorizontalAlignment="Center" Margin="0,16,0,0" />
        </StackPanel>

        <!-- 底部说明 -->
        <TextBlock Grid.Row="2" Text="登录状态仅保存在本机, 用于访问哔哩哔哩, 请勿外借账号"
                   Style="{StaticResource MetaTextStyle}" HorizontalAlignment="Center"
                   Margin="20,12,20,18" TextWrapping="Wrap" TextAlignment="Center" />
    </Grid>
</views:FluentWindow>
