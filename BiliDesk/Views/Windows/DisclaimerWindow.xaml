<views:FluentWindow x:Class="BiliDesk.Views.Windows.DisclaimerWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiliDesk.Views"
                    xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
                    Title="非官方软件 · 免责声明"
                    Width="760" Height="640" MinWidth="560" MinHeight="420"
                    WindowStartupLocation="CenterScreen">
    <!--
        首次启动的"同意 / 不同意"弹窗。
        不同意时不是关掉弹窗、而是**直接结束程序** —— 所以这里必须拦掉一切"悄悄绕过"的路径:
        Alt+F4、点标题栏的 × 、Esc, 全都按"不同意"处理(见代码后置)。
        窗口底色不在这里写: FluentWindow.ApplyChrome 会按当前主题设(与其它窗口一致)。
    -->
    <Grid Margin="24,20,24,20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="使用前请阅读并同意以下声明"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />
        <TextBlock Grid.Row="1" Margin="0,8,0,0" TextWrapping="Wrap" FontSize="12"
                   Foreground="{DynamicResource TextTertiaryBrush}"
                   Text="BiliDesk 是非官方、非商业的第三方客户端, 与哔哩哔哩官方无任何关联。点「不同意」将立即退出程序。" />

        <Border Grid.Row="2" Margin="0,16,0,0" CornerRadius="10" Padding="20,16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <controls:DisclaimerView />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" Margin="0,18,0,0">
            <TextBlock x:Name="FooterHint" VerticalAlignment="Center" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}"
                       Text="同意后不再重复提示, 随时可在「设置 → 关于」里重新查看。" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnDecline" Content="不同意, 退出" Style="{StaticResource SubtleButtonStyle}"
                        Padding="18,9" Click="OnDeclineClick" />
                <Button x:Name="BtnAccept" Content="同意并继续" Style="{StaticResource AccentButtonStyle}"
                        Margin="10,0,0,0" Padding="24,9" Click="OnAcceptClick" />
            </StackPanel>
        </Grid>
    </Grid>
</views:FluentWindow>
