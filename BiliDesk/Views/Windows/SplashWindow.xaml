<views:FluentWindow x:Class="BiliDesk.Views.Windows.SplashWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiliDesk.Views"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    Title="BiliDesk" Width="460" Height="250"
                    WindowStartupLocation="CenterScreen"
                    ResizeMode="NoResize" ShowInTaskbar="False"
                    WindowStyle="None" AllowsTransparency="True"
                    Background="Transparent">
    <!--
        开屏窗: 品牌字标逐笔画出来。

        ★★★ 三条硬约束(都是本项目实测踩过的坑, 别改):
          ① **底色必须不透明、且自己做**, 不能依赖 FluentWindow.ApplyChrome ——
             那个会给窗口套主题底色 + 云母/亚克力材质, 而材质模式下窗口底是**壁纸**,
             程序算不准底色(见 MainWindow.xaml 里删掉"幕布"的那段说明)。
             这里 AllowsTransparency=True + Background=Transparent, 真正的底色由
             里面的 Border 提供(纯白 / 深灰), 任何主题/材质下都一致。
          ② **动画只作用在单个 Path 上**(StrokeDashOffset / 单控件 Opacity),
             绝不对整棵树做透明度动画 —— 这台机器上整树淡入**不上屏**
             (见 Helpers/PageTransition 的类注释, 探针 bd-probe-switchback2 实测)。
             ⇒ 退场时也只淡出**这一层 Border**, 不动窗口本身。
          ③ **不可交互**: IsHitTestVisible=False, 且 ShowInTaskbar=False。
             它只是"品牌一闪", 不该挡住用户点别的窗口。

        ★ 字标几何来自 Assets/brand-logo.xaml(pack URI 资源字典),
          16 段笔画各自一个 Path, 描边生长逐段错开 60ms。
    -->
    <Grid>
        <!-- 底色层: 浅色纯白(图一就是纯白), 深色 #202020(= WindowSolidDarkBrush)。
             ★ 这一层是**唯一**做淡出的对象(整窗淡出在有边框/圆角时边缘会露馅)。 -->
        <Border x:Name="SplashRoot" CornerRadius="14"
                Background="{DynamicResource SplashBackgroundBrush}">
            <Grid>
                <!-- 字标: 1000x270 的画布缩到窗内, 居中偏上 -->
                <Viewbox x:Name="LogoViewbox"
                         Width="300" Height="81"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                    <Canvas Width="1000" Height="270" Background="Transparent">
                        <!-- 16 段笔画。StrokeThickness 在代码里按画布比例设好。 -->
                        <Path x:Name="Stroke_B_Stem"    Data="{StaticResource Brand_B_Stem}" />
                        <Path x:Name="Stroke_B_Top"     Data="{StaticResource Brand_B_Top}" />
                        <Path x:Name="Stroke_B_Bottom"  Data="{StaticResource Brand_B_Bottom}" />
                        <Path x:Name="Stroke_I1"        Data="{StaticResource Brand_I1}" />
                        <Path x:Name="Stroke_L_Stem"    Data="{StaticResource Brand_L_Stem}" />
                        <Path x:Name="Stroke_L_Bar"     Data="{StaticResource Brand_L_Bar}" />
                        <Path x:Name="Stroke_I2"        Data="{StaticResource Brand_I2}" />
                        <Path x:Name="Stroke_D_Stem"    Data="{StaticResource Brand_D_Stem}" />
                        <Path x:Name="Stroke_D_Bowl"    Data="{StaticResource Brand_D_Bowl}" />
                        <Path x:Name="Stroke_E_Stem"    Data="{StaticResource Brand_E_Stem}" />
                        <Path x:Name="Stroke_E_Top"     Data="{StaticResource Brand_E_Top}" />
                        <Path x:Name="Stroke_E_Middle"  Data="{StaticResource Brand_E_Middle}" />
                        <Path x:Name="Stroke_E_Bottom"  Data="{StaticResource Brand_E_Bottom}" />
                        <Path x:Name="Stroke_S_Top"     Data="{StaticResource Brand_S_Top}" />
                        <Path x:Name="Stroke_S_Bottom"  Data="{StaticResource Brand_S_Bottom}" />
                        <Path x:Name="Stroke_K_Stem"    Data="{StaticResource Brand_K_Stem}" />
                        <Path x:Name="Stroke_K_Upper"   Data="{StaticResource Brand_K_Upper}" />
                        <Path x:Name="Stroke_K_Lower"   Data="{StaticResource Brand_K_Lower}" />
                    </Canvas>
                </Viewbox>
            </Grid>
        </Border>
    </Grid>
</views:FluentWindow>
