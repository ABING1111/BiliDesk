<views:FluentWindow x:Class="BiliDesk.Views.PlayerWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliDesk.Views"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Title="BiliDesk 播放器" Width="1280" Height="760"
             MinWidth="1100" MinHeight="600" WindowStartupLocation="CenterScreen"
             WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <!--
        顶栏(标题 + 全屏; 2026-09-26 左上角"返回主界面"按钮已按用户要求删除,
        Esc 键仍可关播放器), 系统标题栏去掉了, 所以最右边补上最小化/最大化/关闭三个自绘按钮。
        WindowChrome 的 CaptionHeight 就是顶栏的高度(44): 这块既能拖动窗口、双击最大化,
        又参与布局; 里面的控件都要标 IsHitTestVisibleInChrome="True" 才点得到。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <views:FluentWindow.Resources>
        <!-- ============ 三连 / 评论图标(B 站官方 SVG 的路径数据) ============
             WPF 不认 SVG, 所以把 svg 里 <path d="..."> 的数据原样搬进来当几何资源。

             三个源文件的共同点(改的时候别丢):
               - viewBox 都是 1024x1024, fill="currentColor" —— 也就是**纯填充图形**,
                 上色要用 Path 的 Fill(不能用 Stroke), 颜色由调用方给;
               - 图形里带"挖空"(币是实心圆挖出 ¥, 赞是拇指+小方块两个子路径),
                 填充规则按源文件的 nonzero 写死, 别改成 EvenOdd;
               - svg 里 <g transform="translate(x, y)"> 的纵向微调必须保留, 否则图标
                 在文字旁边会高/低一点(这是原作者用来对齐基线的)。
            缩放统一交给调用方 Path 的 Stretch=Uniform: 三个图标的墨迹都占设计框约 86%,
            比例接近, 所以按墨迹适配后彼此的相对大小与设计稿一致。 -->
        <PathGeometry x:Key="LikeIconGeometry" FillRule="Nonzero"
                      Figures="M323 877V326H327L481 137Q506 112 541 110Q576 108 603 131Q617 145 625 163Q633 181 631 202L625 326H860Q882 326 901.5 335.5Q921 345 935 363Q947 380 950 401Q953 422 948 441L848 769Q835 816 799 845Q763 874 713 877ZM266 877H186Q156 879 130 865Q104 851 89 824Q74 797 73 769V438Q73 407 88 381.5Q103 356 130 342Q144 335 158 331.5Q172 328 186 326H266Z">
            <PathGeometry.Transform>
                <TranslateTransform X="-0.06" Y="18.46" />
            </PathGeometry.Transform>
        </PathGeometry>

        <PathGeometry x:Key="CoinIconGeometry" FillRule="Nonzero"
                      Figures="M545 317H664Q680 317 690 307.5Q700 298 700 284Q700 270 690 261Q680 252 664 252H354Q339 252 329 261Q319 270 319 284Q319 298 329 307.5Q339 317 354 317H479V377Q395 383 340.5 440.5Q286 498 283 582V626Q284 639 293 648.5Q302 658 316 658Q330 658 339 649Q348 640 349 626V582Q350 526 386.5 486.5Q423 447 479 442V747Q480 761 489 770Q498 779 512 779Q526 779 535 770Q544 761 545 747V442Q601 447 637.5 486.5Q674 526 675 582V626Q675 640 684.5 649Q694 658 708 658Q722 658 731 649Q740 640 740 626V582Q738 498 683.5 440.5Q629 383 544 377V317ZM512 951Q326 946 202 822Q78 698 73 512Q78 326 202 202Q326 78 512 73Q698 78 822 202Q946 326 951 512Q946 698 822 822Q698 946 512 951Z" />

        <PathGeometry x:Key="FavoriteIconGeometry" FillRule="Nonzero"
                      Figures="M735 297Q703 292 678 273Q653 254 640 225L568 74Q549 37 511.5 37Q474 37 452 74L384 225Q369 254 344.5 273Q320 292 289 297L127 322Q88 330 76.5 364Q65 398 92 429L214 555Q236 576 244.5 605Q253 634 249 665L221 840Q216 882 246.5 903Q277 924 315 906L452 831Q481 814 513.5 814Q546 814 575 831L713 906Q750 924 779.5 903Q809 882 807 840L775 665Q771 634 779.5 605Q788 576 810 555L932 429Q959 398 947.5 364Q936 330 897 322Z">
            <PathGeometry.Transform>
                <TranslateTransform X="0" Y="36.35" />
            </PathGeometry.Transform>
        </PathGeometry>

        <!-- 播放器滑条(进度/音量): 细轨道 + 白色圆点, 深底更清晰 -->
        <Style x:Key="PlayerSlider" TargetType="Slider">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <!-- 不吃键盘焦点, 保证空格键始终控制播放/暂停 -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid MinHeight="18" Background="Transparent">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.DecreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18">
                                                    <Border Height="3" CornerRadius="1.5"
                                                            Background="#F2FFFFFF" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static Slider.IncreaseLarge}" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Grid Background="Transparent" Height="18">
                                                    <Border Height="3" CornerRadius="1.5"
                                                            Background="#4DFFFFFF" VerticalAlignment="Center" />
                                                </Grid>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Grid Background="Transparent">
                                                    <Ellipse Width="11" Height="11" Fill="White"
                                                            Margin="-2,0" />
                                                </Grid>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放器圆形图标按钮 -->
        <Style x:Key="PlayerRoundBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 播放器文字按钮(清晰度/倍速等): 半透明底衬, 与任意视频画面区分开 -->
        <Style x:Key="PlayerTextBtn" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#F2FFFFFF" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="#40000000" CornerRadius="5"
                                BorderBrush="#22FFFFFF" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#5C000000" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#66000000" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

            <!-- 评论里的等级徽章(LV6) 与 UP 标。
                 ★ 这两个是**身份标**, 不是主题强调色, 所以色值写死、不跟主题色变 ——
                   和导航选中项/按钮那种"交互反馈色"是两回事: 用户把主题色调成绿色,
                   UP 标跟着变绿只会让人认不出那是"UP主"的意思。等级蓝同理(B 站官方就是蓝)。
                 注意边框里的 TextBlock **必须显式写 Foreground** —— 全局隐式 TextBlock 样式
                 会压过继承下去的前景色(踩过的坑, 见 MEMORY)。 -->
            <Style x:Key="LevelBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#5B8FF9" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="4,0,4,1" />
                <Setter Property="Margin" Value="5,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="UpBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#FB7299" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="4,0,4,1" />
                <Setter Property="Margin" Value="4,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <!-- 「置顶」标(2026-10-03 修"置顶评论不可见"时加)。
                 ★ 摆在昵称**最前面**(见评论模板), 因为"置顶"说的是这条评论的位置属性,
                   不是作者身份 —— 跟在 UP 标后面会让人以为是第三种身份标。
                 ★ 色值写死成中性灰蓝: 与 UP 标(#FB7299)/等级蓝(#5B8FF9)区分开, 不跟主题色走
                   (与上面两个身份标同一个理由)。 -->
            <Style x:Key="PinnedBadgeStyle" TargetType="Border">
                <Setter Property="Background" Value="#7A7A7A" />
                <Setter Property="CornerRadius" Value="3" />
                <Setter Property="Padding" Value="4,0,4,1" />
                <Setter Property="Margin" Value="0,0,4,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- 评论操作行(赞 / 踩 / 回复)。
                 卡片、详情页根评论、详情页回复三处共用一份 —— 同款按钮抄三遍的话,
                 改一次颜色要改三处, 漏一处就是"有的地方颜色不对"这种难查的怪 bug。
                 踩 = 同一个拇指路径上下翻转(ScaleY=-1); 踩不显示数量, 接口不给 dislike 总数。 -->
            <DataTemplate x:Key="CommentActionBarTemplate">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource CommentActionButtonStyle}"
                            Click="OnCommentLikeClick"
                            IsEnabled="{Binding CanLike}"
                            ToolTip="点赞 / 取消点赞">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                                  Stretch="Uniform" VerticalAlignment="Center">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                            <TextBlock Text="{Binding LikeText}" FontSize="11" Margin="4,0,0,0"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                            Click="OnCommentDislikeClick" IsEnabled="{Binding CanLike}"
                            ToolTip="点踩 / 取消点踩">
                        <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                              Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Path.RenderTransform>
                                <ScaleTransform ScaleY="-1" />
                            </Path.RenderTransform>
                            <Path.Style>
                                <Style TargetType="Path">
                                    <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Button>
                    <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                            Click="OnCommentReplyClick" ToolTip="回复这条评论">
                        <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                    </Button>
                </StackPanel>
            </DataTemplate>

            <DataTemplate x:Key="CommentCardTemplate">
            <Border Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            CornerRadius="6" Padding="10,8" Margin="0,0,0,6">
            <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- 真实头像: 圆形裁切靠 CornerRadius + Cover 附加属性,
                 加载失败时里面的占位人形图标仍然可见 -->
            <Border Grid.Column="0" Width="26" Height="26" CornerRadius="13"
                    VerticalAlignment="Top"
                    Background="{DynamicResource AccentSoftFillBrush}"
                    ClipToBounds="True"
                    Cursor="Hand" ToolTip="进入 TA 的主页"
                    MouseLeftButtonUp="OnCommentAvatarClick"
                    behaviors:Cover.Source="{Binding UserFace}">
                <TextBlock Text="&#xE77B;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="12"
                           Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <!-- 「置顶」标摆在昵称**最前面**: 它说的是这条评论的位置属性, 不是作者身份。
                         见 PinnedBadgeStyle 的说明。 -->
                    <Border Style="{StaticResource PinnedBadgeStyle}"
                            Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="置顶" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding UserName}"
                               FontWeight="SemiBold" FontSize="12" />
                    <!-- 等级徽章 + UP 标 -->
                    <Border Style="{StaticResource LevelBadgeStyle}"
                            Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding LevelText}" FontSize="9" Foreground="White" />
                    </Border>
                    <Border Style="{StaticResource UpBadgeStyle}"
                            Visibility="{Binding IsUp, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="UP" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                    </Border>
                    <TextBlock Text="{Binding RcTime}"
                               Style="{StaticResource MetaTextStyle}"
                               Margin="8,1,0,0" FontSize="11" />
                    <!-- IP 属地: 接口给的 Location 已经自带 "IP属地：" 前缀,
                         没有就整块不显示(用户可以在 B 站设置里关掉展示 / 未登录时接口不下发)。
                         用比时间更淡的颜色, 别和昵称/时间抢视线。 -->
                    <TextBlock Text="{Binding Location}"
                               FontSize="11" Margin="8,1,0,0"
                               Foreground="{DynamicResource TextTertiaryBrush}"
                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <!-- 评论内容: 走 CommentText, 把 [表情] 内联成图片。
                     换成它之后就不能再拖选复制了(TextBlock 没有选中能力),
                     所以控件自带右键菜单"复制评论文字"补回来。 -->
                <controls:CommentText Comment="{Binding}"
                                     FontSize="12" Margin="0,3,0,0"
                                     Foreground="{DynamicResource TextPrimaryBrush}" />
                <!-- 评论操作行(赞 / 踩 / 回复): 统一走 CommentActionBarTemplate, 别在这里另写一份 -->
                <ContentControl Content="{Binding}" HorizontalAlignment="Left" Margin="0,3,0,0"
                                ContentTemplate="{StaticResource CommentActionBarTemplate}" />

                <!-- ===== 楼中楼预览方框 =====
                     整框可点 → 进"详情"页看这条评论的全部回复(唯一的楼中楼入口)。
                     框内**列出全部回复**(用户要求"自动展开所有评论", 不再截前 3 条);
                     每条是"用户名 [UP]：正文"的一行混排(前缀由 CommentText 内联, 见 ReplyPrefix)。 -->
                <Border Margin="0,6,0,0" Padding="8,6" CornerRadius="6"
                        Background="{DynamicResource ControlFillDefaultBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                        Cursor="Hand"
                        MouseLeftButtonUp="OnReplyBoxClick"
                        ToolTip="查看这条评论的全部回复"
                        Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Replies}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <controls:CommentText Comment="{Binding}"
                                                          Prefix="{Binding ReplyPrefix}"
                                                          PrefixForeground="{DynamicResource TextTertiaryBrush}"
                                                          FontSize="11.5" Margin="0,0,0,3"
                                                          Foreground="{DynamicResource TextSecondaryBrush}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- 底部提示行: 明确"这里能点", 顺便给出真实回复总数 -->
                        <TextBlock Text="{Binding ReplyBoxText}" FontSize="11" Margin="0,1,0,0"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}" />
                    </StackPanel>
                </Border>
        </StackPanel>
    </Grid>
</Border>
            </DataTemplate>

        <!--
            ============ 评论区排序入口(热门 / 时间) ============

            用户要求: 入口放在「共 N 条评论」右边; 选中后要**美观的矩形底色**。
            ★ 2026-10-06 第二次改: 第一版是**纯文字**(只有颜色变化), 用户反馈
              "热门和时间的可读性比较差, 加入美观的矩形底色" ——
              纯文字在"共 N 条评论"那行 12px 灰字旁边太弱, 用户看不出那俩词是可点的。
              现在改成**带矩形底的小胶囊**:
                · 未选中: 极淡的中性底(ControlFillDefaultBrush) + 次要文字色 ——
                  "淡淡的底"本身就在说"这是一个可点的东西", 但又不抢选中项的视线;
                · 选中: 强调色浅底(AccentSoftFillBrush) + 强调色文字 + SemiBold,
                  与全应用其它"选中态"共用同一套观感(见记忆里的 AccentSoftFill 基准);
                · 悬停: 比未选中再深一档(ControlFillHoverBrush)。
              ★ 圆角用 6(不是胶囊的 100): 用户明确说"矩形底色", 且这里字号只有 12,
                全圆角会显得像个按钮而不像"行内的一个可点词"。
              ★ 为什么 Tag 驱动选中态而不是 IsChecked: 这里没有互斥组的需求(只有两个), 用
                Tag="on" + DataTrigger 与 ContentActionTabStyle 同一套写法, 代码里一行就能切。
                ★★ 绑定必须写 RelativeSource Self —— 2026-10-03 探针实测过, 在 ControlTemplate
                   的触发器里写 TemplatedParent 或不写 RelativeSource 都**静默失效**。
        -->
        <Style x:Key="CommentSortLinkStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <!-- 左右 9 / 上下 3: 矩形底不能太胖, 否则会把这行文字的行高撑开 -->
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6"
                                Background="{DynamicResource ControlFillDefaultBrush}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource AccentSoftFillBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextStrongBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            ============ 播放页操作栏(六个按钮) ============
            2026-10-06 按设计稿「播放页_v4」重做。要点(每条都对应设计稿里的一节):

            · **每个动作有自己的色相**, 未激活一律是灰 —— 颜色只在用户动过之后才出现。
              色相是**固定**的(不跟主题强调色走), 与 B 站一致: 红=情绪(点赞)、金=货币(投币)、
              蓝=收进我的库(收藏/稍后再看)、绿=拿走(下载)。用户把主题色改成绿色时,
              "点赞"跟着变绿会立刻丢掉这套分工。
            · **hover 预览**: 鼠标上来就先把色相透出来(见代码 OnActionButtonHover),
              底色跟着一起染 —— 红色文字压在灰底上很脏, 底色必须同色相。
            · **弹跳**: 点赞/投币点下去图标弹一下(见 PlayActionPop)。
            · **文字/图标的双层叠放**: 「稍后再看 ↔ 已添加」两个词的宽度取最大值,
              切换时只做透明度过渡, **整排按钮不会被推着走**(这是设计稿 v3 的原始 bug)。
            · **数字不推走邻居**: 计数框给 MinWidth, 位数从 9 变到 10 时右侧按钮不位移。

            ★ 前景色由代码集中设置(见 ApplyActionVisual): hover / 点亮 / 取消后锁定三种态
              都走那一处。散着在 XAML 触发器里改颜色会和代码打架。
            ★ 底色用了 `Background="{TemplateBinding Foreground}"` + 低透明度 —— 
              这样"同色相浅底"是**从前景色推导**出来的, 不必为六个按钮各配一支浅色笔刷。
        -->
        <Style x:Key="PlayerActionBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <!-- ★★ 两行布局下每行只有三个按钮, 每个能用 ~130px(实测最宽的「稍后再看」约 90px),
                 宽度富余 —— 所以 Padding/Margin 可以给得宽松一些, 排版才松快。
                   · Padding 4,6: 垂直 6px 容纳点击时 PlayActionPop 的 1.3 倍弹跳
                     (20px 盒 → 26px, 上下各溢出 3px), 不像单行那样几乎顶到边缘;
                   · Margin 右 8: 行内三个之间留 8px, 比单行时的 14px 略紧是合理的
                     —— 单行挤六个才需要 14, 两行三个用 8 就够。
                 ★ 为什么改小而不是让 Grid 换行: 用户要求"单行显示", 换行就违背了。
                 ★ ActionCountText 的 MinWidth 20(原值): 两位数(10~99)在 13px 字号下
                   宽约 16~18px, 给 20 有余量, 切到三位数时也不会推走右侧按钮。 -->
            <Setter Property="Padding" Value="4,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <!-- hover / 离开统一在代码里处理色相(见 ApplyActionVisual), 所以这里挂样式级事件:
                 六个按钮各写一遍 Attribute 必然漏掉一两个。 -->
            <EventSetter Event="MouseEnter" Handler="OnActionButtonHover" />
            <EventSetter Event="MouseLeave" Handler="OnActionButtonLeave" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- 同色相浅底: 颜色取自前景色, 透明度低到只作为"染色提示" -->
                            <Border x:Name="Tint" CornerRadius="8"
                                    Background="{TemplateBinding Foreground}" Opacity="0" />
                            <Border Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.10" />
                            </Trigger>
                            <!-- 点亮态常驻一层浅底(与 hover 同款), 让"已经点过"一眼可读 -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Tint" Property="Opacity" Value="0.10" />
                            </DataTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 操作栏图标(描边画法): 未激活空心, 点亮由子类样式补 Fill -->
        <Style x:Key="ActionGlyphStroke" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="StrokeThickness" Value="1.85" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 计数文字: 所有 TextBlock 都必须显式绑 Foreground —— 全局隐式 TextBlock 样式带
             Foreground setter, 优先级高于继承, 不绑的话变色的只有图标(项目里反复踩的那个坑)。
             MinWidth 兜住位数变化, 右侧按钮不会被推走。

             ★ 2026-10-06 用户要求"数字与图案隔开一些":
               Margin 左 6px(图标格 20px 之后的第一道间隙)。之前完全没有左边距, 数字紧贴图标,
               "282" 那种三位数几乎顶在图标上, 两样东西糊成一团。
               ★ 为什么靠 Margin 而不是给 IconBox 加 Padding: 图标盒是**六个按钮共用**的排版基线
                 (固定 20×20, 改它会连带影响所有图标的居中与弹跳基准, 见 ActionIconBox 的注释)。
                 只在文字这一侧加间隙, 图形那边一动不动。
               ★ 为什么不用 MinWidth 顶开: MinWidth 只是给文字块留白, 文字默认左对齐,
                 所以留白落在**右边**(数字右边的空档), 左边的"贴"一点没变。 -->
        <Style x:Key="ActionCountText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="MinWidth" Value="20" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- 操作栏文字标签(稍后再看/已添加/分享/下载)。
             ★ 图标与文字的**上下对齐**靠这条样式的 VerticalAlignment="Center"
               加上 ActionIconBox 的固定 20×20: 两者等高居中, 一排六个图标的基线才一致。
               (用户报过"6 个按钮没有上下对齐", 根因是当时下载图标格写了 18 而其余是 20。) -->
        <Style x:Key="ActionLabelText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>


        <!-- 弹跳: 作用在图标盒子上, 不打断内部图形 -->
        <!--
            操作栏图标盒子(弹跳动画的载体)。

            ★★★ 这里**绝不能**在样式里给 RenderTransform 一个共享的 ScaleTransform。
              WPF 会把样式 Setter 里的 Freezable **冻结**, 而冻结对象挂不了动画 ——
              调用 BeginAnimation 会当场抛
                "无法在 System.Windows.Media.ScaleTransform 上激活 ScaleX 属性,
                 因为该对象已密封或已冻结"
              表现就是"点一下点赞/投币/收藏/稍后再看就弹错误框"(2026-10-06 实测踩到)。
              缩放对象由代码在每次播放动画时**新建**一份(见 PlayActionPop), 样式只管
              尺寸与变换原点。
        -->
        <Style x:Key="ActionIconBox" TargetType="Grid">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <!-- 变换原点是普通 double, 冻结不了, 放在样式里安全 -->
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        </Style>

        <!-- 声波单根(聆听遮罩里的大号, 5px 宽 7 根)。
             ★ 颜色取**主题强调色**, 不再写死琥珀 —— 用户要求"听视频的颜色跟随全局主题设置"
               (旧版这颗写死 #F59E0B, 用户换主题色后播放页就剩它还是橙的)。
               遮罩底是固定深色渐变(它替代的是视频画面, 浅底会像"画面坏了"),
               所以声波直接用 AccentBrush, 在深底上足够亮。
             ★ 高度由代码逐帧改(见 UpdateListenWave)。 -->
        <Style x:Key="ListenBigWaveBar" TargetType="Border">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="10" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!--
            ============ 「听视频」幽灵按钮(设计稿 听视频.html) ============

            只有一个变体(幽灵)和两种状态(待命 / 聆听中)。要点:
              · 高度 40 与旁边按钮齐平; 圆角 pill; 图标 18px; 左右内边距 18; 图文间距 9。
              · **待命**: 透明底 + 次要文字色。**无边框**(2026-10-06 用户要求去除
                "隐约可见的胶囊边缘" —— 原来 1px 描边在顶栏底色上有对比度, 形成
                可见的胶囊轮廓; 现在 BorderThickness=0, 只在悬停/按下/聆听时给底色)。
              · **聆听中**: 强调色实心 + 深色文字 + 声波律动。
              · ★ 声波条不能靠 Storyboard 逐条写: 五根条的延迟/高度各不相同, 在 XAML 里要写
                 五组 BeginStoryboard。这里改成代码驱动的 DispatcherTimer(见 _listenWaveTimer),
                 顺带解决"退出聆听后动画还在跑"这个必然会被踩的坑 —— 定时器可以一处停掉。
            ★ 文案只用「听视频 / 正在聆听 m:ss」: 设计稿第 05 节明确不写"AI"二字,
              且必须能取消(再点一次回到待命)。

            ★★★ 聆听态用**主题强调色**, 不是设计稿的琥珀。2026-10-06 用户要求
                 "听视频的颜色跟随全局主题设置" —— 设计稿那版把琥珀写死, 用户在设置页把
                 主题色改成蓝/绿之后, 这颗按钮会始终是橙的, 和整个应用的主题脱节。
                 改法: 底色取 AccentBrush、文字取 TextOnAccentBrush(强调色底上的专用前景,
                 ThemeService 会按强调色亮度自动选白/黑, 见 BrandOnAccent)。
                 ★ 声波条取 Foreground(即 TextOnAccentBrush) —— 压在强调色实心底上,
                   跟着文字色走才保证任何主题色下都看得清。
                 ★ 这三个键都是 ThemeService 用 DynamicResource 注入的, 换主题即时生效。
        -->
        <Style x:Key="ListenGhostBtn" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="20"
                                Background="{TemplateBinding Background}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- 设计稿: 悬停时墨黑反转。本工程用主题的悬停底色 + 主文字色代替
                                     (顶栏底色是主题色, 硬写墨黑在深色主题下反而看不见) -->
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillPressedBrush}" />
                            </Trigger>
                            <!-- 聆听中: 主题强调色实心。文案/图标/声波由代码切换(见 ApplyListenMode) -->
                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="on">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentBrush}" />
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


</views:FluentWindow.Resources>
    <!-- 根底色: 常规状态跟主题走; 全屏时 ApplyFullscreenLayout 会把它切成纯黑
         (窗口自身 Background 在这层网格底下, 被它盖住 —— 只切窗口那一层是不够的,
         浅色主题下这里就是用户看到的"全屏全白") -->
    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TopRow" Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶栏(2026-09-26 用户要求): 左上角的"返回主界面"按钮已删, 现在只有 标题 + 全屏。
             Esc 键关播放器的键盘路径不受影响(走 HandleBackRequest 那一套)。
             浅底 + 细分隔线, 与主窗口的观感统一。 -->
        <Border x:Name="TopBar" Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TitleText" Grid.Column="0" FontSize="13" FontWeight="SemiBold"
                           Margin="0,0,14,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="播放器" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- 「听视频」入口(2026-10-06 新增, 用户要求放播放器右上角, 设计参考 听视频.html)。
                         幽灵胶囊: 待命 = 透明底 + 1px 描边 + 耳机图标 + "听视频";
                         聆听中 = 琥珀实心 + "正在聆听 m:ss"(由 ApplyListenMode 切换)。
                         ★ 2026-10-06 用户要求"胶囊里的音频波纹去掉, 只保留视频播放器的":
                           胶囊内原先叠了 5 根小波条(现已删除), 聆听态画面里那组大波纹保留。
                         ★ 两段文案的宽度差很多("听视频" 3 字 vs "正在聆听 0:00"), 直接换文案会把右边的
                           窗口按钮推着走 —— 与「稍后再看」同一个坑。这里用**同一套双层叠放**:
                           两个 TextBlock 叠在同一格里, 容器宽度自动取两者最大值, 切换只做透明度过渡。
                         ★ 直播 / 本地文件不给这个入口(见 UpdateListenButtonState): 直播是连续流、
                           本地文件没有独立音轨, 点了只会失败。 -->
                    <Button x:Name="BtnListen" Style="{StaticResource ListenGhostBtn}"
                            Margin="0,0,8,0"
                            Click="OnListenToggleClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- 待命/聆听态都用这一个耳机图标(lucide headphones 路径, 与设计稿一致)。
                                 ★ 2026-10-06 用户要求"去掉胶囊里的音频波纹, 只保留视频播放器的":
                                   这里原来还叠了一个 ListenWavePanel(5 根小波条), 与耳机图标同位切换 ——
                                   5 根 20px 高的细条挤在 20×18 的格子里, 既看不清又和耳机图标打架。
                                   现在胶囊里只有耳机图标; 聆听态画面里那组大波纹
                                   (BigWave1~7, 见下方聆听态区)保留不动。 -->
                            <Grid Width="20" Height="18" VerticalAlignment="Center">
                                <Path x:Name="ListenHeadIcon" Width="18" Height="18" Stretch="Uniform"
                                      HorizontalAlignment="Center"
                                      Fill="Transparent"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="2" StrokeLineJoin="Round"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M3,14 L6,14 A2,2 0 0 1 8,16 L8,19 A2,2 0 0 0 10,21 L11,21 A2,2 0 0 0 13,19 L13,16 A2,2 0 0 1 15,14 L18,14 M21,18 L21,12 A9,9 0 0 0 3,12 L3,18" />
                            </Grid>
                            <!-- 双层文字: 宽度取两者最大值(见上面注释)。
                                 ★ 聆听那层的秒数用等宽数字: "10:00" 与 "9:59" 宽度不等会把按钮撑得一跳一跳。 -->
                            <Grid Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="ListenLabel" Text="听视频" FontSize="14"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <TextBlock x:Name="ListenLabelOn" Text="正在聆听 00:00" FontSize="14" Opacity="0"
                                           FontFamily="Consolas, Segoe UI"
                                           HorizontalAlignment="Center"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Grid>
                        </StackPanel>
                    </Button>

                    <!-- 铺满窗口(2026-10-04 按用户要求把这里原来是"全屏"的功能改成它):
                         点了之后视频铺满**顶栏以下的整个窗口宽度**, 右侧信息栏整个收起
                         (不再占任何显示空间), 窗口尺寸本身完全不变; 再点一次还原。
                         ★ 与"真全屏"是两件事, 别把它们合并: 全屏会连顶栏一起收起、把窗口
                           最大化到整块显示器并盖住任务栏。真全屏的入口仍然是 F 键 / 双击视频 /
                           控制栏那个同款图标 —— 三者都还是 OnFullscreenClick。
                         ★ 图标两种状态可区分(进入 / 已铺满), 由 UpdateFillWindowButton 切换:
                           进入前 = 虚线框(E9A6, "填充这块区域"); 已铺满 = 向内的双箭头(E73F, "还原")。
                           为什么不继续用 E92D(对角双箭头): 它在这个窗口里已经是"真全屏"的语义
                           (F/双击/控制栏三处都在用), 同一个字形挂两种行为会让人以为是同一个功能。
                         ★ 字形必须写进**显式 TextBlock**: 全局隐式 TextBlock 样式带 Foreground
                           setter, 会吃掉 Button.Foreground(项目里反复踩的那个坑)。 -->
                    <Button x:Name="BtnFillWindow" Style="{StaticResource IconButtonStyle}"
                            Width="34" Height="34"
                            ToolTip="铺满窗口" Click="OnFillWindowClick"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <TextBlock x:Name="FillWindowGlyph" Text="&#xE9A6;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="14" />
                    </Button>

                    <!-- 最小化 / 最大化 / 关闭。
                         顶栏底色跟着主题走(浅色主题是浅底), 所以这里用控件的默认色 ——
                         IconBrush 取 TextPrimaryBrush、悬停取 ControlFillHoverBrush, 深浅都对得上。 -->
                    <controls:WindowButtons Margin="8,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主区: 左右分割 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="VideoColumn" Width="*" MinWidth="480" />
                <ColumnDefinition x:Name="RightColumn" Width="400" />
            </Grid.ColumnDefinitions>

            <!-- ============ 左: 视频 + 弹幕 ============ -->
            <!--
                层级设计:
                LibVLC 的 VideoView 是 HwndHost, 普通 WPF 元素无论 ZIndex 多高都会被视频
                HWND 盖住(airspace 问题), 鼠标输入也会被 HWND 吞掉。
                LibVLCSharp.WPF 的解决方案是把这些内容直接放在 VideoView 的 Content 里:
                内容渲染在一个跟随 VideoView 位置/大小的透明浮动窗口中,
                因此既能显示在视频之上, 又能接收鼠标。
                  - 弹幕层 DanmakuCanvas (不可点击)
                  - ControlBar 底部控件栏 (Slider/按钮正常 hit-test)
                  - LoadingOverlay / FailOverlay 模态遮罩
                  - 覆盖 Grid 本身承担单击/双击/长按手势
            -->
            <Grid Grid.Column="0" Background="Black">
                <vlc:VideoView x:Name="VideoView">
                    <!-- 注意: 鼠标事件要求背景不能完全透明, 用 #01000000 -->
                    <!-- 滚轮用 PreviewMouseWheel 挂在视频区的根 Grid 上: 隧道事件从根往叶子最先
                         经过这里, 不会被底部控制栏里的 Slider / 清晰度 Popup 里的 ListBox 先截走;
                         也只挂视频区(右侧信息面板的滚轮仍然该滚它自己的列表)。 -->
                    <Grid x:Name="VideoAreaRoot" Background="#01000000"
                          PreviewMouseLeftButtonDown="OnVideoAreaMouseLeftDown"
                          PreviewMouseLeftButtonUp="OnVideoAreaMouseLeftUp"
                          PreviewMouseWheel="OnVideoAreaMouseWheel"
                          MouseMove="OnVideoAreaMouseMove"
                          MouseLeave="OnVideoAreaMouseLeave">
                            <!-- 弹幕层 -->
                            <Canvas x:Name="DanmakuCanvas" Background="Transparent" IsHitTestVisible="False"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />

                            <!-- ===== 「听视频」聆听态画面(2026-10-06 新增) =====
                                 ★ 为什么必须是**一层盖住视频的浮层**而不是"隐藏 VideoView":
                                   视频区被两层原生 HWND 占着(见 VideoAreaRoot 的说明), 把
                                   VideoView.Visibility 藏掉会让那个 vout HWND 露出一块白底
                                   —— 和 EOF 那条"浅色全屏全白"是同一个现象。盖一层不透明的
                                   画面最稳, 而且退出时不需要重新协商 vout。
                                 ★ IsHitTestVisible=False: 手势(单击暂停/双击全屏/长按快进)必须
                                   照常落到 VideoAreaRoot 上; 这层只是"看"的。
                                 ★ 层级: 放在弹幕层之后、加载遮罩之前 —— 弹出的是"正在加载"而不是
                                   垫在它下面。控制栏在它之后声明, 所以仍然压在它上面(可操作)。
                                 ★ 背景用深色渐变(不跟主题走): 它替代的是视频画面, 浅色主题下
                                   用浅底会看着像"画面坏了"。 -->
                            <Grid x:Name="ListenOverlay" Visibility="Collapsed" IsHitTestVisible="False">
                                <Grid.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0.6,1">
                                        <GradientStop Color="#1A1A1F" Offset="0" />
                                        <GradientStop Color="#101013" Offset="0.62" />
                                        <GradientStop Color="#0B0B0D" Offset="1" />
                                    </LinearGradientBrush>
                                </Grid.Background>
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="520">
                                    <!-- 封面: 圆角 + 投影。播封面图进来当视觉锚点, 一眼知道在听什么。
                                         ★ 用 Image 而不是 Border.Background(ImageBrush): 后者要做
                                           ImageBrush 的 Stretch 还要处理异步换图, Image 直接吃
                                           Cover.ImageSource 附加属性(CoverLoader 那条异步链)。
                                         ★★★ 圆角裁剪: Border.CornerRadius + ClipToBounds **不会**把
                                           子元素裁成圆角(WPF 的 ClipToBounds 是矩形裁剪) ——
                                           必须显式设 Image.Clip = RectangleGeometry(圆角矩形),
                                           否则封面图四角是直角戳出 Border 外(2026-10-06 用户反馈)。 -->
                                    <Border Width="260" Height="146" CornerRadius="12"
                                            HorizontalAlignment="Center"
                                            Background="#26FFFFFF">
                                        <Image x:Name="ListenCover" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,260,146" RadiusX="12" RadiusY="12" />
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    <!-- 声波律动: 比顶栏那颗按钮上的大一号, 是这一屏的主角。 -->
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                                Margin="0,30,0,0" Height="34">
                                        <Border x:Name="BigWave1" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave2" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave3" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave4" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave5" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave6" Style="{StaticResource ListenBigWaveBar}" />
                                        <Border x:Name="BigWave7" Style="{StaticResource ListenBigWaveBar}" />
                                    </StackPanel>
                                    <TextBlock x:Name="ListenOverlayTitle" Text="" FontSize="15"
                                               Foreground="#E8E8EA" HorizontalAlignment="Center"
                                               Margin="0,26,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                               MaxHeight="46" TextAlignment="Center" LineHeight="23" />
                                    <!-- 提示行: 明确"再点一次就能退出", 不留死路(设计稿第 05 节) -->
                                    <TextBlock Text="正在聆听 · 点击右上角「听视频」可退出" FontSize="12"
                                               Foreground="#8A8A94" HorizontalAlignment="Center"
                                               Margin="0,10,0,0" />
                                </StackPanel>
                            </Grid>
                            <!-- 加载遮罩: 转圈 + 轮换颜文字 + 文案(颜文字由后台定时器驱动, 见 ShowLoading) -->
                            <Border x:Name="LoadingOverlay" Background="Black"
                                    Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:LoadingRing Width="40" Height="40" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="LoadingKaomoji" Text="(´･ω･`)" FontSize="20"
                                               Margin="0,18,0,0" HorizontalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextBrush}" />
                                    <TextBlock x:Name="LoadingText" Text="正在加载视频…" Margin="0,8,0,0"
                                               Foreground="#999" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <!-- 失败遮罩 -->
                            <Border x:Name="FailOverlay" Background="Black" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE783;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="34" Foreground="#666" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="FailText" Text="播放器初始化失败" Margin="0,12,0,0"
                                               Foreground="#999" FontSize="13" />
                                    <Button Content="重试" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                                            Click="OnRetryClick" />
                                </StackPanel>
                            </Border>

                            <!-- 播完遮罩。
                                 为什么需要它: 播到结尾时 LibVLC 会拆掉视频输出, 那个 HWND 就变成
                                 一块没有内容的空白面(浅色主题下看着就是"整块全白")。以前这里直接
                                 Stop(), 于是短视频播完必然留一片白。现在不 Stop, 而是盖一层遮罩 ——
                                 既挡住那块白, 又顺手给了个"重播"入口。 -->
                            <Border x:Name="EndOverlay" Background="#CC000000" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="30" Foreground="#AAA" HorizontalAlignment="Center" />
                                    <TextBlock x:Name="EndText" Text="已播完" Margin="0,12,0,0"
                                               Foreground="#DDD" FontSize="13" HorizontalAlignment="Center" />
                                    <Button Content="重播" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Center" Margin="0,16,0,0" Padding="24,7"
                                            Click="OnReplayClick" />
                                </StackPanel>
                            </Border>

                            <!-- 音量提示(滚轮 / ↑↓ / 静音键调音量时短暂浮出)。
                                 放在视频区左侧中线上, 不挡底部控制栏; IsHitTestVisible=False
                                 保证它不吃掉视频区的手势与滚轮。 -->
                            <Border x:Name="VolumeOsd" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Padding="15,10" CornerRadius="9"
                                    Background="#B3000000" IsHitTestVisible="False"
                                    Visibility="Collapsed" Opacity="0" Panel.ZIndex="98">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="VolumeOsdIcon" Text="&#xE767;"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="16" Foreground="White" VerticalAlignment="Center" />
                                    <TextBlock x:Name="VolumeOsdText" Text="80%" Margin="9,0,0,0"
                                               FontSize="14" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>

                            <!-- 跳过赞助片段的提示(带「撤回」)。
                                 ★ 必须放在**视频区的浮层里**(VideoAreaRoot), 不能放右侧信息栏 ——
                                   全屏时 ApplyFullscreenLayout 会把 InfoPanel 整个折叠掉, 放那边等于
                                   "全屏看视频时永远看不到提示"(2026-09-27 真机反馈: 跳过成功但没有提示)。
                                   视频区浮层在窗口模式和全屏下都在, 且能压在视频 HWND 上。
                                 视觉照搬音量提示那种"深色半透明胶囊 + 白字": 不依赖主题配色,
                                 压在任何画面的视频上都看得清(亮底视频上也不会糊掉)。
                                 ZIndex=97: 在控制栏(默认 0)之上、音量提示(98)之下 ——
                                 切全屏那几百毫秒的黑幕必须能盖住它。 -->
                            <Border x:Name="SkipNoticeBorder" HorizontalAlignment="Left" VerticalAlignment="Top"
                                    Margin="14,14,0,0" Padding="12,6" CornerRadius="8"
                                    Background="#B3000000" Visibility="Collapsed" Opacity="0"
                                    Panel.ZIndex="97">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="12" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SkipNoticeText" Margin="8,0,0,0" FontSize="12"
                                               Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                                    <!-- 撤回按钮复用控制栏那个 PlayerTextBtn: 它本来就是为"压在视频上"定的
                                         (深色半透明底 + 白字 + 悬停加深), 换成主题里的浅色按钮样式反而会看不清。
                                         ★ 文字必须写成显式 TextBlock —— 全局那个隐式 TextBlock 样式带
                                         Foreground setter, 而 Style setter 优先级高于继承, 会**吃掉**
                                         Button.Foreground。写成 Content="撤回" 的话文字会变成主题主文字色
                                         (浅色主题下就是深灰), 压在深色胶囊上基本看不见。 -->
                                    <Button x:Name="SkipUndoButton" Margin="12,0,0,0"
                                            Style="{StaticResource PlayerTextBtn}" Click="OnSkipUndoClick">
                                        <TextBlock Text="撤回" Foreground="#F2FFFFFF" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- 播放控件栏(底部覆盖在视频上, 渐变底更沉浸) -->
                            <Border x:Name="ControlBar" VerticalAlignment="Bottom"
                                    BorderThickness="0" Padding="14,6,14,8">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#00000000" Offset="0" />
                                        <GradientStop Color="#66000000" Offset="0.45" />
                                        <GradientStop Color="#D9000000" Offset="1" />
                                    </LinearGradientBrush>
                                </Border.Background>
                                <StackPanel>
                                    <!-- 进度条(点击轨道任意位置可直接跳转)。
                                         ★ 外面套一层 Grid 是为了压一层"片段色块": 它必须和进度条
                                           严丝合缝地对齐, 放同一个格子里最省事(几何换算见 RenderSponsorMarks)。 -->
                                    <Grid>
                                        <Slider x:Name="ProgressSlider" Style="{StaticResource PlayerSlider}"
                                                Minimum="0" Maximum="1000" Value="0"
                                                Thumb.DragStarted="OnProgressDragStart"
                                                Thumb.DragCompleted="OnProgressDragEnd"
                                                ValueChanged="OnProgressValueChanged" />
                                        <!-- 被标注的片段(sponsor 等)在这里画成色块。
                                             · IsHitTestVisible=False —— 绝对不能挡住拖进度条 / 点击跳转;
                                             · 必须排在 Slider **之后**才画在它上面(色块要压住那条白色轨道);
                                             · ClipToBounds 防止算出来的宽度溢出到控制栏外面。
                                             ★ 一个已知的小取舍: 色块压在滑块(那个 11px 圆点)上面, 所以
                                               手动拖进度拖到片段内部时, 圆点中段会被色块盖住 5px —— 圆点
                                               仍能看出轮廓。把色块放到 Slider 底下就完全避开, 但那样它会被
                                               那条不透明的白轨道挡掉中间 3px, 只剩两道细边, 反而看不出是色块。 -->
                                        <Canvas x:Name="SponsorMarks" IsHitTestVisible="False"
                                                ClipToBounds="True" />
                                    </Grid>
                                    <!-- 操作行 -->
                                    <Grid Margin="0,2,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- 播放/暂停 -->
                                        <Button Grid.Column="0" x:Name="BtnPlay" Style="{StaticResource PlayerRoundBtn}"
                                                Width="36" Height="36" Click="OnPlayPauseClick" ToolTip="播放/暂停 (空格)">
                                            <Path Fill="White" Width="15" Height="15" Stretch="Uniform"
                                                  Data="M 7,4 L 18,11 L 7,18 Z" />
                                        </Button>
                                        <TextBlock x:Name="TimeText" Grid.Column="1" Foreground="#E6FFFFFF" FontSize="12"
                                                   VerticalAlignment="Center" Margin="10,0,0,0" Text="00:00 / 00:00" />

                                        <!-- 音量 -->
                                        <TextBlock x:Name="VolumeIcon" Grid.Column="3" Text="&#xE767;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                   Foreground="#E6FFFFFF" FontSize="14" VerticalAlignment="Center" Margin="10,0,6,0" />
                                        <Slider Grid.Column="4" x:Name="VolumeSlider" Style="{StaticResource PlayerSlider}"
                                                Minimum="0" Maximum="100" Value="80" Width="78"
                                                ValueChanged="OnVolumeChanged" />

                                        <!-- 倍速 -->
                                        <Button Grid.Column="5" x:Name="SpeedBtn" Style="{StaticResource PlayerTextBtn}"
                                                Margin="6,0,0,0" Click="OnSpeedClick" ToolTip="切换播放速度">
                                            <TextBlock x:Name="SpeedText" Text="1.0x" Foreground="#F2FFFFFF" />
                                        </Button>

                                        <!-- 清晰度 -->
                                        <Button Grid.Column="6" x:Name="BtnQuality" Style="{StaticResource PlayerTextBtn}"
                                                Margin="4,0,0,0" Click="OnQualityClick" ToolTip="切换清晰度">
                                            <TextBlock x:Name="QualityText" Text="1080P" Foreground="#F2FFFFFF" />
                                        </Button>
                                        <Popup x:Name="QualityPopup"
                                               Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="#F0202226" CornerRadius="8" Padding="6"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1" MinWidth="110">
                                                <ListBox x:Name="QualityList" Background="Transparent"
                                                         BorderThickness="0" Foreground="White"
                                                         SelectionChanged="OnQualitySelected">
                                                    <ListBox.ItemContainerStyle>
                                                        <Style TargetType="ListBoxItem">
                                                            <!-- 绝不能设 Focusable=False: ListBoxItem 鼠标按下时
                                                                 Focus() 失败会短路选中逻辑, SelectionChanged 永不触发
                                                                 (之前"切换清晰度没反应"就是它)。去焦点框用 FocusVisualStyle -->
                                                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                                            <Setter Property="Padding" Value="10,6" />
                                                            <Setter Property="Cursor" Value="Hand" />
                                                            <Setter Property="ContentTemplate">
                                                                <Setter.Value>
                                                                    <DataTemplate>
                                                                        <!-- 显式白字: 全局隐式 TextBlock 样式(主题色)会覆盖继承的前景色 -->
                                                                        <TextBlock Text="{Binding}" Foreground="#F2FFFFFF" />
                                                                    </DataTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="ListBoxItem">
                                                                        <Border x:Name="Bd" Background="Transparent"
                                                                                CornerRadius="5" Padding="{TemplateBinding Padding}">
                                                                            <ContentPresenter VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <ControlTemplate.Triggers>
                                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                                                            </Trigger>
                                                                            <Trigger Property="IsSelected" Value="True">
                                                                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                                                            </Trigger>
                                                                        </ControlTemplate.Triggers>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </ListBox.ItemContainerStyle>
                                                </ListBox>
                                            </Border>
                                        </Popup>

                                        <!-- 弹幕开关。以前只能按快捷键 D, 界面上没有入口 ——
                                             看视频时想随手关掉刷屏弹幕是很常见的操作, 这里必须有个按钮。
                                             文案用"弹幕开/关"而不是图标: 开关状态一眼可读, 不用猜图标含义。 -->
                                        <Button Grid.Column="7" x:Name="BtnDanmaku" Style="{StaticResource PlayerTextBtn}"
                                                Margin="4,0,0,0" Click="OnDanmakuToggleClick" ToolTip="开关弹幕 (D)">
                                            <TextBlock x:Name="DanmakuBtnText" Text="弹幕开" Foreground="#F2FFFFFF" />
                                        </Button>

                                        <!-- 弹幕区域占比 -->
                                        <Button Grid.Column="8" x:Name="BtnDanmakuArea" Style="{StaticResource PlayerTextBtn}"
                                                Margin="4,0,0,0" Click="OnDanmakuAreaClick" ToolTip="弹幕显示区域占比">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="&#xE734;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           FontSize="12" VerticalAlignment="Center" Foreground="#F2FFFFFF" />
                                                <TextBlock x:Name="DanmakuAreaText" Text="25%" Margin="5,0,0,0"
                                                           Foreground="#F2FFFFFF" />
                                            </StackPanel>
                                        </Button>
                                        <Popup x:Name="DanmakuAreaPopup"
                                               Placement="Top" StaysOpen="False" AllowsTransparency="True"
                                               PopupAnimation="Fade">
                                            <Border Background="#F0202226" CornerRadius="8" Padding="12,10"
                                                    BorderBrush="#33FFFFFF" BorderThickness="1" Width="190">
                                                <StackPanel>
                                                    <TextBlock Text="弹幕显示区域" Foreground="#E6FFFFFF" FontSize="12" />
                                                    <Slider x:Name="DanmakuAreaSlider" Style="{StaticResource PlayerSlider}"
                                                            Minimum="25" Maximum="100" Value="25"
                                                            Margin="0,10,0,4" IsSnapToTickEnabled="True"
                                                            TickFrequency="5" ValueChanged="OnDanmakuAreaChanged" />
                                                    <TextBlock x:Name="DanmakuAreaValue" Text="25%"
                                                               Foreground="#99FFFFFF" FontSize="11" HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Border>
                                        </Popup>

                                        <!-- 全屏(离线缓存已挪到右侧信息面板的操作栏, 2026-09-26) -->
                                        <Button Grid.Column="9" x:Name="BtnFullscreen2" Style="{StaticResource PlayerRoundBtn}"
                                                Width="36" Height="36" Click="OnFullscreenClick" ToolTip="全屏 (F)">
                                            <TextBlock Text="&#xE92D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                       FontSize="14" Foreground="White" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </Grid>
                </vlc:VideoView>
            </Grid>

            <!-- ============ 右: 信息面板 ============ -->
            <!-- x:Name 供全屏退出时做淡入用(400px 的一大块"啪"地出现很跳) -->
            <Grid x:Name="InfoPanel" Grid.Column="1" Background="{DynamicResource AppBackgroundBrush}">
                <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0">
                    <ScrollViewer x:Name="InfoScroll" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,24">
                            <!-- 标题 + 数据 -->
                            <TextBlock x:Name="VideoTitleText" FontSize="17" FontWeight="SemiBold"
                                       TextWrapping="Wrap" Text="视频标题" LineHeight="24" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <TextBlock x:Name="ViewCountText" Style="{StaticResource MetaTextStyle}" Text="--" />
                                <TextBlock Text=" 播放" Style="{StaticResource MetaTextStyle}" />
                                <TextBlock Text=" · " Style="{StaticResource MetaTextStyle}" Margin="6,0" />
                                <TextBlock x:Name="DanmakuCountText" Style="{StaticResource MetaTextStyle}" Text="--" />
                                <TextBlock Text=" 弹幕" Style="{StaticResource MetaTextStyle}" />
                                <TextBlock Text=" · " Style="{StaticResource MetaTextStyle}" Margin="6,0" />
                                <TextBlock x:Name="PubDateText" Style="{StaticResource MetaTextStyle}" Text="--" />
                            </StackPanel>
                            <!-- UP 主卡片 -->
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
                                    CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="UpAvatarBox" Grid.Column="0" Width="40" Height="40"
                                            CornerRadius="20" Background="{DynamicResource AccentSoftFillBrush}"
                                            Cursor="Hand" ToolTip="进入 UP 主主页"
                                            MouseLeftButtonUp="OnUpAvatarClick">
                                        <Border.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="查看头像大图" Click="OnViewUpAvatar">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE8A7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="13" VerticalAlignment="Center" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                                <MenuItem Header="下载头像到本地" Click="OnDownloadUpAvatar">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                   FontSize="13" VerticalAlignment="Center" />
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </Border.ContextMenu>
                                        <TextBlock x:Name="UpAvatarFallback" Text="&#xE77B;"
                                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                                        <TextBlock x:Name="UpNameText" FontSize="14" FontWeight="SemiBold" Text="UP 主"
                                                   Cursor="Hand" ToolTip="进入 UP 主主页"
                                                   MouseLeftButtonUp="OnUpAvatarClick" Background="Transparent" />
                                        <TextBlock x:Name="UpDescText" Style="{StaticResource MetaTextStyle}" Text="" Margin="0,2,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="2" x:Name="BtnFollow" Style="{StaticResource AccentButtonStyle}"
                                            Click="OnFollowClick" Padding="12,5" VerticalAlignment="Center"
                                            ToolTip="关注/取消关注">
                                        <StackPanel Orientation="Horizontal">
                                            <!-- 爱心图标(矢量, 不依赖字体)。
                                                 Fill 用 DynamicResource 跟随强调色前景色, 不要写死 White:
                                                 强调色偏浅时白心会糊在浅底上(和文字一样的坑) -->
                                            <Path Width="12" Height="12" Stretch="Uniform"
                                                  Fill="{DynamicResource TextOnAccentBrush}"
                                                  Data="M 12,21 L 10.55,19.65 C 5.4,15.04 2,12.05 2,8.5 C 2,5.42 4.42,3 7.5,3 C 9.24,3 10.91,3.81 12,5.08 C 13.09,3.81 14.76,3 16.5,3 C 19.58,3 22,5.42 22,8.5 C 22,12.05 18.6,15.04 13.45,19.65 Z" />
                                            <TextBlock x:Name="FollowLabel" Text="+ 关注" FontSize="12" Margin="5,0,0,0" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- 操作栏(2026-10-06 按设计稿「播放页_v4」重构): "图标 + 数量/文字"一行。
                                 计数来自 view 接口的 stat; 分享 = 复制链接; 离线缓存复用同一条下载链路。

                                 ★ 按 v4 稿第 07 节分成三组:
                                     标记这个视频(点赞/投币/收藏/稍后再看) | 传出去(分享) | 拿走(下载)
                                   组间一条竖线; 下载是低频"取出"类动作, 做得更小更淡。
                                 ★ 每个动作的色相是**固定**的(见 ApplyActionVisual), 不跟主题强调色走 ——
                                   红=情绪、金=货币、蓝=收进我的库、绿=拿走。用户把主题色改成绿色时,
                                   "点赞"跟着变绿会立刻毁掉这套分工。
                                 ★ 点赞/投币/收藏 沿用 B 站官方 SVG 几何(见文件头注释): 它们是**填充式**
                                   图形(带挖空), 只能靠 Fill 上色、不能改描边 —— 描边会把挖空部分的
                                   轮廓也画出来, 整个图标糊掉。所以这三个的激活反馈是"灰 → 该动作色相"。
                                   稍后再看/分享/下载 是矢量描边图标: 与旁边三个的线宽圆角风格统一,
                                   也不受字体缺失影响(v4 稿第 05 节的图标结论)。 -->
                            <!-- ★★★ 固定两行(2026-10-06 方案A, 用户审核通过)。
                                 以前用 WrapPanel 自动换行, 实测有两个硬伤:
                                   ① 换行点是"字数/位数"决定的 —— 同一颗按钮在不同视频里会跳到
                                      另一行(实测: 8 位数计数时「稍后再看」从第 1 行掉到第 2 行),
                                      用户没法靠肌肉记忆点;
                                   ② 断点落成 4+2, 第二行只剩两个, 右边空一大片, 看着像没排完。
                                 改成**写死两行**后断点恒定:
                                   第 1 行 = 点赞 投币 收藏      (标记这个视频, 三连)
                                   第 2 行 = 稍后再看 分享 下载   (收起来 / 传出去 / 拿走)
                                 实测两行各自的最大宽度: 真实计数下 240, 8 位数计数下 282,
                                 都远小于可用 351 ⇒ 任何视频都不会再换行。
                                 ★ 两行本身就是分组, 所以原先那两条分组竖线一并删掉
                                   (它们在第 2 行里会悬在「分享」和「下载」中间, 本来就怪)。 -->
                            <StackPanel x:Name="ActionBar" Margin="0,14,0,0">
                                <!-- ★★ 2026-10-06 改回**两行**(点赞 投币 收藏 / 稍后再看 分享 下载)。
                                     一行六列试过, 两个问题都出在"只有一行"上:
                                       ① 六个挤在 392px 里, 每个只剩 ~62px, 数字(三位数)几乎顶到边缘;
                                       ② 点击时 PlayActionPop 放大到 1.3 倍(20px 盒 → 26px),
                                          单行时水平方向没有富余, 弹跳溢出量会碰到相邻按钮。
                                     两行每行只有三个 ⇒ 每个能用 90px 以上, 图标与文字都松快。

                                     ★★ 图标**上下对齐**(2026-10-06 用户要求): 图标盒与文字格都设
                                        VerticalAlignment="Center", 两者等高居中对齐。
                                        ActionIconBox 固定 20×20, 所以一排里六个图标的基线也一致
                                        —— 与 XAML 里"图标格必须同为 20×20"是同一个道理。 -->
                                <Grid x:Name="ActionRowMark" VerticalAlignment="Center">
                                    <!-- 三列等分: 每行三个按钮, 每个可用 ~130px, 远用不完
                                         (实测最宽的「稍后再看」约 90px) ⇒ 数字与文字都不会被裁,
                                         也不必再靠调 Padding/Margin 去抠宽度。
                                         ★ 列宽用 "*" 而不是 Auto 是因为**文字会变**:
                                           「稍后再看」↔「已添加」宽度不同, Auto 会让某一列
                                           跟着变宽、把整排推着走; 等分则每列固定, 谁也不动谁。 -->
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- 点赞: 点过 = 图标和数字一起变红 -->
                                    <Button x:Name="BtnLike" Style="{StaticResource PlayerActionBtn}"  Grid.Column="0"
                                            Click="OnLikeClick" ToolTip="点赞 (L)">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="LikeIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path Data="{StaticResource LikeIconGeometry}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="LikeLabel" Text="--"
                                                       Style="{StaticResource ActionCountText}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 投币 -->
                                    <Button x:Name="BtnCoin" Style="{StaticResource PlayerActionBtn}"  Grid.Column="1"
                                            Click="OnCoinClick" ToolTip="投币 1 个">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="CoinIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path Data="{StaticResource CoinIconGeometry}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="CoinLabel" Text="--"
                                                       Style="{StaticResource ActionCountText}" />
                                        </StackPanel>
                                    </Button>
                                    <!-- 收藏 -->
                                    <Button x:Name="BtnFavorite" Style="{StaticResource PlayerActionBtn}"  Grid.Column="2"
                                            Click="OnFavoriteClick" ToolTip="收藏到云端收藏夹">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="FavIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path Data="{StaticResource FavoriteIconGeometry}"
                                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock x:Name="FavLabel" Text="--"
                                                       Style="{StaticResource ActionCountText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- ===== 第 2 行: 稍后再看 + 传出去(分享) + 拿走(下载) ===== -->
                                <Grid x:Name="ActionRowOther" Margin="0,2,0,0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                <!-- 稍后再看: 点一下加入/移出 B 站账号的云端列表。
                                         ★ 图标: 空心钟, 点亮时**只变色**(描边绑 Button.Foreground,
                                           由 ApplyActionVisual 统一刷成该动作的蓝色)。
                                         ★ 用户要求(2026-10-06): **不要打勾图案**, 保留时钟图标 + 跳动动画即可,
                                           所以这里只有一个空心钟, 不再切换到"实心圆+白勾"。
                                           ★ 旧版那两层(实心圆 LaterIconOnFill + 白勾 LaterIconOnCheck)已删除;
                                             它们换来的代价是两个 Path 必须同步显隐, 而用户明确表示不需要勾。 -->
                                    <Button x:Name="BtnWatchLater" Style="{StaticResource PlayerActionBtn}"  Grid.Column="0"
                                            Click="OnWatchLaterClick" ToolTip="加入稍后再看">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="LaterIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path x:Name="LaterIcon" Style="{StaticResource ActionGlyphStroke}"
                                                      Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                                                      Data="M3.4,12 A8.6,8.6 0 1 1 20.6,12 A8.6,8.6 0 1 1 3.4,12 Z M12,7.2 L12,12 L15.1,14" />
                                            </Grid>
                                            <!-- 文字**双层叠放**(稍后再看 / 已添加 叠在同一格): 宽度自动取两者
                                                 最大值, 切换只做透明度过渡 —— 否则"已添加"比"稍后再看"少一个字,
                                                 宽度一变后面整排按钮全被推着走(设计稿 v4 第 05 节修的就是这个 bug)。
                                                 ★ 这对两层在两行布局下是必需的(2026-10-06 改回两行时恢复)。 -->
                                            <Grid Margin="6,0,0,0" VerticalAlignment="Center">
                                                <TextBlock x:Name="LaterLabelOff" Text="稍后再看"
                                                           Style="{StaticResource ActionLabelText}" />
                                                <TextBlock x:Name="LaterLabelOn" Text="已添加" Opacity="0"
                                                           Style="{StaticResource ActionLabelText}" />
                                            </Grid>
                                        </StackPanel>
                                    </Button>

                                    <!-- 分享(复制链接): 几何取自设计稿「播放页_v4.html」的分享按钮,
                                         用户要求"按参照方案设计"。它由两段组成:
                                           · 箭头: 竖杆自 y15 上到 3.5, 顶端两撇
                                           · 托盘: 开口朝上的 U 形(自 y12.5 往下, 圆角 2),
                                             箭头竖杆伸到 y15 —— 比托盘口低 2.5, 等于"插进托盘里"
                                         ★★★ 两段必须合并进**同一个 Path**, 不能拆成两个 Path 元素。
                                           原因(实测验过, .probes/bd-share-real):
                                           Stretch="Uniform" 是按**该元素自己的几何包围盒**同比缩放的。
                                           箭头高(10.2)、托盘矮(10.1)却宽窄不同, 拆开后两者
                                           各自算出不同的缩放比(实测渲染尺寸 13.6x16.8 vs 16.8x13.6),
                                           结果是箭头被放大到戳穿托盘底部, 整个图标变形。
                                           合并之后只有一个包围盒, 两段共用同一套比例 ⇒ 严丝合缝。
                                           合并是安全的: 两段都是**只描边不填充**(Fill 透明)、
                                            线宽与圆角完全相同, 拆开本来只是为了分组可读。
                                            ★ 尺寸 18×18(与「下载」一致): 分享和下载是同一排的
                                              "传出去/拿走"动作, 图标大小必须对齐(2026-10-06 用户要求)。 -->
                                    <Button x:Name="BtnShare" Style="{StaticResource PlayerActionBtn}"  Grid.Column="1"
                                            Click="OnCopyLinkClick" ToolTip="复制视频链接">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Grid x:Name="ShareIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path x:Name="ShareGlyph" Width="18" Height="18"
                                                      Stretch="Uniform" Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.7" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M12,15 V3.5 M8.2,7.3 L12,3.5 L15.8,7.3 M4.5,12.5 V18.5 A2,2 0 0 0 6.5,20.5 H17.5 A2,2 0 0 0 19.5,18.5 V12.5" />
                                            </Grid>
                                            <TextBlock Text="分享" Style="{StaticResource ActionLabelText}" />
                                        </StackPanel>
                                    </Button>

                                    <!-- 离线缓存(下载) -->
                                    <Button x:Name="BtnCache" Style="{StaticResource PlayerActionBtn}"  Grid.Column="2"
                                            Click="OnCacheClick" ToolTip="离线缓存当前视频">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <!-- ★★★ 图标格必须与其它五个按钮**同为 20×20**(ActionIconBox),
                                                 否则整颗按钮的图文会被压低 —— 这是用户报"6 个按钮没有上下对齐"的根因。
                                                 (实测: 原来这里写死 Width/Height=18 ⇒ 图标格量成 17.6,
                                                  图标中心 15.2 而其它五个是 14.8, 差 0.4px 肉眼可辨;
                                                  文字中心也被推到 15.6。)
                                                 需要"下载看起来更小一档"时, 应该缩**里面的 Path**(18px),
                                                 而不是缩外面的 Grid —— 格子尺寸是排版基线, 不是观感参数。
                                                 ★ 不参与弹跳: 一次性动作, 弹一下反而像"可以反复点"。
                                                   ScaleTransform 由 PlayActionPop 按需新建(样式里放共享的会被冻结)。 -->
                                            <Grid x:Name="CacheIconBox" Style="{StaticResource ActionIconBox}">
                                                <Path Width="18" Height="18" Stretch="Uniform" Fill="Transparent"
                                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                      StrokeThickness="1.85" StrokeLineJoin="Round"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                                      Data="M12,3.5 L12,15 M8.2,11.3 L12,15 L15.8,11.3 M4.5,17 L4.5,19 A2,2 0 0 0 6.5,21 L17.5,21 A2,2 0 0 0 19.5,19 L19.5,17" />
                                            </Grid>
                                            <TextBlock Text="下载" Style="{StaticResource ActionLabelText}" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </StackPanel>

                            <!-- Tab 简介/评论 -->
                            <Border Margin="0,18,0,0" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="0,1,0,0" Padding="0,10,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <!-- 第 3 列给「合集」按钮: 它**不能**用 GroupName=ContentTab,
                                             那是个动作按钮不是 tab(点了要把内容区换成合集列表, 而不是"选中某个 tab")。
                                             也因此它必须有自己的列 —— 挤进 tab 组会把 简介/评论 这两个互斥的
                                             tab 拆开, 用户就看不出"这两个是一组的"了。 -->
                                        <ColumnDefinition Width="Auto" />
                                        <!-- 第 4 列 `*`: "返回评论列表"仍占这一格靠左。它默认 Collapsed,
                                             与「合集」按钮分开占列后, 两者同时出现时不会再叠在一起。 -->
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton x:Name="TabIntro" Grid.Column="0" GroupName="ContentTab"
                                                 Style="{StaticResource ContentTabStyle}" Content="简介"
                                                 Checked="TabIntro_Checked" />
                                    <RadioButton x:Name="TabComments" Grid.Column="1" GroupName="ContentTab"
                                                 Style="{StaticResource ContentTabStyle}" Content="评论"
                                                 Checked="TabComments_Checked" />
                                    <!-- 视频合集入口(2026-10-02 新增; 2026-10-03 改成与 简介/评论 统一风格):
                                         无合集的视频整个按钮**隐藏**(不是禁用) —— 右侧信息栏只有 400px,
                                         一个常年灰着的按钮既占位又像是坏了, 而 B 站自己在没有合集时也不给入口。
                                         ★ 用 ContentActionTabStyle: 与旁边两个 tab 完全同款的字号(15)/内边距(4,6)/
                                           悬停色, 并带同款下划线(展开时点亮) —— 见 Styles.xaml 里该样式的说明。
                                           ★ 2026-10-03 用户要求"与简介评论区的按钮统一风格, 并且就在他们的右边,
                                             不要隔那么远": 原来用 SubtleButtonStyle + 额外 Margin/Padding,
                                             视觉上是另一套语言、还被推远了 10px。现在那两笔已去掉。
                                         文案用显式 TextBlock 并绑到按钮 Foreground: 全局那个隐式 TextBlock 样式
                                         带 Foreground setter, 优先级高于继承, 直接写 Content="合集" 是改不动颜色的
                                         (面板展开时要把它点亮成强调色)。 -->
                                    <Button x:Name="BtnSeason" Grid.Column="2" Visibility="Collapsed"
                                            Style="{StaticResource ContentActionTabStyle}"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="OnSeasonToggleClick"
                                            ToolTip="查看/收起视频合集">
                                        <TextBlock Text="合集" FontSize="15"
                                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    </Button>
                                    <!-- 返回评论列表: 进了"评论详情"才出现, 就摆在"评论详情"右边(用户指定)。
                                         用按钮而不是文字链接 —— 这里是个"动作", 有底的按钮更好认、也更好点。 -->
                                    <Button x:Name="BtnBackToComments" Grid.Column="3" Visibility="Collapsed"
                                            Style="{StaticResource SubtleButtonStyle}"
                                            Content="返回评论列表" FontSize="12"
                                            Margin="10,0,0,0" Padding="10,4"
                                            HorizontalAlignment="Left" VerticalAlignment="Center"
                                            Click="OnCommentDetailBack"
                                            ToolTip="回到评论列表" />
                                </Grid>
                            </Border>

                            <Grid Margin="0,12,0,0" MinHeight="120">
                                <StackPanel x:Name="IntroPanel">
                                    <!-- 简介可自由选中复制: 只读文本框(无边框透明, 光标为文本) -->
                                    <TextBox x:Name="DescText" TextWrapping="Wrap" IsReadOnly="True"
                                             Background="Transparent" BorderThickness="0" Padding="0"
                                             Foreground="{DynamicResource TextSecondaryBrush}"
                                             FontSize="12" Cursor="IBeam" Text="加载中…" />
                                </StackPanel>
                                <StackPanel x:Name="CommentsPanel" Visibility="Collapsed">
                                    <!-- ===== 发表评论 =====
                                         放在列表上方(和 B 站网页版一致): 先能说话, 再看别人说什么。 -->
                                    <!-- ===== 回复态提示条(整个评论区只有这一个输入框) =====
                                         在列表页 = 发表评论(新楼层); 进详情页后自动切成"回复 @这层楼",
                                         点某条回复的"回复"按钮则切成"回复 @那个人" —— 发布时带 root/parent。
                                         这里的"取消"退回"发表评论"。 -->
                                    <Border x:Name="CommentDetailReplyHint" Visibility="Collapsed"
                                            Background="{DynamicResource AccentSoftFillBrush}"
                                            CornerRadius="4" Padding="8,3" Margin="0,0,0,6">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Style="{StaticResource LinkButtonStyle}"
                                                    Content="取消" FontSize="11" Padding="4,0"
                                                    Click="OnCommentReplyCancel"
                                                    ToolTip="取消回复, 改为发表评论" />
                                            <TextBlock x:Name="CommentDetailReplyTarget" FontSize="11"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource AccentTextBrush}" />
                                        </DockPanel>
                                    </Border>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="CommentDraft" Grid.Column="0"
                                                 Style="{StaticResource FluentTextBoxStyle}"
                                                 Height="66" MaxLength="1000"
                                                 TextWrapping="Wrap" AcceptsReturn="True"
                                                 VerticalScrollBarVisibility="Auto"
                                                 TextChanged="OnCommentDraftChanged"
                                                 PreviewKeyDown="OnCommentDraftPreviewKeyDown" />
                                        <Button x:Name="PostCommentButton" Grid.Column="1" Content="发表"
                                                Margin="8,0,0,0" Padding="20,8"
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource AccentButtonStyle}"
                                                Click="OnPostCommentClick"
                                                ToolTip="发表评论 (Enter)" />
                                    </Grid>
                                    <TextBlock x:Name="CommentPostHint" Style="{StaticResource MetaTextStyle}"
                                               Margin="0,0,0,10" TextWrapping="Wrap" />

                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <controls:LoadingRing x:Name="CommentLoadingRing" Width="14" Height="14" Visibility="Collapsed" />
                                        <TextBlock x:Name="CommentHint" Style="{StaticResource MetaTextStyle}"
                                                   Text="加载评论中…" Margin="6,0,0,0" VerticalAlignment="Center" />
                                        <!-- ===== 排序入口(热门 / 时间) =====
                                             用户要求: 摆在「共 N 条评论」**右边**, 带**矩形底色**便于识别(见样式注释)。
                                             ★ 间隔: 与左边那句说明文字留 12px(比两个词之间的 6px 大) ——
                                               不然"评论"和"热门"的底色会挤在一起看不出是两块。
                                             ★ 两个词之间只留 6px: 底色本身已经把边界画清楚了,
                                               再拉宽会显得是两个不相干的东西。
                                             ★ 只在一开始**加载完成**后才显示(见 UpdateCommentSortUi):
                                               加载中/失败/没评论时挂两个底色块在"加载评论中…"右边很怪。
                                             ★ 选中态由代码写 Tag="on"/"off" 驱动(见 UpdateCommentSortUi)。 -->
                                        <Button x:Name="BtnCommentSortHot" Style="{StaticResource CommentSortLinkStyle}"
                                                Content="热门" Margin="12,0,0,0"
                                                Tag="on" Visibility="Collapsed"
                                                Click="OnCommentSortHotClick" ToolTip="按热度排序" />
                                        <Button x:Name="BtnCommentSortTime" Style="{StaticResource CommentSortLinkStyle}"
                                                Content="时间" Margin="6,0,0,0"
                                                Tag="off" Visibility="Collapsed"
                                                Click="OnCommentSortTimeClick" ToolTip="按时间排序" />
                                    </StackPanel>
                                    <ItemsControl x:Name="CommentList"
                                                  ItemTemplate="{StaticResource CommentCardTemplate}" />

                                    <!-- ===== 评论详情(点"查看详情"进入) =====
                                         楼主区在上方(头像 + 昵称 + 时间/属地 + 正文 + 点赞),
                                         下方"全部回复"逐条带头像 —— 列表里的内联楼中楼不带头像,
                                         头像只在详情页展示。数据直接用评论自身的 Replies
                                         (含"展开更多", 与列表共用同一条加载逻辑), 不放大。 -->
                                    <Grid x:Name="CommentDetailPanel" Visibility="Collapsed">
                                        <!-- 标题与"返回评论列表"都挪到上方 tab 行了:
                                             进入详情后那个 tab 显示"评论详情", 返回链接就在它右边(用户指定)。 -->
                                        <!-- 直接放进外层右面板的滚动流里:
                                             内层再套 ScrollViewer 在 StackPanel 里拿不到高度
                                             约束(内容多高就多高), 表现为滚轮滚不动。 -->
                                        <StackPanel x:Name="CommentDetailHost">

                                                <!-- ② 焦点条目(楼主或被点开的回复): 头像在上方 -->
                                                <ContentControl x:Name="CommentDetailCard">
                                                    <ContentControl.ContentTemplate>
                                                        <DataTemplate>
                                                            <StackPanel>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                                            Background="{DynamicResource AccentSoftFillBrush}"
                                                                            ClipToBounds="True"
                                                                            Cursor="Hand" ToolTip="进入 TA 的主页"
                                                                            MouseLeftButtonUp="OnCommentAvatarClick"
                                                                            behaviors:Cover.Source="{Binding UserFace}">
                                                                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                                   FontSize="16" Foreground="{DynamicResource AccentTextBrush}"
                                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                    </Border>
                                                                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <!-- 置顶评论点进来后这里也要显示"置顶"标(与列表模板一致) -->
                                                                            <Border Style="{StaticResource PinnedBadgeStyle}"
                                                                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="置顶" FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold" />
                                                                            <Border Style="{StaticResource LevelBadgeStyle}"
                                                                                    Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="{Binding LevelText}" FontSize="9.5" Foreground="White" />
                                                                            </Border>
                                                                            <Border Style="{StaticResource UpBadgeStyle}"
                                                                                    Visibility="{Binding IsUp, Converter={StaticResource BoolToVis}}">
                                                                                <TextBlock Text="UP" FontSize="9.5" FontWeight="SemiBold" Foreground="White" />
                                                                            </Border>
                                                                        </StackPanel>
                                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                                            <TextBlock Text="{Binding RcTime}" Style="{StaticResource MetaTextStyle}" FontSize="11" />
                                                                            <TextBlock Text="{Binding Location}" FontSize="11" Margin="8,0,0,0"
                                                                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                                                        </StackPanel>
                                                                    </StackPanel>
                                                                </StackPanel>
                                                                <controls:CommentText Comment="{Binding}" FontSize="13.5" Margin="0,8,0,0"
                                                                                      Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <ContentControl Content="{Binding}"
                                                                                HorizontalAlignment="Left" Margin="0,6,0,0"
                                                                                ContentTemplate="{StaticResource CommentActionBarTemplate}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ContentControl.ContentTemplate>
                                                </ContentControl>

                                                <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,12" />
                                                <!-- 相关回复共 N 条(与 B 站 App 详情页文案一致) -->
                                                <TextBlock Text="{Binding ReplyCount, StringFormat=相关回复共 {0} 条}"
                                                           FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10"
                                                           Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}" />
                                                <!-- 楼中楼回复: 每条带头像 + 等级/UP 标 + 赞踩回复 -->
                                                <ItemsControl x:Name="DetailRepliesList" ItemsSource="{Binding Replies}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,14">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                                                                        Background="{DynamicResource AccentSoftFillBrush}" ClipToBounds="True"
                                                                        VerticalAlignment="Top"
                                                                        Cursor="Hand" ToolTip="进入 TA 的主页"
                                                                        MouseLeftButtonUp="OnCommentAvatarClick"
                                                                        behaviors:Cover.Source="{Binding UserFace}">
                                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                                               FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                                                    <StackPanel Orientation="Horizontal">
                                                                        <TextBlock Text="{Binding UserName}" FontSize="12" FontWeight="SemiBold" />
                                                                        <Border Style="{StaticResource LevelBadgeStyle}"
                                                                                Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="{Binding LevelText}" FontSize="9" Foreground="White" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource UpBadgeStyle}"
                                                                                Visibility="{Binding IsUp, Converter={StaticResource BoolToVis}}">
                                                                            <TextBlock Text="UP" FontSize="9" FontWeight="SemiBold" Foreground="White" />
                                                                        </Border>
                                                                        <TextBlock Text="{Binding RcTime}" Style="{StaticResource MetaTextStyle}"
                                                                                   FontSize="10" Margin="8,1,0,0" />
                                                                        <TextBlock Text="{Binding Location}" FontSize="10" Margin="8,1,0,0"
                                                                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                                                                   Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                    <controls:CommentText Comment="{Binding}" FontSize="12" Margin="0,3,0,0"
                                                                                          Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                                        <ContentControl Content="{Binding}"
                                                                                        ContentTemplate="{StaticResource CommentActionBarTemplate}" />
                                                                        <!-- 查看对话: 只在"回复楼中楼里某个人"的回复上出现, 点击定位到被回复的那条 -->
                                                                        <Button Content="查看对话"
                                                                                Style="{StaticResource LinkButtonStyle}"
                                                                                FontSize="11" Margin="10,0,0,0" Padding="0"
                                                                                VerticalAlignment="Center"
                                                                                Click="OnViewConversationClick"
                                                                                ToolTip="定位到被回复的那条评论"
                                                                                Visibility="{Binding IsReplyToSomeone, Converter={StaticResource BoolToVis}}" />
                                                                    </StackPanel>
                                                                </StackPanel>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Button Content="{Binding ReplyMoreText}"
                                                        Style="{StaticResource LinkButtonStyle}"
                                                        FontSize="12" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="0,2"
                                                        Click="OnLoadMoreRepliesClick"
                                                        Visibility="{Binding HasMoreReplies, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- ============ 合集面板(点 tab 行右侧的「合集」滑出, 2026-10-02 新增) ============
                     ★ 为什么是"盖在信息栏上的浮层"而不是"信息栏里的第四个 tab":
                       合集列表和简介/评论是**互斥**的内容, 走 tab 要动 GroupName=ContentTab 那套结构,
                       还会让"合集"这一个动作入口获得一个自己的持久选中态(点了普通视频之后那个 tab
                       还亮着, 但面板是空的); 浮层则天然"跟着当前视频走", 换片清空即可。
                     ★ 用 Grid 而不是 Popup: Popup 是独立 HWND, 会盖在 VideoView 那个 airspace 之上,
                       窗口缩放/全屏切换时两者位置容易错开; 这里只需要盖住右侧 400px, 同窗口内最稳。
                     IsHitTestVisible 靠 Visibility 控制: 收起时整棵树既不渲染也不参与命中测试。
                     ★★★ 底色必须**不透明** —— 这是浮层, 底下就是简介/评论的内容。
                       ★★ 2026-10-05 修"亚克力下合集页背景几乎透明"(用户截图): 这个绑定原先写的是
                         FloatingFillBrush, 注释也假定它**永远不透明**(它现在是 #E8EAED/#2D2D2D 实色)。
                         但 ThemeService.ApplyAcrylicSurfaces 为了让**右下角工具列**也有亚克力质感,
                         在亚克力开启时把这个**全局共享键**覆盖成了 70% 半透明(#B3ECEDEF)。
                         FloatingFillBrush 不止工具列在用 —— 合集面板整块因此被改成半透明, 压在简介/
                         评论内容上, 文字整片透上来糊成一片, 正是上面这段注释当年要防的现象。
                         ★ 真凶在颜色覆盖层, 不在绑定本身: 所以"把 FloatingFillBrush 调不透明"
                           那种改法是治不好的 —— 工具列要半透明正是它自己的需求。
                       ★ 正确解法是**另立一个专用键**: 工具列浮在卡片封面上, 透出壁纸才叫亚克力质感;
                         合集面板底下是内容, 必须实。两者需求相反, 不能共用一个键。
                         OverlaySurfaceBrush 恒为不透明, 且刻意**不进** ApplyAcrylicSurfaces 的
                         覆盖清单(见 Colors.Light.xaml / Colors.Dark.xaml)。 -->
                <Grid x:Name="SeasonPanel" Visibility="Collapsed"
                      Background="{DynamicResource OverlaySurfaceBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 头部: 合集标题 + 集数 + 关闭。左边留 1px 竖线, 与信息栏的分隔线对齐 -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                            Padding="20,18,14,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock x:Name="SeasonTitleText" FontSize="15" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Text="合集" LineHeight="21" />
                                <TextBlock x:Name="SeasonMetaText" Style="{StaticResource MetaTextStyle}"
                                           Margin="0,4,0,0" Text="" />
                            </StackPanel>
                            <!-- 关闭按钮: 用显式 Style(项目硬规定, Button 不许裸写),
                                 图标字形必须写进显式 TextBlock —— 全局隐式 TextBlock 样式带 Foreground
                                 setter, 会吃掉 Button.Foreground, 字形颜色就跟着主题跑偏了。 -->
                            <Button x:Name="BtnSeasonClose" Grid.Column="1" VerticalAlignment="Top"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    Width="30" Height="30" Padding="0" Margin="8,0,0,0"
                                    Click="OnSeasonCloseClick" ToolTip="收起合集">
                                <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            </Button>
                        </Grid>
                    </Border>

                    <!-- 列表: 展平数据 + IsSectionStart 画分组标题。
                         用 ListBox 而不是 ItemsControl: 一是要**选中态高亮当前集**,
                         二是选中项自带 BringIntoView(打开面板要滚到正在播的那一集)。 -->
                    <ListBox x:Name="SeasonList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             Padding="10,4,10,10"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSeasonEpisodeSelected"
                             behaviors:SmoothScroll.Enabled="True">
                        <ListBox.Resources>
                            <!-- 隐式样式会吃掉继承的前景色(全局隐式 TextBlock 样式带 Foreground setter),
                                 所以模板里每一个 TextBlock 都显式给刷子。 -->
                            <Style x:Key="SeasonTitleStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12.5" />
                                <Setter Property="TextWrapping" Value="Wrap" />
                                <Setter Property="MaxHeight" Value="34" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Style>
                            <Style x:Key="SeasonSectionHeaderStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                            </Style>
                        </ListBox.Resources>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <!-- ★ 绝不设 Focusable=False: 鼠标按下时 Focus() 失败会短路选中逻辑,
                                     SelectionChanged 永不触发(切换清晰度踩过同一个坑), 于是"点了没反应"。
                                     去焦点框用 FocusVisualStyle。 -->
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent"
                                                    CornerRadius="7" Padding="7,6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource ControlFillHoverBrush}" />
                                                </Trigger>
                                                <!-- 当前正在播的那一集: 强调色浅底 + 描边, 与"评论详情"那种选中观感一致。
                                                     没用左边那条竖条: 分组标题也在同一列里, 竖条会和它打架。 -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background"
                                                            Value="{DynamicResource AccentSoftFillBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush"
                                                            Value="{DynamicResource AccentBorderFillBrush}" />
                                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <!-- 分组标题: 只在 GroupsHeaderVisible 时出现。
                                         ★ 为什么在条目模板内部画、而不是外层再套一层带 GroupStyle 的 CollectionView:
                                           数据源里"分组"是**有序且可重复**的(section title 会重复出现),
                                           套 GroupStyle 得先构造 CollectionView + 改数据源类型, 而这里
                                           每条只需要知道自己是不是分组第一集 —— 一个 bool 就够, 少一层结构。 -->
                                    <TextBlock x:Name="SectionHeader"
                                               Style="{StaticResource SeasonSectionHeaderStyle}"
                                               Text="{Binding SectionTitle}"
                                               Margin="7,12,7,6"
                                               Visibility="{Binding ShowSectionHeader, Converter={StaticResource BoolToVis}}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 封面 16:9, 宽 74 => 高 42。Cover 附加属性按元素宽度解码, 小图省内存 -->
                                        <Border Grid.Column="0" Width="74" Height="42" CornerRadius="5"
                                                ClipToBounds="True"
                                                Background="{DynamicResource PlaceholderBrush}"
                                                behaviors:Cover.Source="{Binding Cover}" />
                                        <!-- 集序号压在封面左上角: 与视频卡片上的时长角标同款做法 -->
                                        <Border Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Top"
                                                Margin="3,3,0,0" CornerRadius="3" Padding="4,1"
                                                Background="{DynamicResource DurationBadgeBackgroundBrush}">
                                            <TextBlock Text="{Binding Index}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <!-- 时长压在封面右下角 -->
                                        <Border Grid.Column="0" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                Margin="0,0,3,2" CornerRadius="3" Padding="3,1"
                                                Background="{DynamicResource DurationBadgeBackgroundBrush}"
                                                Visibility="{Binding DurationText, Converter={StaticResource StrToVis}}">
                                            <TextBlock Text="{Binding DurationText}" FontSize="10" Foreground="White" />
                                        </Border>
                                        <StackPanel Grid.Column="2" Margin="9,0,0,0" VerticalAlignment="Center">
                                            <!-- 正在播的那一集由 ListBoxItem 的 IsSelected 触发器整行点亮
                                                 (强调色浅底 + 描边), 标题不再单独变色 —— 条目是普通 POCO,
                                                 没有变更通知, 单独给它一个 IsPlaying 字段是改不动的。 -->
                                            <TextBlock x:Name="EpTitle" Text="{Binding Title}"
                                                       Style="{StaticResource SeasonTitleStyle}"
                                                       ToolTip="{Binding Title, Mode=OneWay}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <!-- 播放量; 拿不到就整段隐藏(不显示"▶ 0") -->
                                                <TextBlock Text="{Binding ViewCountText}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                                <TextBlock Text=" · " FontSize="10.5" Margin="1,0"
                                                           Foreground="{DynamicResource TextTertiaryBrush}"
                                                           Visibility="{Binding ViewCountText, Converter={StaticResource StrToVis}}" />
                                                <TextBlock Text="{Binding PubDateShort}" FontSize="10.5"
                                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- 底部: 加载中/错误提示。放在底部而不是顶部, 免得加载时列表区域高度跳一下 -->
                    <Border Grid.Row="2" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1,0,0,0"
                            Padding="20,10,20,14">
                        <StackPanel Orientation="Horizontal">
                            <controls:LoadingRing x:Name="SeasonLoadingRing" Width="14" Height="14"
                                                  Visibility="Collapsed" />
                            <TextBlock x:Name="SeasonHint" Style="{StaticResource MetaTextStyle}"
                                       Text="" Margin="6,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
                <!-- 本地 Toast -->
                <Border x:Name="LocalToastBorder" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Margin="0,12,12,0" Padding="12,7" CornerRadius="6"
                        Background="{DynamicResource InfoBarBackgroundBrush}"
                        BorderBrush="{DynamicResource AccentBorderFillBrush}" BorderThickness="1"
                        Visibility="Collapsed" Opacity="0" IsHitTestVisible="False">
                    <TextBlock x:Name="LocalToastText" FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</views:FluentWindow>
