<views:FluentWindow x:Class="BiliDesk.Views.Windows.UpdatePromptWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiliDesk.Views"
                    Title="发现新版本"
                    Width="600" Height="520" MinWidth="480" MinHeight="400"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">
    <!--
        「发现新版本」弹窗(自动检查与手动检查共用)。
        只做"展示 + 跳浏览器", 不做程序内下载(职责边界见 UpdateChecker 的注释)。
        窗口底色不在这里写: FluentWindow.ApplyChrome 会按当前主题设(与其它窗口一致)。
    -->
    <Grid Margin="24,20,24,20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="Subline" Margin="0,6,0,0" FontSize="12"
                       Foreground="{DynamicResource TextTertiaryBrush}" />
        </StackPanel>

        <!-- 发布说明正文: 按纯文本展示(它本来就是发布脚本写给用户看的那段, 不需要 markdown 渲染) -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="10" Padding="20,16"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                <TextBlock x:Name="NotesText" TextWrapping="Wrap" FontSize="13" LineHeight="22"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSkip" Content="跳过此版本" Style="{StaticResource SubtleButtonStyle}"
                        Padding="14,9" Click="OnSkipClick"
                        ToolTip="这个版本不再自动提醒(下一个新版本仍会提醒)" />
                <Button Content="以后再说" Style="{StaticResource SubtleButtonStyle}"
                        Margin="10,0,0,0" Padding="14,9" Click="OnLaterClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="前往 GitHub 下载" Style="{StaticResource AccentButtonStyle}"
                        Padding="20,9" Click="OnGithubClick" />
            </StackPanel>
        </Grid>
    </Grid>
</views:FluentWindow>
