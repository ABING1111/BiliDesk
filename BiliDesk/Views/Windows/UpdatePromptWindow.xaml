<views:FluentWindow x:Class="BiliDesk.Views.Windows.UpdatePromptWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:BiliDesk.Views"
                    xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
                    Title="发现新版本"
                    Width="660" Height="640" MinWidth="520" MinHeight="460"
                    WindowStartupLocation="CenterOwner"
                    ShowInTaskbar="False">
    <!--
        「发现新版本」弹窗(自动检查与手动检查共用)。
        只做"展示 + 跳浏览器", 不做程序内下载(职责边界见 UpdateChecker 的注释)。
        窗口底色不在这里写: FluentWindow.ApplyChrome 会按当前主题设(与其它窗口一致)。

        ★ 2026-11-21 重做观感: 原来是把 Release 的 Markdown 原文直接塞进 TextBlock,
          用户看到的是 `### 新增` / `- **xxx**` / ```text 这类编辑态文字。
          现在分成三段: 顶部新版本 Hero(图标 + 版本号 + 当前版本/发布日期) →
          中间渲染后的更新说明(与关于页更新日志共用 MarkdownView) →
          底部操作栏。发布说明里的下载/SHA256 段由 ReleaseNotes.Clean 裁掉。
    -->
    <Grid Margin="24,20,24,20" Background="{DynamicResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ==================== 新版本 Hero ==================== -->
        <Border Grid.Row="0" CornerRadius="14" Padding="20,18"
                Background="{DynamicResource AccentSoftFillBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Width="46" Height="46" CornerRadius="12" VerticalAlignment="Center">
                    <Border.Background>
                        <!-- ★ 资源 URI 必须带程序集名, 否则探针宿主会按入口程序集解析 -->
                        <ImageBrush ImageSource="pack://application:,,,/BiliDesk;component/Assets/app.png"
                                   Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <!-- 小标题用次级灰而不是强调色: 强调色在"淡强调底"上, 深色主题 + 深色系
                         系统强调色(如 Windows 蓝)时对比度会掉得厉害; 版本号与胶囊已经承担了强调。 -->
                    <TextBlock Text="发现新版本" FontSize="12" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="NewVersionText" FontSize="24" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <Border Margin="10,4,0,0" CornerRadius="9" Padding="8,2"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentSoftFillStrongBrush}">
                            <TextBlock Text="最新版本" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextStrongBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="VersionLine" Margin="0,3,0,0" FontSize="12"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ==================== 更新说明 ==================== -->
        <Border Grid.Row="1" Margin="0,16,0,0" CornerRadius="12" Padding="20,14,14,14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Text="更新说明" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextTertiaryBrush}" />

                <ScrollViewer Grid.Row="1" Margin="0,10,0,0" Padding="0,0,8,0"
                              VerticalScrollBarVisibility="Auto">
                    <controls:MarkdownView x:Name="NotesView" />
                </ScrollViewer>

                <TextBlock x:Name="EmptyNotes" Grid.Row="1" Margin="0,8,0,0"
                           FontSize="12.5" TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Text="这个版本没有填写发布说明。" />
            </Grid>
        </Border>

        <!-- ==================== 操作栏 ==================== -->
        <Grid Grid.Row="2" Margin="0,18,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                <Button x:Name="BtnSkip" Content="跳过此版本" Style="{StaticResource SubtleButtonStyle}"
                        Padding="14,9" Click="OnSkipClick"
                        ToolTip="这个版本不再自动提醒(下一个新版本仍会提醒)" />
                <Button Content="以后再说" Style="{StaticResource SubtleButtonStyle}"
                        Margin="10,0,0,0" Padding="14,9" Click="OnLaterClick" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="打开下载页" Style="{StaticResource AccentButtonStyle}"
                        Padding="20,9" Click="OnGithubClick" />
            </StackPanel>
        </Grid>
    </Grid>
</views:FluentWindow>
