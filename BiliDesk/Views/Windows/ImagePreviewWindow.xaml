<vw:FluentWindow x:Class="BiliDesk.Views.Windows.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vw="clr-namespace:BiliDesk.Views"
        Title="图片预览"
        Width="980" Height="700"
        MinWidth="360" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowSolidDarkBrush}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border CornerRadius="8" ClipToBounds="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.45" Color="Black" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 自绘标题栏: 图片查看器用纯黑底, 让画面成为唯一焦点 -->
            <Border Grid.Row="0" Background="#CC000000" MouseLeftButtonDown="OnTitleBarMouseDown">
                <Grid Margin="14,10,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TitleText" Text="图片预览"
                               Foreground="#F0F0F0" FontSize="13"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}"
                            Content="&#xE711;" FontSize="12" Width="32" Height="32"
                            Click="OnCloseClick" ToolTip="关闭 (Esc)"
                            Foreground="#F0F0F0" />
                </Grid>
            </Border>

            <!-- 图片区: 滚轮缩放 / 拖动平移 / 双击切换 1:1 -->
            <Grid Grid.Row="1" Background="#0E0E0E" ClipToBounds="True">
                <Image x:Name="PreviewImage" Cursor="Hand"
                       Stretch="None"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock x:Name="HintText" Text="正在加载图片…"
                           Foreground="#909090" FontSize="13"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>

            <!-- 底部工具条 -->
            <Border Grid.Row="2" Background="#CC000000">
                <Grid Margin="16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="滚轮缩放 · 拖动平移 · 双击 1:1 · 右键/Esc 关闭"
                               Foreground="#9A9A9A" FontSize="11"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="ZoomText" Text="100%"
                                   Foreground="#C8C8C8" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,14,0" />
                        <Button x:Name="SaveButton" Style="{StaticResource AccentButtonStyle}"
                                Content="保存到本地" Padding="16,6" FontSize="12"
                                Click="OnSaveClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</vw:FluentWindow>
