<UserControl x:Class="BiliDesk.Views.Controls.VideoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             Width="{Binding (behaviors:CardWall.ItemWidth), RelativeSource={RelativeSource Self}}"
             Margin="8,10"
             Background="Transparent" Focusable="False"
             PreviewMouseLeftButtonDown="OnCardPress"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave" MouseMove="OnHoverMove">
    <StackPanel x:Name="Root">
        <!-- ===== 封面卡片(卡片本体) =====
             用户要求: 卡片只保留封面, 标题等文字挪到封面**下方**; 封面四角圆角。
             悬停放大保留(作用在封面上), 同时封面角标淡出 —— 见 CoverBadgeFadeStyle。

             ★ 封面的宽高都不写死: 宽度继承自卡片墙(CardWall.ItemWidth), 高度由它按 16:9 算好
             (CardWall.CoverHeight)。两者都有设计值兜底(236 / 132), 所以没挂卡片墙的列表(收藏页的
             收藏夹卡片等)行为与从前一致。写死 132 的话, 卡片被卡片墙放大后封面会被拉扁。 -->
        <Border x:Name="CoverCard" CornerRadius="8" ClipToBounds="True"
                Height="{Binding (behaviors:CardWall.CoverHeight),
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{DynamicResource PlaceholderBrush}"
                Cursor="Hand" MouseLeftButtonUp="OnClick">
            <Grid>
                <!-- 封面图: **圆角必须写在它自己身上**。外层的 CoverCard 虽然也有 CornerRadius,
                     但 Border 的圆角只裁它自己的背景/边框, **不裁子元素** —— 图走的是 Cover 附加属性
                     设在 Background 上, 子元素不圆角就会把四个角顶成直角(用户实测反馈)。 -->
                <Border x:Name="CoverBox" CornerRadius="8" behaviors:Cover.Source="{Binding Cover}" />

                <!-- 左下: 播放量(参考 B 站网页版卡片)。悬停放大封面时角标淡出,
                     免得压在放大的画面上。拿不到(空串)就整段藏起来。
                     ★ 2026-11-28 用户要求去掉弹幕数角标, 卡片上只留播放量。
                     ★ 2026-11-28 历史卡片也不再显示播放量(那条记录看了多少次跟"我"无关):
                       历史解析**不填 ViewCount**(见 ApiClient.GetCloudHistoryAsync), 这里靠
                       ViewCountText 为空自动整段隐藏 —— 首页/搜索等页面照旧显示。 -->
                <StackPanel x:Name="StatsBadge" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="8,0,0,8"
                            Style="{StaticResource CoverBadgeFadeStyle}">
                    <Border CornerRadius="4" Padding="6,2"
                            Background="{DynamicResource DurationBadgeBackgroundBrush}"
                            Visibility="{Binding ViewCountText, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ViewCountText, Mode=OneWay}" FontSize="11"
                                       Foreground="#F2FFFFFF" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右下: 时长。历史卡片会变成"已看 / 总长"("1:20 / 1:21", 见 VideoItem.DurationBadgeText);
                     其它页面没有进度数据, 取到的就是原总时长, 一个字都不变。 -->
                <Border x:Name="DurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8" CornerRadius="4" Padding="6,2"
                        Background="{DynamicResource DurationBadgeBackgroundBrush}"
                        Style="{StaticResource CoverBadgeFadeStyle}"
                        Visibility="{Binding DurationBadgeText, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="{Binding DurationBadgeText}" Foreground="White" FontSize="11" />
                </Border>

                <!-- 底部: 观看进度条(2026-11-28 用户要求, 参考 B 站历史卡片)。
                     ★ 只有历史条目有 ProgressSec(云端历史的 progress/duration), 其它页面 ShowProgressBar
                       恒为 false, 这一块整个 Collapsed —— 首页/搜索/收藏的卡片版式完全没动。
                     ★ 内缩 2px + 圆角 1.5: 封面四角是 8 的圆角, 进度条贴到最边上会把这四个角顶成直角。
                     ★ 悬停**不淡出**(与上面两枚角标不同): 进度是"这条看到哪了"的核心信息,
                       鼠标一放上去就消失反而没法确认。IsHitTestVisible=False 不抢点击。
                     ★ 填充条用 RenderTransform 的 ScaleX 缩放(比例直接绑 ProgressRatio),
                       不参与布局, 也就不需要"比例 → 宽度"的转换器。 -->
                <Grid VerticalAlignment="Bottom" Height="3" Margin="2,0,2,2"
                      IsHitTestVisible="False"
                      Visibility="{Binding ShowProgressBar, Converter={StaticResource BoolToVis}}">
                    <Rectangle Fill="#59000000" RadiusX="1.5" RadiusY="1.5" />
                    <Rectangle Fill="{DynamicResource AccentBrush}" RadiusX="1.5" RadiusY="1.5"
                               RenderTransformOrigin="0,0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform ScaleX="{Binding ProgressRatio}" />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>

                <!--
                    编辑模式的选中圆标(压在封面左上角)。
                    只在页面把 Selectable 打开时出现 —— 平时它是 Collapsed 的,
                    连命中测试都不参与, 所以不影响正常点击播放。
                    圆标的填充由 CardSelectBubble 里的 DataTrigger 按 IsSelected 切换,
                    对勾显隐直接绑 IsSelected(BoolToVis 就够了, 不必为此再加一个转换器)。
                -->
                <Border Style="{StaticResource CardSelectBubble}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0"
                        Visibility="{Binding Selectable,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                </Border>

                <!--
                    右上: 「稍后再看」悬浮按钮(2026-11-12 用户要求, 参考 B 站客户端)。
                    · 只在鼠标悬停封面时出现(见 OnMouseEnter/OnMouseLeave), 默认 Opacity=0
                      且 IsHitTestVisible=False, 不参与命中, 不影响正常点击播放;
                    · 鼠标悬停按钮本身时, 右边展开「稍后再看」文字标签;
                    · 直播卡片没有这个动作(ShowLaterBar 里直接不显示)。
                -->
                <StackPanel x:Name="LaterBar" Orientation="Vertical"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,8,8,0" Opacity="0" IsHitTestVisible="False">
                    <!-- ★ HorizontalAlignment=Right: 标签文字在"稍后再看"和"从稍后再看移除"之间变长时,
                         StackPanel 宽度会跟着变; 按钮若不靠右, 中心位置会左移, 用户再点就点到封面了(实测踩到)。 -->
                    <Border x:Name="LaterButton" Width="28" Height="28" CornerRadius="14"
                            HorizontalAlignment="Right"
                            Background="#B3000000" Cursor="Hand"
                            MouseLeftButtonUp="OnAddWatchLaterClick"
                            MouseEnter="OnLaterButtonEnter" MouseLeave="OnLaterButtonLeave">
                        <TextBlock x:Name="LaterIcon" Text="&#xE7C1;"
                                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="13" Foreground="White"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Border x:Name="LaterLabel" CornerRadius="6" Padding="7,3" Margin="0,5,0,0"
                            Background="#CC000000" Opacity="0" IsHitTestVisible="False">
                        <TextBlock x:Name="LaterLabelText" Text="稍后再看" FontSize="11" Foreground="White" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 封面下方文字区(无卡片底, 直接衬在页面背景上) =====
             两块: 标题(可点播放) / UP 主名(可点进主页) · 日期。
             (UP 徽章、点赞数都按用户要求已从卡片上撤掉; 数据仍在, 需要时再挂。) -->
        <StackPanel Margin="2,8,2,0">
            <TextBlock x:Name="TitleText" Text="{Binding Title}"
                       Style="{StaticResource CardTitleStyle}"
                       Cursor="Hand" MouseLeftButtonUp="OnTitleClick"
                       ToolTip="{Binding Title, Mode=OneWay}" />
            <!-- 第二行: 左边是"已关注 · UP 名 · 分区 · 日期", 右端是**观看时间**(历史页才有)。
                 ★ 用两列 Grid 而不是一根横排 StackPanel: 观看时间要贴卡片右下角(用户 2026-11-28 要求),
                   横排里它只能跟在日期后面, 位置随作者名长短漂移。
                 ★ 非历史卡片的 HasViewTime 恒为 false, 右列 Auto 宽度收到 0 —— 版式与改前完全一致。 -->
            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- ClipToBounds: 卡片被压到最窄(220)且观看时间又长(跨年那串)时, 作者名那头
                     宁可被裁掉一点, 也不能画到右边的时间上(StackPanel 默认不裁子元素)。 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                    <!-- 「已关注」标签(2026-11-08): 放在第二行**行首**, 即 UP 主名左边 ——
                         与 B 站网页版/用户给的参考图一致(「[已关注] 差评君 · 10-24」)。
                         首页推荐流由接口的 is_followed 直接给出; 搜索页由 SearchViewModel
                         在结果展示后批量查 /x/relation/relations 回填(2026-11-14)。
                         其它列表恒为 false, 标签自动隐藏。 -->
                    <Border Style="{StaticResource FollowedBadgeStyle}"
                            Visibility="{Binding IsAuthorFollowed, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="已关注" FontSize="10" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextOnAccentBrush}" />
                    </Border>
                    <TextBlock x:Name="AuthorText" Text="{Binding Author}"
                               Style="{StaticResource CardAuthorStyle}"
                               Cursor="Hand" MouseLeftButtonUp="OnAuthorClick"
                               TextTrimming="CharacterEllipsis" MaxWidth="100"
                               ToolTip="{Binding Author, Mode=OneWay}" />
                    <!-- 直播卡片: 「UP 名 · 分区名」(2026-11-08)。
                         视频稿件的 AreaName 为空, 这里的点与文字都自动隐藏。 -->
                    <TextBlock Text="·" Style="{StaticResource MetaTextStyle}" Margin="4,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding AreaName, Converter={StaticResource StrToVis}}" />
                    <TextBlock Text="{Binding AreaName, Mode=OneWay}"
                               Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="96"
                               ToolTip="{Binding AreaName, Mode=OneWay}"
                               Visibility="{Binding AreaName, Converter={StaticResource StrToVis}}" />
                    <!-- 发布日期(部分接口没给, 空着即可): 前面那个点只在有日期时显示。
                         ★ 绑 CardDateText 而不是 PubDateShort: 历史条目已经用观看时间顶掉这一格
                           (历史里 Pubdate 就是观看时间, 再显示一次 "11-28" 是同一句话两遍)。 -->
                    <TextBlock Text="·" Style="{StaticResource MetaTextStyle}" Margin="4,0"
                               VerticalAlignment="Center"
                               Visibility="{Binding CardDateText, Converter={StaticResource StrToVis}}" />
                    <TextBlock Text="{Binding CardDateText, Mode=OneWay}"
                               Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 右端: 观看时间("今天 14:30" / "昨天 21:05" / "11月20日 18:40")。
                     ★ 文案由 VideoItem.FormatViewTime 在解析历史时算好(ViewTimeText), 卡片只负责摆位置。
                     ★ TextTrimming 不用: 时间被截成"11月20…"比不显示更糟 —— 作者名那边本来就有
                       MaxWidth 限着, 最小卡片宽(220)下这一行放得下。 -->
                <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                           Text="{Binding ViewTimeText}"
                           Style="{StaticResource MetaTextStyle}"
                           Foreground="{DynamicResource TextTertiaryBrush}"
                           Visibility="{Binding HasViewTime, Converter={StaticResource BoolToVis}}" />
            </Grid>
        </StackPanel>
    </StackPanel>
</UserControl>