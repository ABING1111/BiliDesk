<UserControl x:Class="BiliDesk.Views.Controls.VideoCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             Width="{Binding (behaviors:CardWall.ItemWidth), RelativeSource={RelativeSource Self}}"
             Margin="8,10"
             Background="Transparent" Focusable="False"
             MouseEnter="OnMouseEnter" MouseLeave="OnMouseLeave">
    <UserControl.Resources>
        <!--
            卡片本体: 封面 + 文字区。用户指定"标题文字直接以软件背景衬托",
            所以 Border 的 Background 是透明的(旧版是 CardBackgroundBrush, 文字区多出一条底色带);
            保留 1px 描边 + 圆角, 让每张卡片在列表里仍然互相独立。
            悬停反馈走代码里的整卡缩放动画(见 VideoCard.xaml.cs)。
        -->
        <Style x:Key="CardSurfaceStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
        </Style>

        <!--
            编辑模式下的选中圆标。基于全局 SelectionBubbleStyle, 只加一条"选中就换成强调色"的触发器。
            放在卡片自己的资源里而不是全局: 它依赖卡片 DataContext(= VideoItem)上的 IsSelected,
            是这一处专有的绑定, 放进全局样式表只会让别人误用。
        -->
        <Style x:Key="CardSelectBubble" TargetType="Border"
               BasedOn="{StaticResource SelectionBubbleStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- ===== 封面下方文字区 =====
             用户要求: 鼠标**停在标题/UP 主名上**时才变 B 站粉(不是整卡悬停就变), 所以
             DataTrigger 绑的是 TextBlock 自己的 IsMouseOver(RelativeSource Self)。
             Background=Transparent 是必需的: TextBlock 没有背景时不参与命中测试,
             鼠标停在文字右侧的空白处就不会触发悬停态。 -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="40" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CardAuthorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 封面角标(播放量/弹幕/时长): 卡片一悬停就淡出, 取消悬停再淡回。
             放大的是封面, 角标压在上面会挡住画面 —— 这也是 B 站网页版的行为。 -->
        <Style x:Key="CoverBadgeFadeStyle" TargetType="FrameworkElement">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=UserControl}}"
                             Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="0" Duration="0:0:0.12" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 To="1" Duration="0:0:0.18" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <UserControl.ContextMenu>
        <!--
            封面/视频的右键菜单。
            ExtraMenuItems 允许调用页面追加自己的条目(例如收藏页的"移出收藏"),
            这样卡片自带的能力与页面的专属操作能合并成同一个菜单,
            而不是"卡片的菜单把外层 Grid 的菜单顶掉"导致页面功能消失。
        -->
        <ContextMenu>
            <!-- ===== 封面: 看原图 / 存到本地(同一组, 不隔 Separator) =====
                 ★ 「查看封面」2026-10-02 按用户要求**加回**了, 别再删:
                   2026-09-26 曾按当时的反馈把它整体移除("看大图这个动作不要了"), 现在用户
                   明确要"视频卡片右键就能看封面"。它和下面的"下载封面"都是 MediaActions.ShowImage /
                   SaveImageAsync 的调用方, 走的是同一个图片预览窗(头像/评论图也是它)。 -->
            <MenuItem Header="查看封面" Click="OnViewCover">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE91B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Header="下载封面到本地" Click="OnDownloadCover">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!-- 直播间不能下载(下载器要的是视频稿件地址, 直播流是另一回事), 直接在直播卡片上藏掉 -->
            <MenuItem Header="下载视频到本地" Click="OnDownloadVideo"
                      Visibility="{Binding IsLive, Converter={StaticResource InvBoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE896;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator />
            <!-- 加进 B 站账号的「稍后再看」(2026-09-28 新增)。
                 直播间没有 avid, 加不了 —— 和"下载视频"一样在直播卡片上藏掉。 -->
            <MenuItem Header="加入稍后再看" Click="OnAddWatchLater"
                      Visibility="{Binding IsLive, Converter={StaticResource InvBoolToVis}}">
                <MenuItem.Icon>
                    <TextBlock Text="&#xE7C1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13" VerticalAlignment="Center" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator x:Name="ExtraSeparator" Visibility="Collapsed" />
            <!--
                页面追加的菜单项(2026-09-26 改为 code-behind 动态插入, 见 VideoCard.xaml.cs):
                之前用"嵌套 ItemsControl + ItemTemplate"的方式, 但 ContextMenu 是 MenuBase,
                会把 ItemsControl **本身**当做一个菜单项包进 MenuItem 壳 —— 集合为空时菜单底部
                留下一个 14px 高、可悬停发灰的空块(真机截图实锤)。改成动态插 MenuItem 后不再有壳。
            -->
        </ContextMenu>
    </UserControl.ContextMenu>
    <StackPanel x:Name="Root">
        <!-- ===== 封面卡片(卡片本体) =====
             用户要求: 卡片只保留封面, 标题等文字挪到封面**下方**; 封面四角圆角。
             悬停放大保留(作用在封面上), 同时封面角标淡出 —— 见 CoverBadgeFadeStyle。

             ★ 封面的宽高都不写死: 宽度继承自卡片墙(CardWall.ItemWidth), 高度由它按 16:9 算好
             (CardWall.CoverHeight)。两者都有设计值兜底(236 / 132), 所以没挂卡片墙的列表(收藏页的
             收藏夹卡片等)行为与从前一致。写死 132 的话, 卡片被卡片墙放大后封面会被拉扁。 -->
        <Border x:Name="CoverCard" CornerRadius="8" ClipToBounds="True"
                Height="{Binding (behaviors:CardWall.CoverHeight),
                                 RelativeSource={RelativeSource AncestorType=UserControl}}"
                Background="{DynamicResource PlaceholderBrush}"
                Cursor="Hand" MouseLeftButtonUp="OnClick">
            <Grid>
                <!-- 封面图: **圆角必须写在它自己身上**。外层的 CoverCard 虽然也有 CornerRadius,
                     但 Border 的圆角只裁它自己的背景/边框, **不裁子元素** —— 图走的是 Cover 附加属性
                     设在 Background 上, 子元素不圆角就会把四个角顶成直角(用户实测反馈)。 -->
                <Border x:Name="CoverBox" CornerRadius="8" behaviors:Cover.Source="{Binding Cover}" />

                <!-- 左下: 播放量 + 弹幕数(参考 B 站网页版卡片)。悬停放大封面时角标淡出,
                     免得压在放大的画面上。弹幕数拿不到(空串)就整段藏起来。 -->
                <StackPanel x:Name="StatsBadge" Orientation="Horizontal"
                            HorizontalAlignment="Left" VerticalAlignment="Bottom"
                            Margin="8,0,0,8"
                            Style="{StaticResource CoverBadgeFadeStyle}">
                    <Border CornerRadius="4" Padding="6,2"
                            Background="{DynamicResource DurationBadgeBackgroundBrush}"
                            Visibility="{Binding ViewCountText, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ViewCountText, Mode=OneWay}" FontSize="11"
                                       Foreground="#F2FFFFFF" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="4" Padding="6,2" Margin="4,0,0,0"
                            Background="{DynamicResource DurationBadgeBackgroundBrush}"
                            Visibility="{Binding DanmakuCountText, Converter={StaticResource StrToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="#F2FFFFFF" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding DanmakuCountText, Mode=OneWay}" FontSize="11"
                                       Foreground="#F2FFFFFF" Margin="3,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- 右下: 时长 -->
                <Border x:Name="DurationBadge" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                        Margin="0,0,8,8" CornerRadius="4" Padding="6,2"
                        Background="{DynamicResource DurationBadgeBackgroundBrush}"
                        Style="{StaticResource CoverBadgeFadeStyle}"
                        Visibility="{Binding Duration, Converter={StaticResource StrToVis}}">
                    <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="11" />
                </Border>

                <!--
                    编辑模式的选中圆标(压在封面左上角)。
                    只在页面把 Selectable 打开时出现 —— 平时它是 Collapsed 的,
                    连命中测试都不参与, 所以不影响正常点击播放。
                    圆标的填充由 CardSelectBubble 里的 DataTrigger 按 IsSelected 切换,
                    对勾显隐直接绑 IsSelected(BoolToVis 就够了, 不必为此再加一个转换器)。
                -->
                <Border Style="{StaticResource CardSelectBubble}"
                        HorizontalAlignment="Left" VerticalAlignment="Top"
                        Margin="8,8,0,0"
                        Visibility="{Binding Selectable,
                                     RelativeSource={RelativeSource AncestorType=UserControl},
                                     Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="13"
                               Foreground="{DynamicResource TextOnAccentBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                </Border>
            </Grid>
        </Border>

        <!-- ===== 封面下方文字区(无卡片底, 直接衬在页面背景上) =====
             两块: 标题(可点播放) / UP 主名(可点进主页) · 日期。
             (UP 徽章、点赞数都按用户要求已从卡片上撤掉; 数据仍在, 需要时再挂。) -->
        <StackPanel Margin="2,8,2,0">
            <TextBlock x:Name="TitleText" Text="{Binding Title}"
                       Style="{StaticResource CardTitleStyle}"
                       Cursor="Hand" MouseLeftButtonUp="OnTitleClick"
                       ToolTip="{Binding Title, Mode=OneWay}" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock x:Name="AuthorText" Text="{Binding Author}"
                           Style="{StaticResource CardAuthorStyle}"
                           Cursor="Hand" MouseLeftButtonUp="OnAuthorClick"
                           TextTrimming="CharacterEllipsis" MaxWidth="100"
                           ToolTip="{Binding Author, Mode=OneWay}" />
                <!-- 发布日期(部分接口没给, 空着即可): 前面那个点只在有日期时显示 -->
                <TextBlock Text="·" Style="{StaticResource MetaTextStyle}" Margin="4,0"
                           VerticalAlignment="Center"
                           Visibility="{Binding PubDateShort, Converter={StaticResource StrToVis}}" />
                <TextBlock Text="{Binding PubDateShort, Mode=OneWay}"
                           Style="{StaticResource MetaTextStyle}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>