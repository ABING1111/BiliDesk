<UserControl x:Class="BiliDesk.Views.Controls.PlayerFab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed"
             Focusable="False">
    <!--
        ============ 「播放页」浮动入口 ============

        只在播放器窗口存活时出现; 点击把播放器叫回前台(最小化会先还原)。
        图标是电视轮廓 + 三根主题强调色声波条:
          · 正在播放时逐帧改三根条的高度(正弦 + 相位, 与「听视频」同一套算法);
          · 暂停/播完时停在静态高度 —— 按钮仍留着, 方便回到暂停中的视频。
        ★ 定时器由 code-behind 管: 页面不可见 / 播放器暂停时立刻停,
          不让一个隐藏的控件白烧 30fps(与 ListenWave 同一条经验)。
    -->
    <Button x:Name="BtnPlayPage" Style="{StaticResource FloatingIconButtonStyle}"
            Click="OnClick" ToolTip="播放页"
            AutomationProperties.Name="播放页">
        <Grid x:Name="Root" Width="24" Height="24" Opacity="1" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="RootShift" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <!-- 电视轮廓: 圆角机身 + 两根天线耳 -->
            <Path x:Name="TvOutline"
                  Data="M 7.1,6.8 L 5.3,3.4 M 16.9,6.8 L 18.7,3.4 M 6.7,6.8 H 17.3 A 3.2,3.2 0 0 1 20.5,10 V 15.6 A 3.2,3.2 0 0 1 17.3,18.8 H 6.7 A 3.2,3.2 0 0 1 3.5,15.6 V 10 A 3.2,3.2 0 0 1 6.7,6.8 Z"
                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                  StrokeThickness="1.55" StrokeLineJoin="Round"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Stretch="Uniform" />

            <!-- 三根声波条: 高度由 code-behind 逐帧改, 这里只给初始/暂停时的静态值 -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,1.4,0,0">
                <Border x:Name="Wave1" Width="2.8" Height="6" CornerRadius="1.4"
                        Margin="1.1,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}" />
                <Border x:Name="Wave2" Width="2.8" Height="10" CornerRadius="1.4"
                        Margin="1.1,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}" />
                <Border x:Name="Wave3" Width="2.8" Height="7" CornerRadius="1.4"
                        Margin="1.1,0" VerticalAlignment="Center"
                        Background="{DynamicResource AccentBrush}" />
            </StackPanel>
        </Grid>
    </Button>
</UserControl>
