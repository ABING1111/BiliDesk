<UserControl x:Class="BiliDesk.Views.Controls.CommentSection"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="Transparent" Focusable="False">
    <UserControl.Resources>
        <Style x:Key="SortChipStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Padding="4,2" Background="{TemplateBinding Background}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="on">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CommentActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Padding="5,2"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 列表里的顶层评论: 带可点击的楼中楼预览框 -->
        <DataTemplate x:Key="CommentCardTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            VerticalAlignment="Top" ClipToBounds="True"
                            Background="{DynamicResource AccentSoftFillBrush}"
                            Cursor="Hand" ToolTip="进入 TA 的主页"
                            MouseLeftButtonUp="OnCommentAvatarClick"
                            helpers:Cover.Source="{Binding UserFace}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="4,1" Margin="0,0,6,0"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="置顶" FontSize="9" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                    Background="{DynamicResource AccentSoftFillBrush}"
                                    Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LevelText}" FontSize="9"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsUp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="UP" FontSize="9" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding RcTime}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Location}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <controls:CommentText Comment="{Binding}" FontSize="14" Margin="0,5,0,0"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              MentionForeground="{DynamicResource AccentTextBrush}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Pictures}"
                                      Visibility="{Binding HasPictures, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding ThumbWidth}" Height="160" Margin="0,0,6,6"
                                            CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                                            Background="{DynamicResource PlaceholderBrush}"
                                            MouseLeftButtonUp="OnCommentPictureClick"
                                            helpers:Cover.Source="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource CommentActionButtonStyle}"
                                    Click="OnCommentLikeClick" ToolTip="点赞 / 取消点赞">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding LikeText}" FontSize="11" Margin="4,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                                    Click="OnCommentDislikeClick" ToolTip="点踩 / 取消点踩">
                                <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleY="-1" />
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                                    Click="OnCommentReplyClick" ToolTip="回复这条评论">
                                <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" />
                            </Button>
                        </StackPanel>
                        <!-- 楼中楼预览: **整框可点** → 打开评论详情页(与视频评论区一致)
                             ★ 2026-11-14: 去掉 IsHitTestVisible=False, 让预览正文里的链接也能点。
                               点非链接处仍打开详情 —— 但事件必须走 **Preview**(隧道):
                               RichTextBox(CommentText) 会自己吃掉 MouseLeftButtonUp 做拖选,
                               冒泡到 Border 的普通 MouseLeftButtonUp 根本收不到。
                               见 OnReplyBoxClick。 -->
                        <Border Margin="0,8,0,0" Padding="8,6" CornerRadius="6"
                                Background="{DynamicResource ControlFillDefaultBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                Cursor="Hand" ToolTip="查看这条评论的全部回复"
                                PreviewMouseLeftButtonDown="OnReplyBoxPress"
                                PreviewMouseLeftButtonUp="OnReplyBoxClick"
                                Visibility="{Binding HasReplies, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding PreviewReplies}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <controls:CommentText Comment="{Binding}" Prefix="{Binding ReplyPrefix}"
                                                                  FontSize="12.5" Margin="0,2,0,2"
                                                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                                                  PrefixForeground="{DynamicResource TextSecondaryBrush}"
                                                                  MentionForeground="{DynamicResource AccentTextBrush}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="{Binding ReplyBoxText}" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 评论详情页的根评论: 与列表同一个版式, 但不带楼中楼预览框(下面单独列回复) -->
        <DataTemplate x:Key="CommentDetailRootTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="0,10,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="28" Height="28" CornerRadius="14"
                            VerticalAlignment="Top" ClipToBounds="True"
                            Background="{DynamicResource AccentSoftFillBrush}"
                            Cursor="Hand" MouseLeftButtonUp="OnCommentAvatarClick"
                            helpers:Cover.Source="{Binding UserFace}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="12" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Border CornerRadius="4" Padding="4,1" Margin="0,0,6,0"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsPinned, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="置顶" FontSize="9" Foreground="White" />
                            </Border>
                            <TextBlock Text="{Binding UserName}" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                    Background="{DynamicResource AccentSoftFillBrush}"
                                    Visibility="{Binding HasLevel, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding LevelText}" FontSize="9"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </Border>
                            <Border CornerRadius="4" Padding="4,1" Margin="6,0,0,0"
                                    Background="{DynamicResource AccentBrush}"
                                    Visibility="{Binding IsUp, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="UP" FontSize="9" Foreground="White" />
                            </Border>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                            <TextBlock Text="{Binding RcTime}" FontSize="11"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="{Binding Location}" FontSize="11" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextTertiaryBrush}"
                                       Visibility="{Binding HasLocation, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                        <controls:CommentText Comment="{Binding}" FontSize="14" Margin="0,5,0,0"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              MentionForeground="{DynamicResource AccentTextBrush}" />
                        <ItemsControl Margin="0,6,0,0" ItemsSource="{Binding Pictures}"
                                      Visibility="{Binding HasPictures, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding ThumbWidth}" Height="160" Margin="0,0,6,6"
                                            CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                                            Background="{DynamicResource PlaceholderBrush}"
                                            MouseLeftButtonUp="OnCommentPictureClick"
                                            helpers:Cover.Source="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource CommentActionButtonStyle}"
                                    Click="OnCommentLikeClick" ToolTip="点赞 / 取消点赞">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                                          Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding LikeText}" FontSize="11" Margin="4,0,0,0"
                                               VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                                    Click="OnCommentDislikeClick" ToolTip="点踩 / 取消点踩">
                                <Path Data="{StaticResource LikeIconGeometry}" Width="12" Height="12"
                                      Stretch="Uniform" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <ScaleTransform ScaleY="-1" />
                                    </Path.RenderTransform>
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsDisliked}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                            </Button>
                            <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                                    Click="OnCommentReplyClick" ToolTip="回复这条评论">
                                <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 楼中楼回复(详情页) -->
        <DataTemplate x:Key="CommentReplyTemplate">
            <Border BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1"
                    Padding="0,8,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="24" Height="24" CornerRadius="12"
                            VerticalAlignment="Top" ClipToBounds="True"
                            Background="{DynamicResource AccentSoftFillBrush}"
                            Cursor="Hand" MouseLeftButtonUp="OnCommentAvatarClick"
                            helpers:Cover.Source="{Binding UserFace}">
                        <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="10" Foreground="{DynamicResource AccentTextBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <controls:CommentText Comment="{Binding}" Prefix="{Binding ReplyPrefix}"
                                              FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}"
                                              PrefixForeground="{DynamicResource TextSecondaryBrush}"
                                              MentionForeground="{DynamicResource AccentTextBrush}" />
                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Pictures}"
                                      Visibility="{Binding HasPictures, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="{Binding ThumbWidth}" Height="120" Margin="0,0,6,6"
                                            CornerRadius="6" ClipToBounds="True" Cursor="Hand"
                                            Background="{DynamicResource PlaceholderBrush}"
                                            MouseLeftButtonUp="OnCommentPictureClick"
                                            helpers:Cover.Source="{Binding Url}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Button Style="{StaticResource CommentActionButtonStyle}"
                                    Click="OnCommentLikeClick" ToolTip="点赞 / 取消点赞">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource LikeIconGeometry}" Width="11" Height="11"
                                          Stretch="Uniform" VerticalAlignment="Center">
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Fill" Value="{DynamicResource TextTertiaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource AccentTextBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                    <TextBlock Text="{Binding LikeText}" FontSize="11" Margin="3,0,0,0"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextTertiaryBrush}" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource CommentActionButtonStyle}" Margin="4,0,0,0"
                                    Click="OnCommentReplyClick" ToolTip="回复这条回复">
                                <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" />
                            </Button>
                            <TextBlock Text="{Binding RcTime}" FontSize="10" Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextTertiaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <!-- 评论详情态: 返回列表(放在最上面, 与视频评论区的"返回评论列表"同一语义) -->
        <Button x:Name="BackButton" Content="← 返回评论列表" Style="{StaticResource LinkButtonStyle}"
                HorizontalAlignment="Left" Margin="0,8,0,0" FontSize="13"
                Click="OnBackToCommentsClick"
                Visibility="{Binding IsDetailMode, Converter={StaticResource BoolToVis}}" />

        <!-- 评论区标题 + 排序(仅列表态) -->
        <Grid Margin="0,14,0,0"
              Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="评论" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{Binding CommentCountText, Mode=OneWay}" FontSize="12" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="SortHot" Style="{StaticResource SortChipStyle}"
                        Content="最热" Click="OnSortHotClick" />
                <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource TextTertiaryBrush}"
                           VerticalAlignment="Center" />
                <Button x:Name="SortTime" Style="{StaticResource SortChipStyle}"
                        Content="最新" Click="OnSortTimeClick" />
            </StackPanel>
        </Grid>

        <!-- ===== 列表态 ===== -->
        <StackPanel Visibility="{Binding IsListMode, Converter={StaticResource BoolToVis}}">
            <controls:LoadingRing Width="20" Height="20" Margin="0,16,0,0"
                                  HorizontalAlignment="Center"
                                  Visibility="{Binding LoadingComments, Converter={StaticResource BoolToVis}}" />
            <TextBlock Text="{Binding Error}" FontSize="12" Margin="0,10,0,0" TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       Foreground="{DynamicResource DangerBrush}"
                       Visibility="{Binding Error, Converter={StaticResource StrToVis}}" />
            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Comments}"
                          ItemTemplate="{StaticResource CommentCardTemplate}" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Visibility="{Binding LoadingMore, Converter={StaticResource BoolToVis}}">
                <controls:LoadingRing Width="16" Height="16" />
                <TextBlock Text="加载中…" Margin="8,0,0,0" FontSize="12"
                           Foreground="{DynamicResource TextTertiaryBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <Button Content="加载更多评论" Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,12,0,0" Padding="16,6"
                    Click="OnLoadMoreCommentsClick"
                    Visibility="{Binding HasMore, Converter={StaticResource BoolToVis}}" />
        </StackPanel>

        <!-- ===== 评论详情态 ===== -->
        <StackPanel x:Name="DetailState" Visibility="{Binding IsDetailMode, Converter={StaticResource BoolToVis}}">
            <ContentControl Margin="0,4,0,0" Content="{Binding DetailRoot}"
                            ContentTemplate="{StaticResource CommentDetailRootTemplate}" />
            <Grid Margin="0,10,0,0">
                <TextBlock Text="{Binding DetailHeaderText}" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
                <controls:LoadingRing Width="16" Height="16" HorizontalAlignment="Right"
                                      Visibility="{Binding LoadingReplies, Converter={StaticResource BoolToVis}}" />
            </Grid>
            <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding DetailRoot.Replies}"
                          ItemTemplate="{StaticResource CommentReplyTemplate}" />
            <Button Content="展开更多回复" Style="{StaticResource SubtleButtonStyle}"
                    HorizontalAlignment="Center" Margin="0,10,0,0" Padding="16,6"
                    Click="OnLoadMoreRepliesClick"
                    Visibility="{Binding HasMoreReplies, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </StackPanel>
</UserControl>