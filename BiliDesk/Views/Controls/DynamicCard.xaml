<UserControl x:Class="BiliDesk.Views.Controls.DynamicCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             Background="Transparent" Focusable="False"
             PreviewMouseLeftButtonDown="OnCardPress">
    <UserControl.Resources>
        <!-- 底部操作按钮: 常态透明、悬停铺淡底, 图标 + 计数横排。
             与播放器评论区的小动作按钮同一套观感, 不另造语言。 -->
        <Style x:Key="DynamicActionButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="8" Padding="8,6"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 综合动态卡: 视频 / 图文 / 纯文字 / 专栏 / 转发共用一张卡。
         最大宽度 720 居中, 避免右栏很宽时封面/图片被拉得过大(参考 B 站动态页)。 -->
    <Border x:Name="CardBorder" MaxWidth="720" HorizontalAlignment="Center"
            Margin="0,0,0,12" CornerRadius="12" Padding="18,16"
            Background="{DynamicResource CardBackgroundBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            MouseLeftButtonUp="OnCardClick">
        <StackPanel>
            <!-- ===== 头部: 头像 + 昵称 + 时间 · 发布动作 + 更多菜单 ===== -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="40" Height="40" CornerRadius="20" ClipToBounds="True"
                        Background="{DynamicResource AccentSoftFillBrush}"
                        Cursor="Hand" MouseLeftButtonUp="OnUpClick" ToolTip="进入 UP 主主页"
                        helpers:Cover.Source="{Binding AuthorFace}">
                    <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                               FontSize="17" Foreground="{DynamicResource AccentTextBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding AuthorName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Cursor="Hand" MouseLeftButtonUp="OnUpClick"
                               TextTrimming="CharacterEllipsis" MaxWidth="320"
                               ToolTip="{Binding AuthorName, Mode=OneWay}" />
                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                        <TextBlock Text="{Binding PubText, Mode=OneWay}" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   ToolTip="{Binding PubFullText, Mode=OneWay}" />
                        <TextBlock Text="·" Margin="6,0" FontSize="12"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   Visibility="{Binding ActionLabel, Converter={StaticResource StrToVis}}" />
                        <TextBlock Text="{Binding ActionLabel, Mode=OneWay}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}"
                        Content="&#xE712;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                        FontSize="14" Width="30" Height="30"
                        ToolTip="更多操作" Click="OnMoreClick" />
            </Grid>

            <!-- ===== 正文(图文/纯文字/转发才有) =====
                 ★ 2026-11-14: 展开态换成 LinkText(只读 RichTextBox), 支持自由拖选 + Ctrl+C,
                   并把正文里的链接渲染成可点入口(点开走内置浏览器);
                   收起态用 LinkTextBlock(TextBlock) —— 只有它能做 "MaxHeight + 省略号" 的干净截断,
                   而 TextBlock 的 Inlines 同样放得下 Hyperlink, 链接照样能点。 -->
            <StackPanel Margin="0,10,0,0"
                        Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}">
                <controls:LinkTextBlock x:Name="ContentTextBlock" SourceText="{Binding ContentText}"
                                        FontSize="14" LineHeight="22" TextWrapping="Wrap"
                                        Foreground="{DynamicResource TextPrimaryBrush}"
                                        MaxHeight="176" TextTrimming="CharacterEllipsis" />
                <!-- ★ 展开态的 RichTextBox 不带 Text 绑定: 卡片收起时(绝大多数时候)不建 FlowDocument,
                     点「全文」时由 OnExpandClick 再灌文本 —— 一屏十几张卡, 每张都提前建文档太浪费。 -->
                <controls:LinkText x:Name="ContentRichText"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   Visibility="Collapsed" />
                <Button x:Name="ExpandButton" Content="全文" Style="{StaticResource LinkButtonStyle}"
                        HorizontalAlignment="Left" Margin="0,4,0,0" FontSize="12"
                        Visibility="Collapsed" Click="OnExpandClick" />
            </StackPanel>

            <!-- ===== 视频块: 16:9 大封面 + 时长 + 标题(仅本条自身是视频; 转发的视频在内嵌原文块里) ===== -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding HasPlayableVideo, Converter={StaticResource BoolToVis}}">
                <Border x:Name="VideoHost" CornerRadius="8" ClipToBounds="True"
                        Background="{DynamicResource PlaceholderBrush}"
                        Cursor="Hand" MouseLeftButtonUp="OnVideoClick"
                        MouseEnter="OnVideoEnter" MouseLeave="OnVideoLeave">
                    <Grid>
                        <Border CornerRadius="8" helpers:Cover.Source="{Binding VideoCover}" />
                        <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                Margin="0,0,8,8" CornerRadius="4" Padding="6,2"
                                Background="{DynamicResource DurationBadgeBackgroundBrush}"
                                Visibility="{Binding VideoDuration, Converter={StaticResource StrToVis}}">
                            <TextBlock Text="{Binding VideoDuration}" Foreground="White" FontSize="11" />
                        </Border>
                        <Border x:Name="PlayOverlay" CornerRadius="8"
                                Background="#33000000" Opacity="0" IsHitTestVisible="False">
                            <Border Width="52" Height="52" CornerRadius="26"
                                    Background="#99000000"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="&#xE768;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="22" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding VideoTitle}" FontSize="15" FontWeight="SemiBold"
                           Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="21"
                           MaxHeight="44" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="Hand" MouseLeftButtonUp="OnVideoClick"
                           ToolTip="{Binding VideoTitle, Mode=OneWay}" />
            </StackPanel>

            <!-- ===== 专栏标题(封面走下面的图片网格) ===== -->
            <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                       Margin="0,12,0,0" TextWrapping="Wrap" LineHeight="21"
                       MaxHeight="44" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Cursor="Hand" MouseLeftButtonUp="OnArticleClick"
                       Visibility="{Binding ShowArticleTitle, Converter={StaticResource BoolToVis}}" />

            <!-- ===== 图片网格(图文/专栏) ===== -->
            <controls:DynamicImageGrid Margin="0,12,0,0"
                                       ItemsSource="{Binding Images}"
                                       Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}" />

            <!-- ===== 直播块 ===== -->
            <StackPanel Margin="0,12,0,0"
                        Visibility="{Binding IsLive, Converter={StaticResource BoolToVis}}">
                <Border CornerRadius="8" ClipToBounds="True" Height="180"
                        Background="{DynamicResource PlaceholderBrush}"
                        Cursor="Hand" MouseLeftButtonUp="OnLiveClick">
                    <Grid>
                        <Border CornerRadius="8" helpers:Cover.Source="{Binding Cover}" />
                        <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                                Margin="8,8,0,0" CornerRadius="4" Padding="6,2"
                                Background="{DynamicResource DangerBrush}">
                            <TextBlock Text="直播中" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                        </Border>
                    </Grid>
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold"
                           Margin="0,8,0,0" TextWrapping="Wrap" MaxHeight="44"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           Cursor="Hand" MouseLeftButtonUp="OnLiveClick" />
            </StackPanel>

            <!-- ===== 转发原动态(内嵌浅色块) ===== -->
            <Border Margin="0,12,0,0" Padding="12" CornerRadius="8"
                    Background="{DynamicResource ControlFillDefaultBrush}"
                    Visibility="{Binding IsForward, Converter={StaticResource BoolToVis}}">
                <StackPanel DataContext="{Binding Orig}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AuthorName}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   Cursor="Hand" MouseLeftButtonUp="OnOrigUpClick" />
                        <TextBlock Text="{Binding PubText, Mode=OneWay}" FontSize="12" Margin="8,0,0,0"
                                   Foreground="{DynamicResource TextTertiaryBrush}"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <controls:LinkText Text="{Binding ContentText}" FontSize="13"
                                       Margin="0,6,0,0"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       Visibility="{Binding HasText, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold"
                               Margin="0,6,0,0" TextWrapping="Wrap" MaxHeight="40"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Visibility="{Binding HasTitle, Converter={StaticResource BoolToVis}}" />
                    <Border Margin="0,8,0,0" CornerRadius="6" ClipToBounds="True" Height="120"
                            Background="{DynamicResource PlaceholderBrush}"
                            Cursor="Hand" MouseLeftButtonUp="OnOrigVideoClick"
                            Visibility="{Binding HasPlayableVideo, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Border CornerRadius="6" helpers:Cover.Source="{Binding Cover}" />
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                    Margin="0,0,6,6" CornerRadius="4" Padding="5,1"
                                    Background="{DynamicResource DurationBadgeBackgroundBrush}"
                                    Visibility="{Binding Duration, Converter={StaticResource StrToVis}}">
                                <TextBlock Text="{Binding Duration}" Foreground="White" FontSize="10" />
                            </Border>
                        </Grid>
                    </Border>
                    <controls:DynamicImageGrid Margin="0,8,0,0"
                                               ItemsSource="{Binding Images}"
                                               Visibility="{Binding HasImages, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Border>

            <!-- ===== 底部操作栏: 转发 / 评论 / 点赞 ===== -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" Style="{StaticResource DynamicActionButtonStyle}"
                        Click="OnForwardClick" ToolTip="复制动态链接">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding ForwardLabel, Mode=OneWay}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="1" Style="{StaticResource DynamicActionButtonStyle}"
                        Click="OnCommentClick" ToolTip="查看评论">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE90A;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="15" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding CommentLabel, Mode=OneWay}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <Button Grid.Column="2" Click="OnLikeClick" ToolTip="点赞 / 取消点赞"
                        IsEnabled="{Binding LikeBusy, Converter={StaticResource InvBool}}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource DynamicActionButtonStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLiked}" Value="True">
                                    <Setter Property="Foreground" Value="#F43F5E" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Grid x:Name="LikeIconBox" Width="20" Height="20"
                              RenderTransformOrigin="0.5,0.5" VerticalAlignment="Center">
                            <Path Data="{StaticResource LikeIconGeometry}"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center" />
                        </Grid>
                        <TextBlock Text="{Binding LikeLabel, Mode=OneWay}" Margin="6,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>