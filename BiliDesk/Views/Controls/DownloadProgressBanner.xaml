<UserControl x:Class="BiliDesk.Views.Controls.DownloadProgressBanner"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MaxWidth="300" HorizontalAlignment="Right" VerticalAlignment="Top"
             IsHitTestVisible="False" Visibility="Collapsed" Opacity="0">
    <!--
        下载进度条(issue #38)。
        ★ 外观刻意跟 Toast 一致(同一组画刷), 但它是**独立的一块**:
          临时提示继续走 Toast, 下载进度在这里原地更新, 两者互不覆盖。
        ★ MaxWidth 300 + 省略号: 播放器填充模式最窄 320, 再长就会盖满视频。
        ★ 文案由 DownloadProgressService.Summary 合并好(多个任务一行显示),
          这样两个任务同时下载时不会出现"45% → 12% → 47%"来回跳。
    -->
    <Border Padding="14,9" CornerRadius="8"
            Background="{DynamicResource ToastBackgroundBrush}"
            BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#xE896;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="13" Margin="0,0,8,0" VerticalAlignment="Center"
                       Foreground="{DynamicResource AccentTextBrush}" />
            <TextBlock Grid.Column="1" x:Name="Text" FontSize="13"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
        </Grid>
    </Border>
</UserControl>
