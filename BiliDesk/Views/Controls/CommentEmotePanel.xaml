<UserControl x:Class="BiliDesk.Views.Controls.CommentEmotePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:behaviors="clr-namespace:BiliDesk.Helpers"
             Background="Transparent" Focusable="False">
    <UserControl.Resources>
        <!-- 表情墙里的一格。
             ★ 尺寸与私信表情面板(MessagesPage 的 EmoteCellStyle)保持一致: 两处是同一个接口、
               同一批图, 格子在两个界面上大小不一样会显得像两套东西。
             ★ ToolTip 必须写在 DataTemplate 的 Button 上而不是 Style 的 Setter 里:
               Setter.Value 不是依赖属性, 写 {Binding} 会在运行时抛
               "A 'Binding' cannot be set on the 'Value' property of type 'Setter'"。 -->
        <Style x:Key="EmoteCellStyle" TargetType="Button">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="5">
                            <!-- 走 Cover.EmoteSource 异步加载(按 48 宽解码):
                                 直接绑 Image.Source 会让 WPF 在 UI 线程同步下载解码,
                                 一屏几十个表情就是"点开面板卡一下"。 -->
                            <Image Stretch="Uniform" behaviors:Cover.EmoteSource="{Binding Url}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- ★ 内嵌面板, 不用 Popup: 项目的 Popup 一律有"独立 HWND 盖过 airspace / 点一下收不起来"
         的坑(见 MessagesPage 表情面板与合集面板的注释), 这里跟着输入面板一起排版。
         ★ 默认 Collapsed: 只有用户点了「表情」按钮才展开, 不占输入框的高度。
         ★ 三种状态(加载 / 错误 / 表情墙)由代码切换可见性, 不走绑定 ——
           面板没有 DataContext, 绑 ElementName 到控件属性还要额外的通知管道, 不值当。 -->
    <Border x:Name="Root" Visibility="Collapsed" MaxHeight="196" Padding="10,8"
            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0">
        <Grid>
            <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Visibility="Collapsed">
                <controls:LoadingRing Width="20" Height="20" HorizontalAlignment="Center" />
                <TextBlock Text="正在加载表情…" Style="{StaticResource MetaTextStyle}"
                           Margin="0,8,0,0" HorizontalAlignment="Center" />
            </StackPanel>

            <!-- ★ 错误提示只在**没有表情可显示**时出现: 否则一次网络抖动就会在表情墙上压一行字,
                 而表情明明还在(与私信面板同一套判断, 见 UpdateState)。 -->
            <TextBlock x:Name="ErrorText" FontSize="12" HorizontalAlignment="Center"
                       VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource TextTertiaryBrush}" Visibility="Collapsed" />

            <ScrollViewer x:Name="EmoteScroll" VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="PackageList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="2,0,0,4"
                                           Foreground="{DynamicResource TextTertiaryBrush}" />
                                <ItemsControl ItemsSource="{Binding Emotes}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource EmoteCellStyle}"
                                                    ToolTip="{Binding Text}"
                                                    Click="OnEmoteClick" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>
