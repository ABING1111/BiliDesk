<UserControl x:Class="BiliDesk.Views.Controls.SearchBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="34" Focusable="False"
             Background="Transparent">
    <!--
        ============ 统一的搜索小胶囊(2026-11-20) ============

        用在: 历史记录 / 收藏夹 / 动态左栏「搜索已关注的 UP」/ 动态右栏「搜索动态里的视频」。
        要求是"与下方列表等宽"(见 FollowPage.SyncAllDynamicEntry) —— 控件本身只负责高度,
        宽度由宿主给, 所以这里不吃 Stretch, 也不写死宽度。

        ★ 为什么是自绘底 + 透明 TextBox, 而不是套 FluentTextBoxStyle:
          搜索框要放放大镜、占位符、清除按钮三层覆盖, 而 TextBox 的模板自带 Padding / 内容宿主;
          用透明 TextBox 叠在底层 Border 上, 三层的摆放最直接, 也不会和输入框的光标区域打架。
        ★ 占位符/清除按钮的显隐在 code-behind 的 TextChanged 里直接置 Visibility ——
          与首页 / 动态页那两处踩过坑的做法一致(绑定时会静默失效, 尤其是 IME 组字期间)。
        ★ 悬停/聚焦的底色、描边在 code-behind 里用 SetResourceReference 切换,
          这样切换深浅色主题时仍然跟着 DynamicResource 走(不会把颜色钉死)。
    -->
    <Grid x:Name="Host">
        <Border x:Name="Bd" CornerRadius="17"
                Background="{DynamicResource ControlFillDefaultBrush}"
                BorderBrush="Transparent" BorderThickness="1" />

        <!-- 放大镜: 纯装饰, 不参与命中测试 -->
        <TextBlock x:Name="SearchGlyph" Text="&#xE721;"
                   FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                   FontSize="13" VerticalAlignment="Center" HorizontalAlignment="Left"
                   Margin="12,0,0,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextTertiaryBrush}" />

        <TextBox x:Name="Box"
                 Background="Transparent" BorderThickness="0"
                 Foreground="{DynamicResource TextPrimaryBrush}"
                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                 SelectionBrush="{DynamicResource AccentBrush}"
                 FontSize="12.5" Padding="34,0,28,0"
                 VerticalContentAlignment="Center"
                 FocusVisualStyle="{x:Null}"
                 TextChanged="OnTextChanged"
                 KeyDown="OnBoxKeyDown"
                 GotKeyboardFocus="OnBoxFocusChanged"
                 LostKeyboardFocus="OnBoxFocusChanged"
                 Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock x:Name="Placeholder" Text="搜索"
                   FontSize="12.5" VerticalAlignment="Center"
                   Margin="34,0,28,0" IsHitTestVisible="False"
                   Foreground="{DynamicResource TextTertiaryBrush}" />

        <Button x:Name="ClearButton" Content="&#xE711;"
                FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                FontSize="10" Width="24" Height="24" Padding="0"
                HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"
                Style="{StaticResource BareIconButtonStyle}"
                Foreground="{DynamicResource TextTertiaryBrush}"
                ToolTip="清除搜索" Click="OnClearClick"
                Visibility="Collapsed" />
    </Grid>
</UserControl>
