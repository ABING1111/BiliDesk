<UserControl x:Class="BiliDesk.Views.Controls.FollowUserCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Focusable="False" Background="Transparent"
             PreviewMouseLeftButtonDown="OnCardPress"
             MouseLeave="OnCardLeave">
    <!--
        关注 / 粉丝列表里的一行(2026-11-18 新增, issue #90)。

        ★ 为什么不用 controls:UserCard: 那个控件绑的是 SearchUserItem(搜索页专用, issue #47),
          字段是 Name/Face/Sign/MetaText/HasVerify; 这里的模型是 FollowUser,
          字段是 Mid/Name/Face/Sign/VerifyType/VerifyDesc —— 两者不通用。
          把 UserCard 改成兼容两个类型会让两边都不干净, 所以另做一个专用控件。

        ★ 版式参考 B 站网页版空间页的关注/粉丝列表: 头像 + 昵称 + 认证 + 签名, 单列竖排。
    -->
    <Border x:Name="Root" Margin="10,3" Padding="12,10" CornerRadius="10"
            Cursor="Hand" ToolTip="打开 TA 的主页"
            MouseLeftButtonUp="OnOpen">
        <!-- ★★ 底色**只能**由下面的 Style 给: 在 Border 元素上再写一次 Background 是本地值,
             优先级高于 Style 里的 Trigger, 悬停高亮会被永久压掉 —— 表现就是"鼠标移到
             任意用户行、点下去都没有高亮提示"(2026-11-28 修)。 -->
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="Transparent" />
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- 头像: 外圈圆角裁切由 Border 自己完成; 没加载出图片时露出底下的占位图标 -->
            <Border Width="48" Height="48" CornerRadius="24"
                    Background="{DynamicResource AccentSoftFillBrush}" ClipToBounds="True"
                    helpers:Cover.Source="{Binding Face}">
                <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="20" Foreground="{DynamicResource AccentTextBrush}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>

            <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                <!-- 名字 + 认证徽章(2026-11-19 改版)。
                     ★ 列宽必须是 Auto/Auto/* : 原来名字列是 *, 会把徽章顶到整整一行的最右边
                       (离名字上千像素, 看着就是行尾莫名其妙一个勾 —— 用户原话"不明意义的勾")。
                       Auto 让徽章紧跟名字, 末尾的 * 只吃空白(不需要往里放任何东西 ——
                       Grid 默认 Stretch, 星列自然把剩下的宽度全占掉)。
                     ★★ 名字还得能省略: Auto 列配 MaxWidth ⇒ 超长昵称在 420px 处截断,
                       不会把徽章挤出可见区。
                     ★★★ 徽章画成"实心圆 + 矢量对勾"而不是 E73E 字形: 裸对勾读不出"认证"
                       的意思(用户不认识), 字形在不同 Windows 版本上还会糊。
                       矢量对勾的做法与 FollowPage「全部已读」那个勾一致。 -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding Name}" MaxWidth="420"
                               FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding Name}" />
                    <Border x:Name="VerifyBadge" Grid.Column="1"
                            Width="14" Height="14" CornerRadius="7" Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentBrush}"
                            ToolTip="{Binding VerifyToolTip}"
                            Visibility="{Binding HasVerify, Converter={StaticResource BoolToVis}}">
                        <Path Width="8" Height="8" Stretch="Uniform"
                              Data="M 1,4.4 L 3.2,6.6 L 7,1.6"
                              Stroke="White" StrokeThickness="1.5"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              StrokeLineJoin="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </Grid>

                <!-- 签名: 一行截断; 空签名整行藏掉, 免得名字和下面之间多出一条空白 -->
                <TextBlock Text="{Binding Sign}" FontSize="12" Margin="0,3,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding Sign}"
                           Visibility="{Binding Sign, Converter={StaticResource StrToVis}}" />
            </StackPanel>

            <!-- 右侧的"进入主页"提示箭头 -->
            <TextBlock Grid.Column="2" Text="&#xE72A;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="12" Foreground="{DynamicResource TextTertiaryBrush}"
                       VerticalAlignment="Center" Margin="6,0,4,0" />
        </Grid>
    </Border>
</UserControl>
