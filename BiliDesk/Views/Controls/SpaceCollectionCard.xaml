<UserControl x:Class="BiliDesk.Views.Controls.SpaceCollectionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Width="{Binding (helpers:CardWall.ItemWidth), RelativeSource={RelativeSource Self}}"
             Margin="8,10" Background="Transparent" Focusable="False"
             Cursor="Hand" MouseLeftButtonUp="OnClick">
    <!--
        UP 主主页「合集和系列」卡片。
        ★ 尺寸来源与 VideoCard 完全相同(CardWall.ItemWidth / CoverHeight),
          这样同一面卡片墙里两种卡片的封面高度、左右间距一致。
        ★ 背后的两层"纸片"只是视觉(参考 B 站空间页), 用负 Margin 露在封面上方;
          卡片墙行距 20px, 最多露出 6px, 不会压到上一行的文字。
    -->
    <StackPanel>
        <Grid Height="{Binding (helpers:CardWall.CoverHeight),
                              RelativeSource={RelativeSource AncestorType=UserControl}}">
            <!-- 纸片: 先画的两层在下, 封面最后画在最上面 -->
            <Border Height="6" VerticalAlignment="Top" Margin="14,-6,14,0"
                    CornerRadius="7,7,0,0" Background="{DynamicResource DividerBrush}" />
            <Border Height="3" VerticalAlignment="Top" Margin="7,-3,7,0"
                    CornerRadius="6,6,0,0" Background="{DynamicResource ControlFillDefaultBrush}" />

            <Border CornerRadius="8" ClipToBounds="True"
                    Background="{DynamicResource PlaceholderBrush}">
                <Grid>
                    <!-- 圆角写在封面自己身上: 外层 Border 的圆角不裁子元素 -->
                    <Border CornerRadius="8" helpers:Cover.Source="{Binding Cover}" />

                    <!-- 底部渐变: 给内容数和角标当衬底 -->
                    <Border VerticalAlignment="Bottom" Height="56">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#00000000" Offset="0" />
                                <GradientStop Color="#99000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <TextBlock Text="{Binding CountText}" FontSize="12" Foreground="#F2FFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Bottom"
                               Margin="10,0,0,9" />

                    <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                            CornerRadius="4" Padding="6,2" Margin="0,0,9,8"
                            Background="#66000000">
                        <TextBlock Text="{Binding KindText}" FontSize="11" Foreground="#F2FFFFFF" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Margin="2,8,2,0">
            <TextBlock Text="{Binding DisplayTitle}" Style="{StaticResource CardTitleStyle}"
                       ToolTip="{Binding DisplayTitle, Mode=OneWay}" />
            <TextBlock Text="{Binding PubDateShort}" Style="{StaticResource MetaTextStyle}"
                       Margin="0,6,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
