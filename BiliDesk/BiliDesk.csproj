<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon: 这是托盘交互(气泡/双击/右键菜单)最省事且最稳的方案,
         比手搓 Shell_NotifyIcon P/Invoke 少几百行marshalling代码 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BiliDesk</RootNamespace>
    <AssemblyName>BiliDesk</AssemblyName>
    <AssemblyTitle>BiliDesk</AssemblyTitle>
    <Product>BiliDesk</Product>
    <Version>1.2.4</Version>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 不要跟着引用程序集一起拷 .xml/.pdb 等"文档/符号"类文件(WebView2 那 3 个 XML 文档 ~0.8MB 就是它带进来的) -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>

    <!--
      ★ 关掉 LibVLC 的 x86 那一份(发布包里 126.7MB, 纯粹白装)。

      为什么以前会带上: VideoLAN.LibVLC.Windows 的 targets 是按 **$(Platform)** 判断架构的 ——
        VlcWindowsX86Enabled 默认在 '$(Platform)' == 'x86' **或 'AnyCPU'** 时为 true。
      而本工程设的是 <PlatformTarget>x64</PlatformTarget>(那是**编译器**目标),
      $(Platform) 仍然是 AnyCPU, 于是包把 x86 与 x64 两套原生库全拷了进来。
      本工程是 x64-only(PlatformTarget=x64), x86 那套永远不会被加载 —— 直接关掉。
    -->
    <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
  </PropertyGroup>

  <!--
    UseWindowsForms 会往每个文件注入 System.Windows.Forms / System.Drawing 的全局 using,
    和 WPF 的 KeyEventArgs / MouseEventArgs / Point 大面积撞名。本项目只有托盘服务碰
    WinForms, 且它全部用全限定名 —— 把这两条全局 using 摘掉, 其余代码零改动。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LibVLCSharp" Version="3.8.0" />
    <PackageReference Include="LibVLCSharp.WPF" Version="3.8.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.20" />
  </ItemGroup>

  <!--
    ============================ LibVLC 原生库怎么部署 ============================

    VideoLAN.LibVLC.Windows 自己会把原生库放到 <OutDir>/libvlc/win-x64/（含 plugins/），
    这就够了 —— VlcCore 走的是 Core.Initialize(<那个目录的绝对路径>)，它会显式 LoadLibrary
    那个 libvlc.dll，而 libvlccore 3.0.20 的插件扫描找的正是 libvlc.dll **同目录**下的 plugins/。

    ★ 2026-09-26 瘦身（详见根目录 瘦身方案.md）:
      以前这里额外写了两个 Target，把 libvlc.dll / libvlccore.dll / plugins 又拷一份到输出**根目录**，
      理由是"LibVLC 在 Windows 上 P/Invoke 只在 exe 同目录查找" —— 那个理由不成立（我们不是靠
      P/Invoke 默认搜索，是 Core.Initialize 指定绝对路径）。于是在发布包里出现了三份同样的运行时:
      x86 一份(126.7MB) + libvlc/win-x64 一份(92.8MB) + 根目录一份(90.8MB) = 308MB。
      实测(bd-probe-vlc 探针: 在被测输出目录里用 app 自己合流出来的 MP4 真播一遍):
        · 三份都在      → 加载 497 个模块，正常播放
        · 只留嵌套那份  → 加载 497 个模块，正常播放（VLC_PLUGIN_PATH 指向不存在的目录也没关系）
      结论: 根目录那份纯冗余，已删除；x86 那份用上面的 <VlcWindowsX86Enabled>false</VlcWindowsX86Enabled>
      从源头关掉。改动这一块之后**必须**复跑 bd-probe-vlc 探针。
  -->

  <!--
    发布时裁剪掉播放路径用不到的插件（约 -30MB）。裁掉的都是"B站客户端永远碰不到"的东西:
      · 采集/外设: dshow(DirectShow 采集), cdda(CD 音轨), dtv(数字电视)
      · 光盘/影院: dvdnav/dvdread(DVD), libbluray(蓝光), dcp(数字影院包)
      · 传输协议: srt, vnc, sftp, nfs, rtp, live555(RTSP 服务器)
      · 用不到的音乐格式: sid/gme/mod(游戏音源), schroedinger(Dirac), theora, zvbi(图文电视)
      · 元数据/滤镜: taglib(音频标签), samplerate/spatialaudio/mad(重采样与空间音频)
      · 纯编码器: x264/x265/aom/twolame/shine —— 我们只解码，编码走自研下载管道
      · VLC 自带界面/推流/脚本: gui, visualization, stream_out, access_output, services_discovery, lua, mux
    ★ 一律**保留**: 解码(avcodec/dav1d)、解封装(mp4/mkv/ts/adaptive)、输出(d3d11/d3d11va/dxva2/mmdevice/wasapi)、
      访问(http/https/file)、字幕(libass/freetype)、缩放(swscale)、打包(packetizer)。
  -->
  <Target Name="TrimLibVLCPlugins" AfterTargets="Publish">
    <ItemGroup>
      <_VlcTrimDir Include="$(PublishDir)libvlc\win-x64\plugins\gui;
                          $(PublishDir)libvlc\win-x64\plugins\visualization;
                          $(PublishDir)libvlc\win-x64\plugins\stream_out;
                          $(PublishDir)libvlc\win-x64\plugins\access_output;
                          $(PublishDir)libvlc\win-x64\plugins\services_discovery;
                          $(PublishDir)libvlc\win-x64\plugins\lua;
                          $(PublishDir)libvlc\win-x64\plugins\mux;
                          $(PublishDir)libvlc\win-x64\plugins\meta_engine;
                          $(PublishDir)libvlc\win-x64\lua;
                          $(PublishDir)libvlc\win-x64\hrtfs" />
      <_VlcTrimFile Include="$(PublishDir)libvlc\win-x64\plugins\codec\libx264_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libx26410b_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libx265_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libaom_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libtwolame_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libshine_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libschroedinger_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libtheora_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libzvbi_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\codec\libaribsub_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libaccess_srt_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libvnc_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdcp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\liblibbluray_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libbluray-j2se-1.3.2.jar;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdshow_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdtv_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libsftp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libcdda_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\librtp_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\liblive555_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libnfs_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdvdnav_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\access\libdvdread_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libsid_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libgme_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\demux\libmod_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\audio_filter\libsamplerate_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\audio_filter\libspatialaudio_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\audio_filter\libmad_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\video_output\libcaca_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\spu\libremoteosd_plugin.dll;
                           $(PublishDir)libvlc\win-x64\plugins\misc\libxml_plugin.dll;
                           $(PublishDir)libvlc\win-x64\libvlc.lib;
                           $(PublishDir)libvlc\win-x64\libvlccore.lib;
                           $(PublishDir)libvlc\win-x64\libvlc.exp;
                           $(PublishDir)libvlc\win-x64\libvlccore.exp;
                           $(PublishDir)BiliDesk.pdb" />
    </ItemGroup>
    <RemoveDir Directories="@(_VlcTrimDir)" />
    <Delete Files="@(_VlcTrimFile)" />
    <Message Text="LibVLC 插件已裁剪: 只保留播放必需模块" Importance="high" />
  </Target>

</Project>