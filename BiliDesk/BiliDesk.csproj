<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- 托盘图标用 WinForms 的 NotifyIcon: 这是托盘交互(气泡/双击/右键菜单)最省事且最稳的方案,
         比手搓 Shell_NotifyIcon P/Invoke 少几百行 marshalling 代码 -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BiliDesk</RootNamespace>
    <AssemblyName>BiliDesk</AssemblyName>
    <AssemblyTitle>BiliDesk</AssemblyTitle>
    <Product>BiliDesk</Product>
    <Version>1.8.3</Version>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      RollForward=Major: 框架依赖版(安装器)在机器上没有 .NET 10 桌面运行时、
      但装了更高大版本(如 .NET 11)时, 允许直接跑在上面, 不再强求用户装对应版本的
      Desktop Runtime。(Major 语义是滚到*最低*的可用大版本), 不会一觉醒来换到没验证过的最新版本。
      便携版自包含, 此属性对它无影响。安装器侧的检测逻辑同步放在 Publish\installer.iss。
    -->
    <RollForward>Major</RollForward>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <SatelliteResourceLanguages>zh-Hans;en</SatelliteResourceLanguages>
    <!-- 不要跟着引用程序集一起拷 .xml/.pdb 等"文档/符号"类文件(WebView2 那 3 个 XML 文档 ~0.8MB 就是它带进来的) -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <!--
    UseWindowsForms 会往每个文件注入 System.Windows.Forms / System.Drawing 的全局 using,
    和 WPF 的 KeyEventArgs / MouseEventArgs / Point 大面积撞名。本项目只有托盘服务碰
    WinForms, 而且它全部用全限定名 —— 把这两条全局 using 摘掉, 其余代码零改动。
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!--
    mpv core (feat/mpv-core): libmpv 原生库不进仓库(单文件 ~110MB)。
    放到 BiliDesk\libmpv\win-x64\libmpv-2.dll 后构建/发布会自动复制到输出目录;
    文件缺失时工程照样能构建, 只是 MpvEngine.IsAvailable 返回 false。
    ★ P4 起播放内核只剩 mpv, LibVLCSharp / VideoLAN.LibVLC.Windows 已全部移除。
  -->
  <ItemGroup Condition="Exists('libmpv\win-x64\libmpv-2.dll')">
    <Content Include="libmpv\win-x64\libmpv-2.dll">
      <Link>libmpv\win-x64\libmpv-2.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
