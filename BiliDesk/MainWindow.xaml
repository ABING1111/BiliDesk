<views:FluentWindow x:Class="BiliDesk.MainWindow"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:BiliDesk.Views"
             xmlns:controls="clr-namespace:BiliDesk.Views.Controls"
             xmlns:vm="clr-namespace:BiliDesk.ViewModels"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:helpers="clr-namespace:BiliDesk.Helpers"
             Title="BiliDesk" Width="1280" Height="800"
             MinWidth="1060" MinHeight="660" WindowStartupLocation="CenterScreen"
             WindowStyle="None" ResizeMode="CanResize" UseLayoutRounding="True">
    <!--
        布局回到"左侧竖导航 + 右侧内容"这一套。

        唯一的窗口级变化: 系统标题栏去掉了(WindowStyle=None), 最小化/最大化/关闭
        三个按钮改成自绘的。

        CaptionHeight=20 —— 窗口顶部 20px 之内算标题栏(可拖动、双击最大化)。
        为什么是 20 而不是常见的 40: 自绘标题栏**不占布局高度**(那三个按钮是浮层),
        内容区从窗口最上沿开始, 而各页面的头部上边距最小就是 20。
        取 20 正好让"顶部的空白"当拖动区, 又**不会盖住任何可点的东西** ——
        如果取 40, 搜索页/历史页顶部那些输入框的上沿就会被拖动区吃掉, 点上去没反应。
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="20" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0,0,0,1"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <views:FluentWindow.Resources>
        <!-- 分区面板里的一行: 图标 + 名字。有官方图标就用图标(异步加载),
             没有(接口没给 logo 的那十几个)就退化成"首字 + 柔和底色"的方块。 -->
        <DataTemplate x:Key="PartitionItemTemplate">
            <Border Height="34" CornerRadius="6" Padding="6,0" Margin="0,0,0,4"
                    Cursor="Hand" MouseLeftButtonUp="OnPartitionItemClick">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillHoverBrush}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <Grid Width="24" Height="24">
                        <Image helpers:Cover.ImageSource="{Binding IconUrl}"
                               Visibility="{Binding IconUrl, Converter={StaticResource StrToVis}}" />
                        <Border CornerRadius="6" Background="{DynamicResource AccentSoftFillBrush}"
                                Visibility="{Binding IconUrl, Converter={StaticResource InvStrToVis}}">
                            <TextBlock Text="{Binding Initial}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <TextBlock Text="{Binding Name}" FontSize="13" Margin="8,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </views:FluentWindow.Resources>



    <Grid x:Name="RootGrid" Background="{DynamicResource AppBackgroundBrush}"
          helpers:Responsive.Source="True" helpers:Responsive.Enable="True">

        <!--
            ============ 响应式布局(窗口宽度档位) ============

            机制见 Helpers/Responsive.cs: 窗口宽度归成 Wide/Medium/Compact 三档, 带 20px 迟滞,
            只在**真跨档**时才通知, 拖动过程中不会逐帧重排。

            这里是全应用**唯一**的档位真相源(Source="True") —— 档位只按**窗口**宽度算, 不按内容区算。
            这一点是刻意的: 若按内容区算, 导航栏在窄屏收窄会让内容区变宽, 档位又跳回去, 来回抖。

            状态组的写法要点:
              · Wide / Medium **故意留空 Storyboard** —— 它们就是设计值, 退出 Compact 时 WPF 会撤掉
                Compact 设的动画值、自动回到设计值; 而"回到设计值"这一段由下面 GeneratedDuration
                生成的过渡补上, 所以收放两个方向都是平滑的。
              · Compact 里的动画都写 Duration="0" —— 状态自身的 Storyboard 只负责**落值**,
                动画交给 GeneratedDuration(0.18s) 去做。写成默认时长的话, 首次应用(不带动画那一次)
                也会自己滑一段, 启动时看见界面在动很像故障。
              · 只动画**可插值**的属性(double)。UniformGrid 的列数那种 int 属性插不了值,
                这类"重排"本来就是一瞬的事, 网页的 media query 同理。
        -->
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup x:Name="WidthStates">
                <VisualStateGroup.Transitions>
                    <VisualTransition GeneratedDuration="0:0:0.18">
                        <VisualTransition.GeneratedEasingFunction>
                            <CubicEase EasingMode="EaseOut" />
                        </VisualTransition.GeneratedEasingFunction>
                    </VisualTransition>
                </VisualStateGroup.Transitions>

                <VisualState x:Name="Wide" />
                <VisualState x:Name="Medium" />

                <VisualState x:Name="Compact">
                    <Storyboard>
                        <!-- 轨宽 96 → 68。列宽是 Auto, 跟着 Border 的 Width 走 ——
                             所以这里只动一个 double 就够, 不需要自己写 GridLength 动画(WPF 没有内置的)。 -->
                        <DoubleAnimation Storyboard.TargetName="NavRail"
                                         Storyboard.TargetProperty="Width"
                                         To="68" Duration="0" />
                        <!-- 导航项文字: 淡出 + 高度收到 0。只淡出的话文字仍占着 15px, 图标会偏上 ~7px。 -->
                        <DoubleAnimation Storyboard.TargetName="NavLabelHome"
                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelHome"
                                         Storyboard.TargetProperty="Height" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelFollow"
                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelFollow"
                                         Storyboard.TargetProperty="Height" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelMine"
                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelMine"
                                         Storyboard.TargetProperty="Height" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelSettings"
                                         Storyboard.TargetProperty="Opacity" To="0" Duration="0" />
                        <DoubleAnimation Storyboard.TargetName="NavLabelSettings"
                                         Storyboard.TargetProperty="Height" To="0" Duration="0" />
                    </Storyboard>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

        <Grid.ColumnDefinitions>
            <!-- Auto 而不是 96: 轨宽由 NavRail 自己的 Width 决定(那是 double, 能平滑动画),
                 列宽自动跟随。写死 96 的话就得为 GridLength 写一个自定义动画类, 不值当。 -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ============ 左侧导航栏(通高) ============ -->
        <Border x:Name="NavRail" Grid.Column="0" Width="96"
                Background="{DynamicResource SideBarBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 品牌图标。
                     上边距 18 是**对着页面标题定的**: 42px 的图标中心落在 y=39,
                     与各页面大标题(PageTitleStyle 28 号字 + 头部上边距 20)的中心基本重合 ——
                     也就是首页那两个字和这个 logo 处在同一条水平线上。
                     CaptionHeight 只有 20, 图标基本不在拖动区里, 但它本来也不是可点的东西。 -->
                <Border x:Name="BrandLogo" Grid.Row="0" Width="42" Height="42" CornerRadius="12"
                        HorizontalAlignment="Center" Margin="0,18,0,20"
                        Cursor="Hand" ToolTip="分区" MouseLeftButtonUp="OnBrandLogoClick">
                    <Border.Background>
                        <ImageBrush ImageSource="/Assets/app.png" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>

                <!-- 导航项: 图标在上、文字在下(NavRadioStyle)。
                     间距 4 而不是贴着排: 58px 高的块连成一串会显得很闷。
                     VerticalAlignment="Center" 让这几项在"logo 与底部之间"那段里垂直居中,
                     而不是紧贴 logo 下方、把大半个侧边栏空着。
                     2026-09-26 用户改版: 收藏/历史从侧栏撤下(入口收进「我的」页),
                     新增「我的」; 左下角的头像账户区也一并撤掉。 -->
                <StackPanel Grid.Row="1" HorizontalAlignment="Stretch" Margin="10,0"
                            VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <!--
                            导航项的图标和文字都要跟随选中色(悬停浅色 / 选中粉色)。
                            全局那个隐式 TextBlock 样式带 Foreground setter, 优先级**高于属性继承**,
                            会把 NavRadioStyle 模板传下来的颜色钉回主文字色 —— 选中项只剩底框变粉。
                            在这里(内容自己的资源作用域里)放一个隐式样式把它挡住,
                            Foreground 直接绑到祖先 RadioButton 的 Foreground: 触发器改哪它跟哪。
                            注意这道补丁不能放进 NavRadioStyle 的模板里 —— 这里的 TextBlock 是
                            显式内容, 隐式样式查找走逻辑树, 模板内 ContentPresenter.Resources 拦不到。
                        -->
                        <Style TargetType="TextBlock" BasedOn="{x:Null}">
                            <Setter Property="Foreground"
                                    Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="NavHome" GroupName="NavGroup" Style="{StaticResource NavRadioStyle}"
                                 HorizontalAlignment="Stretch"
                                 ToolTip="首页" Click="OnNavClick"
                                 Tag="{x:Static vm:PageKey.Home}"
                                 IsChecked="{Binding Current, Converter={StaticResource EnumEquals}, ConverterParameter=Home, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" HorizontalAlignment="Center" />
                            <!-- 文字外面套一层 Grid 是为了能在窄档里动画 Height(见根元素那组 VisualState):
                                 TextBlock 自己在 FontSize 11 下没有确定高度, 动画 Height 会先撑变形。 -->
                            <Grid x:Name="NavLabelHome" Height="15" Margin="0,4,0,0">
                                <TextBlock Text="首页" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavFollow" GroupName="NavGroup" Style="{StaticResource NavRadioStyle}"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,4,0,0" ToolTip="动态" Click="OnNavClick"
                                 Tag="{x:Static vm:PageKey.Follow}"
                                 IsChecked="{Binding Current, Converter={StaticResource EnumEquals}, ConverterParameter=Follow, Mode=OneWay}">
                        <StackPanel>
                            <Path Data="{StaticResource DynamicIconGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.6" Width="18" Height="18"
                                  Stretch="Uniform" HorizontalAlignment="Center" />
                            <Grid x:Name="NavLabelFollow" Height="15" Margin="0,4,0,0">
                                <TextBlock Text="动态" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavMine" GroupName="NavGroup" Style="{StaticResource NavRadioStyle}"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,4,0,0" ToolTip="我的" Click="OnNavClick"
                                 Tag="{x:Static vm:PageKey.Mine}"
                                 IsChecked="{Binding Current, Converter={StaticResource EnumEquals}, ConverterParameter=Mine, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="&#xE77B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" HorizontalAlignment="Center" />
                            <Grid x:Name="NavLabelMine" Height="15" Margin="0,4,0,0">
                                <TextBlock Text="我的" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton x:Name="NavSettings" GroupName="NavGroup" Style="{StaticResource NavRadioStyle}"
                                 HorizontalAlignment="Stretch"
                                 Margin="0,4,0,0" ToolTip="设置" Click="OnNavClick"
                                 Tag="{x:Static vm:PageKey.Settings}"
                                 IsChecked="{Binding Current, Converter={StaticResource EnumEquals}, ConverterParameter=Settings, Mode=OneWay}">
                        <StackPanel>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="18" HorizontalAlignment="Center" />
                            <Grid x:Name="NavLabelSettings" Height="15" Margin="0,4,0,0">
                                <TextBlock Text="设置" FontSize="11"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ 右侧: 内容区 ============
             内容区**占满整列**, 顶部不再留一条标题栏的高度 —— 页面内容因此整体上移,
             首页的大标题才能和左上角的 logo 落在同一条水平线上(见 logo 那段的说明)。 -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <ContentControl x:Name="PageHost" Focusable="False" />

            <!--
                ============ 切页过渡的"幕布" ============

                切页的淡出/淡入动画**画在这一层上**, 而不是画在 PageHost 自己身上
                (2026-10-03 重做, 用户要求"整页淡入淡出动画重做, 既保证有动画又要保证流畅")。

                ★★ 实测结论先说(探针 `%TEMP%\bd-probe-navframes`, 真实窗口 + CompositionTarget.Rendering
                   量合成帧间隔, 325 张卡的页面):
                     · 子树静止时: 动画 PageHost.Opacity 与动画幕布**一样** —— 两者都是
                       p50 ~7ms / p95 ~14ms / 掉帧 0。**"动画容器导致每帧重栅格化"在这台机器上量不出来**,
                       所以别再把"幕布"写成卡顿的修复(旧注释是这么写的, 已按实测改正)。
                     · 子树在变时(复刻 DeferredFill 每 16ms 加 24 张卡): 两者也都一样(~127ms 一次长帧),
                       那次长帧是**卡片批量重排**的账, 与透明度动画无关。
                   ⇒ 动画载体不是卡顿来源。选幕布的**真实理由**是下面两条。

                ★ 理由一(有实测): 幕布盖住之后**才去建页面实例**。`PageOf` 首次要解析整棵 XAML,
                  探针 Release 口径实测首页 **~360ms**(`bd-probe-navcost` 的 A 段)。旧写法把这句放在 ShowPage 最前面,
                  于是那 360ms 卡在"点击 → 动画开始"之间, 用户看到的是**点了没反应**;
                  现在它落在幕布已经全不透明的那段时间里, 用户看到的只是"一块背景色"。
                  ★ 顺带的好处: 淡出期间用户改点别的导航项时, 这一拍会被代数闸取消 —— 页面**根本不会被建**。

                ★ 理由二(结构性): 页面子树全程保持 `Opacity=1`, 不依赖"中间表面"的行为。
                  这条在本机量不出差异, 但它把"整页半透明合成"这种最容易在别的机器/驱动上退化的
                  画法整个绕开了 —— 观感不变, 风险更低。

                ★ 为什么能严丝合缝地对上页面底色:
                  本层的底色绑的是**窗口自己的 Background**(由 FluentWindow.ApplyChrome 按深浅
                  主题设成不透明的 WindowSolid*Brush), 而各页面的 AppBackgroundBrush 是
                  #B3 的半透明色、压在同一个窗口底色上合成出来的结果**正好等于那个纯色**
                  (浅色 #B3F3F3F3 压 #F3F3F3 → #F3F3F3; 深色同理; 探针 B 段实测两套主题都相等)。
                  所以它盖满时看上去就是"内容区空了", 不会露出一块颜色不同的板子。
                  ★ 别改成 AppBackgroundBrush —— 那个是半透明的, 盖不住下面的新页面。

                ★ 位置: 夹在 PageHost 与 EmbeddedHost 之间 ⇒ 压住页面, 但压不住内嵌页的返回头、
                  Toast 和右上角窗口按钮(那三样在过渡期间照常可见可点)。

                ★ 常驻 Collapsed + IsHitTestVisible=False: 不参与命中测试, 空闲时零开销。
            -->
            <Border x:Name="NavVeil"
                    Background="{Binding Background, RelativeSource={RelativeSource AncestorType=Window}}"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False" />

            <!--
                内嵌页宿主: UP 主主页这类"从当前页面点进去、又要能退回来"的页面走这里,
                不再另开一个独立窗口 —— 独立窗口看起来像换了个程序, 关掉还容易顺手把主界面一起关掉。
                它盖在 PageHost 之上, 自带一条"返回"头; 切换到任何导航页都会自动关掉它。
            -->
            <Grid x:Name="EmbeddedHost" Visibility="Collapsed" Opacity="0"
                  Background="{DynamicResource AppBackgroundBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 顶部内边距 44: 内嵌页盖在内容区上、也从窗口最上沿开始,
                     返回按钮要落到右上角窗口按钮(y=4~36)的下方, 否则和它们叠在一起 -->
                <Border Grid.Row="0" Padding="36,44,36,14"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource SubtleButtonStyle}" Click="OnEmbeddedBackClick"
                                Padding="10,6" FontSize="13" VerticalAlignment="Center" ToolTip="返回上一页">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="13" VerticalAlignment="Center" />
                                <TextBlock Text="返回" Margin="6,0,0,0" FontSize="13" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="EmbeddedTitle" Margin="14,0,0,0" FontSize="13"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>

                <ContentPresenter x:Name="EmbeddedContent" Grid.Row="1" />
            </Grid>

            <!-- Toast 通知。
                 从 44 起而不是 20: 右上角的窗口按钮占 y=4~36, Toast 放 20 正好叠在它们上面 -->
            <Border x:Name="Toast" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,44,24,0" CornerRadius="8" Padding="16,10"
                    Background="{DynamicResource ToastBackgroundBrush}"
                    BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1"
                    Opacity="0" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock x:Name="ToastText" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
            </Border>

            <!--
                最小化 / 最大化 / 关闭 三个按钮浮在右上角。
                做成浮层(Panel.ZIndex 压在最上层)而不是一条独立的标题栏行: 独立一行会把内容区
                往下压一个标题栏的高度, 页面标题就比左侧栏的 logo 低一截, 那正是这次要修的观感。
                按钮自己带 IsHitTestVisibleInChrome(见 WindowButtons), 不写的话点在按钮上是拖窗口。
            -->
            <controls:WindowButtons HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,4,4,0" Panel.ZIndex="20" />
        </Grid>

        <!-- ============ 分区面板(点左上角 logo 展开) ============
             2026-09-26 用户要求: 只保留"与视频相关"的分区(其他全精简掉), 且展开后**占用左上角区域**
             —— 所以是一个从 logo 下方长出来的下拉卡, 不再是盖满整窗的大面板。
             从 logo 处展开: 遮罩淡入 + 面板以左上角为锚点缩放放大(RenderTransformOrigin=0,0)。
             点遮罩 / 点任一分区项 / 鼠标侧键 / 切导航页都会收起。 -->
        <Border x:Name="PartitionScrim" Grid.ColumnSpan="2" Panel.ZIndex="40"
                Background="#4D000000" Opacity="0" Visibility="Collapsed"
                MouseLeftButtonDown="OnPartitionScrimClick" />
        <Border x:Name="PartitionPanel" Grid.ColumnSpan="2" Panel.ZIndex="41"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="14,66,14,20" Width="470" Padding="24,18,24,22"
                CornerRadius="12" Opacity="0" Visibility="Collapsed"
                Background="{DynamicResource FlyoutBackgroundBrush}"
                BorderBrush="{DynamicResource FlyoutBorderBrush}" BorderThickness="1"
                RenderTransformOrigin="0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="6" Opacity="0.28" />
            </Border.Effect>
            <Border.RenderTransform>
                <ScaleTransform x:Name="PartitionScale" ScaleX="1" ScaleY="1" />
            </Border.RenderTransform>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="分区" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl x:Name="PartitionCol0" Grid.Column="0" ItemTemplate="{StaticResource PartitionItemTemplate}" />
                    <ItemsControl x:Name="PartitionCol1" Grid.Column="1" ItemTemplate="{StaticResource PartitionItemTemplate}" />
                    <ItemsControl x:Name="PartitionCol2" Grid.Column="2" ItemTemplate="{StaticResource PartitionItemTemplate}" />
                </Grid>
            </Grid>
        </Border>

        <!-- 隐藏的小 WebView2: 用于退出登录时清理 Cookie(清理时短暂显示 1px) -->
        <wv2:WebView2 x:Name="HiddenWebView" Grid.Column="1" Width="1" Height="1"
                      Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
    </Grid>
</views:FluentWindow>
