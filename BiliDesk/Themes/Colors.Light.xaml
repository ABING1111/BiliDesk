<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 浅色主题色板 (Windows 11 Fluent Light) ============ -->

    <!-- 窗口基底(无可用的 Mica 时的实色回退) -->
    <SolidColorBrush x:Key="WindowSolidLightBrush" Color="#F3F3F3" />
    <SolidColorBrush x:Key="WindowSolidDarkBrush" Color="#202020" />

    <!-- 页面基底: 半透明, 露出云母纹理 -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#B3F3F3F3" />
    <SolidColorBrush x:Key="SideBarBackgroundBrush" Color="#8CF3F3F3" />

    <!-- 卡片 -->
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <!-- 悬停色。浅色主题下原来是纯白(= 和常态一样, 等于没有反馈), 压暗一点点才看得出来 -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
    <!-- 悬停时的描边: 比常态深一档, 是"鼠标在手边"的主要视觉提示 -->
    <SolidColorBrush x:Key="DividerBrush" Color="#10000000" />

    <!-- 文字 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#616161" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#909090" />
    <!--
        TextOnAccentBrush / TextOnAccentSecondaryBrush 刻意不在这里定义:
        它们必须跟随"当前强调色的亮度"变化, 由 ThemeService.ApplyAccent() 按 WCAG
        对比度算出后写入 Application.Resources。
        如果在这里写死 #FFFFFF, 强调色偏浅时文字就会隐形(App.xaml 里保留了同名占位,
        避免 XAML 解析期找不到键, 但真正生效的值一律来自 ApplyAccent)。
    -->

    <!-- 控件填充 -->
    <SolidColorBrush x:Key="ControlFillDefaultBrush" Color="#0A000000" />
    <SolidColorBrush x:Key="ControlFillHoverBrush" Color="#14000000" />
    <SolidColorBrush x:Key="ControlFillPressedBrush" Color="#1F000000" />
    <SolidColorBrush x:Key="NavItemHoverBrush" Color="#0A000000" />

    <!-- 浮动工具列按钮的填充: **不透明版**的控制填充。
         ⚠ 为什么必须另立一组: 上面那三个是带透明度的(#0A000000 = 4% 黑), 只适合"浮在纯色
         页面背景上"; 而右下角工具列是浮在**卡片封面**上的, 半透明就等于露出底下的图片,
         图标会糊进图案里看不清(用户截图反馈)。
         ★ 常态色 2026-10-05 由纯白改为 #E8EAED: 用户反馈"右下角工具列按钮仍偏白"。
            它们压在**彩色封面**上, 纯白在彩色背景旁边会被读成刺眼的"白块"; 压到 #E8EAED
            后既不再扎眼, 又仍然比页面底(#F3F3F3)更"实", 图标可读性不受影响。
            ★ 不能改成半透明: 半透明会露出封面图案, 图标会糊掉(见上面那条)。 -->
    <SolidColorBrush x:Key="FloatingFillBrush" Color="#E8EAED" />
    <SolidColorBrush x:Key="FloatingFillHoverBrush" Color="#DDE0E4" />
    <SolidColorBrush x:Key="FloatingFillPressedBrush" Color="#CFD3D8" />

    <!--
        浮层面板底色(如播放器的合集面板): **恒为不透明**, 且**刻意不进** ThemeService 的
        ApplyAcrylicSurfaces 覆盖清单 —— 亚克力开关改不了它。
        ★ 为什么必须与 FloatingFillBrush 分开: 那个键给"右下角工具列"用, 亚克力开启时会被
          覆盖成 70% 半透明(工具列浮在卡片封面上, 透出壁纸才叫亚克力质感)。但浮层面板
          底下是**内容**(简介/评论列表), 半透明会让底下文字整片透上来糊成一片。
          两个用途的需求正好相反, 共用一个键必然有一处被牺牲 —— 2026-10-05 用户报的
          "亚克力下合集页背景几乎透明"就是这么来的。
        ★ 取值与 FloatingFillBrush 的常态色一致, 纯色模式下两者看不出差别;
          亚克力模式下这个键仍是不透明, 合集面板不会跟着工具列一起变透。 -->
    <SolidColorBrush x:Key="OverlaySurfaceBrush" Color="#E8EAED" />

    <!-- 输入框 -->
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#22000000" />

    <!-- 特殊 -->
    <SolidColorBrush x:Key="DurationBadgeBackgroundBrush" Color="#A6000000" />
    <SolidColorBrush x:Key="ToastBackgroundBrush" Color="#F2FFFFFF" />
    <SolidColorBrush x:Key="ToastBorderBrush" Color="#26000000" />
    <SolidColorBrush x:Key="InfoBarBackgroundBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="#0D000000" />

    <!-- 热搜徽章(新 / 热 / 独家)。这是**语义色**(和"这就是新/热/独家"绑定), 与深浅色主题无关 ——
         两张色板里刻意写同一组值, 和 Danger 那组红一样。徽章上固定白字。 -->
    <SolidColorBrush x:Key="HotBadgeNewBrush" Color="#ED8F1A" />
    <SolidColorBrush x:Key="HotBadgeHotBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="HotBadgeExclusiveBrush" Color="#E1519A" />

    <!-- 浮出层(右键菜单等): 必须接近不透明, 否则菜单叠在视频/图片上会透出底下的内容 -->
    <SolidColorBrush x:Key="FlyoutBackgroundBrush" Color="#FCFFFFFF" />
    <SolidColorBrush x:Key="FlyoutBorderBrush" Color="#1A000000" />
    <SolidColorBrush x:Key="FlyoutItemHoverBrush" Color="#14000000" />

    <!-- 滚动条: 平时半透明, 悬停/拖动时加深, 不抢视线又找得到 -->
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#33000000" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#66000000" />

    <!-- 危险操作(删除 / 清空)。两套主题用同一组值: 深红色饱和度足够,
         在浅底和深底上都读得出来, 而且红色在深色界面上本来就更"沉"得下去。
         红底上的文字固定白色 —— 这组红够暗, 白字对比度 5.4:1。 -->
    <SolidColorBrush x:Key="DangerBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#D93A2B" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#A31F12" />
    <SolidColorBrush x:Key="DangerTextBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="TextOnDangerBrush" Color="#FFFFFF" />

    <!-- 说明: 强调色(Accent*)一律由 ThemeService 注入品牌粉, 见 App.xaml 里的兜底定义。
         这里不放任何固定的强调色, 否则会和品牌色打架。 -->

</ResourceDictionary>
