<?xml version="1.0" encoding="utf-8"?>
<!-- NuGet 源配置: 优先官方源, 失败时自动使用中国区镜像, 加速还原 -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="azure-cn" value="https://nuget.azure.cn/v3/index.json" />
  </packageSources>
  <config>
    <add key="signatureValidationMode" value="accept" />
  </config>
</configuration>